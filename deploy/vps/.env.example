# Repository clone on the VPS. Keep this absolute path unchanged unless the
# repository was cloned elsewhere.
APP_DIR=/srv/chashka-coffee/app
UPLOADS_DIR=/srv/chashka-coffee/uploads
WEBSITE_RELEASES_DIR=/srv/chashka-coffee/website-releases

# Dev domains. DNS A records for all three hosts must point to the VPS before
# Caddy can obtain HTTPS certificates.
WEBSITE_HOST=dev.chashkacoffee.ru
WEBAPP_HOST=admin-dev.chashkacoffee.ru
API_HOST=api-dev.chashkacoffee.ru
ACME_EMAIL=ops@example.com

# These are build-time public URLs. Rebuild the relevant frontend after they
# change; changing only the running containers is not enough.
PUBLIC_SITE_URL=https://dev.chashkacoffee.ru
PUBLIC_API_URL=https://api-dev.chashkacoffee.ru
PUBLIC_WEBAPP_URL=https://admin-dev.chashkacoffee.ru
VITE_API_URL=https://api-dev.chashkacoffee.ru
VITE_PUBLIC_SITE_URL=https://dev.chashkacoffee.ru

# Database. Generate POSTGRES_PASSWORD with `openssl rand -hex 24`; hexadecimal
# values keep DATABASE_URL unambiguous without URL escaping.
POSTGRES_DB=chashka_coffee_dev
POSTGRES_USER=chashka
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
DATABASE_URL=postgresql://chashka:REPLACE_WITH_RANDOM_HEX@postgres:5432/chashka_coffee_dev?schema=public

# Backend runtime.
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
CORS_ORIGINS=https://dev.chashkacoffee.ru,https://admin-dev.chashkacoffee.ru
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true
MEDIA_UPLOADS_DIR=/srv/uploads
MEDIA_UPLOAD_MAX_BYTES=10485760
# Public content changes wait briefly so several edits become one static build.
WEBSITE_BUILD_DEBOUNCE_SECONDS=45
WEBSITE_BUILD_POLL_SECONDS=10
WEBSITE_BUILD_RETRY_SECONDS=300

# Keep optional integrations blank until each integration is intentionally
# enabled. Never commit the real .env file.
PREMIUMBONUS_API_TOKEN=
PREMIUMBONUS_API_URL=https://site-v2.apipb.ru/
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Legacy S3-compatible storage configuration. Direct VPS uploads use the
# MEDIA_UPLOADS_DIR mount above, so leave this group blank.
SPACES_REGION=
SPACES_BUCKET=
SPACES_ENDPOINT=
SPACES_CDN_BASE_URL=
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
SPACES_UPLOAD_MAX_BYTES=10485760
SPACES_UPLOAD_URL_TTL_SECONDS=900
SPACES_DOWNLOAD_URL_TTL_SECONDS=300
SPACES_PUBLIC_CACHE_CONTROL="public, max-age=31536000, immutable"
