# Local PostgreSQL from ../docker-compose.yml.
# Keep an explicit username and password in Prisma URLs even on local machines.
# Peer-auth style URLs without a user can produce opaque Prisma schema-engine errors.
DATABASE_URL="postgresql://superuser:superpassword@localhost:54329/chashka_coffee?schema=public"

# Test PostgreSQL from ../docker-compose.yml. Backend integration, Docker smoke,
# and Playwright E2E use this shape and must target the *_test database.
TEST_DATABASE_URL="postgresql://superuser:superpassword@localhost:54330/chashka_coffee_test?schema=public"

JWT_SECRET="replace-with-at-least-32-random-characters"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4321,http://127.0.0.1:4321,http://localhost:8081,http://localhost:19006"
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_DAYS="30"
COOKIE_SECURE="false"

# PremiumBonus powers the customer account. Keep the developer token only on
# the backend; never expose it through PUBLIC_* or VITE_* variables.
PREMIUMBONUS_API_TOKEN=""
PREMIUMBONUS_API_URL="https://site-v2.apipb.ru/"

# Optional operational notifications. Create the bot via @BotFather, then add
# the token and username without the leading @. Do not enable a webhook for
# this bot: the admin connection flow reads recent private chats via getUpdates.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# Optional YooKassa test shop. Fill all three values together. The secret key
# stays on the backend; the return URL is the public customer order page.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
YOOKASSA_RETURN_URL=""
YOOKASSA_TEST_MODE="true"

# Direct-to-VPS media uploads. On the VPS this directory is a persistent bind
# mount; leave it blank locally until you want to test uploads on disk.
MEDIA_UPLOADS_DIR=""
MEDIA_UPLOAD_MAX_BYTES="10485760"

# Optional DigitalOcean Spaces storage. Leave blank until the product needs
# uploads, media, or other persistent files.
SPACES_REGION=""
SPACES_BUCKET=""
SPACES_ENDPOINT=""
SPACES_CDN_BASE_URL=""
SPACES_ACCESS_KEY_ID=""
SPACES_SECRET_ACCESS_KEY=""
SPACES_UPLOAD_MAX_BYTES="10485760"
SPACES_UPLOAD_URL_TTL_SECONDS="900"
SPACES_DOWNLOAD_URL_TTL_SECONDS="300"
SPACES_PUBLIC_CACHE_CONTROL="public, max-age=31536000, immutable"
