generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RestaurantFormat {
  CITY
  PARK
  AIRPORT
  APART_HOTEL
}

enum RestaurantArea {
  CITY
  PARK
  AIRPORT
}

enum MarketingBadge {
  NEW
  HIT
  SEASONAL
  SPECIAL
}

enum MenuItemMeasurementUnit {
  GRAM
  MILLILITER
  PIECE
}

enum UserRole {
  ADMIN
  EDITOR
  SUPER_ADMIN
  CONTENT_MANAGER
  CATALOG_MANAGER
  ORDER_OPERATOR
  LEAD_OPERATOR
  RECRUITER
}

enum AnalyticsDevice {
  DESKTOP
  TABLET
  MOBILE
}

enum ContentEntryType {
  PROMOTION
  EVENT
  ARTICLE
}

enum HomepageSlideMediaType {
  IMAGE
  VIDEO
}

enum PublicationStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum LeadType {
  CONTACT
  RESERVATION
  FRANCHISE
  BANQUET
  CAKE
  JOB
  EVENT_REGISTRATION
}

enum ProductType {
  COFFEE
  CAKE
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  PREPARING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

enum CommunicationChannel {
  PUSH
  EMAIL
  SMS
}

enum ConsentStatus {
  GRANTED
  WITHDRAWN
}

enum PushProvider {
  WEB_PUSH
  EXPO
}

enum PushPlatform {
  WEB
  IOS
  ANDROID
}

enum NotificationCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  CANCELLED
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum OperationalNotificationEvent {
  COFFEE_ORDER
  CAKE_REQUEST
  FOOTER_INQUIRY
  CONTACT_REQUEST
  RESERVATION_REQUEST
  BANQUET_REQUEST
  FRANCHISE_REQUEST
  JOB_APPLICATION
  JOB_GENERAL_INQUIRY
  EVENT_REGISTRATION
}

enum ManagedPageKey {
  HOME
  COFFEE
  RESTAURANTS
  DELIVERY
  APP
  LOYALTY
  CERTIFICATES
  BAKERY
  FRANCHISE
  JOBS
  CONTACTS
  ABOUT
  BANQUETS
  PROMOTIONS
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

enum MediaAssetStatus {
  PENDING
  READY
}

model User {
  id                    String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email                 String                 @unique
  passwordHash          String                 @map("password_hash")
  displayName           String?                @map("display_name")
  role                  UserRole               @default(EDITOR)
  roles                 UserRole[]             @default([])
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  sessions              AuthSession[]
  auditEvents           AdminAuditEvent[]
  customerNotes         CustomerNote[]
  notificationCampaigns NotificationCampaign[]

  @@map("users")
}

model AdminAuditEvent {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorName  String   @map("actor_name") @db.VarChar(320)
  action     String   @db.VarChar(24)
  resource   String   @db.VarChar(80)
  resourceId String?  @map("resource_id") @db.VarChar(120)
  path       String   @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull, map: "admin_audit_events_actor_id_fkey")

  @@index([createdAt], map: "admin_audit_events_created_at_idx")
  @@index([resource, resourceId], map: "admin_audit_events_resource_id_idx")
  @@map("admin_audit_events")
}

model AuthSession {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique(map: "auth_sessions_refresh_token_hash_key") @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "auth_sessions_user_id_fkey")

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

model CustomerAccount {
  id                   String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  premiumBonusClientId String            @unique @map("premium_bonus_client_id") @db.VarChar(100)
  phone                String            @unique @db.VarChar(20)
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  sessions             CustomerSession[]
  orders               Order[]
  crmCustomerId        String?           @unique(map: "customer_accounts_crm_customer_id_key") @map("crm_customer_id") @db.Uuid
  crmCustomer          Customer?         @relation(fields: [crmCustomerId], references: [id], onDelete: SetNull, map: "customer_accounts_crm_customer_id_fkey")

  @@map("customer_accounts")
}

model CustomerSession {
  id               String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  customerId       String          @map("customer_id") @db.Uuid
  sessionTokenHash String          @unique(map: "customer_sessions_token_hash_key") @map("session_token_hash")
  expiresAt        DateTime        @map("expires_at")
  revokedAt        DateTime?       @map("revoked_at")
  userAgent        String?         @map("user_agent")
  ipAddress        String?         @map("ip_address")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  customer         CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade, map: "customer_sessions_customer_id_fkey")

  @@index([customerId], map: "customer_sessions_customer_id_idx")
  @@index([expiresAt], map: "customer_sessions_expires_at_idx")
  @@map("customer_sessions")
}

model CustomerLoginChallenge {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  phone        String    @db.VarChar(20)
  attemptCount Int       @default(0) @map("attempt_count")
  sentAt       DateTime? @map("sent_at")
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([phone, sentAt], map: "customer_login_challenges_phone_sent_at_idx")
  @@index([expiresAt], map: "customer_login_challenges_expires_at_idx")
  @@map("customer_login_challenges")
}

model PageView {
  id        String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  path      String          @db.VarChar(500)
  visitorId String          @map("visitor_id") @db.Uuid
  referrer  String?         @db.VarChar(1000)
  device    AnalyticsDevice @default(DESKTOP)
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([createdAt], map: "page_views_created_at_idx")
  @@index([path, createdAt], map: "page_views_path_created_at_idx")
  @@index([visitorId, createdAt], map: "page_views_visitor_created_at_idx")
  @@map("page_views")
}

model ContentEntry {
  id                  String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type                ContentEntryType
  status              PublicationStatus @default(DRAFT)
  slug                String            @unique @db.VarChar(120)
  title               String            @db.VarChar(180)
  excerpt             String?           @db.VarChar(500)
  body                String?
  blocks              Json              @default("[]")
  imageUrl            String?           @map("image_url")
  ctaLabel            String?           @map("cta_label") @db.VarChar(80)
  ctaUrl              String?           @map("cta_url")
  startsAt            DateTime?         @map("starts_at")
  endsAt              DateTime?         @map("ends_at")
  publishAt           DateTime?         @map("publish_at")
  eventStartsAt       DateTime?         @map("event_starts_at")
  location            String?           @db.VarChar(220)
  priceKopecks        Int?              @map("price_kopecks")
  registrationEnabled Boolean           @default(false) @map("registration_enabled")
  isFeatured          Boolean           @default(false) @map("is_featured")
  position            Int               @default(0)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@index([type, status, position], map: "content_entries_type_status_position_idx")
  @@index([startsAt], map: "content_entries_starts_at_idx")
  @@map("content_entries")
}

model ManagedPage {
  id              String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key             ManagedPageKey @unique
  title           String         @db.VarChar(180)
  heroTitle       String?        @map("hero_title") @db.VarChar(180)
  heroDescription String?        @map("hero_description") @db.VarChar(500)
  heroImageUrl    String?        @map("hero_image_url")
  coffeeTastes    Json?          @map("coffee_tastes")
  appChoices      Json?          @map("app_choices")
  images          Json           @default("[]")
  blocks          Json           @default("[]")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@map("managed_pages")
}

model Product {
  id           String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type         ProductType
  status       PublicationStatus @default(DRAFT)
  publishAt    DateTime?         @map("publish_at")
  slug         String            @unique @db.VarChar(120)
  name         String            @db.VarChar(180)
  category     String?           @db.VarChar(120)
  subtitle     String?           @db.VarChar(180)
  description  String?
  ingredients  String?
  origin       String?           @db.VarChar(180)
  roastLevel   String?           @map("roast_level") @db.VarChar(80)
  tastingNotes Json              @default("[]") @map("tasting_notes")
  imageUrl     String?           @map("image_url")
  galleryUrls  Json              @default("[]") @map("gallery_urls")
  details      Json              @default("[]")
  blocks       Json              @default("[]")
  isFeatured   Boolean           @default(false) @map("is_featured")
  position     Int               @default(0)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  variants     ProductVariant[]

  @@index([type, status, position], map: "products_type_status_position_idx")
  @@map("products")
}

model ProductVariant {
  id           String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId    String      @map("product_id") @db.Uuid
  label        String      @db.VarChar(80)
  weightGrams  Int?        @map("weight_grams")
  priceKopecks Int         @map("price_kopecks")
  position     Int         @default(0)
  isAvailable  Boolean     @default(true) @map("is_available")
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade, map: "product_variants_product_id_fkey")
  orderItems   OrderItem[]

  @@index([productId, position], map: "product_variants_product_id_position_idx")
  @@map("product_variants")
}

model HomepageSlide {
  id              String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  mediaType       HomepageSlideMediaType @map("media_type")
  mediaUrl        String                 @map("media_url")
  posterUrl       String?                @map("poster_url")
  eyebrow         String?                @db.VarChar(80)
  title           String                 @db.VarChar(180)
  description     String?                @db.VarChar(500)
  ctaLabel        String?                @map("cta_label") @db.VarChar(80)
  ctaUrl          String?                @map("cta_url")
  durationSeconds Int                    @default(7) @map("duration_seconds")
  isPublished     Boolean                @default(false) @map("is_published")
  position        Int                    @default(0)
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  @@index([isPublished, position], map: "homepage_slides_published_position_idx")
  @@map("homepage_slides")
}

model HomepageBestseller {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  menuItemId  String   @map("menu_item_id") @db.Uuid
  badge       String?  @db.VarChar(40)
  position    Int      @default(0)
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade, map: "homepage_bestsellers_menu_item_id_fkey")

  @@unique([menuItemId], map: "homepage_bestsellers_menu_item_id_key")
  @@index([isPublished, position], map: "homepage_bestsellers_published_position_idx")
  @@map("homepage_bestsellers")
}

model HomepageDaySection {
  id          String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  title       String            @db.VarChar(180)
  description String?           @db.VarChar(500)
  isPublished Boolean           @default(false) @map("is_published")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  parts       HomepageDayPart[]

  @@index([isPublished], map: "homepage_day_sections_published_idx")
  @@map("homepage_day_sections")
}

model HomepageDayPart {
  id          String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sectionId   String             @map("section_id") @db.Uuid
  label       String             @db.VarChar(80)
  title       String             @db.VarChar(180)
  description String?            @db.VarChar(500)
  ctaUrl      String?            @map("cta_url")
  position    Int                @default(0)
  isPublished Boolean            @default(false) @map("is_published")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  section     HomepageDaySection @relation(fields: [sectionId], references: [id], onDelete: Cascade, map: "homepage_day_parts_section_id_fkey")

  @@index([sectionId, isPublished, position], map: "homepage_day_parts_section_published_position_idx")
  @@map("homepage_day_parts")
}

model MediaAsset {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  objectKey   String           @unique @map("object_key") @db.VarChar(1024)
  publicUrl   String           @map("public_url")
  filename    String           @db.VarChar(255)
  contentType String           @map("content_type") @db.VarChar(120)
  byteSize    Int              @map("byte_size")
  status      MediaAssetStatus @default(READY)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([createdAt], map: "media_assets_created_at_idx")
  @@map("media_assets")
}

model SiteSettings {
  id             String   @id @default("global") @db.VarChar(32)
  headerPreviews Json     @default("[]") @map("header_previews")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model Lead {
  id            String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type          LeadType
  status        LeadStatus @default(NEW)
  name          String     @db.VarChar(180)
  phone         String?    @db.VarChar(40)
  email         String?    @db.VarChar(320)
  message       String?
  payload       Json?
  crmCustomerId String?    @map("crm_customer_id") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  crmCustomer   Customer?  @relation(fields: [crmCustomerId], references: [id], onDelete: SetNull, map: "leads_crm_customer_id_fkey")

  @@index([type, status, createdAt], map: "leads_type_status_created_at_idx")
  @@index([crmCustomerId, createdAt], map: "leads_crm_customer_created_at_idx")
  @@map("leads")
}

model Customer {
  id                     String                     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name                   String                     @db.VarChar(180)
  phone                  String                     @unique @db.VarChar(20)
  email                  String?                    @db.VarChar(320)
  status                 CustomerStatus             @default(ACTIVE)
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")
  account                CustomerAccount?
  orders                 Order[]
  leads                  Lead[]
  notes                  CustomerNote[]
  tags                   CustomerTagAssignment[]
  consents               CustomerConsent[]
  pushSubscriptions      CustomerPushSubscription[]
  notificationDeliveries NotificationDelivery[]

  @@index([createdAt], map: "customers_created_at_idx")
  @@index([updatedAt], map: "customers_updated_at_idx")
  @@map("customers")
}

model CustomerNote {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  body       String   @db.VarChar(4000)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, map: "customer_notes_customer_id_fkey")
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull, map: "customer_notes_author_id_fkey")

  @@index([customerId, createdAt], map: "customer_notes_customer_created_at_idx")
  @@map("customer_notes")
}

model CustomerTag {
  id        String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String                  @unique @db.VarChar(80)
  color     String?                 @db.VarChar(20)
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")
  customers CustomerTagAssignment[]

  @@map("customer_tags")
}

model CustomerTagAssignment {
  customerId String      @map("customer_id") @db.Uuid
  tagId      String      @map("tag_id") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at")
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade, map: "customer_tag_assignments_customer_id_fkey")
  tag        CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade, map: "customer_tag_assignments_tag_id_fkey")

  @@id([customerId, tagId])
  @@index([tagId], map: "customer_tag_assignments_tag_id_idx")
  @@map("customer_tag_assignments")
}

model CustomerConsent {
  id          String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  customerId  String               @map("customer_id") @db.Uuid
  channel     CommunicationChannel
  status      ConsentStatus
  source      String               @db.VarChar(120)
  grantedAt   DateTime?            @map("granted_at")
  withdrawnAt DateTime?            @map("withdrawn_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade, map: "customer_consents_customer_id_fkey")

  @@unique([customerId, channel], map: "customer_consents_customer_channel_key")
  @@index([channel, status], map: "customer_consents_channel_status_idx")
  @@map("customer_consents")
}

model CustomerPushSubscription {
  id         String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  customerId String                 @map("customer_id") @db.Uuid
  provider   PushProvider
  platform   PushPlatform
  endpoint   String                 @unique
  p256dh     String?
  authSecret String?                @map("auth_secret")
  isActive   Boolean                @default(true) @map("is_active")
  lastSeenAt DateTime               @default(now()) @map("last_seen_at")
  revokedAt  DateTime?              @map("revoked_at")
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")
  customer   Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade, map: "customer_push_subscriptions_customer_id_fkey")
  deliveries NotificationDelivery[]

  @@index([customerId, isActive], map: "customer_push_subscriptions_customer_active_idx")
  @@map("customer_push_subscriptions")
}

model NotificationCampaign {
  id          String                     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  createdById String?                    @map("created_by_id") @db.Uuid
  name        String                     @db.VarChar(180)
  channel     CommunicationChannel       @default(PUSH)
  status      NotificationCampaignStatus @default(DRAFT)
  audience    Json                       @default("{}")
  title       String                     @db.VarChar(120)
  body        String                     @db.VarChar(500)
  deeplink    String?                    @db.VarChar(500)
  scheduledAt DateTime?                  @map("scheduled_at")
  startedAt   DateTime?                  @map("started_at")
  completedAt DateTime?                  @map("completed_at")
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")
  createdBy   User?                      @relation(fields: [createdById], references: [id], onDelete: SetNull, map: "notification_campaigns_created_by_id_fkey")
  deliveries  NotificationDelivery[]

  @@index([status, scheduledAt], map: "notification_campaigns_status_scheduled_idx")
  @@map("notification_campaigns")
}

model NotificationDelivery {
  id                 String                     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  campaignId         String                     @map("campaign_id") @db.Uuid
  customerId         String                     @map("customer_id") @db.Uuid
  pushSubscriptionId String?                    @map("push_subscription_id") @db.Uuid
  status             NotificationDeliveryStatus @default(PENDING)
  providerMessageId  String?                    @map("provider_message_id") @db.VarChar(240)
  errorCode          String?                    @map("error_code") @db.VarChar(120)
  errorMessage       String?                    @map("error_message") @db.VarChar(500)
  sentAt             DateTime?                  @map("sent_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  campaign           NotificationCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade, map: "notification_deliveries_campaign_id_fkey")
  customer           Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade, map: "notification_deliveries_customer_id_fkey")
  pushSubscription   CustomerPushSubscription?  @relation(fields: [pushSubscriptionId], references: [id], onDelete: SetNull, map: "notification_deliveries_push_subscription_id_fkey")

  @@index([campaignId, status], map: "notification_deliveries_campaign_status_idx")
  @@index([customerId, createdAt], map: "notification_deliveries_customer_created_idx")
  @@index([pushSubscriptionId], map: "notification_deliveries_subscription_idx")
  @@map("notification_deliveries")
}

model TelegramRecipient {
  id           String                         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name         String                         @db.VarChar(120)
  chatId       String                         @unique @map("chat_id") @db.VarChar(24)
  username     String?                        @db.VarChar(64)
  eventTypes   OperationalNotificationEvent[] @map("event_types")
  isActive     Boolean                        @default(true) @map("is_active")
  lastSentAt   DateTime?                      @map("last_sent_at")
  lastError    String?                        @map("last_error") @db.VarChar(500)
  createdAt    DateTime                       @default(now()) @map("created_at")
  updatedAt    DateTime                       @updatedAt @map("updated_at")

  @@index([isActive], map: "telegram_recipients_active_idx")
  @@map("telegram_recipients")
}

model JobOpening {
  id             String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug           String             @unique @db.VarChar(120)
  title          String             @db.VarChar(180)
  department     String?            @db.VarChar(120)
  location       String?            @db.VarChar(180)
  employmentType String?            @map("employment_type") @db.VarChar(80)
  description    String?
  restaurantId   String?            @map("restaurant_id") @db.Uuid
  isPublished    Boolean            @default(false) @map("is_published")
  status         PublicationStatus?
  publishAt      DateTime?          @map("publish_at")
  position       Int                @default(0)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  restaurant     Restaurant?        @relation(fields: [restaurantId], references: [id], onDelete: SetNull, map: "job_openings_restaurant_id_fkey")

  @@index([isPublished, position], map: "job_openings_published_position_idx")
  @@index([restaurantId, position], map: "job_openings_restaurant_position_idx")
  @@map("job_openings")
}

model Restaurant {
  id                  String                        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug                String                        @unique @db.VarChar(120)
  name                String                        @db.VarChar(180)
  format              RestaurantFormat
  area                RestaurantArea
  isAtApartHotel      Boolean                       @default(false) @map("is_at_apart_hotel")
  coffeePickupEnabled Boolean                       @default(false) @map("coffee_pickup_enabled")
  city                String                        @db.VarChar(100)
  address             String                        @db.VarChar(300)
  phone               String                        @db.VarChar(40)
  description         String?
  aboutTitle          String?                       @map("about_title") @db.VarChar(180)
  aboutText           String?                       @map("about_text")
  visitAmenities      Json                          @default("[]") @map("visit_amenities")
  coverImageUrl       String?                       @map("cover_image_url")
  galleryUrls         Json                          @default("[]") @map("gallery_urls")
  menuPdfUrl          String?                       @map("menu_pdf_url")
  latitude            Decimal?                      @db.Decimal(9, 6)
  longitude           Decimal?                      @db.Decimal(9, 6)
  yandexMapsUrl       String?                       @map("yandex_maps_url")
  twoGisUrl           String?                       @map("two_gis_url")
  createdAt           DateTime                      @default(now()) @map("created_at")
  updatedAt           DateTime                      @updatedAt @map("updated_at")
  openingHours        RestaurantOpeningHours[]
  scheduleExceptions  RestaurantScheduleException[]
  menuAssignments     RestaurantMenu[]
  menuItemOverrides   MenuItemOverride[]
  pickupOrders        Order[]
  jobOpenings         JobOpening[]

  @@index([format], map: "restaurants_format_idx")
  @@index([area], map: "restaurants_area_idx")
  @@index([city], map: "restaurants_city_idx")
  @@map("restaurants")
}

model Order {
  id                      String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publicNumber            String           @unique @map("public_number") @db.VarChar(32)
  accessTokenHash         String           @unique @map("access_token_hash") @db.VarChar(64)
  idempotencyKey          String           @unique @map("idempotency_key") @db.Uuid
  customerId              String?          @map("customer_id") @db.Uuid
  crmCustomerId           String?          @map("crm_customer_id") @db.Uuid
  pickupRestaurantId      String?          @map("pickup_restaurant_id") @db.Uuid
  status                  OrderStatus      @default(AWAITING_PAYMENT)
  paymentStatus           PaymentStatus    @default(PENDING) @map("payment_status")
  customerName            String           @map("customer_name") @db.VarChar(180)
  customerPhone           String           @map("customer_phone") @db.VarChar(20)
  customerEmail           String?          @map("customer_email") @db.VarChar(320)
  pickupSlug              String           @map("pickup_slug") @db.VarChar(120)
  pickupName              String           @map("pickup_name") @db.VarChar(180)
  pickupCity              String           @map("pickup_city") @db.VarChar(100)
  pickupAddress           String           @map("pickup_address") @db.VarChar(300)
  pickupPhone             String           @map("pickup_phone") @db.VarChar(40)
  pickupOpeningHoursLabel String           @map("pickup_opening_hours_label") @db.VarChar(180)
  itemCount               Int              @map("item_count")
  totalKopecks            Int              @map("total_kopecks")
  comment                 String?
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")
  customer                CustomerAccount? @relation(fields: [customerId], references: [id], onDelete: SetNull, map: "orders_customer_id_fkey")
  crmCustomer             Customer?        @relation(fields: [crmCustomerId], references: [id], onDelete: SetNull, map: "orders_crm_customer_id_fkey")
  pickupRestaurant        Restaurant?      @relation(fields: [pickupRestaurantId], references: [id], onDelete: SetNull, map: "orders_pickup_restaurant_id_fkey")
  items                   OrderItem[]

  @@index([createdAt], map: "orders_created_at_idx")
  @@index([customerId, createdAt], map: "orders_customer_created_at_idx")
  @@index([crmCustomerId, createdAt], map: "orders_crm_customer_created_at_idx")
  @@index([pickupRestaurantId, status, createdAt], map: "orders_pickup_status_created_at_idx")
  @@map("orders")
}

model OrderItem {
  id               String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId          String          @map("order_id") @db.Uuid
  variantId        String?         @map("variant_id") @db.Uuid
  productName      String          @map("product_name") @db.VarChar(180)
  variantLabel     String          @map("variant_label") @db.VarChar(80)
  imageUrl         String?         @map("image_url")
  unitPriceKopecks Int             @map("unit_price_kopecks")
  quantity         Int
  totalKopecks     Int             @map("total_kopecks")
  position         Int             @default(0)
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "order_items_order_id_fkey")
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, map: "order_items_variant_id_fkey")

  @@index([orderId, position], map: "order_items_order_position_idx")
  @@index([variantId], map: "order_items_variant_id_idx")
  @@map("order_items")
}

model RestaurantOpeningHours {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  dayOfWeek    Int        @map("day_of_week")
  opensAt      String?    @map("opens_at") @db.VarChar(5)
  closesAt     String?    @map("closes_at") @db.VarChar(5)
  isClosed     Boolean    @default(false) @map("is_closed")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade, map: "restaurant_opening_hours_restaurant_id_fkey")

  @@unique([restaurantId, dayOfWeek], map: "restaurant_opening_hours_restaurant_id_day_of_week_key")
  @@map("restaurant_opening_hours")
}

model RestaurantScheduleException {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  date         DateTime   @db.Date
  label        String     @db.VarChar(180)
  opensAt      String?    @map("opens_at") @db.VarChar(5)
  closesAt     String?    @map("closes_at") @db.VarChar(5)
  isClosed     Boolean    @default(false) @map("is_closed")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade, map: "restaurant_schedule_exceptions_restaurant_id_fkey")

  @@unique([restaurantId, date], map: "restaurant_schedule_exceptions_restaurant_id_date_key")
  @@map("restaurant_schedule_exceptions")
}

model Menu {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug        String           @unique @db.VarChar(120)
  name        String           @db.VarChar(180)
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  restaurants RestaurantMenu[]
  categories  MenuCategory[]

  @@map("menus")
}

model RestaurantMenu {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  menuId       String     @map("menu_id") @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade, map: "restaurant_menus_restaurant_id_fkey")
  menu         Menu       @relation(fields: [menuId], references: [id], onDelete: Restrict, map: "restaurant_menus_menu_id_fkey")

  @@unique([restaurantId, menuId], map: "restaurant_menus_restaurant_id_menu_id_key")
  @@index([menuId], map: "restaurant_menus_menu_id_idx")
  @@map("restaurant_menus")
}

model MenuCategory {
  id       String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  menuId   String     @map("menu_id") @db.Uuid
  slug     String     @db.VarChar(120)
  name     String     @db.VarChar(100)
  position Int        @default(0)
  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade, map: "menu_categories_menu_id_fkey")
  items    MenuItem[]

  @@unique([menuId, slug], map: "menu_categories_menu_id_slug_key")
  @@index([menuId, position], map: "menu_categories_menu_id_position_idx")
  @@map("menu_categories")
}

model MenuItem {
  id                  String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  categoryId          String                  @map("category_id") @db.Uuid
  slug                String                  @db.VarChar(120)
  name                String                  @db.VarChar(180)
  description         String?
  ingredients         String?
  weightGrams         Int?                    @map("weight_grams")
  measurementUnit     MenuItemMeasurementUnit @default(GRAM) @map("measurement_unit")
  priceKopecks        Int                     @map("price_kopecks")
  calories            Int?
  proteins            Decimal?                @db.Decimal(6, 2)
  fats                Decimal?                @db.Decimal(6, 2)
  carbohydrates       Decimal?                @db.Decimal(6, 2)
  isVegetarian        Boolean                 @default(false) @map("is_vegetarian")
  isSpicy             Boolean                 @default(false) @map("is_spicy")
  isLactoseFree       Boolean                 @default(false) @map("is_lactose_free")
  isGlutenFree        Boolean                 @default(false) @map("is_gluten_free")
  isLight             Boolean                 @default(false) @map("is_light")
  marketingBadge      MarketingBadge?         @map("marketing_badge")
  imageUrl            String?                 @map("image_url")
  position            Int                     @default(0)
  category            MenuCategory            @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "menu_items_category_id_fkey")
  allergens           MenuItemAllergen[]
  restaurantOverrides MenuItemOverride[]
  homepageBestsellers HomepageBestseller[]

  @@unique([categoryId, slug], map: "menu_items_category_id_slug_key")
  @@index([categoryId, position], map: "menu_items_category_id_position_idx")
  @@map("menu_items")
}

model Allergen {
  id        String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug      String             @unique @db.VarChar(120)
  name      String             @unique @db.VarChar(80)
  menuItems MenuItemAllergen[]

  @@map("allergens")
}

model MenuItemAllergen {
  menuItemId String   @map("menu_item_id") @db.Uuid
  allergenId String   @map("allergen_id") @db.Uuid
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade, map: "menu_item_allergens_menu_item_id_fkey")
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Restrict, map: "menu_item_allergens_allergen_id_fkey")

  @@id([menuItemId, allergenId])
  @@index([allergenId], map: "menu_item_allergens_allergen_id_idx")
  @@map("menu_item_allergens")
}

model MenuItemOverride {
  id              String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  restaurantId    String                   @map("restaurant_id") @db.Uuid
  menuItemId      String                   @map("menu_item_id") @db.Uuid
  description     String?
  ingredients     String?
  weightGrams     Int?                     @map("weight_grams")
  measurementUnit MenuItemMeasurementUnit? @map("measurement_unit")
  priceKopecks    Int?                     @map("price_kopecks")
  restaurant      Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade, map: "menu_item_overrides_restaurant_id_fkey")
  menuItem        MenuItem                 @relation(fields: [menuItemId], references: [id], onDelete: Cascade, map: "menu_item_overrides_menu_item_id_fkey")

  @@unique([restaurantId, menuItemId], map: "menu_item_overrides_restaurant_id_menu_item_id_key")
  @@index([menuItemId], map: "menu_item_overrides_menu_item_id_idx")
  @@map("menu_item_overrides")
}
