<dialog class="dish-dialog" data-dish-dialog aria-labelledby="dish-dialog-title">
  <div class="dish-dialog-inner">
    <button class="dish-dialog-close" type="button" data-dish-close aria-label="Закрыть карточку блюда"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19" /></svg></button>
    <div class="dish-dialog-media"><img data-dish-image src="" alt="" /><span class="dish-dialog-badge" data-dish-badge hidden></span></div>
    <div class="dish-dialog-content">
      <p class="dish-dialog-category" data-dish-category></p>
      <h2 id="dish-dialog-title" data-dish-name></h2>
      <p class="dish-dialog-description" data-dish-description></p>
      <details class="dish-dialog-more" data-dish-more open>
        <summary>Состав и аллергены</summary>
        <dl class="dish-dialog-details">
          <div data-dish-ingredients-row><dt>Состав</dt><dd data-dish-ingredients></dd></div>
          <div data-dish-allergens-row><dt>Аллергены</dt><dd data-dish-allergens></dd></div>
          <div class="dish-dialog-marks" data-dish-marks-row><dt>Особенности</dt><dd data-dish-marks></dd></div>
        </dl>
      </details>
      <section class="dish-dialog-nutrition" aria-label="Пищевая ценность и выход">
        <div class="dish-dialog-data-card dish-dialog-nutrition-values"><p>КБЖУ</p><div><span><b data-dish-calories></b><small>ккал</small></span><span><b data-dish-proteins></b><small>белки</small></span><span><b data-dish-fats></b><small>жиры</small></span><span><b data-dish-carbohydrates></b><small>углеводы</small></span></div></div>
        <div class="dish-dialog-data-card dish-dialog-output"><p>Выход</p><strong data-dish-output></strong></div>
      </section>
      <div class="dish-dialog-price"><strong data-dish-price></strong></div>
    </div>
  </div>
</dialog>

<style>
  .dish-dialog{width:min(1160px,calc(100vw - 48px));max-width:none;max-height:calc(100svh - 48px);margin:auto;padding:0;border:0;border-radius:var(--radius);background:#fcfbf8;color:#231e1b;box-shadow:0 28px 90px rgba(22,28,22,.28);overflow:hidden}.dish-dialog::backdrop{background:rgba(27,32,26,.58);backdrop-filter:blur(7px)}.dish-dialog[open]{animation:dish-dialog-in .3s cubic-bezier(.22,1,.36,1)}@keyframes dish-dialog-in{from{opacity:0;transform:translateY(18px) scale(.985)}to{opacity:1;transform:none}}.dish-dialog-inner{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(360px,.92fr);min-height:min(690px,calc(100svh - 48px))}.dish-dialog-close{position:absolute;z-index:3;top:19px;right:19px;display:grid;place-items:center;width:46px;height:46px;padding:0;border:1px solid rgba(35,30,27,.11);border-radius:var(--radius);background:rgba(252,251,248,.94);color:#231e1b;cursor:pointer;transition:background-color .2s ease,transform .2s ease}.dish-dialog-close:hover{background:#bddb3d;transform:rotate(4deg)}.dish-dialog-close:focus-visible{outline:3px solid #bddb3d;outline-offset:3px}.dish-dialog-close svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-width:1.8}.dish-dialog-media{position:relative;min-height:0;overflow:hidden;background:#eeece6}.dish-dialog-media img{display:block;width:100%;height:100%;object-fit:cover}.dish-dialog-badge{position:absolute;top:24px;left:24px;padding:8px 12px;border:0;border-radius:var(--radius);font-size:10px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.dish-dialog-badge--hit{background:#d85e47;color:#fff}.dish-dialog-badge--new{background:#bddb3d;color:#1f3b2e}.dish-dialog-badge--seasonal{background:#e6ae4c;color:#483310}.dish-dialog-badge--favourite{background:#4b87a5;color:#fff}.dish-dialog-badge--special{background:#7278a9;color:#fff}.dish-dialog-content{display:flex;min-height:0;flex-direction:column;padding:clamp(38px,4vw,64px);overflow:auto}.dish-dialog-category{margin:0;color:#1f3b2e;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.dish-dialog-content h2{margin:12px 54px 0 0;font-size:clamp(32px,3.2vw,54px);line-height:.9;letter-spacing:-.08em}.dish-dialog-description{margin:18px 0 0;color:#635e57;font-size:15px;line-height:1.55}.dish-dialog-more{display:contents}.dish-dialog-more>summary{display:none}.dish-dialog-details{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(150px,.8fr);gap:9px;margin:31px 0 0;padding:0;border:0}.dish-dialog-details>div,.dish-dialog-data-card{display:grid;align-content:start;gap:9px;min-height:136px;padding:20px;border-radius:var(--radius);background:#f3eee7}.dish-dialog-details dt,.dish-dialog-nutrition p{margin:0;color:#817a71;font-size:11px;font-weight:700}.dish-dialog-details dd{margin:0;color:#2a2622;font-size:13px;line-height:1.48}.dish-dialog-marks{grid-column:1/-1;min-height:auto!important}.dish-dialog-marks dd{display:flex;flex-wrap:wrap;gap:6px}.dish-dialog-marks dd span{padding:6px 9px;border-radius:var(--radius);background:#dce7d4;color:#27432f;font-size:10px;font-weight:800}.dish-dialog-nutrition{display:grid;grid-template-columns:minmax(0,1fr) minmax(145px,.38fr);gap:9px;margin-top:9px;padding:0;border:0}.dish-dialog-nutrition-values>div{display:flex;flex-wrap:wrap;gap:8px 12px}.dish-dialog-nutrition-values span{display:flex;align-items:baseline;gap:4px}.dish-dialog-nutrition-values b{font-size:13px}.dish-dialog-nutrition-values small{color:#817a71;font-size:9px;font-weight:700;text-transform:uppercase}.dish-dialog-output strong{margin-top:auto;font-size:21px}.dish-dialog-price{display:flex;align-items:center;justify-content:center;min-height:78px;margin-top:18px;padding:17px 21px;border-radius:var(--radius);background:#f3eee7}.dish-dialog-price strong{font-size:31px;letter-spacing:-.075em}
  @media(max-width:760px){.dish-dialog{position:fixed;inset:auto 12px 12px;width:auto;height:auto;max-height:calc(100svh - 24px);margin:0}.dish-dialog-inner{display:grid;height:auto;min-height:0;max-height:calc(100svh - 24px);grid-template-columns:1fr;grid-template-rows:min(31svh,260px) auto;overflow:hidden}.dish-dialog-media{height:auto}.dish-dialog-badge{top:14px;left:14px;padding:7px 10px;font-size:8px}.dish-dialog-content{display:grid;max-height:calc(69svh - 24px);grid-template-columns:minmax(0,1fr) auto;align-content:start;column-gap:14px;padding:18px 20px 22px;overflow:auto;overscroll-behavior:contain}.dish-dialog-close{top:12px;right:12px;width:42px;height:42px}.dish-dialog-category{grid-column:1/-1;font-size:8px}.dish-dialog-content h2{grid-row:2;grid-column:1;margin:7px 0 0;font-size:clamp(26px,8vw,32px);line-height:.95}.dish-dialog-description{grid-row:3;grid-column:1/-1;margin:12px 0 0;font-size:13px;line-height:1.42}.dish-dialog-price{grid-row:2;grid-column:2;align-self:start;min-height:0;margin:7px 0 0;padding:0;border-radius:0;background:transparent}.dish-dialog-price strong{font-size:23px;letter-spacing:-.055em;white-space:nowrap}.dish-dialog-nutrition{grid-row:4;grid-column:1/-1;display:grid;grid-template-columns:minmax(0,1fr) 54px;gap:10px;margin:16px 0 0;padding:13px 14px;border-radius:16px;background:#f3eee7}.dish-dialog-data-card{min-height:0;padding:0;border-radius:0;background:transparent}.dish-dialog-nutrition-values>p{display:none}.dish-dialog-nutrition-values>div{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}.dish-dialog-nutrition-values span{display:grid;gap:2px}.dish-dialog-nutrition-values b{font-size:13px}.dish-dialog-nutrition-values small{font-size:7px}.dish-dialog-output{display:flex;flex-direction:column;justify-content:center;padding-left:10px;border-left:1px solid #ded8cf}.dish-dialog-output p{font-size:8px}.dish-dialog-output strong{margin-top:3px;font-size:16px}.dish-dialog-more{grid-row:5;grid-column:1/-1;display:block;margin-top:12px}.dish-dialog-more>summary{display:flex;min-height:46px;align-items:center;justify-content:space-between;border-top:1px solid #e5e1da;border-bottom:1px solid #e5e1da;outline:0;color:#2a2622;cursor:pointer;font-size:12px;font-weight:750;list-style:none}.dish-dialog-more>summary:focus-visible{border-radius:10px;outline:2px solid #bddb3d;outline-offset:2px}.dish-dialog-more>summary::-webkit-details-marker{display:none}.dish-dialog-more>summary:after{content:'+';color:#6f902b;font-size:22px;font-weight:400;transition:transform .2s ease}.dish-dialog-more[open]>summary:after{transform:rotate(45deg)}.dish-dialog-details{grid-template-columns:1fr;gap:0;margin:0}.dish-dialog-details>div{min-height:0;padding:13px 0;border-bottom:1px solid #e5e1da;border-radius:0;background:transparent}.dish-dialog-details dt{font-size:9px}.dish-dialog-details dd{font-size:11px;line-height:1.42}.dish-dialog-marks{grid-column:auto}.dish-dialog-marks dd span{padding:5px 8px;font-size:8px}}
  @media(prefers-reduced-motion:reduce){.dish-dialog[open]{animation:none}.dish-dialog-close{transition:none}}
</style>

<script>
  type DishPayload = { name:string; categoryName:string; description:string; ingredients:string; allergens:string[]; dietaryMarks:string[]; weight:string; price:string; calories:string|null; proteins:string|null; fats:string|null; carbohydrates:string|null; imageUrl:string; badge:string|null; badgeTone:string }
  const dialogs = [...document.querySelectorAll<HTMLDialogElement>('[data-dish-dialog]')]
  const dialog = dialogs.at(-1)
  const setText = (selector:string,value:string|null) => { const element=dialog?.querySelector<HTMLElement>(selector); if(element) element.textContent=value||'—' }
  const setRow = (selector:string,show:boolean) => { const element=dialog?.querySelector<HTMLElement>(selector); if(element) element.hidden=!show }
  const openDish = (payload:DishPayload) => {
    if(!dialog) return
    const image=dialog.querySelector<HTMLImageElement>('[data-dish-image]'); if(image){image.src=payload.imageUrl;image.alt=`Фото блюда: ${payload.name}`}
    setText('[data-dish-category]',payload.categoryName);setText('[data-dish-name]',payload.name);setText('[data-dish-description]',payload.description);setText('[data-dish-ingredients]',payload.ingredients);setText('[data-dish-allergens]',payload.allergens.join(' · '));setText('[data-dish-output]',payload.weight);setText('[data-dish-price]',payload.price);setText('[data-dish-calories]',payload.calories);setText('[data-dish-proteins]',payload.proteins);setText('[data-dish-fats]',payload.fats);setText('[data-dish-carbohydrates]',payload.carbohydrates)
    setRow('[data-dish-ingredients-row]',Boolean(payload.ingredients));setRow('[data-dish-allergens-row]',payload.allergens.length>0);setRow('[data-dish-marks-row]',payload.dietaryMarks.length>0)
    const more=dialog.querySelector<HTMLDetailsElement>('[data-dish-more]');if(more){const hasMore=Boolean(payload.ingredients)||payload.allergens.length>0||payload.dietaryMarks.length>0;more.hidden=!hasMore;more.open=!window.matchMedia('(max-width:760px)').matches}
    const marks=dialog.querySelector<HTMLElement>('[data-dish-marks]');if(marks)marks.replaceChildren(...payload.dietaryMarks.map((value)=>{const tag=document.createElement('span');tag.textContent=value;return tag}))
    const badge=dialog.querySelector<HTMLElement>('[data-dish-badge]');if(badge){badge.hidden=!payload.badge;badge.textContent=payload.badge??'';badge.className=`dish-dialog-badge dish-dialog-badge--${payload.badgeTone}`}
    dialog.showModal();dialog.querySelector<HTMLButtonElement>('[data-dish-close]')?.focus()
  }
  document.querySelectorAll<HTMLButtonElement>('[data-dish-trigger]').forEach((trigger)=>trigger.addEventListener('click',()=>{try{if(trigger.dataset.dish)openDish(JSON.parse(trigger.dataset.dish) as DishPayload)}catch{}}))
  dialog?.querySelector('[data-dish-close]')?.addEventListener('click',()=>dialog.close())
  dialog?.addEventListener('click',(event)=>{if(event.target===dialog)dialog.close()})
</script>
