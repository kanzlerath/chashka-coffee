<dialog class="dish-dialog" data-dish-dialog aria-labelledby="dish-dialog-title">
  <div class="dish-dialog-inner">
    <button class="dish-dialog-close" type="button" data-dish-close aria-label="Закрыть карточку блюда"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19" /></svg></button>
    <div class="dish-dialog-media"><img data-dish-image src="" alt="" /><span class="dish-dialog-badge" data-dish-badge hidden></span></div>
    <div class="dish-dialog-content">
      <p class="dish-dialog-category" data-dish-category></p>
      <h2 id="dish-dialog-title" data-dish-name></h2>
      <p class="dish-dialog-description" data-dish-description></p>
      <div class="dish-dialog-more" data-dish-more data-expanded="true">
        <button class="dish-dialog-more-toggle" type="button" data-dish-more-toggle aria-expanded="true" aria-controls="dish-dialog-more-panel"><span>Состав и аллергены</span><i aria-hidden="true"></i></button>
        <div class="dish-dialog-more-panel" id="dish-dialog-more-panel" data-dish-more-panel aria-hidden="false">
          <div class="dish-dialog-more-panel-inner">
            <dl class="dish-dialog-details">
              <div data-dish-ingredients-row><dt>Состав</dt><dd data-dish-ingredients></dd></div>
              <div data-dish-allergens-row><dt>Аллергены</dt><dd data-dish-allergens></dd></div>
              <div class="dish-dialog-marks" data-dish-marks-row><dt>Особенности</dt><dd data-dish-marks></dd></div>
            </dl>
          </div>
        </div>
      </div>
      <section class="dish-dialog-nutrition" aria-label="Пищевая ценность и выход">
        <span><b data-dish-calories></b><small>ккал</small></span>
        <span><b data-dish-proteins></b><small>белки</small></span>
        <span><b data-dish-fats></b><small>жиры</small></span>
        <span><b data-dish-carbohydrates></b><small>углеводы</small></span>
        <span><b data-dish-output></b><small>выход</small></span>
      </section>
      <div class="dish-dialog-price"><strong data-dish-price></strong></div>
    </div>
  </div>
</dialog>

<style>
  .dish-dialog{width:min(1120px,calc(100vw - 48px));max-width:none;max-height:calc(100svh - 48px);margin:auto;padding:0;border:0;border-radius:var(--radius);background:#fcfbf8;color:#231e1b;box-shadow:0 28px 90px rgba(22,28,22,.28);overflow:hidden}
  .dish-dialog::backdrop{background:rgba(27,32,26,.58);backdrop-filter:blur(7px)}
  .dish-dialog[open]{animation:dish-dialog-in .3s cubic-bezier(.22,1,.36,1)}
  @keyframes dish-dialog-in{from{opacity:0;transform:translateY(18px) scale(.985)}to{opacity:1;transform:none}}
  .dish-dialog-inner{display:grid;height:min(520px,calc(100svh - 48px));min-height:0;grid-template-columns:minmax(0,1.04fr) minmax(390px,.96fr)}
  .dish-dialog-close{position:absolute;z-index:3;top:19px;right:19px;display:grid;place-items:center;width:46px;height:46px;padding:0;border:1px solid rgba(35,30,27,.11);border-radius:var(--radius);background:rgba(252,251,248,.94);color:#231e1b;cursor:pointer;transition:background-color .2s ease,transform .2s ease}
  .dish-dialog-close:hover{background:#bddb3d;transform:rotate(4deg)}
  .dish-dialog-close:focus-visible{outline:3px solid #bddb3d;outline-offset:3px}
  .dish-dialog-close svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-width:1.8}
  .dish-dialog-media{position:relative;min-height:0;overflow:hidden;background:#eeece6}
  .dish-dialog-media img{display:block;width:100%;height:100%;object-fit:cover}
  .dish-dialog-badge{position:absolute;top:24px;left:24px;padding:8px 12px;border:0;border-radius:var(--radius);font-size:10px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
  .dish-dialog-badge--hit{background:#d85e47;color:#fff}.dish-dialog-badge--new{background:#bddb3d;color:#1f3b2e}.dish-dialog-badge--seasonal{background:#e6ae4c;color:#483310}.dish-dialog-badge--favourite{background:#4b87a5;color:#fff}.dish-dialog-badge--special{background:#7278a9;color:#fff}
  .dish-dialog-content{display:grid;min-height:0;grid-template-columns:minmax(0,1fr) auto;align-content:start;column-gap:18px;padding:clamp(34px,3.5vw,52px);overflow:auto}
  .dish-dialog-category{grid-column:1/-1;margin:0;color:#1f3b2e;font-size:9px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .dish-dialog-content h2{grid-row:2;grid-column:1;align-self:baseline;margin:10px 0 0;font-size:27px;line-height:1;letter-spacing:-.055em}
  .dish-dialog-description{grid-row:3;grid-column:1/-1;margin:15px 0 0;color:#635e57;font-size:14px;line-height:1.5}
  .dish-dialog-price{grid-row:2;grid-column:2;align-self:baseline;min-height:0;margin:10px 0 0;padding:0;background:transparent;line-height:1}
  .dish-dialog-price strong{display:block;font-size:27px;line-height:1;letter-spacing:-.055em;white-space:nowrap}
  .dish-dialog-more{grid-row:4;grid-column:1/-1;margin-top:22px}
  .dish-dialog-more-toggle{display:none}
  .dish-dialog-more-panel{display:grid;grid-template-rows:1fr;opacity:1}
  .dish-dialog-more-panel-inner{min-height:0}
  .dish-dialog-details{display:grid;gap:14px;margin:0;padding:18px;border:0;border-radius:18px;background:#f3eee7}
  .dish-dialog-details>div{display:grid;gap:6px;min-height:0;padding:0}
  .dish-dialog-details dt{margin:0;color:#817a71;font-size:10px;font-weight:700}
  .dish-dialog-details dd{margin:0;color:#2a2622;font-size:12px;line-height:1.45}
  .dish-dialog-marks dd{display:flex;flex-wrap:wrap;gap:7px}
  :global(.dish-dialog-mark){padding:6px 10px;border:1px solid #cad8bc;border-radius:999px;background:#e3ebd7;color:#27432f;font-size:9px;font-weight:800}
  .dish-dialog-nutrition{grid-row:5;grid-column:1/-1;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px;margin-top:12px;padding:15px 12px;border:0;border-radius:18px;background:#f3eee7}
  .dish-dialog-nutrition span{display:grid;min-width:0;justify-items:center;align-content:center;gap:4px;text-align:center}
  .dish-dialog-nutrition b{font-size:15px;line-height:1;letter-spacing:-.025em;white-space:nowrap}
  .dish-dialog-nutrition small{color:#817a71;font-size:8px;font-weight:700;line-height:1;text-transform:uppercase;white-space:nowrap}

  @media(max-width:760px){
    .dish-dialog{position:fixed;inset:auto 12px 12px;width:auto;height:auto;max-height:calc(100svh - 24px);margin:0}
    .dish-dialog-inner{display:grid;height:auto;min-height:0;max-height:calc(100svh - 24px);grid-template-columns:1fr;grid-template-rows:min(31svh,260px) auto;overflow:hidden}
    .dish-dialog-media{height:auto}.dish-dialog-badge{top:14px;left:14px;padding:7px 10px;font-size:8px}
    .dish-dialog-content{display:grid;max-height:calc(69svh - 24px);grid-template-columns:minmax(0,1fr) auto;align-content:start;column-gap:14px;padding:18px 20px 22px;overflow:auto;overscroll-behavior:contain}
    .dish-dialog-close{top:12px;right:12px;width:42px;height:42px}
    .dish-dialog-category{font-size:8px}.dish-dialog-content h2{margin-top:7px;font-size:23px;line-height:1}
    .dish-dialog-description{margin-top:12px;font-size:13px;line-height:1.42}
    .dish-dialog-price{margin-top:7px}.dish-dialog-price strong{font-size:23px}
    .dish-dialog-more{margin-top:12px}
    .dish-dialog-more-toggle{display:flex;width:100%;min-height:46px;align-items:center;justify-content:space-between;padding:0 14px;border:0;border-radius:14px;outline:0;background:#f3eee7;color:#2a2622;cursor:pointer;font:inherit;font-size:12px;font-weight:750;text-align:left}
    .dish-dialog-more-toggle:focus-visible{outline:2px solid #bddb3d;outline-offset:2px}
    .dish-dialog-more-toggle i{position:relative;width:16px;height:16px}
    .dish-dialog-more-toggle i:before,.dish-dialog-more-toggle i:after{position:absolute;top:50%;left:50%;width:12px;height:1.5px;border-radius:99px;background:#6f902b;content:'';transform:translate(-50%,-50%);transition:transform .3s cubic-bezier(.22,1,.36,1)}
    .dish-dialog-more-toggle i:after{transform:translate(-50%,-50%) rotate(90deg)}
    .dish-dialog-more[data-expanded='true'] .dish-dialog-more-toggle i:after{transform:translate(-50%,-50%) rotate(0)}
    .dish-dialog-more-panel{grid-template-rows:0fr;opacity:0;transition:grid-template-rows .34s cubic-bezier(.22,1,.36,1),opacity .22s ease}
    .dish-dialog-more[data-expanded='true'] .dish-dialog-more-panel{grid-template-rows:1fr;opacity:1}
    .dish-dialog-more-panel-inner{overflow:hidden}
    .dish-dialog-details{gap:12px;margin-top:8px;padding:14px;border-radius:14px;background:#f7f3ed}
    .dish-dialog-details dt{font-size:9px}.dish-dialog-details dd{font-size:11px;line-height:1.42}
    :global(.dish-dialog-mark){padding:6px 9px;font-size:8px}
    .dish-dialog-nutrition{gap:2px;margin-top:12px;padding:13px 7px;border-radius:14px}
    .dish-dialog-nutrition span{gap:3px}.dish-dialog-nutrition b{font-size:13px}.dish-dialog-nutrition small{font-size:7px}
  }
  @media(prefers-reduced-motion:reduce){.dish-dialog[open]{animation:none}.dish-dialog-close,.dish-dialog-more-panel,.dish-dialog-more-toggle i:before,.dish-dialog-more-toggle i:after{transition:none}}
</style>

<script>
  type DishPayload = { name:string; categoryName:string; description:string; ingredients:string; allergens:string[]; dietaryMarks:string[]; weight:string; price:string; calories:string|null; proteins:string|null; fats:string|null; carbohydrates:string|null; imageUrl:string; badge:string|null; badgeTone:string }
  const dialogs = [...document.querySelectorAll<HTMLDialogElement>('[data-dish-dialog]')]
  const dialog = dialogs.at(-1)
  const setText = (selector:string,value:string|null) => { const element=dialog?.querySelector<HTMLElement>(selector); if(element) element.textContent=value||'—' }
  const setRow = (selector:string,show:boolean) => { const element=dialog?.querySelector<HTMLElement>(selector); if(element) element.hidden=!show }
  const more=dialog?.querySelector<HTMLElement>('[data-dish-more]')
  const moreToggle=dialog?.querySelector<HTMLButtonElement>('[data-dish-more-toggle]')
  const morePanel=dialog?.querySelector<HTMLElement>('[data-dish-more-panel]')
  const setMoreExpanded=(expanded:boolean)=>{if(!more||!moreToggle)return;more.dataset.expanded=String(expanded);moreToggle.setAttribute('aria-expanded',String(expanded));morePanel?.setAttribute('aria-hidden',String(!expanded))}
  const openDish = (payload:DishPayload) => {
    if(!dialog) return
    const image=dialog.querySelector<HTMLImageElement>('[data-dish-image]'); if(image){image.src=payload.imageUrl;image.alt=`Фото блюда: ${payload.name}`}
    setText('[data-dish-category]',payload.categoryName);setText('[data-dish-name]',payload.name);setText('[data-dish-description]',payload.description);setText('[data-dish-ingredients]',payload.ingredients);setText('[data-dish-allergens]',payload.allergens.join(' · '));setText('[data-dish-output]',payload.weight);setText('[data-dish-price]',payload.price);setText('[data-dish-calories]',payload.calories);setText('[data-dish-proteins]',payload.proteins);setText('[data-dish-fats]',payload.fats);setText('[data-dish-carbohydrates]',payload.carbohydrates)
    setRow('[data-dish-ingredients-row]',Boolean(payload.ingredients));setRow('[data-dish-allergens-row]',payload.allergens.length>0);setRow('[data-dish-marks-row]',payload.dietaryMarks.length>0)
    if(more){const hasMore=Boolean(payload.ingredients)||payload.allergens.length>0||payload.dietaryMarks.length>0;more.hidden=!hasMore;setMoreExpanded(!window.matchMedia('(max-width:760px)').matches)}
    const marks=dialog.querySelector<HTMLElement>('[data-dish-marks]');if(marks)marks.replaceChildren(...payload.dietaryMarks.map((value)=>{const tag=document.createElement('span');tag.className='dish-dialog-mark';tag.textContent=value;return tag}))
    const badge=dialog.querySelector<HTMLElement>('[data-dish-badge]');if(badge){badge.hidden=!payload.badge;badge.textContent=payload.badge??'';badge.className=`dish-dialog-badge dish-dialog-badge--${payload.badgeTone}`}
    dialog.showModal();dialog.querySelector<HTMLButtonElement>('[data-dish-close]')?.focus()
  }
  document.querySelectorAll<HTMLButtonElement>('[data-dish-trigger]').forEach((trigger)=>trigger.addEventListener('click',()=>{try{if(trigger.dataset.dish)openDish(JSON.parse(trigger.dataset.dish) as DishPayload)}catch{}}))
  moreToggle?.addEventListener('click',()=>setMoreExpanded(more?.dataset.expanded!=='true'))
  dialog?.querySelector('[data-dish-close]')?.addEventListener('click',()=>dialog.close())
  dialog?.addEventListener('click',(event)=>{if(event.target===dialog)dialog.close()})
</script>
