<dialog class="cart-drawer" data-cart-drawer aria-labelledby="cart-drawer-title">
  <div class="cart-drawer-shell">
    <header>
      <div><span>Кофе домой</span><h2 id="cart-drawer-title">Корзина</h2></div>
      <button type="button" data-cart-close aria-label="Закрыть корзину"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19" /></svg></button>
    </header>
    <div class="cart-drawer-lines" data-cart-lines></div>
    <section class="cart-drawer-empty" data-cart-empty hidden>
      <span aria-hidden="true">½</span>
      <h3>Пока пусто</h3>
      <p>Выберите зерно и фасовку — заказ можно будет забрать в удобном ресторане.</p>
      <a href="/coffee#catalog">Выбрать кофе</a>
    </section>
    <footer data-cart-footer hidden>
      <div><span>Предварительный итог</span><strong data-cart-total>0 ₽</strong></div>
      <p>Наличие и цена будут проверены перед оформлением.</p>
      <a href="/checkout">Перейти к оформлению</a>
    </footer>
  </div>
</dialog>

<script>
  import { cartTotal, getCart, onCartChanged, removeCartItem, updateCartQuantity } from '../lib/cart-store'

  const dialog = document.querySelector<HTMLDialogElement>('[data-cart-drawer]')
  const linesRoot = dialog?.querySelector<HTMLElement>('[data-cart-lines]')
  const empty = dialog?.querySelector<HTMLElement>('[data-cart-empty]')
  const footer = dialog?.querySelector<HTMLElement>('[data-cart-footer]')
  const total = dialog?.querySelector<HTMLElement>('[data-cart-total]')
  const money = (kopecks: number) => `${(kopecks / 100).toLocaleString('ru-RU')} ₽`

  function element<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string) {
    const node = document.createElement(tag)
    if (className) node.className = className
    return node
  }

  function render() {
    const lines = getCart()
    if (linesRoot) linesRoot.replaceChildren()
    empty?.toggleAttribute('hidden', lines.length > 0)
    footer?.toggleAttribute('hidden', lines.length === 0)
    if (total) total.textContent = money(cartTotal(lines))

    for (const line of lines) {
      const article = element('article', 'cart-line')
      const media = element('a', 'cart-line-media')
      media.href = `/coffee/${line.productSlug}`
      const image = element('img')
      image.src = line.imageUrl ?? '/images/home-morning-v2.png'
      image.alt = ''
      media.append(image)

      const copy = element('div', 'cart-line-copy')
      const title = element('a')
      title.href = media.href
      title.textContent = line.productName
      const variant = element('span')
      variant.textContent = line.variantLabel
      const controls = element('div', 'cart-line-controls')
      const minus = element('button')
      minus.type = 'button'; minus.textContent = '−'; minus.setAttribute('aria-label', `Уменьшить количество ${line.productName}`)
      minus.addEventListener('click', () => updateCartQuantity(line.variantId, line.quantity - 1))
      const quantity = element('b'); quantity.textContent = String(line.quantity)
      const plus = element('button')
      plus.type = 'button'; plus.textContent = '+'; plus.disabled = line.quantity >= 20; plus.setAttribute('aria-label', `Увеличить количество ${line.productName}`)
      plus.addEventListener('click', () => updateCartQuantity(line.variantId, line.quantity + 1))
      controls.append(minus, quantity, plus)
      copy.append(title, variant, controls)

      const aside = element('div', 'cart-line-aside')
      const price = element('strong'); price.textContent = money(line.unitPriceKopecks * line.quantity)
      const remove = element('button'); remove.type = 'button'; remove.textContent = 'Убрать'
      remove.addEventListener('click', () => removeCartItem(line.variantId))
      aside.append(price, remove)
      article.append(media, copy, aside)
      linesRoot?.append(article)
    }
  }

  document.addEventListener('coffee-cart:open', () => {
    render()
    if (!dialog?.open) dialog?.showModal()
  })
  dialog?.querySelector('[data-cart-close]')?.addEventListener('click', () => dialog.close())
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close() })
  onCartChanged(render)
  render()
</script>

<style is:global>
  .cart-drawer{width:min(580px,100vw);max-width:none;height:100svh;max-height:none;margin:0 0 0 auto;padding:0;border:0;background:#fcfbf8;color:#1f3b2e;box-shadow:-24px 0 70px rgba(17,35,27,.2)}.cart-drawer::backdrop{background:rgba(15,31,24,.5);backdrop-filter:blur(5px)}.cart-drawer[open]{animation:cart-in .34s cubic-bezier(.22,1,.36,1)}.cart-drawer-shell{display:grid;height:100%;grid-template-rows:auto 1fr auto}.cart-drawer header{display:flex;align-items:center;justify-content:space-between;padding:30px clamp(24px,5vw,42px) 24px;border-bottom:1px solid #e5e0d8}.cart-drawer header span{color:#78912f;font-size:9px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.cart-drawer h2{margin:7px 0 0;font-size:42px;line-height:.9;letter-spacing:-.06em}.cart-drawer header button{display:grid;width:42px;height:42px;padding:0;border:1px solid #dcd7cf;border-radius:50%;place-items:center;background:transparent;color:#1f3b2e;cursor:pointer}.cart-drawer header svg{width:18px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-width:1.7}.cart-drawer-lines{overflow:auto;padding:10px clamp(24px,5vw,42px)}.cart-line{display:grid;padding:20px 0;grid-template-columns:88px minmax(0,1fr) auto;gap:17px;border-bottom:1px solid #e5e0d8}.cart-line-media{overflow:hidden;width:88px;height:98px;border-radius:18px;background:#eee8df}.cart-line-media img{width:100%;height:100%;object-fit:cover}.cart-line-copy{display:flex;min-width:0;align-items:flex-start;flex-direction:column}.cart-line-copy>a{color:#1f3b2e;font-size:17px;font-weight:750;line-height:1.1;text-decoration:none}.cart-line-copy>span{margin-top:7px;color:#777069;font-size:10px}.cart-line-controls{display:grid;margin-top:auto;grid-template-columns:32px 30px 32px;align-items:center;border:1px solid #dcd7cf;border-radius:14px}.cart-line-controls button{height:31px;padding:0;border:0;background:transparent;color:#1f3b2e;cursor:pointer;font-size:17px}.cart-line-controls b{text-align:center;font-size:11px}.cart-line-aside{display:flex;align-items:flex-end;flex-direction:column}.cart-line-aside strong{white-space:nowrap;font-size:15px}.cart-line-aside button{margin-top:auto;padding:6px 0;border:0;background:transparent;color:#8a4038;cursor:pointer;font-size:9px;text-decoration:underline;text-underline-offset:3px}.cart-drawer footer{padding:24px clamp(24px,5vw,42px) 30px;border-top:1px solid #e5e0d8;background:#f3efe8}.cart-drawer footer[hidden],.cart-drawer-empty[hidden]{display:none}.cart-drawer footer>div{display:flex;align-items:end;justify-content:space-between;gap:20px}.cart-drawer footer span{color:#6f6962;font-size:10px}.cart-drawer footer strong{font-size:28px;letter-spacing:-.04em}.cart-drawer footer p{margin:10px 0 18px;color:#777069;font-size:9px}.cart-drawer footer a,.cart-drawer-empty a{display:flex;min-height:54px;align-items:center;justify-content:center;border-radius:16px;background:#1f3b2e;color:#fff;font-size:11px;font-weight:800;text-decoration:none}.cart-drawer-empty{align-self:center;max-width:390px;padding:40px;justify-self:center;text-align:center}.cart-drawer-empty>span{display:grid;width:66px;height:66px;margin:0 auto 24px;border-radius:21px;place-items:center;background:#e4eadb;color:#1f3b2e;font-size:24px;font-weight:800}.cart-drawer-empty h3{margin:0;font-size:34px;letter-spacing:-.05em}.cart-drawer-empty p{margin:14px 0 24px;color:#716a63;font-size:12px;line-height:1.6}
  @keyframes cart-in{from{opacity:.7;transform:translateX(44px)}to{opacity:1;transform:none}}@media(max-width:620px){.cart-drawer{width:100vw}.cart-drawer header{padding:22px 20px 18px}.cart-drawer h2{font-size:36px}.cart-drawer-lines{padding:6px 20px}.cart-line{grid-template-columns:74px minmax(0,1fr);gap:13px}.cart-line-media{width:74px;height:84px}.cart-line-aside{grid-column:2;align-items:center;justify-content:space-between;margin-top:-22px;flex-direction:row}.cart-line-aside button{margin:0}.cart-drawer footer{padding:20px 20px calc(22px + env(safe-area-inset-bottom))}}@media(prefers-reduced-motion:reduce){.cart-drawer[open]{animation-duration:.01ms}}
</style>
