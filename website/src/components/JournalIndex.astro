---
import type { ContentEntry } from '@chashka-coffee/contracts'

import JournalCard from './JournalCard.astro'
import { journalPageHref } from '../lib/journal'

interface Props {
  entries: ContentEntry[]
  currentPage: number
  totalPages: number
}

const { entries, currentPage, totalPages } = Astro.props
const pageNumbers = [...new Set([1, currentPage - 1, currentPage, currentPage + 1, totalPages])]
  .filter((page) => page >= 1 && page <= totalPages)
  .sort((a, b) => a - b)
const paginationItems: Array<number | 'ellipsis'> = []

pageNumbers.forEach((page, index) => {
  if (index > 0 && page - pageNumbers[index - 1] > 1) paginationItems.push('ellipsis')
  paginationItems.push(page)
})
---

<section class="journal-page" aria-labelledby="journal-title">
  <header class="journal-heading">
    <h1 id="journal-title">Новости</h1>
  </header>

  {entries.length
    ? <div class="journal-grid">
        {entries.map((entry) => <JournalCard entry={entry} />)}
      </div>
    : <p class="journal-empty">Новости появятся после публикации первого материала.</p>}

  {totalPages > 1 && <nav class="journal-pagination" aria-label="Страницы новостей">
    {currentPage > 1
      ? <a class="journal-pagination__arrow" href={journalPageHref(currentPage - 1)} rel="prev" aria-label="Предыдущая страница">←</a>
      : <span class="journal-pagination__placeholder" aria-hidden="true"></span>}
    <div>
      {paginationItems.map((item) => item === 'ellipsis'
        ? <span class="journal-pagination__ellipsis" aria-hidden="true">…</span>
        : <a class:list={{ 'is-current': item === currentPage }} href={journalPageHref(item)} aria-current={item === currentPage ? 'page' : undefined}>{item}</a>)}
    </div>
    {currentPage < totalPages
      ? <a class="journal-pagination__arrow" href={journalPageHref(currentPage + 1)} rel="next" aria-label="Следующая страница">→</a>
      : <span class="journal-pagination__placeholder" aria-hidden="true"></span>}
  </nav>}
</section>

<style>
  .journal-page{padding:clamp(58px,7.5vw,118px) 0 clamp(88px,10vw,156px)}
  .journal-heading{margin-bottom:clamp(42px,5vw,72px)}
  .journal-heading h1{margin:0;font-size:clamp(52px,6vw,94px);line-height:.88;letter-spacing:-.09em}
  .journal-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
  .journal-empty{margin:0;padding:32px;border-radius:var(--radius);background:var(--sand);color:var(--muted)}
  .journal-pagination{display:grid;grid-template-columns:52px auto 52px;gap:12px;justify-content:center;margin-top:clamp(48px,6vw,82px)}
  .journal-pagination>div{display:flex;gap:8px}
  .journal-pagination__placeholder{width:52px;height:52px}
  .journal-pagination a,.journal-pagination__ellipsis{display:grid;width:52px;height:52px;place-items:center;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper);color:var(--ink);font-size:12px;font-weight:800;text-decoration:none;transition:border-color .2s ease,background-color .2s ease,color .2s ease,transform .2s ease}
  .journal-pagination a:hover{border-color:var(--moss);background:var(--moss);color:#fff;transform:translateY(-2px)}
  .journal-pagination a:focus-visible{outline:3px solid var(--lime);outline-offset:3px}
  .journal-pagination a.is-current{border-color:var(--moss);background:var(--moss);color:#fff;pointer-events:none}
  .journal-pagination__ellipsis{border-color:transparent;background:transparent;color:var(--muted)}
  @media(max-width:700px){
    .journal-page{padding:52px var(--mobile-gutter) 84px}
    .journal-heading{margin-bottom:36px}
    .journal-grid{grid-template-columns:1fr;gap:10px}
    .journal-pagination{grid-template-columns:46px minmax(0,auto) 46px;gap:7px}
    .journal-pagination>a.journal-pagination__arrow,.journal-pagination>.journal-pagination__placeholder{width:46px;height:46px}
    .journal-pagination>div{gap:4px}
    .journal-pagination>div a{width:42px;height:46px}
    .journal-pagination__ellipsis{display:none}
  }
  @media(prefers-reduced-motion:reduce){.journal-pagination a{transition:none}.journal-pagination a:hover{transform:none}}
</style>
