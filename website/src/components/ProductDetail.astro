---
import type { Product } from '@chashka-coffee/contracts'
import PageShell from '../layouts/PageShell.astro'
import ContentBlocks from './ContentBlocks.astro'
import ProductCard from './ProductCard.astro'
import TastingNote from './TastingNote.astro'
import { availableVariants } from '../lib/product-presentation'
const { product, related = [] } = Astro.props as { product: Product; related?: Product[] }
const available = product.variants.filter((variant) => variant.isAvailable)
const cakeVariants = availableVariants(product)
const hasDetails = Boolean(product.origin || product.roastLevel || product.details.length)
const money = (kopecks:number) => `${Math.round(kopecks / 100).toLocaleString('ru-RU')} ₽`
const backHref = product.type === 'COFFEE' ? '/coffee#catalog' : '/bakery#catalog'
const kind = product.type === 'COFFEE' ? 'Кофе собственной обжарки' : product.category ?? 'Кондитерская'
---
<PageShell title={product.name} active={product.type === 'COFFEE' ? 'coffee' : 'bakery'} image={product.imageUrl ?? undefined}>
  <article class="product-detail">
    <div class="product-gallery"><img src={product.imageUrl ?? '/images/home-morning-v2.png'} alt={product.name}/><div>{product.galleryUrls.slice(0,2).map((url) => <img src={url} alt="" loading="lazy" />)}</div></div>
    <div class="product-info">{product.type !== 'COFFEE' && <p>{kind}</p>}<h1>{product.name}</h1>{product.subtitle && <strong>{product.subtitle}</strong>}<span>{product.description}</span>
      {product.tastingNotes.length > 0 && <ul class="notes" aria-label="Вкусовые ноты">{product.tastingNotes.map((note) => <TastingNote note={note} />)}</ul>}
      {hasDetails && <dl>{product.origin && <div><dt>Происхождение</dt><dd>{product.origin}</dd></div>}{product.roastLevel && <div><dt>Обжарка</dt><dd>{product.roastLevel}</dd></div>}{product.details.map((detail) => <div><dt>{detail.label}</dt><dd>{detail.value}</dd></div>)}</dl>}
      {product.type === 'COFFEE' ? <form class="product-purchase" data-product-purchase data-product-name={product.name} data-product-slug={product.slug} data-image-url={product.imageUrl ?? ''}>
        <fieldset class="variants"><legend>Выберите фасовку</legend>{available.map((variant, index) => <label><input type="radio" name="variant" value={variant.id} checked={index === 0} data-variant-label={variant.label} data-price={variant.priceKopecks}/><span>{variant.label}</span><strong>{money(variant.priceKopecks)}</strong></label>)}</fieldset>
        <button class="product-add" type="submit" disabled={available.length === 0}>{available.length ? 'Добавить в корзину' : 'Сейчас нет в продаже'}</button>
        <p class="product-order" data-product-message>Самовывоз из выбранных ресторанов. Наличие и цена подтвердятся при оформлении.</p>
      </form> : <section class="cake-offer" aria-label="Варианты и цены">{product.ingredients && <div class="cake-ingredients"><p>Состав</p><span>{product.ingredients}</span></div>}<div class="cake-variants"><p>Варианты и цены</p>{cakeVariants.map((variant) => <div><span>{variant.label}</span><strong>{money(variant.priceKopecks)}</strong></div>)}</div><p class="product-order">Для заказа оставьте <a href="/bakery#cake-request">заявку кондитерской</a> не менее чем за 48 часов.</p></section>}
    </div>
  </article>
  {product.blocks.some((block) => block.isVisible) && <section class="product-blocks"><ContentBlocks blocks={product.blocks}/></section>}
  {related.length > 0 && <section class="related"><header><p>Ещё в каталоге</p><h2>Попробуйте другой вкус</h2></header><div>{related.slice(0,3).map((item) => <ProductCard product={item} presentation="menu" />)}</div></section>}
  <a class="back" href={backHref}>Вернуться в каталог</a>
</PageShell>
<script>
  import { addCartItem } from '../lib/cart-store'

  document.querySelectorAll<HTMLFormElement>('[data-product-purchase]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault()
      const selected = form.querySelector<HTMLInputElement>('input[name="variant"]:checked')
      if (!selected) return
      addCartItem({
        variantId: selected.value,
        productSlug: form.dataset.productSlug ?? '',
        productName: form.dataset.productName ?? '',
        variantLabel: selected.dataset.variantLabel ?? '',
        imageUrl: form.dataset.imageUrl || null,
        unitPriceKopecks: Number(selected.dataset.price),
      })
      const message = form.querySelector<HTMLElement>('[data-product-message]')
      if (message) message.textContent = `${selected.dataset.variantLabel} добавлено в корзину.`
      document.dispatchEvent(new CustomEvent('coffee-cart:open'))
    })
  })
</script>
<style>
  .product-detail{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(420px,.92fr);gap:clamp(35px,6vw,90px);padding:clamp(40px,6vw,92px) 0 clamp(100px,11vw,170px)}.product-gallery>img{width:100%;aspect-ratio:1/.95;border-radius:var(--radius);background:#eee9e1;object-fit:cover}.product-gallery>div{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}.product-gallery>div img{width:100%;aspect-ratio:1/.7;border-radius:var(--radius);object-fit:cover}.product-info{position:sticky;top:130px;height:max-content}.product-info>p:first-child,.related header p{margin:0;color:#6f902b;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.product-info h1{margin:0 0 16px;font-size:clamp(40px,4vw,66px);line-height:.9;letter-spacing:-.065em}.product-info>p:first-child{margin-bottom:18px}.product-info>strong{display:block;margin-bottom:16px;font-size:15px}.product-info>span{display:block;max-width:640px;color:var(--muted);font-size:15px;line-height:1.65}.notes{display:flex;flex-wrap:wrap;gap:8px 12px;margin:26px 0 0;padding:0;list-style:none}.product-info dl{display:grid;grid-template-columns:1fr 1fr;margin:34px 0 0;border-top:1px solid var(--line)}.product-info dl>div{padding:19px 0;border-bottom:1px solid var(--line)}.product-info dt{color:var(--muted);font-size:10px}.product-info dd{margin:7px 0 0;font-size:14px;font-weight:700}.product-purchase,.cake-offer{margin-top:28px}.variants{display:grid;margin:0;padding:0;border:0;gap:8px}.variants legend,.cake-ingredients>p,.cake-variants>p{margin:0 0 9px;color:#746e67;font-size:9px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.variants label{display:flex;position:relative;align-items:center;justify-content:space-between;padding:17px 19px;border:1px solid transparent;border-radius:var(--radius);background:var(--sand);cursor:pointer;transition:border-color .2s ease,background .2s ease,transform .2s ease}.variants label:has(input:checked){border-color:#78912f;background:#edf1e3;transform:translateX(3px)}.variants input{position:absolute;opacity:0}.variants span{font-size:13px}.variants strong{font-size:22px}.cake-offer{border-top:1px solid var(--line)}.cake-ingredients{padding:18px 0;border-bottom:1px solid var(--line)}.cake-ingredients>p{margin-bottom:7px}.cake-ingredients>span{display:block;color:var(--muted);font-size:13px;line-height:1.6}.cake-variants{display:grid;padding:18px 0 2px}.cake-variants>div{display:flex;align-items:baseline;justify-content:space-between;gap:20px;padding:12px 0;border-top:1px solid var(--line)}.cake-variants>p+div{border-top:0;padding-top:3px}.cake-variants span{font-size:14px;line-height:1.35}.cake-variants strong{flex:0 0 auto;font-size:16px}.product-add{width:100%;min-height:56px;margin-top:10px;border:0;border-radius:var(--radius);background:#382b24;color:#fff;cursor:pointer;font-size:11px;font-weight:850;letter-spacing:.04em;transition:background .2s ease,transform .2s ease}.product-add:hover{background:#294d3b;transform:translateY(-1px)}.product-add:focus-visible{outline:3px solid #bdd65a;outline-offset:3px}.product-add:disabled{cursor:not-allowed;opacity:.5}.product-order{margin:0;padding-top:14px!important;color:var(--muted)!important;font-size:10px!important;line-height:1.6!important}.product-blocks{display:grid;gap:var(--section-gap);padding:0 0 clamp(100px,11vw,170px)}.related{padding:0 0 clamp(90px,10vw,150px)}.related header{max-width:800px;margin-bottom:30px}.related h2{margin:11px 0 0;font-size:clamp(30px,3vw,46px);line-height:.94;letter-spacing:-.065em}.related>div{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}@media(max-width:900px){.product-detail{grid-template-columns:1fr;padding:32px 20px 90px}.product-info{position:static}.product-info h1{font-size:clamp(36px,10vw,48px);line-height:.92}.product-blocks{padding:0 20px 90px}.related{padding:0 20px 90px}.related>div{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.product-gallery>div{display:none}}
</style>
