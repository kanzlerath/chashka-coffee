---
import type { Product } from '@chashka-coffee/contracts'
import PageShell from '../layouts/PageShell.astro'
import ProductCard from './ProductCard.astro'
const { product, related = [] } = Astro.props as { product: Product; related?: Product[] }
const available = product.variants.filter((variant) => variant.isAvailable)
const money = (kopecks:number) => `${Math.round(kopecks / 100).toLocaleString('ru-RU')} ₽`
const backHref = product.type === 'COFFEE' ? '/coffee#catalog' : '/bakery#catalog'
const kind = product.type === 'COFFEE' ? 'Кофе собственной обжарки' : 'Торт на заказ'
---
<PageShell title={product.name} active={product.type === 'COFFEE' ? 'coffee' : 'bakery'} image={product.imageUrl ?? undefined}>
  <article class="product-detail">
    <div class="product-gallery"><img src={product.imageUrl ?? '/images/home-morning-v2.png'} alt={product.name}/><div>{product.galleryUrls.slice(0,2).map((url) => <img src={url} alt="" loading="lazy" />)}</div></div>
    <div class="product-info"><p>{kind}</p><h1>{product.name}</h1>{product.subtitle && <strong>{product.subtitle}</strong>}<span>{product.description}</span>
      {product.tastingNotes.length > 0 && <div class="notes">{product.tastingNotes.map((note) => <b>{note}</b>)}</div>}
      <dl>{product.origin && <div><dt>Происхождение</dt><dd>{product.origin}</dd></div>}{product.roastLevel && <div><dt>Обжарка</dt><dd>{product.roastLevel}</dd></div>}{product.details.map((detail) => <div><dt>{detail.label}</dt><dd>{detail.value}</dd></div>)}</dl>
      <div class="variants">{available.map((variant) => <div><span>{variant.label}</span><strong>{money(variant.priceKopecks)}</strong></div>)}</div>
      <p class="product-order">{product.type === 'COFFEE' ? 'Продажа кофе онлайн появится позже. Сейчас его можно найти в наших ресторанах.' : 'Для заказа торта свяжитесь с кондитерской не менее чем за 48 часов.'}</p>
    </div>
  </article>
  {related.length > 0 && <section class="related"><header><p>Ещё в каталоге</p><h2>Попробуйте другой вкус</h2></header><div>{related.slice(0,3).map((item) => <ProductCard product={item}/>)}</div></section>}
  <a class="back" href={backHref}>Вернуться в каталог</a>
</PageShell>
<style>
  .product-detail{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(420px,.92fr);gap:clamp(35px,6vw,90px);padding:clamp(40px,6vw,92px) 0 clamp(100px,11vw,170px)}.product-gallery>img{width:100%;aspect-ratio:1/.95;border-radius:var(--radius);background:#eee9e1;object-fit:cover}.product-gallery>div{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}.product-gallery>div img{width:100%;aspect-ratio:1/.7;border-radius:var(--radius);object-fit:cover}.product-info{position:sticky;top:130px;height:max-content}.product-info>p:first-child,.related header p{margin:0;color:#6f902b;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.product-info h1{margin:18px 0 16px;font-size:clamp(48px,5.3vw,86px);line-height:.88}.product-info>strong{display:block;margin-bottom:16px;font-size:15px}.product-info>span{display:block;max-width:640px;color:var(--muted);font-size:15px;line-height:1.65}.notes{display:flex;flex-wrap:wrap;gap:7px;margin-top:26px}.notes b{padding:9px 12px;border-radius:var(--radius);background:#e6ecd9;color:var(--moss);font-size:10px}.product-info dl{display:grid;grid-template-columns:1fr 1fr;margin:34px 0 0;border-top:1px solid var(--line)}.product-info dl>div{padding:19px 0;border-bottom:1px solid var(--line)}.product-info dt{color:var(--muted);font-size:10px}.product-info dd{margin:7px 0 0;font-size:14px;font-weight:700}.variants{display:grid;gap:8px;margin-top:28px}.variants>div{display:flex;align-items:center;justify-content:space-between;padding:18px 20px;border-radius:var(--radius);background:var(--sand)}.variants span{font-size:13px}.variants strong{font-size:22px}.product-order{padding-top:23px!important;color:var(--muted)!important;font-size:12px!important;line-height:1.6!important}.related{padding:0 0 clamp(90px,10vw,150px)}.related header{max-width:800px;margin-bottom:45px}.related h2{margin:14px 0 0;font-size:clamp(40px,4.5vw,70px)}.related>div{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}@media(max-width:900px){.product-detail{grid-template-columns:1fr;padding:32px 20px 90px}.product-info{position:static}.related{padding:0 20px 90px}.related>div{grid-template-columns:1fr}.product-gallery>div{display:none}}
</style>
