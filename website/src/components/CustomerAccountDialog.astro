<dialog class="account-dialog" data-account-dialog aria-label="Личный кабинет">
  <div class="account-dialog-shell">
    <header class="account-dialog-header">
      <a href="/account" class="account-dialog-brand" aria-label="Перейти в личный кабинет">
        <img src="/brand/logo.png" alt="Чашка кофе" width="52" height="52" />
      </a>
      <button class="account-dialog-close" type="button" data-account-close aria-label="Закрыть окно">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19" /></svg>
      </button>
    </header>

    <section class="account-dialog-view account-dialog-loading" data-account-view="loading" aria-live="polite">
      <span class="account-dialog-loader" aria-hidden="true"></span>
      <p>Проверяем карту…</p>
    </section>

    <section class="account-dialog-view" data-account-view="phone" hidden>
      <h2>Вход в личный кабинет</h2>
      <p class="account-dialog-intro">Введите номер, привязанный к бонусной карте. Пришлём короткий код в SMS.</p>
      <form class="account-dialog-form" data-account-phone-form novalidate>
        <label for="account-phone">Номер телефона</label>
        <input id="account-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7 (999) 000-00-00" required />
        <p class="account-dialog-error" data-account-phone-error role="alert" hidden></p>
        <button class="account-dialog-primary" type="submit">Получить код</button>
      </form>
      <p class="account-dialog-legal">Номер используется для входа и сервисного SMS. Подробнее — в <a href="/privacy">политике данных</a>; условия бонусной карты размещены у <a href="/loyalty-rules">PremiumBonus</a>.</p>
    </section>

    <section class="account-dialog-view" data-account-view="code" hidden>
      <h2>Проверьте сообщения</h2>
      <p class="account-dialog-intro">Отправили SMS на <strong data-account-phone-copy></strong>. Введите код из сообщения.</p>
      <form class="account-dialog-form" data-account-code-form novalidate>
        <label for="account-code">Код из SMS</label>
        <input id="account-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" placeholder="0000" minlength="3" maxlength="8" required />
        <p class="account-dialog-error" data-account-code-error role="alert" hidden></p>
        <button class="account-dialog-primary" type="submit">Войти</button>
        <button class="account-dialog-secondary" type="button" data-account-change-phone>Изменить номер</button>
      </form>
    </section>

    <section class="account-dialog-view account-dialog-qr-view" data-account-view="qr" hidden>
      <div class="account-dialog-profile-line">
        <h2 data-account-greeting>Здравствуйте</h2>
        <div class="account-dialog-balance"><strong data-account-balance>—</strong><span>бонусов</span></div>
      </div>
      <div class="account-dialog-qr-frame" data-account-qr-frame>
        <span class="account-dialog-loader" aria-hidden="true"></span>
        <canvas data-account-qr aria-label="QR-код бонусной карты" hidden></canvas>
      </div>
      <p class="account-dialog-qr-note">Покажите QR-код официанту перед оплатой, чтобы начислить или списать бонусы.</p>
      <p class="account-dialog-error" data-account-qr-error role="alert" hidden></p>
      <div class="account-dialog-actions">
        <button class="account-dialog-secondary" type="button" data-account-refresh-qr>Обновить QR</button>
        <a class="account-dialog-primary" href="/account">Открыть кабинет</a>
      </div>
    </section>

    <section class="account-dialog-view account-dialog-denied" data-account-view="denied" hidden>
      <h2>Карта недоступна</h2>
      <p class="account-dialog-intro" data-account-denied-message>Сейчас открыть карту не получается. Обратитесь в поддержку — мы поможем.</p>
      <a class="account-dialog-primary" href="/contacts">Обратиться в поддержку</a>
      <button class="account-dialog-secondary" type="button" data-account-try-again>Попробовать снова</button>
    </section>
  </div>
</dialog>

<script>
  import QRCode from 'qrcode'
  import type { CustomerProfile } from '@chashka-coffee/contracts'
  import { CustomerAccountApiError, customerAccountApi } from '../lib/customer-account-api'
  import { attachRussianPhoneMask, formatRussianPhone } from '../lib/contact-fields'

  const dialog = document.querySelector<HTMLDialogElement>('[data-account-dialog]')
  const views = [...dialog?.querySelectorAll<HTMLElement>('[data-account-view]') ?? []]
  const phoneForm = dialog?.querySelector<HTMLFormElement>('[data-account-phone-form]')
  const codeForm = dialog?.querySelector<HTMLFormElement>('[data-account-code-form]')
  const phoneInput = dialog?.querySelector<HTMLInputElement>('#account-phone')
  const codeInput = dialog?.querySelector<HTMLInputElement>('#account-code')
  const phoneError = dialog?.querySelector<HTMLElement>('[data-account-phone-error]')
  const codeError = dialog?.querySelector<HTMLElement>('[data-account-code-error]')
  const qrError = dialog?.querySelector<HTMLElement>('[data-account-qr-error]')
  const qrCanvas = dialog?.querySelector<HTMLCanvasElement>('[data-account-qr]')
  const qrFrame = dialog?.querySelector<HTMLElement>('[data-account-qr-frame]')
  const deniedMessage = dialog?.querySelector<HTMLElement>('[data-account-denied-message]')
  let challengeId: string | null = null
  let submittedPhone = ''
  let currentCustomer: CustomerProfile | null = null

  function showView(name: 'loading' | 'phone' | 'code' | 'qr' | 'denied') {
    views.forEach((view) => { view.hidden = view.dataset.accountView !== name })
  }

  function setFormBusy(form: HTMLFormElement | null | undefined, busy: boolean) {
    form?.querySelectorAll<HTMLInputElement | HTMLButtonElement>('input, button').forEach((control) => { control.disabled = busy })
  }

  function showError(target: HTMLElement | null | undefined, message = '') {
    if (!target) return
    target.textContent = message
    target.hidden = message.length === 0
  }

  if (phoneInput) attachRussianPhoneMask(phoneInput)

  function customerName(customer: CustomerProfile) {
    return [customer.name, customer.surname].filter(Boolean).join(' ') || 'Здравствуйте'
  }

  function updateCustomerUi(customer: CustomerProfile | null) {
    currentCustomer = customer
    dialog?.querySelectorAll<HTMLElement>('[data-account-greeting]').forEach((node) => { node.textContent = customer ? customerName(customer) : 'Здравствуйте' })
    dialog?.querySelectorAll<HTMLElement>('[data-account-balance]').forEach((node) => { node.textContent = customer ? new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 2 }).format(customer.balance) : '—' })
    document.querySelectorAll<HTMLElement>('[data-account-trigger-label]').forEach((node) => { node.textContent = customer ? 'Показать QR' : 'Моя карта' })
    document.dispatchEvent(new CustomEvent('customer-account:changed', { detail: { customer } }))
  }

  function readableError(error: unknown) {
    if (!(error instanceof CustomerAccountApiError)) return 'Не удалось связаться с сервисом. Попробуйте ещё раз.'
    switch (error.code) {
      case 'CUSTOMER_NOT_REGISTERED': return 'Бонусная карта с таким номером не найдена. Проверьте номер или обратитесь в поддержку.'
      case 'CUSTOMER_BLOCKED': return 'Доступ к карте ограничен. Обратитесь в поддержку — мы поможем разобраться.'
      case 'CODE_INVALID': return 'Код не подошёл. Проверьте цифры и попробуйте ещё раз.'
      case 'CODE_EXPIRED': return 'Срок действия кода истёк. Запросите новый код.'
      case 'TOO_MANY_ATTEMPTS': return 'Попыток слишком много. Запросите новый код.'
      case 'TOO_MANY_REQUESTS': return 'Новый код уже отправлен. Подождите минуту и попробуйте снова.'
      case 'LOYALTY_UNAVAILABLE': return 'Бонусная система временно недоступна. Попробуйте ещё раз немного позже.'
      default: return error.message || 'Не удалось выполнить запрос. Попробуйте ещё раз.'
    }
  }

  function showDenied(error: unknown) {
    if (deniedMessage) deniedMessage.textContent = readableError(error)
    showView('denied')
  }

  async function renderQr() {
    if (!currentCustomer || !qrCanvas) return
    showError(qrError)
    qrCanvas.hidden = true
    qrFrame?.classList.add('is-loading')
    try {
      const qr = await customerAccountApi.generateQr()
      await QRCode.toCanvas(qrCanvas, qr.value, {
        width: 276,
        margin: 2,
        errorCorrectionLevel: 'M',
        color: { dark: '#182e24', light: '#ffffff' },
      })
      qrCanvas.hidden = false
    } catch (error) {
      if (error instanceof CustomerAccountApiError && ['UNAUTHORIZED', 'CUSTOMER_BLOCKED'].includes(error.code)) {
        updateCustomerUi(null)
        showDenied(error)
        return
      }
      showError(qrError, readableError(error))
    } finally {
      qrFrame?.classList.remove('is-loading')
    }
  }

  async function openAccount() {
    document.dispatchEvent(new CustomEvent('customer-account:opening'))
    if (!dialog?.open) dialog?.showModal()
    showView('loading')
    try {
      const customer = await customerAccountApi.getProfile()
      updateCustomerUi(customer)
      if (!customer) {
        showView('phone')
        requestAnimationFrame(() => phoneInput?.focus())
        return
      }
      showView('qr')
      await renderQr()
    } catch (error) {
      showDenied(error)
    }
  }

  document.querySelectorAll<HTMLElement>('[data-account-trigger]').forEach((trigger) => trigger.addEventListener('click', (event) => {
    event.preventDefault()
    void openAccount()
  }))

  dialog?.querySelector('[data-account-close]')?.addEventListener('click', () => dialog.close())
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close() })

  phoneForm?.addEventListener('submit', async (event) => {
    event.preventDefault()
    showError(phoneError)
    if (!phoneForm.reportValidity()) return
    setFormBusy(phoneForm, true)
    try {
      submittedPhone = customerAccountApi.normalizePhone(phoneInput?.value ?? '')
      const response = await customerAccountApi.sendCode(submittedPhone)
      challengeId = response.challengeId
      const phoneCopy = dialog?.querySelector<HTMLElement>('[data-account-phone-copy]')
      if (phoneCopy) phoneCopy.textContent = formatRussianPhone(submittedPhone)
      showView('code')
      requestAnimationFrame(() => codeInput?.focus())
    } catch (error) {
      showError(phoneError, readableError(error))
    } finally {
      setFormBusy(phoneForm, false)
    }
  })

  codeForm?.addEventListener('submit', async (event) => {
    event.preventDefault()
    showError(codeError)
    if (!challengeId) { showView('phone'); return }
    setFormBusy(codeForm, true)
    try {
      const customer = await customerAccountApi.verifyCode(challengeId, codeInput?.value ?? '')
      updateCustomerUi(customer)
      showView('qr')
      await renderQr()
    } catch (error) {
      showError(codeError, readableError(error))
    } finally {
      setFormBusy(codeForm, false)
    }
  })

  dialog?.querySelector('[data-account-change-phone]')?.addEventListener('click', () => {
    challengeId = null
    submittedPhone = ''
    if (codeInput) codeInput.value = ''
    showError(codeError)
    showView('phone')
    phoneInput?.focus()
  })
  dialog?.querySelector('[data-account-refresh-qr]')?.addEventListener('click', () => void renderQr())
  dialog?.querySelector('[data-account-try-again]')?.addEventListener('click', () => void openAccount())

  void customerAccountApi.getProfile().then(updateCustomerUi).catch(() => {})
</script>

<style>
  .account-dialog{width:min(500px,calc(100vw - 28px));max-height:calc(100svh - 28px);padding:0;border:0;border-radius:28px;background:#fcfbf8;color:#231e1b;box-shadow:0 28px 90px rgba(18,46,36,.28);overflow:auto}.account-dialog::backdrop{background:rgba(16,34,26,.56);backdrop-filter:blur(7px)}.account-dialog[open]{animation:account-dialog-in .25s cubic-bezier(.22,1,.36,1)}
  .account-dialog-shell{min-height:520px;padding:24px clamp(24px,5vw,38px) 34px}.account-dialog-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:30px}.account-dialog-brand{display:grid;width:52px;height:52px;border-radius:50%;place-items:center;text-decoration:none}.account-dialog-brand img{display:block;width:52px;height:52px;object-fit:contain}.account-dialog-brand:focus-visible,.account-dialog-close:focus-visible{outline:3px solid rgba(189,214,90,.8);outline-offset:3px}.account-dialog-close{display:grid;width:40px;height:40px;padding:0;border:1px solid #ded9d1;border-radius:50%;place-items:center;background:transparent;color:#382b24;cursor:pointer;transition:background .2s ease,transform .2s ease}.account-dialog-close svg{width:18px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-width:1.7}.account-dialog-close:hover{background:#eef2e9;transform:rotate(3deg)}
  .account-dialog-view[hidden]{display:none}.account-dialog-view h2{max-width:390px;margin:0 0 14px;color:#382b24;font-size:clamp(30px,7vw,40px);line-height:1;letter-spacing:-.055em}.account-dialog-intro{max-width:400px;margin:0 0 26px;color:#68615a;font-size:13px;line-height:1.6}.account-dialog-intro strong{color:#382b24}.account-dialog-form{display:grid;gap:10px}.account-dialog-form label{margin-bottom:1px;color:#5e5851;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.account-dialog-form input{width:100%;height:56px;padding:0 18px;border:1px solid #dcd7ce;border-radius:15px;background:#fff;color:#382b24;font-size:16px;outline:0;transition:border-color .2s ease,box-shadow .2s ease}.account-dialog-form input:focus{border-color:#78922e;box-shadow:0 0 0 4px rgba(189,214,90,.2)}.account-dialog-form input:disabled{opacity:.6}.account-dialog-primary,.account-dialog-secondary{display:inline-flex;min-height:50px;padding:0 20px;border-radius:15px;align-items:center;justify-content:center;cursor:pointer;font-size:11px;font-weight:800;letter-spacing:.04em;text-decoration:none;transition:background .2s ease,border-color .2s ease,transform .2s ease}.account-dialog-primary{border:1px solid #382b24;background:#382b24;color:#fff}.account-dialog-primary:hover{background:#294d3b;transform:translateY(-1px)}.account-dialog-primary:disabled{cursor:wait;opacity:.6}.account-dialog-secondary{border:1px solid #dcd7ce;background:transparent;color:#382b24}.account-dialog-secondary:hover{border-color:#b8c49d;background:#f0f3ea}.account-dialog-primary:focus-visible,.account-dialog-secondary:focus-visible{outline:3px solid rgba(189,214,90,.8);outline-offset:3px}.account-dialog-error{margin:1px 0 2px;color:#a4382f;font-size:11px;line-height:1.45}.account-dialog-legal{margin:17px 0 0;color:#8a837b;font-size:9px;line-height:1.5}.account-dialog-legal a{text-underline-offset:2px}
  .account-dialog-loading{display:grid;min-height:330px;place-content:center;justify-items:center;gap:16px;color:#716a62;font-size:11px}.account-dialog-loader{display:block;width:29px;height:29px;border:2px solid #d8dfcf;border-top-color:#67862a;border-radius:50%;animation:account-dialog-spin .8s linear infinite}.account-dialog-profile-line{display:flex;min-width:0;align-items:center;justify-content:space-between;gap:16px;padding-bottom:20px;border-bottom:1px solid #e3ded6}.account-dialog-profile-line h2{min-width:0;margin:0;overflow:hidden;font-size:clamp(24px,5vw,27px);line-height:1.05;text-overflow:ellipsis;white-space:nowrap}.account-dialog-balance{display:flex;flex:0 0 auto;align-items:baseline;gap:5px}.account-dialog-balance strong{color:#382b24;font-size:24px;line-height:1;letter-spacing:-.05em}.account-dialog-balance span{color:#768f2c;font-size:7px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.account-dialog-qr-frame{display:grid;position:relative;width:min(100%,276px);aspect-ratio:1;margin:24px auto 16px;padding:14px;border:1px solid #e2ded7;border-radius:24px;place-items:center;background:#fff}.account-dialog-qr-frame:not(.is-loading)>.account-dialog-loader{display:none}.account-dialog-qr-frame canvas{display:block;width:100%!important;height:auto!important}.account-dialog-qr-frame canvas[hidden]{display:none}.account-dialog-qr-note{max-width:340px;margin:0 auto;color:#69635c;font-size:11px;line-height:1.5;text-align:center}.account-dialog-actions{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:20px}.account-dialog-denied .account-dialog-primary,.account-dialog-denied .account-dialog-secondary{width:100%;margin-top:9px}.account-dialog-denied .account-dialog-primary{margin-top:0}
  @keyframes account-dialog-in{from{opacity:0;transform:translateY(14px) scale(.985)}to{opacity:1;transform:none}}@keyframes account-dialog-spin{to{transform:rotate(360deg)}}
  @media(max-width:560px){.account-dialog{width:100vw;max-width:none;height:auto;max-height:calc(100svh - 12px);margin:auto 0 0;border-radius:24px 24px 0 0}.account-dialog-shell{min-height:570px;padding:18px 20px calc(26px + env(safe-area-inset-bottom))}.account-dialog-header{margin-bottom:24px}.account-dialog-brand,.account-dialog-brand img{width:46px;height:46px}.account-dialog-profile-line{gap:12px}.account-dialog-profile-line h2{font-size:clamp(20px,6vw,24px)}.account-dialog-balance{align-items:flex-end;flex-direction:column;gap:3px}.account-dialog-qr-frame{width:min(100%,268px);margin-top:20px}.account-dialog-actions{grid-template-columns:1fr}.account-dialog[open]{animation-name:account-dialog-mobile-in}@keyframes account-dialog-mobile-in{from{opacity:0;transform:translateY(40px)}to{opacity:1;transform:none}}}
  @media(prefers-reduced-motion:reduce){.account-dialog[open],.account-dialog-loader{animation-duration:.01ms}}
</style>
