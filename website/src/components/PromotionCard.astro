---
import type { PromotionCardEntry } from '../lib/promotions'
import { promotionAction, promotionPeriodLabel } from '../lib/promotions'

interface Props {
  entry: PromotionCardEntry
  fallbackImage: string
  featured?: boolean
}

const { entry, fallbackImage, featured = false } = Astro.props
const detailHref = `/promotions/${entry.slug}`
const action = promotionAction(entry)
const period = promotionPeriodLabel(entry)
const showSeparateDetails = action.href !== detailHref
---

<article class:list={['promotion-card', { 'promotion-card--featured': featured }]}>
  <a class="promotion-card__media" href={detailHref} aria-label={`Открыть акцию «${entry.title}»`}>
    <img src={entry.imageUrl ?? fallbackImage} alt={`Обложка акции «${entry.title}»`} loading="lazy" />
  </a>
  <div class="promotion-card__body">
    <time datetime={entry.endsAt ?? entry.startsAt ?? undefined}>{period}</time>
    <h2><a href={detailHref}>{entry.title}</a></h2>
    {entry.excerpt && <p>{entry.excerpt}</p>}
    <footer>
      {showSeparateDetails && <a class="promotion-card__details" href={detailHref}>Условия акции</a>}
      <a class="promotion-card__action" href={action.href} target={action.external ? '_blank' : undefined} rel={action.external ? 'noopener noreferrer' : undefined}>
        <span>{action.label}</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4" /></svg>
      </a>
    </footer>
  </div>
</article>

<style>
  .promotion-card{display:grid;grid-template-rows:auto 1fr;min-width:0;overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);background:#fffdf9;transition:border-color .25s ease,box-shadow .25s ease,transform .25s ease}
  .promotion-card:hover{border-color:#c8d5b9;box-shadow:0 18px 34px rgba(31,38,32,.09);transform:translateY(-4px)}
  .promotion-card__media{display:block;aspect-ratio:16/10;overflow:hidden;background:#e4dfd6}
  .promotion-card__media:focus-visible,.promotion-card h2 a:focus-visible,.promotion-card footer a:focus-visible{outline:3px solid var(--lime);outline-offset:3px}
  .promotion-card__media img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .65s cubic-bezier(.22,1,.36,1)}
  .promotion-card:hover .promotion-card__media img{transform:scale(1.035)}
  .promotion-card__body{display:flex;min-height:340px;padding:clamp(28px,3vw,46px);flex-direction:column}
  .promotion-card time{color:#78736c;font-size:11px;font-weight:700;letter-spacing:.03em}
  .promotion-card h2{margin:18px 0 0;font-size:clamp(31px,2.7vw,46px);line-height:.93;letter-spacing:-.075em}
  .promotion-card h2 a{color:inherit;text-decoration:none}
  .promotion-card p{display:-webkit-box;max-width:680px;margin:20px 0 0;overflow:hidden;color:var(--muted);font-size:14px;line-height:1.65;-webkit-box-orient:vertical;-webkit-line-clamp:5}
  .promotion-card footer{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:auto;padding-top:34px}
  .promotion-card__details{color:#5f5b55;font-size:11px;font-weight:700;text-decoration-thickness:1px;text-underline-offset:4px}
  .promotion-card__action{display:inline-flex;min-height:50px;align-items:center;justify-content:space-between;gap:28px;margin-left:auto;padding:0 19px;border-radius:var(--radius);background:var(--moss);color:#fff;text-decoration:none;font-size:11px;font-weight:800;transition:background-color .22s ease,box-shadow .22s ease,transform .22s ease}
  .promotion-card__action:hover{background:#315b45;box-shadow:0 9px 18px rgba(31,59,46,.14);transform:translateY(-2px)}
  .promotion-card__action svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.8;transition:transform .22s ease}
  .promotion-card__action:hover svg{transform:translateX(3px)}
  .promotion-card--featured{grid-column:1/-1;grid-template-columns:minmax(0,1.15fr) minmax(380px,.85fr);grid-template-rows:none;height:clamp(520px,46vw,620px)}
  .promotion-card--featured .promotion-card__media{height:100%;aspect-ratio:auto}
  .promotion-card--featured .promotion-card__body{min-height:0}
  .promotion-card--featured h2{font-size:clamp(42px,4.2vw,70px)}
  @media(max-width:980px){
    .promotion-card--featured{grid-template-columns:1fr;grid-template-rows:auto 1fr;height:auto}
    .promotion-card--featured .promotion-card__media{height:auto;aspect-ratio:16/10}
    .promotion-card--featured .promotion-card__body{min-height:340px}
    .promotion-card--featured h2{font-size:clamp(34px,7vw,52px)}
  }
  @media(max-width:600px){
    .promotion-card__body,.promotion-card--featured .promotion-card__body{min-height:325px;padding:26px 24px}
    .promotion-card h2,.promotion-card--featured h2{font-size:31px}
    .promotion-card p{margin-top:18px;font-size:13px;-webkit-line-clamp:5}
    .promotion-card footer{align-items:stretch;gap:15px;flex-direction:column}
    .promotion-card__action{width:100%;margin-left:0}
  }
  @media(prefers-reduced-motion:reduce){.promotion-card,.promotion-card__media img,.promotion-card__action,.promotion-card__action svg{transition:none}.promotion-card:hover,.promotion-card:hover .promotion-card__media img,.promotion-card__action:hover,.promotion-card__action:hover svg{transform:none}}
</style>
