---
import type { ContentEntry } from '@chashka-coffee/contracts'

import { formatCardDate, getPublicationDate } from '../lib/journal'

type JournalCardEntry = Pick<ContentEntry, 'slug' | 'title' | 'excerpt' | 'imageUrl' | 'startsAt' | 'createdAt'>

interface Props {
  entry: JournalCardEntry
  fallbackImage?: string
  headingLevel?: 2 | 3
}

const {
  entry,
  fallbackImage = '/images/home-morning-v2.png',
  headingLevel = 2,
} = Astro.props
const publishedAt = getPublicationDate(entry)
---

<a class="news-card" href={`/journal/${entry.slug}`}>
  <figure class="news-card__image">
    <img src={entry.imageUrl ?? fallbackImage} alt={`Обложка новости «${entry.title}»`} loading="lazy" />
  </figure>
  <div class="news-card__body">
    {headingLevel === 2
      ? <h2>{entry.title}</h2>
      : <h3>{entry.title}</h3>}
    {entry.excerpt && <p>{entry.excerpt}</p>}
    <footer>
      <time datetime={publishedAt}>{formatCardDate(publishedAt)}</time>
      <span>Читать</span>
    </footer>
  </div>
</a>

<style>
  .news-card{display:grid;grid-template-rows:auto 1fr;min-width:0;overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);background:#fffdf9;color:inherit;text-decoration:none;transition:border-color .25s ease,box-shadow .25s ease,transform .25s ease}
  .news-card:hover{border-color:#c8d5b9;box-shadow:0 16px 30px rgba(31,38,32,.09);transform:translateY(-4px)}
  .news-card:focus-visible{outline:3px solid var(--lime);outline-offset:3px}
  .news-card__image{aspect-ratio:16/10;margin:0;overflow:hidden;background:#e6e1d8}
  .news-card__image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .55s cubic-bezier(.22,1,.36,1)}
  .news-card:hover .news-card__image img{transform:scale(1.035)}
  .news-card__body{display:grid;grid-template-rows:auto 1fr auto;min-height:clamp(300px,24vw,360px);padding:clamp(28px,3vw,46px)}
  .news-card :is(h2,h3){margin:0;color:var(--ink);font-size:clamp(29px,2.35vw,40px);line-height:.97;letter-spacing:-.07em}
  .news-card p{display:-webkit-box;max-width:760px;margin:22px 0 0;overflow:hidden;color:var(--muted);font-size:14px;line-height:1.65;-webkit-box-orient:vertical;-webkit-line-clamp:6}
  .news-card footer{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-top:34px;padding-top:22px}
  .news-card time{color:#6f746d;font-size:11px;font-weight:800;letter-spacing:.06em}
  .news-card footer span{display:inline-flex;min-width:112px;min-height:48px;align-items:center;justify-content:center;padding:0 22px;border-radius:var(--radius);background:var(--moss);color:#fff;font-size:11px;font-weight:800;transition:background-color .22s ease,box-shadow .22s ease,transform .22s ease}
  .news-card:hover footer span{background:#315b45;box-shadow:0 9px 18px rgba(31,59,46,.14);transform:translateY(-2px)}
  @media(max-width:700px){
    .news-card__body{min-height:330px;padding:26px 24px}
    .news-card :is(h2,h3){font-size:30px}
    .news-card p{margin-top:18px;font-size:13px;-webkit-line-clamp:6}
    .news-card footer{gap:15px;margin-top:28px;padding-top:19px}
    .news-card footer span{min-width:104px;padding:0 18px}
  }
  @media(prefers-reduced-motion:reduce){
    .news-card,.news-card__image img,.news-card footer span{transition:none}
    .news-card:hover,.news-card:hover .news-card__image img,.news-card:hover footer span{transform:none}
  }
</style>
