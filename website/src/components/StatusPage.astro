---
import PageShell from '../layouts/PageShell.astro'

interface Props {
  title: string
  eyebrow: string
  heading: string
  copy: string
  action: string
  actionHref: string
  mark: string
  tone?: 'dark' | 'light'
}

const {
  title,
  eyebrow,
  heading,
  copy,
  action,
  actionHref,
  mark,
  tone = 'dark',
} = Astro.props
---

<PageShell title={title} description={copy} footer={false} noindex>
  <section class:list={['status-page', `status-page--${tone}`]}>
    <div class="status-copy">
      <p>{eyebrow}</p>
      <h1>{heading}</h1>
      <span>{copy}</span>
      <a class="button" href={actionHref}>{action}</a>
    </div>
    <b aria-hidden="true">{mark}</b>
  </section>
</PageShell>

<style>
  .status-page{position:relative;isolation:isolate;display:flex;min-height:calc(100svh - 114px);overflow:hidden;border-radius:var(--radius);align-items:center;padding:clamp(54px,7vw,112px);background:var(--moss);color:#fff}
  .status-page--light{background:var(--moss-soft);color:var(--moss)}
  .status-copy{position:relative;z-index:2;max-width:820px}
  .status-copy p{margin:0;color:var(--lime);font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}
  .status-page--light .status-copy p{color:#6f902b}
  .status-copy h1{max-width:820px;margin:18px 0 0;color:inherit!important;white-space:pre-line}
  .status-copy span{display:block;max-width:430px;margin-top:25px;color:#d7e0d7;font-size:15px;line-height:1.65}
  .status-page--light .status-copy span{color:var(--muted)}
  .status-copy .button{margin-top:31px;padding-inline:22px;background:var(--lime)!important;color:var(--moss)!important}
  .status-page--light .status-copy .button{background:var(--moss)!important;color:#fff!important}
  .status-page>b{position:absolute;z-index:-1;right:-.08em;bottom:-.3em;margin:0;color:var(--lime);font-size:min(46vw,690px);font-weight:800;line-height:1;letter-spacing:-.16em;opacity:.98;white-space:nowrap}
  @media(max-width:980px){.status-page{min-height:calc(100svh - 102px);margin:0 var(--mobile-gutter);padding:48px 25px}.status-copy h1{font-size:clamp(52px,15vw,70px)!important}.status-page>b{right:-.04em;font-size:min(75vw,410px)}}
</style>
