---
import type { Product } from '@chashka-coffee/contracts'
import TastingNote from './TastingNote.astro'
import { productFromPrice } from '../lib/product-presentation'

const { product, presentation = 'editorial' } = Astro.props as { product: Product; presentation?: 'editorial' | 'menu' }
const variant = product.variants.find((item) => item.isAvailable) ?? product.variants[0]
const price = variant ? `${Math.round(variant.priceKopecks / 100).toLocaleString('ru-RU')} ₽` : 'Уточняйте'
const fromPrice = productFromPrice(product)
const cakePrice = fromPrice ? `от ${Math.round(fromPrice / 100).toLocaleString('ru-RU')} ₽` : 'Цена по запросу'
const href = product.type === 'COFFEE' ? `/coffee/${product.slug}` : `/bakery/${product.slug}`
const imageStyle = product.imageCrop
  ? `--card-image-focus-x:${product.imageCrop.focusX}%;--card-image-focus-y:${product.imageCrop.focusY}%;--card-image-zoom:${product.imageCrop.zoom};`
  : undefined
---

<a class:list={['product-card', { 'product-card--menu': presentation === 'menu' }]} href={href}>
  <div class="product-card-media">
    <img src={product.imageUrl ?? '/images/home-morning-v2.png'} alt={product.name} loading="lazy" style={imageStyle} />
    {product.isFeatured && <span>{product.type === 'COFFEE' ? 'Свежая обжарка' : 'Любимый'}</span>}
    <div class="product-card-reveal"><p>{product.description}</p><b>Подробнее</b></div>
  </div>
  <div class="product-card-copy">
    <small>{product.type === 'CAKE' ? product.category ?? 'Кондитерская' : product.subtitle ?? 'Кофе собственной обжарки'}</small>
    <h3>{product.name}</h3>
    {presentation === 'editorial' && product.tastingNotes.length > 0 && <p>{product.tastingNotes.join(' · ')}</p>}
    {presentation === 'menu' && product.tastingNotes.length > 0 && <div class="product-card-tasting">
      <ul class="product-card-tasting-list" aria-label="Вкусовые ноты">
        {product.tastingNotes.map((note) => <TastingNote note={note} />)}
      </ul>
    </div>}
    {product.type === 'CAKE'
      ? <div class="product-card-price product-card-price--from"><strong>{cakePrice}</strong></div>
      : <div class="product-card-price"><span>{variant?.label}</span><strong>{price}</strong></div>}
  </div>
</a>

<style>
  .product-card{display:grid;color:#211d19;text-decoration:none}.product-card-media{position:relative;overflow:hidden;aspect-ratio:1/.86;border-radius:var(--radius);background:#eee8df}.product-card-media img{width:100%;height:100%;object-fit:cover;object-position:var(--card-image-focus-x,50%) var(--card-image-focus-y,50%);transform:scale(var(--card-image-zoom,1));transform-origin:var(--card-image-focus-x,50%) var(--card-image-focus-y,50%);transition:transform .55s cubic-bezier(.22,1,.36,1)}.product-card:hover img{transform:scale(var(--card-image-zoom,1)) scale(1.045)}.product-card-media>span{position:absolute;top:14px;left:14px;padding:8px 12px;border-radius:var(--radius);background:#ec6f51;color:#fff;font-size:9px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.product-card-reveal{position:absolute;inset:auto 10px 10px;display:flex;align-items:end;justify-content:space-between;gap:18px;padding:18px;border-radius:calc(var(--radius) - 6px);background:rgba(31,59,46,.94);color:#fff;opacity:0;transform:translateY(10px);transition:opacity .25s ease,transform .25s ease}.product-card:hover .product-card-reveal,.product-card:focus-visible .product-card-reveal{opacity:1;transform:none}.product-card-reveal p{max-width:70%;margin:0;font-size:11px;line-height:1.45}.product-card-reveal b{font-size:10px;text-transform:uppercase}.product-card-copy{padding:17px 3px 0}.product-card-copy>small{color:#1f3b2e;font-size:10px;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.product-card-copy h3{margin:7px 0 8px;font-size:clamp(22px,2vw,32px);line-height:1;letter-spacing:-.055em}.product-card-copy>p{margin:0 0 20px;color:#777068;font-size:13px}.product-card-price{display:flex;justify-content:space-between;gap:20px;padding-top:13px;border-top:1px solid #d9d3ca;color:#6f6961;font-size:13px}.product-card-price--from{justify-content:flex-start}.product-card-price strong{color:#211d19;font-size:18px}.product-card-tasting{margin:14px 0 18px}.product-card-tasting-list{display:flex;min-width:0;flex-wrap:wrap;align-content:start;align-items:center;justify-content:flex-start;gap:8px 12px;margin:0;padding:0;list-style:none}
  .product-card--menu{grid-template-rows:auto 1fr;height:100%;padding:9px;border:1px solid var(--line);border-radius:var(--radius);background:#f7f5f0;transition:transform .25s ease,box-shadow .25s ease,background .25s ease}.product-card--menu:hover{background:#fffdf9;box-shadow:0 16px 34px rgba(50,40,29,.1);transform:translateY(-4px)}.product-card--menu:focus-visible{outline:3px solid #bddb3d;outline-offset:4px}.product-card--menu .product-card-media{border-radius:calc(var(--radius) - 5px)}.product-card--menu .product-card-media>span{top:10px;left:10px;padding:7px 9px;font-size:8px}.product-card--menu .product-card-reveal{display:none}.product-card--menu .product-card-copy{display:flex;min-width:0;flex-direction:column;padding:15px 4px 3px}.product-card--menu .product-card-copy>small{font-size:8px;letter-spacing:.1em}.product-card--menu .product-card-copy h3{margin:8px 0 0;font-size:clamp(17px,1.35vw,21px);line-height:1;letter-spacing:-.05em}.product-card--menu .product-card-tasting{display:flex;min-height:62px;flex:1;flex-direction:column;margin:14px 0 0;padding-top:14px;border-top:1px solid #ddd7ce}.product-card--menu .product-card-price{align-items:flex-end;margin-top:auto;padding-top:18px;border-top:0}.product-card--menu .product-card-price strong{font-size:15px}
  @media(max-width:720px){.product-card-reveal{display:none}.product-card--menu{padding:7px;border-radius:18px}.product-card--menu .product-card-media{border-radius:13px}.product-card--menu .product-card-copy{padding:11px 3px 3px}.product-card--menu .product-card-copy>small{font-size:7px}.product-card--menu .product-card-copy h3{margin-top:7px;font-size:15px;line-height:.98}.product-card--menu .product-card-tasting{min-height:56px;margin-top:11px;padding-top:11px}.product-card-tasting-list{gap:6px}.product-card--menu .product-card-price{padding-top:14px}.product-card--menu .product-card-price span{font-size:9px}.product-card--menu .product-card-price strong{font-size:13px}}
</style>
