---
import type { Product } from '@chashka-coffee/contracts'
const { product } = Astro.props as { product: Product }
const variant = product.variants.find((item) => item.isAvailable) ?? product.variants[0]
const price = variant ? `${Math.round(variant.priceKopecks / 100).toLocaleString('ru-RU')} ₽` : 'Уточняйте'
const href = product.type === 'COFFEE' ? `/coffee/${product.slug}` : `/bakery/${product.slug}`
---
<a class="product-card" href={href}>
  <div class="product-card-media">
    <img src={product.imageUrl ?? '/images/home-morning-v2.png'} alt={product.name} loading="lazy" />
    {product.isFeatured && <span>{product.type === 'COFFEE' ? 'Свежая обжарка' : 'Любимый'}</span>}
    <div class="product-card-reveal"><p>{product.description}</p><b>Подробнее</b></div>
  </div>
  <div class="product-card-copy"><small>{product.subtitle}</small><h3>{product.name}</h3>{product.tastingNotes.length > 0 && <p>{product.tastingNotes.join(' · ')}</p>}<div><span>{variant?.label}</span><strong>{price}</strong></div></div>
</a>
<style>
  .product-card{display:grid;color:#211d19;text-decoration:none}.product-card-media{position:relative;overflow:hidden;aspect-ratio:1/.86;border-radius:var(--radius);background:#eee8df}.product-card-media img{width:100%;height:100%;object-fit:cover;transition:transform .55s cubic-bezier(.22,1,.36,1)}.product-card:hover img{transform:scale(1.045)}.product-card-media>span{position:absolute;top:14px;left:14px;padding:8px 12px;border-radius:var(--radius);background:#ec6f51;color:#fff;font-size:9px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.product-card-reveal{position:absolute;inset:auto 10px 10px;display:flex;align-items:end;justify-content:space-between;gap:18px;padding:18px;border-radius:calc(var(--radius) - 6px);background:rgba(31,59,46,.94);color:#fff;opacity:0;transform:translateY(10px);transition:opacity .25s ease,transform .25s ease}.product-card:hover .product-card-reveal,.product-card:focus-visible .product-card-reveal{opacity:1;transform:none}.product-card-reveal p{max-width:70%;margin:0;font-size:11px;line-height:1.45}.product-card-reveal b{font-size:10px;text-transform:uppercase}.product-card-copy{padding:17px 3px 0}.product-card-copy small{color:#1f3b2e;font-size:10px;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.product-card-copy h3{margin:7px 0 8px;font-size:clamp(22px,2vw,32px);line-height:1;letter-spacing:-.055em}.product-card-copy>p{margin:0 0 20px;color:#777068;font-size:13px}.product-card-copy>div{display:flex;justify-content:space-between;gap:20px;padding-top:13px;border-top:1px solid #d9d3ca;color:#6f6961;font-size:13px}.product-card-copy strong{color:#211d19;font-size:18px}@media(max-width:720px){.product-card-reveal{display:none}}
</style>
