---
import type { Product } from '@chashka-coffee/contracts'

const { product, presentation = 'editorial' } = Astro.props as { product: Product; presentation?: 'editorial' | 'menu' }
const variant = product.variants.find((item) => item.isAvailable) ?? product.variants[0]
const price = variant ? `${Math.round(variant.priceKopecks / 100).toLocaleString('ru-RU')} ₽` : 'Уточняйте'
const href = product.type === 'COFFEE' ? `/coffee/${product.slug}` : `/bakery/${product.slug}`
const tastingText = product.tastingNotes.join(' ').toLowerCase()
const tastingIcon = /абрикос|персик|ягод|виш|яблок|цитрус|фрукт/.test(tastingText) ? 'fruit' : /шоколад|какао|карамел|орех/.test(tastingText) ? 'cocoa' : 'floral'
---

<a class:list={['product-card', { 'product-card--menu': presentation === 'menu' }]} href={href}>
  <div class="product-card-media">
    <img src={product.imageUrl ?? '/images/home-morning-v2.png'} alt={product.name} loading="lazy" />
    {product.isFeatured && <span>{product.type === 'COFFEE' ? 'Свежая обжарка' : 'Любимый'}</span>}
    <div class="product-card-reveal"><p>{product.description}</p><b>Подробнее</b></div>
  </div>
  <div class="product-card-copy">
    <small>{product.subtitle ?? 'Кофе собственной обжарки'}</small>
    <h3>{product.name}</h3>
    {presentation === 'editorial' && product.tastingNotes.length > 0 && <p>{product.tastingNotes.join(' · ')}</p>}
    {presentation === 'menu' && product.tastingNotes.length > 0 && <div class="product-card-tasting">
      <div class="product-card-tasting-art" aria-hidden="true">
        {tastingIcon === 'fruit' && <svg viewBox="0 0 220 180"><circle cx="70" cy="120" r="47"/><circle cx="150" cy="120" r="47"/><path d="M107 70C111 38 127 23 162 15c-22 24-43 41-59 64Z"/><path d="M107 72C84 59 62 56 40 64c22 7 45 10 67 8Z"/></svg>}
        {tastingIcon === 'cocoa' && <svg viewBox="0 0 220 180"><rect x="32" y="38" width="67" height="67" rx="14"/><rect x="121" y="38" width="67" height="67" rx="14"/><rect x="76" y="112" width="67" height="38" rx="14"/><path fill="#f7f5f0" d="M66 71h-8V63h8v-8h8v8h8v8h-8v8h-8zm89 0h-8V63h8v-8h8v8h8v8h-8v8h-8z"/></svg>}
        {tastingIcon === 'floral' && <svg viewBox="0 0 220 180"><circle cx="110" cy="90" r="20"/><circle cx="110" cy="46" r="31"/><circle cx="152" cy="71" r="31"/><circle cx="152" cy="116" r="31"/><circle cx="110" cy="136" r="31"/><circle cx="68" cy="116" r="31"/><circle cx="68" cy="71" r="31"/></svg>}
      </div>
      <p>{product.tastingNotes.join(' · ')}</p>
    </div>}
    <div class="product-card-price"><span>{variant?.label}</span><strong>{price}</strong></div>
  </div>
</a>

<style>
  .product-card{display:grid;color:#211d19;text-decoration:none}.product-card-media{position:relative;overflow:hidden;aspect-ratio:1/.86;border-radius:var(--radius);background:#eee8df}.product-card-media img{width:100%;height:100%;object-fit:cover;transition:transform .55s cubic-bezier(.22,1,.36,1)}.product-card:hover img{transform:scale(1.045)}.product-card-media>span{position:absolute;top:14px;left:14px;padding:8px 12px;border-radius:var(--radius);background:#ec6f51;color:#fff;font-size:9px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.product-card-reveal{position:absolute;inset:auto 10px 10px;display:flex;align-items:end;justify-content:space-between;gap:18px;padding:18px;border-radius:calc(var(--radius) - 6px);background:rgba(31,59,46,.94);color:#fff;opacity:0;transform:translateY(10px);transition:opacity .25s ease,transform .25s ease}.product-card:hover .product-card-reveal,.product-card:focus-visible .product-card-reveal{opacity:1;transform:none}.product-card-reveal p{max-width:70%;margin:0;font-size:11px;line-height:1.45}.product-card-reveal b{font-size:10px;text-transform:uppercase}.product-card-copy{padding:17px 3px 0}.product-card-copy>small{color:#1f3b2e;font-size:10px;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.product-card-copy h3{margin:7px 0 8px;font-size:clamp(22px,2vw,32px);line-height:1;letter-spacing:-.055em}.product-card-copy>p{margin:0 0 20px;color:#777068;font-size:13px}.product-card-price{display:flex;justify-content:space-between;gap:20px;padding-top:13px;border-top:1px solid #d9d3ca;color:#6f6961;font-size:13px}.product-card-price strong{color:#211d19;font-size:18px}.product-card-tasting{margin:14px 0 18px}.product-card-tasting p{margin:0;color:#6f6961;font-size:12px;line-height:1.45}
  .product-card--menu{grid-template-rows:auto 1fr;height:100%;padding:9px;border:1px solid var(--line);border-radius:var(--radius);background:#f7f5f0;transition:transform .25s ease,box-shadow .25s ease,background .25s ease}.product-card--menu:hover{background:#fffdf9;box-shadow:0 16px 34px rgba(50,40,29,.1);transform:translateY(-4px)}.product-card--menu:focus-visible{outline:3px solid #bddb3d;outline-offset:4px}.product-card--menu .product-card-media{border-radius:calc(var(--radius) - 5px)}.product-card--menu .product-card-media>span{top:10px;left:10px;padding:7px 9px;font-size:8px}.product-card--menu .product-card-reveal{display:none}.product-card--menu .product-card-copy{display:flex;min-width:0;flex-direction:column;padding:15px 4px 3px}.product-card--menu .product-card-copy>small{font-size:8px;letter-spacing:.1em}.product-card--menu .product-card-copy h3{margin:8px 0 0;font-size:clamp(17px,1.35vw,21px);line-height:1;letter-spacing:-.05em}.product-card--menu .product-card-tasting{display:flex;min-height:178px;flex:1;flex-direction:column;margin:14px 0 0;padding-top:14px;border-top:1px solid #ddd7ce}.product-card--menu .product-card-tasting-art{display:grid;flex:1;place-items:center;min-height:118px;color:#211d19}.product-card--menu .product-card-tasting-art svg{width:min(74%,156px);height:132px;fill:currentColor}.product-card--menu .product-card-tasting p{margin:12px 0 0;padding-top:12px;border-top:1px solid #ddd7ce;color:#706a62;font-size:11px;line-height:1.45}.product-card--menu .product-card-price{align-items:flex-end;margin-top:auto;padding-top:18px;border-top:0}.product-card--menu .product-card-price strong{font-size:15px}
  @media(max-width:720px){.product-card-reveal{display:none}.product-card--menu{padding:7px;border-radius:18px}.product-card--menu .product-card-media{border-radius:13px}.product-card--menu .product-card-copy{padding:11px 3px 3px}.product-card--menu .product-card-copy>small{font-size:7px}.product-card--menu .product-card-copy h3{margin-top:7px;font-size:15px;line-height:.98}.product-card--menu .product-card-tasting{min-height:132px;margin-top:11px;padding-top:11px}.product-card--menu .product-card-tasting-art{min-height:80px}.product-card--menu .product-card-tasting-art svg{width:min(70%,110px);height:88px}.product-card--menu .product-card-tasting p{margin-top:9px;padding-top:9px;font-size:10px}.product-card--menu .product-card-price{padding-top:14px}.product-card--menu .product-card-price span{font-size:9px}.product-card--menu .product-card-price strong{font-size:13px}}
</style>
