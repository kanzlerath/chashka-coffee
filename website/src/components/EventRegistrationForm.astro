---
const { eventSlug, eventTitle } = Astro.props as { eventSlug: string; eventTitle: string }
---
<form class="event-form" data-event-form data-event-slug={eventSlug} data-event-title={eventTitle} novalidate>
  <label>Ваше имя<input name="name" autocomplete="name" required /></label>
  <label>Телефон<input name="phone" type="tel" autocomplete="tel" inputmode="tel" required placeholder="+7 (999) 000-00-00" /></label>
  <label>E-mail<input name="email" autocomplete="email" type="email" /></label>
  <label>Количество гостей<input name="guests" type="number" min="1" max="20" value="1" required /></label>
  <label class="wide">Комментарий<textarea name="message" placeholder="Вопрос или важная деталь"></textarea></label>
  <label class="consent"><input name="privacyAccepted" type="checkbox" required /><span>Даю <a href="/consent" target="_blank">согласие на обработку персональных данных</a> и ознакомлен(а) с <a href="/privacy" target="_blank">политикой</a>.</span></label>
  <button type="submit">Записаться</button><p aria-live="polite"></p>
</form>
<script>
  import { attachRussianPhoneMask } from '../lib/contact-fields'
  import { PUBLIC_FORM_SUCCESS_EVENT } from '../lib/form-success'

  const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3000'
  document.querySelectorAll<HTMLFormElement>('[data-event-form]').forEach((form) => {
    const phoneInput = form.elements.namedItem('phone')
    if (phoneInput instanceof HTMLInputElement) attachRussianPhoneMask(phoneInput)
    form.addEventListener('submit', async (event) => {
    event.preventDefault()
    if (!form.reportValidity()) return
    const values = new FormData(form)
    const button = form.querySelector<HTMLButtonElement>('button')
    const status = form.querySelector<HTMLParagraphElement>('p[aria-live]')
    const payload = { type:'EVENT_REGISTRATION', name:String(values.get('name') ?? '').trim(), phone:String(values.get('phone') ?? '').trim() || null, email:String(values.get('email') ?? '').trim() || null, message:String(values.get('message') ?? '').trim() || null, metadata:{ eventSlug:form.dataset.eventSlug ?? '', eventTitle:form.dataset.eventTitle ?? '', guests:String(values.get('guests') ?? '1') }, privacyAccepted:values.get('privacyAccepted') === 'on' }
    if (button) button.disabled = true
    if (status) status.textContent = 'Отправляем…'
    try {
      const response = await fetch(`${apiUrl}/api/leads`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload) })
      if (!response.ok) throw new Error()
      form.reset()
      if (status) status.textContent = 'Регистрация принята.'
      document.dispatchEvent(new CustomEvent(PUBLIC_FORM_SUCCESS_EVENT, { detail: { type: 'EVENT_REGISTRATION', eventTitle: form.dataset.eventTitle, form } }))
    } catch {
      if (status) status.textContent = 'Не удалось отправить заявку. Попробуйте ещё раз.'
    } finally {
      if (button) button.disabled = false
    }
    })
  })
</script>
<style>
  .event-form{display:grid;grid-template-columns:1fr 1fr;gap:10px}.event-form label{display:grid;gap:7px;color:#dce6dd;font-size:10px;font-weight:700}.event-form input,.event-form textarea{width:100%;min-height:50px;padding:14px 16px;border:1px solid rgba(255,255,255,.2);border-radius:var(--radius);background:#fff;color:var(--ink);outline:0}.event-form textarea{min-height:105px;resize:vertical}.event-form .wide,.event-form .consent,.event-form button,.event-form>p{grid-column:1/-1}.event-form .consent{display:flex;align-items:flex-start;gap:10px;line-height:1.5}.event-form .consent input{flex:0 0 auto;width:18px;min-height:18px;margin-top:1px;padding:0;accent-color:var(--lime)}.event-form .consent a{color:inherit;text-underline-offset:2px}.event-form button{min-height:52px;border:0;border-radius:var(--radius);background:var(--lime);color:var(--moss);font-weight:800;cursor:pointer}.event-form>p{min-height:20px;margin:0;color:#fff;font-size:12px}@media(max-width:650px){.event-form{grid-template-columns:1fr}.event-form .wide,.event-form .consent,.event-form button,.event-form>p{grid-column:1}}
</style>
