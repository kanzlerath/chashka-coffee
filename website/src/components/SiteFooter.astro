---
import ContactDialog from './ContactDialog.astro'
import StoreBadges from './StoreBadges.astro'
import { footerGroups, footerLegalLinks } from '../lib/footer-navigation'
---

<footer class="site-footer">
  <div class="footer-intro">
    <a href="/"><img src="/brand/logo.png" alt="Чашка кофе" width="62" height="62"/><span>Место для хорошего дня.</span></a>
    <StoreBadges />
  </div>
  <div class="footer-grid">
    {footerGroups.map((group) => <div class="footer-link-group">
      <small>{group.title}</small>
      {group.links.map((link) => <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>{link.label}{link.external && <svg class="footer-external-icon" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 11 11 3M5 3h6v6" /></svg>}</a>)}
    </div>)}
    <div class="footer-cta">
      <p>Есть вопрос<br/>или идея?</p>
      <button type="button" data-contact-dialog-trigger aria-haspopup="dialog" aria-controls="site-contact-dialog"><span>Написать нам</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4" /></svg></button>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© 2026 Чашка кофе</span>
    <nav class="footer-legal" aria-label="Юридические документы">{footerLegalLinks.map((link) => <a href={link.href}>{link.label}</a>)}<button type="button" data-cookie-settings>Настройки cookies</button></nav>
    <a class="footer-to-top" href="#top">Наверх <span aria-hidden="true">↑</span></a>
  </div>
  <b>ЧАШКА КОФЕ</b>
</footer>
<ContactDialog />

<style>
  .site-footer{width:100vw;margin:14px calc(50% - 50vw) 0;padding:clamp(46px,6vw,92px) var(--page-edge) 0;border-radius:0;background:#1f3b2e;color:#f8f4ed;overflow:hidden}
  .footer-intro{display:flex;justify-content:space-between;align-items:center;gap:25px}.footer-intro>a{display:flex;align-items:center;gap:22px;color:inherit;text-decoration:none}.footer-intro>a span{font-size:clamp(28px,3.1vw,47px);line-height:.9;font-weight:700;letter-spacing:-.075em;white-space:nowrap}.footer-intro img{flex:0 0 auto;object-fit:contain}
  .footer-grid{display:grid;grid-template-columns:.9fr 1fr .9fr 1fr 1.35fr;gap:clamp(22px,2.2vw,38px);padding:76px 0}
  .footer-link-group{display:flex;min-width:0;flex-direction:column;align-items:flex-start;gap:11px}.footer-grid small{margin-bottom:8px;color:#b9cfaf;text-transform:uppercase;letter-spacing:.13em;font-size:9px;font-weight:700}.footer-grid a{color:inherit;text-decoration:none;font-size:12px;line-height:1.35}.footer-link-group a{display:inline-flex;align-items:center;gap:5px}.footer-link-group a:hover{text-decoration:underline;text-underline-offset:3px}.footer-external-icon{width:12px;height:12px;flex:0 0 auto;color:#bddb3d;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.7}
  .footer-cta{align-self:start;padding:26px;border-radius:var(--radius);background:#bddb3d;color:#1f3b2e}.footer-cta p{margin:0 0 24px;font-size:23px;line-height:.94;font-weight:800;letter-spacing:-.075em}.footer-cta button{display:flex;width:100%;min-height:47px;align-items:center;justify-content:space-between;gap:18px;padding:0 17px;border:0;border-radius:var(--radius);background:#1f3b2e;color:#fff;cursor:pointer;font:700 11px Montserrat,Arial,sans-serif;transition:background-color .2s ease,transform .2s ease}.footer-cta button:hover{background:#315b45;transform:translateY(-2px)}.footer-cta button:focus-visible{outline:3px solid #fff;outline-offset:3px}.footer-cta svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.8;transition:transform .2s ease}.footer-cta button:hover svg{transform:translateX(3px)}
  .footer-bottom{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:start;gap:28px;padding:20px 0;border-top:1px solid rgba(255,255,255,.17);color:#b9c6b8;font-size:10px}.footer-legal{display:flex;justify-content:center;flex-wrap:wrap;gap:9px 18px}.footer-bottom a,.footer-legal button{padding:0;border:0;background:transparent;color:inherit;text-decoration:none;font:inherit;cursor:pointer}.footer-bottom a:hover,.footer-legal button:hover{color:#fff}.footer-legal button:focus-visible{outline:2px solid #bddb3d;outline-offset:3px}.footer-to-top{white-space:nowrap}.site-footer>b{display:block;width:100%;margin:86px 0 -10px;color:#f8f4ed;font-size:clamp(72px,10.5vw,182px);line-height:.66;letter-spacing:-.12em;white-space:nowrap}
  @media(max-width:1180px){.footer-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.footer-cta{grid-column:span 2}.footer-bottom{grid-template-columns:auto 1fr}.footer-legal{grid-column:1/-1;grid-row:2;justify-content:flex-start}.footer-to-top{justify-self:end}}
  @media(max-width:700px){.site-footer{margin-top:0;padding:48px 20px 0}.footer-intro{align-items:flex-start;flex-direction:column}.footer-intro>a{align-items:flex-start;flex-direction:column;gap:20px}.footer-intro>a span{font-size:32px;white-space:normal}.footer-grid{grid-template-columns:1fr 1fr;gap:43px 16px;padding:57px 0}.footer-cta{grid-column:1/-1}.footer-bottom{grid-template-columns:1fr auto;flex-wrap:wrap}.footer-legal{grid-column:1/-1;grid-row:2;justify-content:flex-start}.footer-external-icon{display:block;width:14px;height:14px;stroke-width:2}.site-footer>b{font-size:11.8vw;margin-top:65px;letter-spacing:-.13em}}
  @media(prefers-reduced-motion:reduce){.footer-cta button,.footer-cta svg{transition:none}}
</style>
