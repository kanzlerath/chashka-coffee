</style>

<script>
  import { matchesMenuSearch } from '../lib/menu-search'

  document.querySelectorAll<HTMLElement>('[data-restaurant-menu]').forEach((menu) => {
    const input = menu.querySelector<HTMLInputElement>('[data-menu-search]')
    const clearButton = menu.querySelector<HTMLButtonElement>('[data-menu-search-clear]')
    const emptyState = menu.querySelector<HTMLElement>('[data-menu-empty]')
    const categories = [...menu.querySelectorAll<HTMLElement>('[data-menu-category]')]
    const toolbarSlot = menu.querySelector<HTMLElement>('[data-menu-toolbar-slot]')
    const toolbar = menu.querySelector<HTMLElement>('[data-menu-toolbar]')
    const categoryNav = menu.querySelector<HTMLElement>('.menu-category-nav')
    const categoryNavList = categoryNav?.querySelector<HTMLElement>('nav')
    const categoryLinks = [...menu.querySelectorAll<HTMLAnchorElement>('[data-menu-category-link]')]
    const footer = document.querySelector<HTMLElement>('.site-footer')
    const picker = menu.querySelector<HTMLElement>('.restaurant-picker')
    const pickerSummary = picker?.querySelector<HTMLButtonElement>('.restaurant-picker-summary')
    const pickerPanel = picker?.querySelector<HTMLElement>('.restaurant-picker-panel')
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    let pickerCloseTimer = 0
    let pickerOpenFrame = 0
    let toolbarFrame = 0
    let categoryFrame = 0
    let activeCategory = ''

    const syncToolbar = () => {
      toolbarFrame = 0
      if (!toolbar || !toolbarSlot) return
      if (!window.matchMedia('(max-width: 850px)').matches) {
        toolbarSlot.style.removeProperty('height')
        toolbar.classList.remove('is-fixed')
        toolbar.style.removeProperty('--menu-toolbar-left')
        toolbar.style.removeProperty('--menu-toolbar-width')
        return
      }
      const slotRect = toolbarSlot.getBoundingClientRect()
      const slotPaddingTop = Number.parseFloat(getComputedStyle(toolbarSlot).paddingTop) || 0
      toolbarSlot.style.height = `${toolbar.offsetHeight + slotPaddingTop}px`
      toolbar.style.setProperty('--menu-toolbar-left', `${slotRect.left}px`)
      toolbar.style.setProperty('--menu-toolbar-width', `${slotRect.width}px`)
      toolbar.classList.add('is-fixed')
    }

    const requestToolbarSync = () => {
      if (toolbarFrame) return
      toolbarFrame = window.requestAnimationFrame(syncToolbar)
    }

    syncToolbar()
    window.requestAnimationFrame(() => menu.classList.remove('menu-page--controls-pending'))
    window.addEventListener('scroll', requestToolbarSync, { passive: true })
    window.addEventListener('resize', requestToolbarSync)

    let footerIsVisible = false
    const syncFooterVisibility = () => {
      const hidden = window.matchMedia('(max-width: 850px)').matches && footerIsVisible
      toolbar?.classList.toggle('is-footer-hidden', hidden)
      categoryNav?.classList.toggle('is-footer-hidden', hidden)
    }
    const footerObserver = footer && 'IntersectionObserver' in window ? new IntersectionObserver(([entry]) => {
      footerIsVisible = entry.isIntersecting
      syncFooterVisibility()
    }, { threshold: 0.01 }) : null
    if (footer && footerObserver) footerObserver.observe(footer)
    window.addEventListener('resize', syncFooterVisibility)

    const setActiveCategory = (slug: string) => {
      if (activeCategory === slug) return
      activeCategory = slug

      categoryLinks.forEach((link) => {
        const isActive = link.dataset.menuCategoryLink === slug
        link.classList.toggle('is-active', isActive)
        if (isActive) link.setAttribute('aria-current', 'true')
        else link.removeAttribute('aria-current')
      })

      const activeLink = categoryLinks.find((link) => link.dataset.menuCategoryLink === slug)
      if (!activeLink || !categoryNavList) return
      const centeredLeft = activeLink.offsetLeft - (categoryNavList.clientWidth - activeLink.offsetWidth) / 2
      const maxLeft = Math.max(0, categoryNavList.scrollWidth - categoryNavList.clientWidth)
      categoryNavList.scrollTo({
        left: Math.min(maxLeft, Math.max(0, centeredLeft)),
        behavior: reduceMotion.matches ? 'auto' : 'smooth',
      })
    }

    const syncActiveCategory = () => {
      categoryFrame = 0
      if (!window.matchMedia('(max-width: 850px)').matches) {
        setActiveCategory('')
        return
      }

      const visibleCategories = categories.filter((category) => !category.hidden)
      if (!visibleCategories.length) {
        setActiveCategory('')
        return
      }

      const activationLine = (categoryNav?.getBoundingClientRect().bottom ?? 0) + 18
      let currentCategory = visibleCategories[0]
      for (const category of visibleCategories) {
        if (category.getBoundingClientRect().top > activationLine) break
        currentCategory = category
      }
      setActiveCategory(currentCategory.dataset.menuCategory ?? '')
    }

    const requestCategorySync = () => {
      if (categoryFrame) return
      categoryFrame = window.requestAnimationFrame(syncActiveCategory)
    }

    syncActiveCategory()
    window.addEventListener('scroll', requestCategorySync, { passive: true })
    window.addEventListener('resize', requestCategorySync)

    const setPickerExpanded = (expanded: boolean) => pickerSummary?.setAttribute('aria-expanded', String(expanded))

    const openPicker = () => {
      if (!picker || !pickerPanel) return
      window.clearTimeout(pickerCloseTimer)
      window.cancelAnimationFrame(pickerOpenFrame)
      pickerPanel.hidden = false
      setPickerExpanded(true)
      pickerOpenFrame = window.requestAnimationFrame(() => {
        picker.classList.add('is-open')
      })
    }

    const closePicker = () => {
      if (pickerSummary?.getAttribute('aria-expanded') !== 'true' || !picker || !pickerPanel) return
      window.cancelAnimationFrame(pickerOpenFrame)
      picker.classList.remove('is-open')
      setPickerExpanded(false)
      if (reduceMotion.matches) {
        pickerPanel.hidden = true
        return
      }

      window.clearTimeout(pickerCloseTimer)
      pickerCloseTimer = window.setTimeout(() => {
        pickerPanel.hidden = true
      }, 230)
    }

    pickerSummary?.addEventListener('click', (event) => {
      event.preventDefault()
      if (pickerSummary.getAttribute('aria-expanded') === 'true') {
        closePicker()
      } else {
        openPicker()
      }
    })

    document.addEventListener('pointerdown', (event) => {
      if (pickerSummary?.getAttribute('aria-expanded') === 'true' && event.target instanceof Node && !picker?.contains(event.target)) closePicker()
    })

    picker?.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return
      closePicker()
      pickerSummary?.focus()
    })

    const applySearch = () => {
      const query = input?.value ?? ''
      let visibleCategories = 0

      categories.forEach((category) => {
        const items = [...category.querySelectorAll<HTMLButtonElement>('[data-menu-item]')]
        const hasVisibleItems = items.reduce((hasMatch, item) => {
          const matches = matchesMenuSearch(query, [item.dataset.menuSearchValue ?? ''])
          item.hidden = !matches
          return hasMatch || matches
        }, false)

        category.hidden = !hasVisibleItems
        const categoryLink = menu.querySelector<HTMLElement>(`[data-menu-category-link="${category.dataset.menuCategory}"]`)
        if (categoryLink) categoryLink.hidden = !hasVisibleItems
        if (hasVisibleItems) visibleCategories += 1
      })

      if (clearButton) clearButton.hidden = query.length === 0
      if (emptyState) emptyState.hidden = visibleCategories > 0
      requestCategorySync()
    }

    input?.addEventListener('input', applySearch)
    clearButton?.addEventListener('click', () => {
      if (!input) return
      input.value = ''
      applySearch()
      input.focus()
    })
  })
</script>
