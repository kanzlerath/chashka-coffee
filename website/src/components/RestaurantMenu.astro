---
import DishDialog from './DishDialog.astro'
import type { RestaurantMenuResponse, RestaurantSummary } from '@chashka-coffee/contracts'
import { formatMenuPortion } from '../lib/menu-portion'

interface Props {
  data: RestaurantMenuResponse | null
  restaurants: RestaurantSummary[]
  currentSlug: string | undefined
}

const { data, restaurants, currentSlug } = Astro.props
const menuRestaurants = restaurants.filter(({ hasMenu }) => hasMenu)
const selectedRestaurant = menuRestaurants.find(({ slug }) => slug === currentSlug)
const money = (kopecks:number) => `${new Intl.NumberFormat('ru-RU').format(kopecks / 100)} ₽`
const badgeLabel = (badge:string|null) => ({NEW:'Новинка',HIT:'Хит',SEASONAL:'Сезонное',SPECIAL:'Специальное'}[badge ?? ''] ?? null)
const badgeTone = (badge:string|null) => ({NEW:'new',HIT:'hit',SEASONAL:'seasonal',SPECIAL:'special'}[badge ?? ''] ?? 'special')
const dietaryLabel = (mark:string) => ({VEGETARIAN:'Вегетарианское',SPICY:'Острое',LACTOSE_FREE:'Без лактозы',GLUTEN_FREE:'Без глютена',LIGHT:'Лёгкое'}[mark] ?? mark)
const allergenLabel = (allergen:string) => ({egg:'Яйцо',gluten:'Глютен',nuts:'Орехи',milk:'Молочный продукт',fish:'Рыба'}[allergen] ?? allergen)
const fallbackImages = ['/images/home-breakfast.png','/images/home-hero-v1.png','/images/home-morning-v2.png','/images/restaurants-hero.png']
const dishPayload = (item:RestaurantMenuResponse['categories'][number]['items'][number], categoryName:string, imageUrl:string) => JSON.stringify({
  name:item.name, categoryName, description:item.description ?? '', ingredients:item.ingredients ?? '', allergens:item.allergens.map(allergenLabel), dietaryMarks:item.dietaryMarks.map(dietaryLabel),
  weight:formatMenuPortion(item.weightGrams, item.measurementUnit), price:money(item.priceKopecks), calories:item.calories === null ? null : String(item.calories), proteins:item.proteins === null ? null : `${item.proteins} г`, fats:item.fats === null ? null : `${item.fats} г`, carbohydrates:item.carbohydrates === null ? null : `${item.carbohydrates} г`, imageUrl, badge:badgeLabel(item.marketingBadge), badgeTone:badgeTone(item.marketingBadge),
})
---

{data ? <div class="menu-page menu-page--controls-pending" data-restaurant-menu>
  <div class="menu-layout">
    <div class="menu-toolbar-slot" data-menu-toolbar-slot>
  <header class="menu-toolbar" data-menu-toolbar>
    <div class="menu-search" role="search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
      <input type="search" aria-label="Поиск по меню" placeholder="Найти блюдо или напиток" autocomplete="off" data-menu-search />
      <button type="button" aria-label="Очистить поиск" data-menu-search-clear hidden>×</button>
    </div>
    <div class="restaurant-picker">
      <button class="restaurant-picker-summary" type="button" aria-label="Выбрать ресторан" aria-expanded="false" aria-controls="restaurant-picker-panel"><span><b>{(selectedRestaurant?.name ?? data.restaurant.name).replace('Чашка кофе — ', '')}</b><small>{selectedRestaurant?.address ?? data.restaurant.address}</small></span><svg class="restaurant-picker-mobile-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 17s5-4.4 5-9a5 5 0 0 0-10 0c0 4.6 5 9 5 9Z"></path><circle cx="10" cy="8" r="1.7"></circle></svg><svg class="restaurant-picker-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m6 8 4 4 4-4"></path></svg></button>
      <div class="restaurant-picker-panel" id="restaurant-picker-panel" hidden>
        <div class="restaurant-picker-list">{menuRestaurants.map((restaurant) => restaurant.slug === currentSlug
          ? <span class="restaurant-option active" aria-current="page"><span class="restaurant-option-mark"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 17s5-4.4 5-9a5 5 0 0 0-10 0c0 4.6 5 9 5 9Z"></path><circle cx="10" cy="8" r="1.7"></circle></svg></span><span class="restaurant-option-copy"><b>{restaurant.name.replace('Чашка кофе — ', '')}</b><small>{restaurant.address}</small></span><span class="restaurant-option-state"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10 3 3 6-6"></path></svg></span></span>
          : <a class="restaurant-option" href={`/restaurants/${restaurant.slug}/menu`}><span class="restaurant-option-mark"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 17s5-4.4 5-9a5 5 0 0 0-10 0c0 4.6 5 9 5 9Z"></path><circle cx="10" cy="8" r="1.7"></circle></svg></span><span class="restaurant-option-copy"><b>{restaurant.name.replace('Чашка кофе — ', '')}</b><small>{restaurant.address}</small></span><span class="restaurant-option-state"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4 6 6-6 6"></path></svg></span></a>)}</div>
      </div>
    </div>
  </header>
    </div>
    <aside class="menu-category-nav"><nav aria-label="Категории меню">{data.categories.map((category) => <a href={`#${category.slug}`} data-menu-category-link={category.slug}>{category.name}</a>)}</nav></aside>
    <div class="menu-categories">{data.categories.map((category) => <section id={category.slug} class="menu-category" data-menu-category={category.slug}><header><h2>{category.name}</h2></header><div class="menu-items">{category.items.map((item, itemIndex) => {
      const imageUrl = item.imageUrl ?? fallbackImages[itemIndex % fallbackImages.length]
      const imageStyle = item.imageCrop
        ? `--card-image-focus-x:${item.imageCrop.focusX}%;--card-image-focus-y:${item.imageCrop.focusY}%;--card-image-zoom:${item.imageCrop.zoom};`
        : undefined
      const badge = badgeLabel(item.marketingBadge)
      const searchValue = [category.name, item.name, item.description, item.ingredients].filter(Boolean).join(' ')
      return <button class="menu-item" type="button" data-menu-item data-menu-search-value={searchValue} data-dish-trigger data-dish={dishPayload(item,category.name,imageUrl)} aria-haspopup="dialog">
        <div class="menu-item-image"><img src={imageUrl} alt="" loading="lazy" style={imageStyle} />{badge && <span class={`menu-badge menu-badge--${badgeTone(item.marketingBadge)}`}>{badge}</span>}</div>
        <div class="menu-item-copy"><small>{category.name}</small><h3>{item.name}</h3><div><span>{formatMenuPortion(item.weightGrams, item.measurementUnit)}</span><strong>{money(item.priceKopecks)}</strong></div></div>
      </button>
    })}</div></section>)}<div class="menu-empty" data-menu-empty hidden><h2>Ничего не нашли</h2><p>Попробуйте другое название или выберите категорию.</p></div></div>
  </div>
  <DishDialog />
</div> : <section class="menu-unavailable"><p>Меню</p><h1>Меню временно недоступно.</h1><span>Попробуйте обновить страницу немного позже или выберите другой ресторан.</span><a href="/restaurants">К ресторанам</a></section>}

<style>
  :global(html:has([data-restaurant-menu])){scroll-behavior:smooth}
  :global(body.public-site .page-shell:has([data-restaurant-menu])>.site-header){margin-bottom:0}
  .menu-page{padding:clamp(14px,1.5vw,24px) 0 clamp(90px,10vw,160px)}.menu-heading{display:flex;align-items:end;justify-content:space-between;gap:42px;padding-bottom:42px;border-bottom:1px solid var(--line)}.menu-heading p,.menu-layout aside>p,.menu-unavailable>p{margin:0;color:#6f902b;font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.menu-heading h1{margin:14px 0 12px;font-size:clamp(44px,5vw,82px);line-height:.88;letter-spacing:-.085em}.menu-heading>div>span{color:var(--muted);font-size:14px}.restaurant-picker{position:relative;z-index:8;width:min(420px,100%)}.restaurant-picker summary{display:flex;min-height:52px;align-items:center;justify-content:space-between;padding:0 20px;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper);cursor:pointer;font-size:12px;font-weight:800;list-style:none}.restaurant-picker summary:after{content:'⌄';font-size:17px}.restaurant-picker[open] summary:after{transform:rotate(180deg)}.restaurant-picker summary::-webkit-details-marker{display:none}.restaurant-picker>div{position:absolute;top:calc(100% + 8px);right:0;left:0;max-height:360px;padding:8px;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper);box-shadow:0 18px 40px rgba(35,30,27,.13);overflow:auto}.restaurant-picker a{display:grid;gap:4px;padding:13px;border-radius:calc(var(--radius) - 8px);text-decoration:none}.restaurant-picker a:hover,.restaurant-picker a.active{background:#e8eddc}.restaurant-picker b{font-size:12px}.restaurant-picker span{color:var(--muted);font-size:10px}.menu-layout{display:grid;grid-template-columns:220px minmax(0,1fr);gap:clamp(38px,6vw,94px);padding-top:60px}.menu-layout aside{position:sticky;top:118px;height:max-content}.menu-layout nav{display:grid;gap:5px;margin-top:20px}.menu-layout nav a{padding:8px 0;color:#57524c;font-size:12px;font-weight:600;text-decoration:none;transition:color .2s,transform .2s,background-color .2s}.menu-layout nav a:hover{color:#6f902b;transform:translateX(4px)}.menu-categories{display:grid;gap:24px}.menu-category{scroll-margin-top:200px}.menu-category>header{display:flex;align-items:end;justify-content:space-between;gap:22px;margin-bottom:24px}.menu-category h2{margin:0;font-size:clamp(34px,4vw,62px);line-height:.91;letter-spacing:-.075em}.menu-category header span{color:var(--muted);font-size:11px}.menu-items{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px}.menu-item{display:grid;grid-template-rows:auto 1fr;width:100%;min-width:0;height:100%;padding:9px;border:1px solid var(--line);border-radius:var(--radius);background:#f7f5f0;color:inherit;cursor:pointer;font:inherit;text-align:left;transition:transform .25s ease,box-shadow .25s ease,background .25s ease}.menu-item:hover{background:#fffdf9;box-shadow:0 16px 34px rgba(50,40,29,.1);transform:translateY(-4px)}.menu-item:focus-visible{outline:3px solid #bddb3d;outline-offset:4px}.menu-item-image{position:relative;align-self:start;width:100%;aspect-ratio:1/.86;overflow:hidden;border-radius:calc(var(--radius) - 5px);background:#ebe7df}.menu-item-image img{width:100%;height:100%;object-fit:cover;transition:transform .45s ease}.menu-item:hover img{transform:scale(1.045)}.menu-badge{position:absolute;top:10px;left:10px;padding:7px 9px;border-radius:var(--radius);font-size:8px;font-weight:900;letter-spacing:.07em;text-transform:uppercase}.menu-badge--hit{background:#ef603f;color:#fff}.menu-badge--new{background:#bddb3d;color:#382b24}.menu-badge--seasonal{background:#f2c86f;color:#503616}.menu-badge--special{background:#7278a9;color:#fff}.menu-item-copy{display:flex;min-width:0;flex-direction:column;padding:15px 4px 3px}.menu-item-copy small{color:#382b24;font-size:8px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.menu-item-copy h3{margin:8px 0 0;font-size:clamp(17px,1.35vw,21px);line-height:1;letter-spacing:-.05em}.menu-item-copy>div{display:flex;align-items:end;justify-content:space-between;gap:10px;margin-top:auto;padding-top:18px}.menu-item-copy>div span{color:var(--muted);font-size:10px}.menu-item-copy strong{font-size:15px}.menu-unavailable{min-height:65svh;padding:clamp(90px,12vw,190px) 0}.menu-unavailable h1{max-width:900px;margin:18px 0;font-size:clamp(45px,6vw,90px);line-height:.9}.menu-unavailable>span{color:var(--muted)}.menu-unavailable a{display:flex;width:max-content;margin-top:30px;padding:15px 20px;border-radius:var(--radius);background:var(--moss);color:#fff;text-decoration:none;font-size:12px;font-weight:800}
  .menu-page{--menu-gap:clamp(16px,1.3vw,26px);overflow:visible;padding-top:0;padding-bottom:0}.menu-page::after{content:'';display:block;height:clamp(90px,10vw,160px)}
  .menu-toolbar-slot{position:sticky;top:96px;z-index:40;grid-column:1/-1}.menu-toolbar{position:relative;z-index:40;display:grid;width:100%;grid-template-columns:minmax(300px,1fr) minmax(330px,420px);align-items:start;gap:7px;padding:var(--menu-gap) 0 0;background:transparent}.menu-toolbar.is-fixed{position:fixed;top:96px;left:var(--menu-toolbar-left);width:var(--menu-toolbar-width)}
  .menu-search{display:flex;min-width:0;min-height:56px;align-items:center;gap:11px;padding:0 16px;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper);transition:border-color .2s ease,box-shadow .2s ease}
  .menu-search:focus-within{border-color:#8ba23b;box-shadow:0 0 0 3px rgba(139,162,59,.14)}.menu-search svg{flex:0 0 auto;width:20px;height:20px;fill:none;stroke:#6b675f;stroke-linecap:round;stroke-width:1.7}.menu-search input{width:100%;min-width:0;padding:0;border:0;outline:0;background:transparent;color:#25201c;font:inherit;font-size:14px;font-weight:650}.menu-search input::placeholder{color:#8b867e}.menu-search button{display:grid;flex:0 0 auto;place-items:center;width:32px;height:32px;padding:0;border:0;border-radius:50%;background:#ece9e1;color:#4f4a44;font:inherit;font-size:20px;line-height:1;cursor:pointer}.menu-search button[hidden]{display:none}
  .menu-search input::-webkit-search-cancel-button{-webkit-appearance:none;appearance:none;display:none}.menu-search input::-ms-clear{display:none}
  .restaurant-picker{width:100%}.restaurant-picker summary{position:relative;z-index:2;min-height:56px;padding:0 15px 0 17px;transition:border-color .2s ease,background-color .2s ease,box-shadow .2s ease,border-radius .2s ease}.restaurant-picker summary:hover,.restaurant-picker[open] summary{border-color:#cad4b8;background:#fffdf9}.restaurant-picker[open] summary{border-bottom-color:transparent;border-radius:20px 20px 0 0;box-shadow:none}.restaurant-picker summary:after{display:none}.restaurant-picker summary>span{display:grid;min-width:0;gap:3px;color:#25201c;font-size:inherit}.restaurant-picker summary>span b{overflow:hidden;font-size:12px;text-overflow:ellipsis;white-space:nowrap}.restaurant-picker summary>span small{overflow:hidden;color:var(--muted);font-size:9px;font-weight:500;text-overflow:ellipsis;white-space:nowrap}.restaurant-picker-chevron{flex:0 0 auto;width:22px;height:22px;padding:4px;border-radius:8px;background:#f0eee8;fill:none;stroke:#4d4943;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.7;transition:transform .2s ease,background-color .2s ease}.restaurant-picker[open] .restaurant-picker-chevron{background:#e7ecd9;transform:rotate(180deg)}.restaurant-picker>.restaurant-picker-panel{top:calc(100% - 1px);max-height:430px;padding:10px;border-top:0;border-color:#cad4b8;border-radius:0 0 20px 20px;background:#fffdf9;box-shadow:0 22px 46px rgba(35,30,27,.14)}.restaurant-picker-panel>header{padding:9px 11px 13px;border-bottom:1px solid var(--line)}.restaurant-picker-panel>header p{margin:0;color:#28231f;font-size:13px;font-weight:750}.restaurant-picker-panel>header span{display:block;margin-top:4px;color:var(--muted);font-size:10px}.restaurant-picker-list{display:grid;gap:4px;padding-top:8px}.restaurant-picker .restaurant-option{display:grid;grid-template-columns:38px minmax(0,1fr) 28px;align-items:center;gap:11px;padding:9px;border-radius:14px;color:inherit;text-decoration:none;transition:background-color .18s ease,transform .18s ease}.restaurant-picker a.restaurant-option:hover{background:#f0f3e8;transform:translateX(2px)}.restaurant-picker .restaurant-option.active{background:#e7ecd9;cursor:default}.restaurant-option-mark,.restaurant-option-state{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:#f0eee8;color:#536342}.restaurant-option-mark svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.45}.restaurant-option-copy{display:grid;min-width:0;gap:4px}.restaurant-option-copy b{overflow:hidden;color:#28231f;font-size:12px;text-overflow:ellipsis;white-space:nowrap}.restaurant-option-copy small{overflow:hidden;color:var(--muted);font-size:9px;text-overflow:ellipsis;white-space:nowrap}.restaurant-option-state{width:28px;height:28px;border-radius:10px;background:transparent;color:#777168}.restaurant-option-state svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.8}.restaurant-option.active .restaurant-option-mark{background:#d5e0bd;color:#34482c}.restaurant-option.active .restaurant-option-state{background:#6f902b;color:#fff}
  .restaurant-picker{display:block;box-sizing:border-box;height:56px;overflow:visible;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper);transition:border-color .18s ease,box-shadow .22s ease}.restaurant-picker.is-open{border-color:#cad4b8;border-bottom-color:transparent;border-radius:var(--radius) var(--radius) 0 0}.restaurant-picker:has(.restaurant-picker-summary:focus-visible){box-shadow:0 0 0 3px rgba(139,162,59,.14)}.restaurant-picker-summary{position:relative;z-index:2;display:flex;box-sizing:border-box;width:100%;min-height:54px;align-items:center;justify-content:space-between;padding:0 15px 0 17px;border:0;border-radius:var(--radius);outline:0;background:transparent;color:inherit;cursor:pointer;font:inherit;font-size:12px;font-weight:800;text-align:left;transition:background-color .18s ease}.restaurant-picker-summary:hover,.restaurant-picker.is-open .restaurant-picker-summary{background:#fffdf9}.restaurant-picker.is-open .restaurant-picker-summary{border-radius:var(--radius) var(--radius) 0 0}.restaurant-picker-summary>span{display:grid;min-width:0;gap:3px;color:#25201c}.restaurant-picker-summary>span b{overflow:hidden;font-size:12px;text-overflow:ellipsis;white-space:nowrap}.restaurant-picker-summary>span small{overflow:hidden;color:var(--muted);font-size:9px;font-weight:500;text-overflow:ellipsis;white-space:nowrap}.restaurant-picker-mobile-icon{display:none}.restaurant-picker.is-open .restaurant-picker-chevron{background:#e7ecd9;transform:rotate(180deg)}
  .restaurant-picker>.restaurant-picker-panel{position:absolute;z-index:1;top:calc(100% - 1px);right:-1px;left:-1px;min-height:0;max-height:360px;padding:8px 9px 9px;border:1px solid #cad4b8;border-top:0;border-radius:0 0 var(--radius) var(--radius);background:#fffdf9;box-shadow:0 20px 38px rgba(35,30,27,.13);opacity:0;visibility:hidden;overflow:auto;transform:scaleY(.985);transform-origin:top center;transition:visibility 0s linear .18s,opacity .14s ease,transform .18s cubic-bezier(.22,1,.36,1)}.restaurant-picker-list{padding:0}.restaurant-picker.is-open>.restaurant-picker-panel{opacity:1;visibility:visible;transform:none;transition-delay:0s}
  .menu-layout{grid-template-columns:220px minmax(0,1fr);column-gap:clamp(24px,3vw,42px);row-gap:var(--menu-gap);padding-top:var(--menu-gap)}.menu-layout .menu-category-nav{top:calc(152px + var(--menu-gap) + var(--menu-gap));box-sizing:border-box;display:flex;height:max(420px,calc(100svh - 257px));flex-direction:column;overflow-x:hidden;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:none;padding:9px;border:1px solid var(--line);border-radius:18px;background:rgba(252,251,248,.58)}.menu-layout .menu-category-nav::-webkit-scrollbar{display:none}.menu-layout .menu-category-nav nav{gap:2px;margin-top:0;padding-top:0}.menu-layout .menu-category-nav nav a{padding:13px 12px;border-radius:12px;color:#3f3a35;font-size:16px;font-weight:600;letter-spacing:-.02em}.menu-layout .menu-category-nav nav a:hover{background:#e8eddc;color:#27432f;transform:none}.menu-item[hidden],.menu-category[hidden],.menu-category-nav a[hidden]{display:none}.menu-empty{padding:clamp(44px,7vw,84px);border-radius:var(--radius);background:#f1f0e9}.menu-empty h2{margin:0;font-size:clamp(33px,4vw,58px);line-height:.92;letter-spacing:-.07em}.menu-empty p{margin:15px 0 0;color:var(--muted);font-size:14px}.menu-empty[hidden]{display:none}
  .menu-category h2{font-size:clamp(30px,3.1vw,48px);line-height:.94;letter-spacing:-.065em}
  .menu-item-image img{object-position:var(--card-image-focus-x,50%) var(--card-image-focus-y,50%);transform:scale(var(--card-image-zoom,1));transform-origin:var(--card-image-focus-x,50%) var(--card-image-focus-y,50%)}.menu-item:hover img{transform:scale(var(--card-image-zoom,1)) scale(1.045)}
  @media(max-width:1180px) and (min-width:851px){.menu-items{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:850px){.menu-page{padding:12px 16px 82px}.menu-toolbar{top:100px;grid-template-columns:1fr;gap:6px;padding:6px 0 8px}.menu-search,.restaurant-picker summary{min-height:48px}.menu-search{padding:0 14px}.menu-search input{font-size:12px}.restaurant-picker{width:100%}.restaurant-picker summary{padding-left:14px}.restaurant-picker>.restaurant-picker-panel{right:0;left:0}.menu-layout{display:block;padding-top:18px}.menu-layout aside{position:static}.menu-layout .menu-category-nav{height:auto;min-height:0;padding:9px;border-radius:18px}.menu-layout .menu-category-nav nav{display:flex;gap:4px;margin:0;padding:0;overflow:auto;white-space:nowrap}.menu-layout .menu-category-nav nav a{padding:11px 12px;border:0;border-radius:12px;background:var(--paper);font-size:14px;font-weight:600}.menu-categories{margin-top:34px;gap:16px}.menu-category{scroll-margin-top:230px}.menu-category>header{margin-bottom:18px}.menu-category h2{font-size:clamp(34px,10vw,44px)}.menu-items{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.menu-item{padding:7px;border-radius:18px}.menu-item-image{aspect-ratio:1/.9;border-radius:13px}.menu-badge{top:7px;left:7px;padding:6px 7px;font-size:7px}.menu-item-copy{padding:11px 3px 3px}.menu-item-copy small{font-size:7px}.menu-item-copy h3{margin-top:7px;font-size:15px;line-height:.98;letter-spacing:-.04em}.menu-item-copy>div{gap:5px;padding-top:14px}.menu-item-copy>div span{font-size:9px}.menu-item-copy strong{font-size:13px}.menu-unavailable{padding-inline:20px}}
  @media(max-width:850px){.menu-page{--menu-gap:16px;padding-top:0;padding-bottom:0}.menu-page::after{height:82px}.menu-toolbar-slot{position:relative;top:auto;padding-top:8px}.menu-toolbar{top:auto;grid-template-columns:minmax(0,1fr) 48px;gap:8px;padding:4px 8px 0;border:1px solid #e4dfd7;border-bottom:0;border-radius:var(--radius) var(--radius) 0 0;background:rgba(252,251,248,.98);backdrop-filter:blur(14px)}.menu-toolbar.is-fixed{top:89px}.menu-search{border-color:transparent;border-radius:0;background:transparent}.menu-search:focus-within{box-shadow:none}.restaurant-picker{width:48px;height:48px;border-color:transparent;border-radius:0;background:transparent}.restaurant-picker.is-open{border-color:#cad4b8;border-radius:var(--radius)}.restaurant-picker-summary{min-height:46px;justify-content:center;padding:0}.restaurant-picker-summary:hover{background:transparent}.restaurant-picker.is-open .restaurant-picker-summary{border-radius:var(--radius);background:#fffdf9}.restaurant-picker-summary>span,.restaurant-picker-chevron{display:none}.restaurant-picker-mobile-icon{display:block;width:21px;height:21px;fill:none;stroke:#425438;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.55}.restaurant-picker>.restaurant-picker-panel{top:calc(100% + 8px);right:-10px;left:auto;width:calc(100vw - 32px);padding:8px;border:1px solid #cad4b8;border-radius:var(--radius)}.menu-layout{padding-top:var(--menu-gap)}.menu-layout .menu-category-nav{position:fixed;z-index:30;top:138px;right:16px;left:16px;width:auto;height:auto;min-height:0;padding:6px 8px 8px;border:1px solid #e4dfd7;border-top:0;border-radius:0 0 var(--radius) var(--radius);background:rgba(252,251,248,.98);box-shadow:0 12px 28px rgba(35,30,27,.07);backdrop-filter:blur(14px)}.menu-layout .menu-category-nav nav a{padding:10px 12px}.menu-layout .menu-category-nav nav a.is-active{background:#e3ebd7;color:#27432f}.menu-categories{margin-top:0;padding-top:51px}.menu-category{scroll-margin-top:205px}.menu-category>header{margin-bottom:16px}.menu-category h2{font-size:clamp(28px,8vw,36px)}}
  @media(max-width:850px){.menu-page--controls-pending :is(.menu-toolbar,.menu-layout .menu-category-nav){visibility:hidden}.menu-toolbar,.menu-layout .menu-category-nav{transition:opacity .22s ease,visibility 0s linear 0s}.menu-toolbar.is-footer-hidden,.menu-layout .menu-category-nav.is-footer-hidden{opacity:0;visibility:hidden;pointer-events:none;transition:opacity .22s ease,visibility 0s linear .22s}.menu-layout .menu-category-nav nav{scrollbar-width:none}.menu-layout .menu-category-nav nav::-webkit-scrollbar{display:none}}
