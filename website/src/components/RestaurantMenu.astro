---
import DishDialog from './DishDialog.astro'
import type { RestaurantMenuResponse, RestaurantSummary } from '@chashka-coffee/contracts'

interface Props {
  data: RestaurantMenuResponse | null
  restaurants: RestaurantSummary[]
  currentSlug: string | undefined
}

const { data, restaurants, currentSlug } = Astro.props
const menuRestaurants = restaurants.filter(({ hasMenu }) => hasMenu)
const selectedRestaurant = menuRestaurants.find(({ slug }) => slug === currentSlug)
const money = (kopecks:number) => `${new Intl.NumberFormat('ru-RU').format(kopecks / 100)} ₽`
const badgeLabel = (badge:string|null) => ({NEW:'Новинка',HIT:'Хит',SEASONAL:'Сезонное',SPECIAL:'Специальное'}[badge ?? ''] ?? null)
const badgeTone = (badge:string|null) => ({NEW:'new',HIT:'hit',SEASONAL:'seasonal',SPECIAL:'special'}[badge ?? ''] ?? 'special')
const dietaryLabel = (mark:string) => ({VEGETARIAN:'Вегетарианское',SPICY:'Острое',LACTOSE_FREE:'Без лактозы',GLUTEN_FREE:'Без глютена',LIGHT:'Лёгкое'}[mark] ?? mark)
const allergenLabel = (allergen:string) => ({egg:'Яйцо',gluten:'Глютен',nuts:'Орехи',milk:'Молочный продукт',fish:'Рыба'}[allergen] ?? allergen)
const fallbackImages = ['/images/home-breakfast.png','/images/home-hero-v1.png','/images/home-morning-v2.png','/images/restaurants-hero.png']
const dishPayload = (item:RestaurantMenuResponse['categories'][number]['items'][number], categoryName:string, imageUrl:string) => JSON.stringify({
  name:item.name, categoryName, description:item.description ?? '', ingredients:item.ingredients ?? '', allergens:item.allergens.map(allergenLabel), dietaryMarks:item.dietaryMarks.map(dietaryLabel),
  weight:item.weightGrams ? `${item.weightGrams} г` : '1 порция', price:money(item.priceKopecks), calories:item.calories === null ? null : String(item.calories), proteins:item.proteins === null ? null : `${item.proteins} г`, fats:item.fats === null ? null : `${item.fats} г`, carbohydrates:item.carbohydrates === null ? null : `${item.carbohydrates} г`, imageUrl, badge:badgeLabel(item.marketingBadge), badgeTone:badgeTone(item.marketingBadge),
})
---

{data ? <div class="menu-page" data-restaurant-menu>
  <header class="menu-toolbar">
    <div class="menu-search" role="search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
      <input type="search" aria-label="Поиск по меню" placeholder="Найти блюдо или напиток" autocomplete="off" data-menu-search />
      <button type="button" aria-label="Очистить поиск" data-menu-search-clear hidden>×</button>
    </div>
    <details class="restaurant-picker">
      <summary><span><b>{(selectedRestaurant?.name ?? data.restaurant.name).replace('Чашка кофе — ', '')}</b><small>{selectedRestaurant?.address ?? data.restaurant.address}</small></span></summary>
      <div>{menuRestaurants.map((restaurant) => restaurant.slug === currentSlug
        ? <span class="restaurant-option active" aria-current="page"><b>{restaurant.name.replace('Чашка кофе — ', '')}</b><span>{restaurant.address}</span><i>Выбран</i></span>
        : <a class="restaurant-option" href={`/restaurants/${restaurant.slug}/menu`}><b>{restaurant.name.replace('Чашка кофе — ', '')}</b><span>{restaurant.address}</span></a>)}</div>
    </details>
  </header>
  <div class="menu-layout">
    <aside class="menu-category-nav"><p>Категории</p><nav aria-label="Категории меню">{data.categories.map((category) => <a href={`#${category.slug}`} data-menu-category-link={category.slug}>{category.name}</a>)}</nav></aside>
    <div class="menu-categories">{data.categories.map((category) => <section id={category.slug} class="menu-category" data-menu-category={category.slug}><header><h2>{category.name}</h2></header><div class="menu-items">{category.items.map((item, itemIndex) => {
      const imageUrl = item.imageUrl ?? fallbackImages[itemIndex % fallbackImages.length]
      const badge = badgeLabel(item.marketingBadge)
      const searchValue = [category.name, item.name, item.description, item.ingredients].filter(Boolean).join(' ')
      return <button class="menu-item" type="button" data-menu-item data-menu-search-value={searchValue} data-dish-trigger data-dish={dishPayload(item,category.name,imageUrl)} aria-haspopup="dialog">
        <div class="menu-item-image"><img src={imageUrl} alt="" loading="lazy" />{badge && <span class={`menu-badge menu-badge--${badgeTone(item.marketingBadge)}`}>{badge}</span>}</div>
        <div class="menu-item-copy"><small>{category.name}</small><h3>{item.name}</h3><div><span>{item.weightGrams ? `${item.weightGrams} г` : '1 порция'}</span><strong>{money(item.priceKopecks)}</strong></div></div>
      </button>
    })}</div></section>)}<div class="menu-empty" data-menu-empty hidden><h2>Ничего не нашли</h2><p>Попробуйте другое название или выберите категорию.</p></div></div>
  </div>
  <DishDialog />
</div> : <section class="menu-unavailable"><p>Меню</p><h1>Не удалось загрузить данные.</h1><span>Запустите локальный API и обновите страницу.</span><a href="/restaurants">К ресторанам</a></section>}

<style>
  .menu-page{padding:clamp(14px,1.5vw,24px) 0 clamp(90px,10vw,160px)}.menu-heading{display:flex;align-items:end;justify-content:space-between;gap:42px;padding-bottom:42px;border-bottom:1px solid var(--line)}.menu-heading p,.menu-layout aside>p,.menu-unavailable>p{margin:0;color:#6f902b;font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.menu-heading h1{margin:14px 0 12px;font-size:clamp(44px,5vw,82px);line-height:.88;letter-spacing:-.085em}.menu-heading>div>span{color:var(--muted);font-size:14px}.restaurant-picker{position:relative;z-index:8;width:min(420px,100%)}.restaurant-picker summary{display:flex;min-height:52px;align-items:center;justify-content:space-between;padding:0 20px;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper);cursor:pointer;font-size:12px;font-weight:800;list-style:none}.restaurant-picker summary:after{content:'⌄';font-size:17px}.restaurant-picker[open] summary:after{transform:rotate(180deg)}.restaurant-picker summary::-webkit-details-marker{display:none}.restaurant-picker>div{position:absolute;top:calc(100% + 8px);right:0;left:0;max-height:360px;padding:8px;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper);box-shadow:0 18px 40px rgba(35,30,27,.13);overflow:auto}.restaurant-picker a{display:grid;gap:4px;padding:13px;border-radius:calc(var(--radius) - 8px);text-decoration:none}.restaurant-picker a:hover,.restaurant-picker a.active{background:#e8eddc}.restaurant-picker b{font-size:12px}.restaurant-picker span{color:var(--muted);font-size:10px}.menu-layout{display:grid;grid-template-columns:220px minmax(0,1fr);gap:clamp(38px,6vw,94px);padding-top:60px}.menu-layout aside{position:sticky;top:118px;height:max-content}.menu-layout nav{display:grid;gap:5px;margin-top:20px}.menu-layout nav a{padding:8px 0;color:#57524c;font-size:12px;font-weight:600;text-decoration:none;transition:color .2s,transform .2s,background-color .2s}.menu-layout nav a:hover{color:#6f902b;transform:translateX(4px)}.menu-categories{display:grid;gap:clamp(76px,9vw,132px)}.menu-category{scroll-margin-top:128px}.menu-category>header{display:flex;align-items:end;justify-content:space-between;gap:22px;margin-bottom:24px}.menu-category h2{margin:0;font-size:clamp(34px,4vw,62px);line-height:.91;letter-spacing:-.075em}.menu-category header span{color:var(--muted);font-size:11px}.menu-items{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px}.menu-item{display:grid;grid-template-rows:auto 1fr;width:100%;min-width:0;height:100%;padding:9px;border:1px solid var(--line);border-radius:var(--radius);background:#f7f5f0;color:inherit;cursor:pointer;font:inherit;text-align:left;transition:transform .25s ease,box-shadow .25s ease,background .25s ease}.menu-item:hover{background:#fffdf9;box-shadow:0 16px 34px rgba(50,40,29,.1);transform:translateY(-4px)}.menu-item:focus-visible{outline:3px solid #bddb3d;outline-offset:4px}.menu-item-image{position:relative;align-self:start;width:100%;aspect-ratio:1/.86;overflow:hidden;border-radius:calc(var(--radius) - 5px);background:#ebe7df}.menu-item-image img{width:100%;height:100%;object-fit:cover;transition:transform .45s ease}.menu-item:hover img{transform:scale(1.045)}.menu-badge{position:absolute;top:10px;left:10px;padding:7px 9px;border-radius:var(--radius);font-size:8px;font-weight:900;letter-spacing:.07em;text-transform:uppercase}.menu-badge--hit{background:#ef603f;color:#fff}.menu-badge--new{background:#bddb3d;color:#1f3b2e}.menu-badge--seasonal{background:#f2c86f;color:#503616}.menu-badge--special{background:#7278a9;color:#fff}.menu-item-copy{display:flex;min-width:0;flex-direction:column;padding:15px 4px 3px}.menu-item-copy small{color:#1f3b2e;font-size:8px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.menu-item-copy h3{margin:8px 0 0;font-size:clamp(17px,1.35vw,21px);line-height:1;letter-spacing:-.05em}.menu-item-copy>div{display:flex;align-items:end;justify-content:space-between;gap:10px;margin-top:auto;padding-top:18px}.menu-item-copy>div span{color:var(--muted);font-size:10px}.menu-item-copy strong{font-size:15px}.menu-unavailable{min-height:65svh;padding:clamp(90px,12vw,190px) 0}.menu-unavailable h1{max-width:900px;margin:18px 0;font-size:clamp(45px,6vw,90px);line-height:.9}.menu-unavailable>span{color:var(--muted)}.menu-unavailable a{display:flex;width:max-content;margin-top:30px;padding:15px 20px;border-radius:var(--radius);background:var(--moss);color:#fff;text-decoration:none;font-size:12px;font-weight:800}
  .menu-toolbar{display:grid;grid-template-columns:minmax(300px,1fr) minmax(330px,420px);align-items:stretch;gap:12px;padding-bottom:30px;border-bottom:1px solid var(--line)}
  .menu-search{display:flex;min-width:0;min-height:68px;align-items:center;gap:13px;padding:0 19px;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper);transition:border-color .2s ease,box-shadow .2s ease}
  .menu-search:focus-within{border-color:#8ba23b;box-shadow:0 0 0 3px rgba(139,162,59,.14)}.menu-search svg{flex:0 0 auto;width:20px;height:20px;fill:none;stroke:#6b675f;stroke-linecap:round;stroke-width:1.7}.menu-search input{width:100%;min-width:0;padding:0;border:0;outline:0;background:transparent;color:#25201c;font:inherit;font-size:14px;font-weight:650}.menu-search input::placeholder{color:#8b867e}.menu-search button{display:grid;flex:0 0 auto;place-items:center;width:32px;height:32px;padding:0;border:0;border-radius:50%;background:#ece9e1;color:#4f4a44;font:inherit;font-size:20px;line-height:1;cursor:pointer}.menu-search button[hidden]{display:none}
  .restaurant-picker{width:100%}.restaurant-picker summary{min-height:68px}.restaurant-picker summary>span{display:grid;min-width:0;gap:4px;color:#25201c;font-size:inherit}.restaurant-picker summary>span b{overflow:hidden;font-size:13px;text-overflow:ellipsis;white-space:nowrap}.restaurant-picker summary>span small{overflow:hidden;color:var(--muted);font-size:10px;font-weight:500;text-overflow:ellipsis;white-space:nowrap}.restaurant-picker .restaurant-option{position:relative;display:grid;gap:4px;padding:13px;border-radius:calc(var(--radius) - 8px);color:inherit;text-decoration:none}.restaurant-picker .restaurant-option:hover,.restaurant-picker .restaurant-option.active{background:#e8eddc}.restaurant-picker .restaurant-option.active{padding-right:76px;cursor:default}.restaurant-picker .restaurant-option>span{color:var(--muted);font-size:10px}.restaurant-picker .restaurant-option i{position:absolute;top:50%;right:13px;color:#6f902b;font-size:9px;font-style:normal;font-weight:800;text-transform:uppercase;transform:translateY(-50%)}
  .menu-layout{grid-template-columns:190px minmax(0,1fr);gap:clamp(24px,3vw,42px);padding-top:36px}.menu-category-nav{padding:9px;border:1px solid var(--line);border-radius:18px;background:rgba(252,251,248,.58)}.menu-layout .menu-category-nav>p{padding:10px 12px 13px;font-size:10px}.menu-layout .menu-category-nav nav{gap:2px;margin-top:0;padding-top:8px;border-top:1px solid var(--line)}.menu-layout .menu-category-nav nav a{padding:12px;border-radius:12px;color:#3f3a35;font-size:14px;font-weight:700}.menu-layout .menu-category-nav nav a:hover{background:#e8eddc;color:#27432f;transform:none}.menu-item[hidden],.menu-category[hidden],.menu-category-nav a[hidden]{display:none}.menu-empty{padding:clamp(44px,7vw,84px);border-radius:var(--radius);background:#f1f0e9}.menu-empty h2{margin:0;font-size:clamp(33px,4vw,58px);line-height:.92;letter-spacing:-.07em}.menu-empty p{margin:15px 0 0;color:var(--muted);font-size:14px}.menu-empty[hidden]{display:none}
  @media(max-width:1180px) and (min-width:851px){.menu-items{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:850px){.menu-page{padding:20px 16px 82px}.menu-toolbar{grid-template-columns:1fr;gap:9px;padding-bottom:26px}.menu-search,.restaurant-picker summary{min-height:56px}.restaurant-picker{width:100%}.menu-layout{display:block;padding-top:24px}.menu-layout aside{position:static}.menu-category-nav{padding:9px;border-radius:18px}.menu-layout .menu-category-nav>p{padding:8px 10px 11px}.menu-layout .menu-category-nav nav{display:flex;gap:4px;margin:0;padding:8px 0 0;overflow:auto;white-space:nowrap}.menu-layout .menu-category-nav nav a{padding:10px 12px;border:0;border-radius:12px;background:var(--paper);font-size:12px}.menu-categories{margin-top:40px;gap:64px}.menu-category>header{margin-bottom:18px}.menu-category h2{font-size:clamp(34px,10vw,44px)}.menu-items{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.menu-item{padding:7px;border-radius:18px}.menu-item-image{aspect-ratio:1/.9;border-radius:13px}.menu-badge{top:7px;left:7px;padding:6px 7px;font-size:7px}.menu-item-copy{padding:11px 3px 3px}.menu-item-copy small{font-size:7px}.menu-item-copy h3{margin-top:7px;font-size:15px;line-height:.98;letter-spacing:-.04em}.menu-item-copy>div{gap:5px;padding-top:14px}.menu-item-copy>div span{font-size:9px}.menu-item-copy strong{font-size:13px}.menu-unavailable{padding-inline:20px}}
  @media(prefers-reduced-motion:reduce){.menu-item,.menu-item-image img,.menu-layout nav a{transition:none}}
</style>

<script>
  import { matchesMenuSearch } from '../lib/menu-search'

  document.querySelectorAll<HTMLElement>('[data-restaurant-menu]').forEach((menu) => {
    const input = menu.querySelector<HTMLInputElement>('[data-menu-search]')
    const clearButton = menu.querySelector<HTMLButtonElement>('[data-menu-search-clear]')
    const emptyState = menu.querySelector<HTMLElement>('[data-menu-empty]')
    const categories = [...menu.querySelectorAll<HTMLElement>('[data-menu-category]')]

    const applySearch = () => {
      const query = input?.value ?? ''
      let visibleCategories = 0

      categories.forEach((category) => {
        const items = [...category.querySelectorAll<HTMLButtonElement>('[data-menu-item]')]
        const hasVisibleItems = items.reduce((hasMatch, item) => {
          const matches = matchesMenuSearch(query, [item.dataset.menuSearchValue ?? ''])
          item.hidden = !matches
          return hasMatch || matches
        }, false)

        category.hidden = !hasVisibleItems
        const categoryLink = menu.querySelector<HTMLElement>(`[data-menu-category-link="${category.dataset.menuCategory}"]`)
        if (categoryLink) categoryLink.hidden = !hasVisibleItems
        if (hasVisibleItems) visibleCategories += 1
      })

      if (clearButton) clearButton.hidden = query.length === 0
      if (emptyState) emptyState.hidden = visibleCategories > 0
    }

    input?.addEventListener('input', applySearch)
    clearButton?.addEventListener('click', () => {
      if (!input) return
      input.value = ''
      applySearch()
      input.focus()
    })
  })
</script>
