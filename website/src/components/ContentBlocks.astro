---
import type { ContentBlock } from '@chashka-coffee/contracts'
const { blocks = [] } = Astro.props as { blocks?: ContentBlock[] }
const visible = blocks.filter((block) => block.isVisible)
---
<div class="content-blocks">
  {visible.map((block) => {
    if (block.type === 'TEXT') return <section class="editorial-text"><div>{block.title && <h2>{block.title}</h2>}<p>{block.text}</p></div></section>
    if (block.type === 'IMAGE') return <figure class="editorial-image"><img src={block.imageUrl} alt={block.alt} loading="lazy" />{block.caption && <figcaption>{block.caption}</figcaption>}</figure>
    if (block.type === 'SPLIT') return <section class:list={['editorial-split', { reverse: block.imagePosition === 'LEFT' }]}><div><h2>{block.title}</h2><p>{block.text}</p></div><img src={block.imageUrl} alt={block.alt} loading="lazy" /></section>
    if (block.type === 'GALLERY') return <section class="editorial-gallery">{block.images.map((image) => <figure><img src={image.url} alt={image.alt} loading="lazy" />{image.caption && <figcaption>{image.caption}</figcaption>}</figure>)}</section>
    if (block.type === 'QUOTE') return <blockquote class="editorial-quote"><p>{block.text}</p>{block.attribution && <cite>{block.attribution}</cite>}</blockquote>
    if (block.type === 'VIDEO') return <section class="editorial-video"> <video controls playsinline poster={block.posterUrl ?? undefined} src={block.videoUrl}></video>{block.title && <p>{block.title}</p>}</section>
    return <section class="editorial-cta"><div><h2>{block.title}</h2>{block.text && <p>{block.text}</p>}</div><a class="button button-solid" href={block.url}>{block.label}</a></section>
  })}
</div>

<style>
  .content-blocks{display:grid;gap:var(--section-gap)}.editorial-text{display:grid;min-height:320px;align-items:end;padding:clamp(26px,5vw,76px);border-radius:var(--radius);background:#ebe4d9}.editorial-text>div{max-width:820px}.editorial-text h2,.editorial-split h2,.editorial-cta h2{margin:0 0 18px;font-size:clamp(32px,5vw,74px);line-height:.94;letter-spacing:-.075em}.editorial-text p,.editorial-split p,.editorial-cta p{max-width:720px;margin:0;color:#6f6961;font-size:clamp(16px,1.5vw,22px);line-height:1.55;white-space:pre-line}.editorial-image,.editorial-gallery figure{margin:0}.editorial-image img{width:100%;max-height:780px;border-radius:var(--radius);object-fit:cover}.editorial-image figcaption,.editorial-gallery figcaption{padding-top:9px;color:#817a71;font-size:12px}.editorial-split{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);min-height:520px;overflow:hidden;border-radius:var(--radius);background:#f0ebe4}.editorial-split.reverse>div{order:2}.editorial-split>div{display:flex;justify-content:center;align-items:flex-start;padding:clamp(28px,5vw,78px);flex-direction:column}.editorial-split img{width:100%;height:100%;min-height:430px;object-fit:cover}.editorial-gallery{display:grid;grid-template-columns:repeat(12,1fr);gap:12px}.editorial-gallery figure{grid-column:span 6}.editorial-gallery figure:nth-child(3n){grid-column:span 12}.editorial-gallery img{width:100%;height:clamp(280px,42vw,620px);border-radius:var(--radius);object-fit:cover}.editorial-quote{margin:0;padding:clamp(40px,8vw,120px);border-radius:var(--radius);background:#1f3b2e;color:#f8f4ed}.editorial-quote p{max-width:1100px;margin:0;font-size:clamp(34px,5vw,76px);line-height:1;letter-spacing:-.065em}.editorial-quote cite{display:block;margin-top:32px;color:#bddb3d;font-size:13px;font-style:normal;text-transform:uppercase}.editorial-video video{width:100%;max-height:800px;border-radius:var(--radius);background:#111;object-fit:cover}.editorial-video p{margin:10px 0 0}.editorial-cta{display:flex;min-height:300px;align-items:end;justify-content:space-between;gap:30px;padding:clamp(30px,6vw,88px);border-radius:var(--radius);background:#bddb3d;color:#1f3b2e}.editorial-cta h2{max-width:900px}.editorial-cta p{color:inherit}@media(max-width:760px){.editorial-split{grid-template-columns:1fr}.editorial-split.reverse>div{order:0}.editorial-split img{min-height:280px}.editorial-gallery figure,.editorial-gallery figure:nth-child(3n){grid-column:span 12}.editorial-cta{align-items:flex-start;flex-direction:column}}
</style>
