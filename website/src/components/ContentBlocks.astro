---
import { sanitizeRichText, type ContentBlock } from '@chashka-coffee/contracts'
const { blocks = [] } = Astro.props as { blocks?: ContentBlock[] }
const visible = blocks.filter((block) => block.isVisible)
const variantClass = (prefix: string, value: string) => `${prefix}-${value.toLowerCase().replaceAll('_', '-')}`
const headingTag = (level?: 'H1' | 'H2' | 'H3' | 'H4' | 'H5' | 'H6') => (level ?? 'H2').toLowerCase() as 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6'
---
<div class="content-blocks">
  {visible.map((block) => {
    if (block.type === 'TEXT') { const Heading = headingTag(block.titleLevel); return <section class:list={['editorial-text', variantClass('editorial-text', block.layout ?? 'STANDARD'), variantClass('editorial-copy', block.textSize ?? 'NORMAL')]}><div>{block.title && <Heading>{block.title}</Heading>}<div class="editorial-rich-text" set:html={sanitizeRichText(block.text)}></div></div></section> }
    if (block.type === 'IMAGE') return <figure class:list={['editorial-image', variantClass('editorial-image', block.layout ?? 'WIDE')]}><img src={block.imageUrl} alt={block.alt} loading="lazy" />{block.caption && <figcaption>{block.caption}</figcaption>}</figure>
    if (block.type === 'SPLIT') { const Heading = headingTag(block.titleLevel); return <section class:list={['editorial-split', variantClass('editorial-split', block.layout ?? 'BALANCED'), variantClass('editorial-copy', block.textSize ?? 'NORMAL'), { reverse: block.imagePosition === 'LEFT' }]}><div><Heading>{block.title}</Heading><div class="editorial-rich-text" set:html={sanitizeRichText(block.text)}></div></div><img src={block.imageUrl} alt={block.alt} loading="lazy" /></section> }
    if (block.type === 'GALLERY') return <section class:list={['editorial-gallery', `editorial-gallery-${(block.layout ?? 'MOSAIC').toLowerCase()}`]}>{block.images.map((image) => <figure><img src={image.url} alt={image.alt} loading="lazy" />{image.caption && <figcaption>{image.caption}</figcaption>}</figure>)}</section>
    if (block.type === 'QUOTE') return <blockquote class:list={['editorial-quote', variantClass('editorial-quote', block.style ?? 'DARK'), variantClass('editorial-copy', block.textSize ?? 'NORMAL')]}><div class="editorial-rich-text" set:html={sanitizeRichText(block.text)}></div>{block.attribution && <cite>{block.attribution}</cite>}</blockquote>
    if (block.type === 'VIDEO') return <section class:list={['editorial-video', variantClass('editorial-video', block.layout ?? 'WIDE')]}> <video controls playsinline poster={block.posterUrl ?? undefined} src={block.videoUrl}></video>{block.title && <p>{block.title}</p>}</section>
    const Heading = headingTag(block.titleLevel); return <section class:list={['editorial-cta', variantClass('editorial-cta', block.style ?? 'ACCENT'), variantClass('editorial-copy', block.textSize ?? 'NORMAL')]}><div><Heading>{block.title}</Heading>{block.text && <div class="editorial-rich-text" set:html={sanitizeRichText(block.text)}></div>}</div><a class="button button-solid" href={block.url}>{block.label}</a></section>
  })}
</div>

<style>
  .content-blocks{display:grid;gap:var(--section-gap)}.editorial-text{display:grid;min-height:320px;align-items:end;padding:clamp(26px,5vw,76px);border-radius:var(--radius);background:#ebe4d9}.editorial-text>div{max-width:820px}.editorial-text h2,.editorial-split h2,.editorial-cta h2{margin:0 0 18px;font-size:clamp(32px,5vw,74px);line-height:.94;letter-spacing:-.075em}.editorial-text p,.editorial-split p,.editorial-cta p{max-width:720px;margin:0;color:#6f6961;font-size:clamp(16px,1.5vw,22px);line-height:1.55;white-space:pre-line}.editorial-text-lead{min-height:0;border-block:1px solid #d8d0c6;border-radius:0;background:transparent;padding-block:clamp(38px,7vw,96px)}.editorial-text-lead>div{max-width:1050px}.editorial-text-lead p{font-size:clamp(19px,2.2vw,34px);line-height:1.38}.editorial-text-columns{align-items:start}.editorial-text-columns>div{display:grid;grid-template-columns:minmax(220px,.75fr) minmax(0,1.25fr);align-items:start;max-width:none;gap:clamp(28px,6vw,96px)}.editorial-text-columns>div>:is(h1,h2,h3,h4,h5,h6){position:sticky;top:118px;margin:0}.editorial-image,.editorial-gallery figure{margin:0}.editorial-image img{width:100%;max-height:780px;border-radius:var(--radius);object-fit:cover}.editorial-image-inset{width:min(100%,1100px);margin-inline:auto}.editorial-image-portrait{width:min(100%,760px);margin-inline:auto}.editorial-image-portrait img{max-height:none;aspect-ratio:4/5}.editorial-image figcaption,.editorial-gallery figcaption{padding-top:9px;color:#817a71;font-size:12px}.editorial-split{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);min-height:520px;overflow:hidden;border-radius:var(--radius);background:#f0ebe4}.editorial-split-media-wide{grid-template-columns:minmax(0,.72fr) minmax(0,1.28fr)}.editorial-split-media-wide.reverse{grid-template-columns:minmax(0,1.28fr) minmax(0,.72fr)}.editorial-split-text-wide{grid-template-columns:minmax(0,1.28fr) minmax(0,.72fr)}.editorial-split-text-wide.reverse{grid-template-columns:minmax(0,.72fr) minmax(0,1.28fr)}.editorial-split.reverse>div{order:2}.editorial-split>div{display:flex;justify-content:center;align-items:flex-start;padding:clamp(28px,5vw,78px);flex-direction:column}.editorial-split img{width:100%;height:100%;min-height:430px;object-fit:cover}.editorial-gallery{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:12px}.editorial-gallery figure{grid-column:span 6}.editorial-gallery img{width:100%;height:clamp(280px,42vw,620px);border-radius:var(--radius);object-fit:cover}.editorial-gallery-mosaic figure:nth-child(3n){grid-column:span 12}.editorial-gallery-grid figure{grid-column:span 4}.editorial-gallery-grid img{height:clamp(260px,30vw,460px)}.editorial-gallery-featured figure:first-child{grid-column:span 8;grid-row:span 2}.editorial-gallery-featured figure:not(:first-child){grid-column:span 4}.editorial-gallery-featured figure:first-child img{height:100%;min-height:clamp(560px,70vw,900px)}.editorial-gallery-featured figure:not(:first-child) img{height:clamp(270px,34vw,440px)}.editorial-gallery-carousel{display:flex;overflow-x:auto;padding-bottom:12px;scroll-snap-type:x mandatory;scrollbar-width:thin}.editorial-gallery-carousel figure{flex:0 0 min(76vw,760px);scroll-snap-align:start}.editorial-gallery-carousel img{height:clamp(330px,48vw,650px)}.editorial-quote{margin:0;padding:clamp(40px,8vw,120px);border-radius:var(--radius);background:#1f3b2e;color:#f8f4ed}.editorial-quote-light{background:#ebe4d9;color:#1f3b2e}.editorial-quote-accent{background:#bddb3d;color:#1f3b2e}.editorial-quote-light cite,.editorial-quote-accent cite{color:#58711e}.editorial-quote p{max-width:1100px;margin:0;font-size:clamp(34px,5vw,76px);line-height:1;letter-spacing:-.065em}.editorial-quote cite{display:block;margin-top:32px;color:#bddb3d;font-size:13px;font-style:normal;text-transform:uppercase}.editorial-video video{width:100%;max-height:800px;border-radius:var(--radius);background:#111;object-fit:cover}.editorial-video-inset{width:min(100%,1100px);margin-inline:auto}.editorial-video-cinema{border-radius:var(--radius);background:#151515;padding:clamp(14px,2.5vw,32px);color:#f8f4ed}.editorial-video-cinema video{aspect-ratio:16/9;border-radius:calc(var(--radius) - 8px)}.editorial-video p{margin:10px 0 0}.editorial-cta{display:flex;min-height:300px;align-items:end;justify-content:space-between;gap:30px;padding:clamp(30px,6vw,88px);border-radius:var(--radius);background:#bddb3d;color:#1f3b2e}.editorial-cta .button{flex:0 0 auto;padding:0 23px}.editorial-cta-dark{background:#1f3b2e;color:#f8f4ed}.editorial-cta-light{background:#ebe4d9;color:#1f3b2e}.editorial-cta-dark .button{background:#f8f4ed;color:#1f3b2e}.editorial-cta h2{max-width:900px}.editorial-cta p{color:inherit}@media(max-width:760px){.editorial-text-columns>div{grid-template-columns:1fr;gap:18px}.editorial-text-columns>div>:is(h1,h2,h3,h4,h5,h6){position:static}.editorial-split,.editorial-split-media-wide,.editorial-split-media-wide.reverse,.editorial-split-text-wide,.editorial-split-text-wide.reverse{grid-template-columns:1fr}.editorial-split.reverse>div{order:0}.editorial-split img{min-height:280px}.editorial-gallery:not(.editorial-gallery-carousel) figure,.editorial-gallery-mosaic figure:nth-child(3n),.editorial-gallery-featured figure:first-child,.editorial-gallery-featured figure:not(:first-child){grid-column:span 12;grid-row:auto}.editorial-gallery img,.editorial-gallery-featured figure:first-child img,.editorial-gallery-featured figure:not(:first-child) img{height:clamp(250px,82vw,440px);min-height:0}.editorial-gallery-carousel figure{flex-basis:88vw}.editorial-cta{align-items:flex-start;flex-direction:column}.editorial-cta .button{width:100%}}
</style>

<style>
  .editorial-text :is(h1,h2,h3,h4,h5,h6),
  .editorial-split > div > :is(h1,h2,h3,h4,h5,h6),
  .editorial-cta > div > :is(h1,h2,h3,h4,h5,h6) { margin: 0 0 18px; font-size: clamp(32px,5vw,74px); line-height: .94; letter-spacing: -.075em; }
  .editorial-rich-text { max-width: 720px; color: #6f6961; line-height: 1.55; overflow-wrap: anywhere; }
  .content-blocks .editorial-rich-text :where(p,ul,ol,li,table,blockquote,div) { color: inherit; font-size: inherit; line-height: inherit; }
  .editorial-copy-small .editorial-rich-text { font-size: clamp(14px,1vw,16px); }
  .editorial-copy-normal .editorial-rich-text { font-size: clamp(16px,1.25vw,20px); }
  .editorial-copy-large .editorial-rich-text { font-size: clamp(19px,1.65vw,26px); line-height: 1.48; }
  .editorial-text-lead .editorial-rich-text { max-width: 1050px; line-height: 1.4; }
  .editorial-text-lead { border-block: 0; }
  .editorial-text-lead.editorial-copy-small .editorial-rich-text { font-size: clamp(16px,1.4vw,21px); }
  .editorial-text-lead.editorial-copy-normal .editorial-rich-text { font-size: clamp(19px,1.8vw,28px); }
  .editorial-text-lead.editorial-copy-large .editorial-rich-text { font-size: clamp(23px,2.3vw,36px); }
  .editorial-quote .editorial-rich-text { max-width: 1100px; color: inherit; line-height: 1.04; letter-spacing: -.045em; }
  .editorial-quote.editorial-copy-small .editorial-rich-text { font-size: clamp(24px,2.8vw,42px); }
  .editorial-quote.editorial-copy-normal .editorial-rich-text { font-size: clamp(30px,3.8vw,58px); }
  .editorial-quote.editorial-copy-large .editorial-rich-text { font-size: clamp(38px,5vw,78px); }
  .editorial-cta .editorial-rich-text { color: inherit; }
  .editorial-rich-text > :first-child { margin-top: 0; }
  .editorial-rich-text > :last-child { margin-bottom: 0; }
  .editorial-rich-text p,
  .editorial-rich-text ul,
  .editorial-rich-text ol,
  .editorial-rich-text table,
  .editorial-rich-text blockquote { margin: 0 0 1em; }
  .editorial-rich-text ul,
  .editorial-rich-text ol { margin-left: -1.15em; padding-left: 1.15em; list-style-position: outside; }
  .editorial-rich-text ul { list-style-type: disc; }
  .editorial-rich-text ol { list-style-type: decimal; }
  .editorial-rich-text li + li { margin-top: .35em; }
  .editorial-rich-text a { color: inherit; text-decoration-thickness: .08em; text-underline-offset: .18em; }
  .editorial-rich-text :is(h1,h2,h3,h4,h5,h6) { margin: 1.25em 0 .45em; color: inherit; line-height: 1.05; letter-spacing: -.045em; }
  .editorial-rich-text h1 { font-size: 2.15em; }
  .editorial-rich-text h2 { font-size: 1.8em; }
  .editorial-rich-text h3 { font-size: 1.5em; }
  .editorial-rich-text h4 { font-size: 1.28em; }
  .editorial-rich-text h5 { font-size: 1.1em; }
  .editorial-rich-text h6 { font-size: 1em; text-transform: uppercase; letter-spacing: .05em; }
  .editorial-rich-text table { display: block; width: 100%; max-width: 100%; overflow-x: auto; border-collapse: collapse; font-size: .78em; }
  .editorial-rich-text th,
  .editorial-rich-text td { min-width: 8rem; border: 1px solid currentColor; padding: .65em .75em; text-align: left; }
  .editorial-rich-text th { font-weight: 750; }
  .editorial-rich-text blockquote { border-left: 3px solid currentColor; padding-left: 1em; }
</style>
