<dialog class="job-dialog" data-job-dialog aria-labelledby="job-dialog-title">
  <div class="job-dialog-inner">
    <button class="job-dialog-close" type="button" data-job-close aria-label="Закрыть вакансию"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19" /></svg></button>
    <aside class="job-dialog-aside">
      <span>Чашка кофе</span>
      <p>Место, где тебя знают по имени.</p>
      <i aria-hidden="true">✦</i>
    </aside>
    <div class="job-dialog-content">
      <p data-job-place></p>
      <h2 id="job-dialog-title" data-job-title></h2>
      <strong data-job-terms></strong>
      <div class="job-dialog-description" data-job-description></div>
      <button class="job-dialog-apply" type="button" data-job-apply>Откликнуться <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6" /></svg></span></button>
    </div>
  </div>
</dialog>

<script>
  type JobPayload = { slug: string; title: string; place: string; terms: string; description: string }
  const jobDialog = document.querySelector<HTMLDialogElement>('[data-job-dialog]')
  let selectedJob = ''
  const setJobText = (selector: string, value: string) => {
    const element = jobDialog?.querySelector<HTMLElement>(selector)
    if (element) element.textContent = value
  }
  document.querySelectorAll<HTMLButtonElement>('[data-job-trigger]').forEach((trigger) => trigger.addEventListener('click', () => {
    try {
      const payload = JSON.parse(trigger.dataset.job ?? '') as JobPayload
      selectedJob = payload.title
      setJobText('[data-job-place]', payload.place)
      setJobText('[data-job-title]', payload.title)
      setJobText('[data-job-terms]', payload.terms)
      setJobText('[data-job-description]', payload.description)
      jobDialog?.showModal()
      jobDialog?.querySelector<HTMLButtonElement>('[data-job-close]')?.focus()
    } catch { /* A malformed editorial payload must not break the vacancy list. */ }
  }))
  jobDialog?.querySelector('[data-job-close]')?.addEventListener('click', () => jobDialog.close())
  jobDialog?.addEventListener('click', (event) => { if (event.target === jobDialog) jobDialog.close() })
  jobDialog?.querySelector('[data-job-apply]')?.addEventListener('click', () => {
    jobDialog.close()
    window.dispatchEvent(new CustomEvent('jobs:apply', { detail: { title: selectedJob } }))
  })
</script>

<style>
  .job-dialog{width:min(980px,calc(100vw - 48px));max-width:none;max-height:calc(100svh - 48px);margin:auto;padding:0;border:0;border-radius:var(--radius);background:#fcfbf8;color:var(--ink);box-shadow:0 28px 90px rgba(22,28,22,.3);overflow:hidden}.job-dialog::backdrop{background:rgba(25,31,25,.6);backdrop-filter:blur(7px)}.job-dialog[open]{animation:job-dialog-in .3s cubic-bezier(.22,1,.36,1)}@keyframes job-dialog-in{from{opacity:0;transform:translateY(18px) scale(.985)}to{opacity:1;transform:none}}
  .job-dialog-inner{display:grid;min-height:610px;grid-template-columns:minmax(260px,.72fr) minmax(0,1.28fr)}.job-dialog-close{position:absolute;z-index:3;top:19px;right:19px;display:grid;place-items:center;width:46px;height:46px;padding:0;border:1px solid rgba(35,30,27,.11);border-radius:var(--radius);background:rgba(252,251,248,.94);color:var(--ink);cursor:pointer;transition:background-color .2s ease,transform .2s ease}.job-dialog-close:hover{background:var(--lime);transform:rotate(4deg)}.job-dialog-close:focus-visible{outline:3px solid var(--lime);outline-offset:3px}.job-dialog-close svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-width:1.8}
  .job-dialog-aside{display:flex;padding:clamp(32px,4vw,58px);background:var(--moss);color:#fff;flex-direction:column}.job-dialog-aside span{font-family:'21Cent',serif;font-size:clamp(35px,4vw,58px);font-style:italic;line-height:.8}.job-dialog-aside p{max-width:250px;margin:auto 0 0;color:#d6e0d7;font-size:17px;font-weight:650;line-height:1.35}.job-dialog-aside i{margin-top:30px;color:var(--lime);font-size:32px;font-style:normal}.job-dialog-content{display:flex;min-height:0;padding:clamp(45px,6vw,84px);overflow:auto;flex-direction:column}.job-dialog-content>p{margin:0;padding-right:45px;color:var(--muted);font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.job-dialog-content h2{margin:17px 0 12px;font-size:clamp(43px,5vw,76px);line-height:.88;letter-spacing:-.08em}.job-dialog-content>strong{font-size:13px}.job-dialog-description{margin:34px 0 40px;padding-top:28px;border-top:1px solid var(--line);color:var(--muted);font-size:13px;line-height:1.72;white-space:pre-line}.job-dialog-apply{display:flex;width:100%;min-height:58px;align-items:center;justify-content:space-between;margin-top:auto;padding:0 12px 0 21px;border:0;border-radius:var(--radius);background:var(--lime);color:var(--moss);cursor:pointer;font-size:12px;font-weight:800}.job-dialog-apply span{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--moss);color:#fff;transition:transform .2s ease}.job-dialog-apply span svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.8}.job-dialog-apply:hover span{transform:translateX(3px)}.job-dialog-apply:focus-visible{outline:3px solid var(--moss);outline-offset:3px}
  @media(max-width:700px){.job-dialog{position:fixed;inset:auto 12px 12px;width:auto;max-height:calc(100svh - 24px);margin:0}.job-dialog-inner{display:block;min-height:0;max-height:calc(100svh - 24px);overflow:auto}.job-dialog-aside{min-height:145px;padding:27px}.job-dialog-aside span{font-size:38px}.job-dialog-aside p{margin:32px 0 0;font-size:13px}.job-dialog-aside i{display:none}.job-dialog-content{padding:33px 22px 24px;overflow:visible}.job-dialog-content h2{font-size:48px}.job-dialog-description{margin:25px 0 30px;padding-top:22px;font-size:12px}.job-dialog-close{top:14px;right:14px;width:42px;height:42px}}
  @media(prefers-reduced-motion:reduce){.job-dialog[open]{animation:none}.job-dialog-close,.job-dialog-apply span{transition:none}}
</style>
