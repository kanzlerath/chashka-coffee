---
import { APP_DOWNLOAD_URL } from '../lib/app-links'
---

<div class="store-badges"><a href={APP_DOWNLOAD_URL} aria-label="Открыть приложение в App Store"><img src="/brand-badges/app-store.svg" alt="Download on the App Store" /></a><a href={APP_DOWNLOAD_URL} aria-label="Открыть приложение в Google Play"><img src="/brand-badges/google-play.svg" alt="Get it on Google Play" /></a></div>
<style>.store-badges{display:flex;flex-wrap:wrap;align-items:center;gap:10px}.store-badges a{display:block;transition:opacity .2s,transform .2s}.store-badges a:hover{opacity:.84;transform:translateY(-2px)}.store-badges img{display:block;width:auto;height:44px}@media(max-width:520px){.store-badges img{height:39px}}</style>
