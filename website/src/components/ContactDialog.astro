---
import { FOOTER_QUESTION_LEAD_SOURCE } from '@chashka-coffee/contracts'
import LeadForm from './LeadForm.astro'
---

<dialog id="site-contact-dialog" class="contact-dialog" data-contact-dialog aria-labelledby="contact-dialog-title">
  <div class="contact-dialog-inner">
    <button class="contact-dialog-close" type="button" data-contact-dialog-close aria-label="Закрыть форму">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19" /></svg>
    </button>
    <div class="contact-dialog-copy">
      <img src="/brand/logo.png" alt="" width="64" height="64" />
      <h2 id="contact-dialog-title">Есть вопрос<br />или идея?</h2>
      <span>Напишите нам — ответим или передадим предложение нужной команде.</span>
    </div>
    <div class="contact-dialog-form">
      <LeadForm type="CONTACT" source={FOOTER_QUESTION_LEAD_SOURCE} submitLabel="Отправить" />
    </div>
  </div>
</dialog>

<script>
  document.querySelectorAll<HTMLDialogElement>('[data-contact-dialog]').forEach((dialog) => {
    const closeButton = dialog.querySelector<HTMLButtonElement>('[data-contact-dialog-close]')
    let opener: HTMLElement | null = null

    document.querySelectorAll<HTMLElement>('[data-contact-dialog-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        opener = trigger
        dialog.showModal()
        dialog.querySelector<HTMLInputElement>('input[name="name"]')?.focus()
      })
    })

    closeButton?.addEventListener('click', () => dialog.close())
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close()
    })
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault()
        dialog.close()
      }
    })
    dialog.addEventListener('close', () => opener?.focus())
  })
</script>

<style>
  .contact-dialog{width:min(1100px,calc(100vw - 48px));max-width:none;max-height:calc(100svh - 48px);margin:auto;padding:0;border:0;border-radius:var(--radius);background:#fcfbf8;color:var(--ink);box-shadow:0 28px 90px rgba(22,28,22,.32);overflow:hidden}
  .contact-dialog::backdrop{background:rgba(25,31,25,.64);backdrop-filter:blur(8px)}
  .contact-dialog[open]{animation:contact-dialog-in .3s cubic-bezier(.22,1,.36,1)}
  @keyframes contact-dialog-in{from{opacity:0;transform:translateY(18px) scale(.985)}to{opacity:1;transform:none}}
  .contact-dialog-inner{position:relative;display:grid;min-height:650px;grid-template-columns:minmax(310px,.85fr) minmax(0,1.15fr)}
  .contact-dialog-copy{display:flex;padding:clamp(38px,5vw,76px);background:var(--moss);color:#fff;flex-direction:column}.contact-dialog-copy>img{width:64px;height:64px;object-fit:contain}
  .contact-dialog-copy h2{margin:auto 0 0;color:#fff;font-size:clamp(46px,4.7vw,74px);line-height:.88;letter-spacing:-.08em}.contact-dialog-copy span{max-width:390px;margin-top:24px;color:#d3ddd4;font-size:13px;line-height:1.68}
  .contact-dialog-form{display:flex;align-items:center;padding:clamp(56px,6vw,92px)}.contact-dialog-form :global(.lead-form){width:100%}
  .contact-dialog-close{position:absolute;z-index:2;top:19px;right:19px;display:grid;place-items:center;width:46px;height:46px;padding:0;border:1px solid rgba(35,30,27,.11);border-radius:var(--radius);background:rgba(252,251,248,.94);color:var(--ink);cursor:pointer;transition:background-color .2s ease,transform .2s ease}
  .contact-dialog-close:hover{background:var(--lime);transform:rotate(4deg)}.contact-dialog-close:focus-visible{outline:3px solid var(--lime);outline-offset:3px}.contact-dialog-close svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-width:1.8}
  .contact-dialog-form :global(.lead-form button){display:flex!important;width:100%;min-height:58px!important;justify-content:space-between!important;padding:0 10px 0 21px!important;background:var(--moss)!important;color:#fff;transition:background-color .2s ease,transform .2s ease}.contact-dialog-form :global(.lead-form button b){display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--lime);color:var(--moss)}
  .contact-dialog-form :global(.lead-form button:hover){background:#315b45!important;transform:translateY(-2px)}.contact-dialog-form :global(.lead-form input:focus),.contact-dialog-form :global(.lead-form textarea:focus){outline:3px solid rgba(189,219,61,.55);outline-offset:1px;border-color:#79942d}
  @media(max-width:720px){
    .contact-dialog{position:fixed;inset:auto 12px 12px;width:auto;max-height:calc(100svh - 24px);margin:0}
    .contact-dialog-inner{display:block;min-height:0;max-height:calc(100svh - 24px);overflow:auto}
    .contact-dialog-copy{min-height:310px;padding:34px 24px}.contact-dialog-copy>img{width:52px;height:52px}.contact-dialog-copy h2{margin:auto 0 0;font-size:52px}.contact-dialog-copy span{max-width:285px;margin-top:20px;font-size:12px}
    .contact-dialog-form{padding:34px 22px 28px}
    .contact-dialog-close{top:14px;right:14px;width:42px;height:42px}
  }
  @media(prefers-reduced-motion:reduce){.contact-dialog[open]{animation:none}.contact-dialog-close,.contact-dialog-form :global(.lead-form button){transition:none}}
</style>
