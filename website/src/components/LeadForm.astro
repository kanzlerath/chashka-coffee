---
interface Props {
  type: 'CONTACT' | 'RESERVATION' | 'FRANCHISE' | 'BANQUET' | 'CAKE' | 'JOB'
  submitLabel?: string
  subjectLabel?: string
  subjectValue?: string
  source?: string
  metadata?: Record<string, string>
}
const { type, submitLabel = 'Отправить заявку', subjectLabel, subjectValue, source, metadata } = Astro.props
---
<form class="lead-form" data-lead-form data-lead-type={type} data-lead-source={source} data-lead-metadata={JSON.stringify(metadata ?? {})} novalidate>
  <label>Ваше имя<input name="name" autocomplete="name" required placeholder="Как к вам обращаться" /></label>
  <label>Телефон<input name="phone" type="tel" autocomplete="tel" inputmode="tel" required placeholder="+7 (999) 000-00-00" /></label>
  <label>E-mail<input name="email" autocomplete="email" type="email" placeholder="name@mail.ru" /></label>
  {subjectLabel && <label>{subjectLabel}<input name="subject" placeholder={subjectLabel} value={subjectValue} /></label>}
  <label class="lead-form-message">Комментарий<textarea name="message" placeholder="Расскажите, чем помочь"></textarea></label>
  <label class="lead-form-consent"><input name="privacyAccepted" type="checkbox" required /><span>Даю <a href="/consent" target="_blank">согласие на обработку персональных данных</a> и ознакомлен(а) с <a href="/privacy" target="_blank">политикой</a>.</span></label>
  <button type="submit">{submitLabel} <b><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg></b></button>
  <p class="lead-form-status" aria-live="polite"></p>
</form>
<script>
  import { attachRussianPhoneMask } from '../lib/contact-fields'
  import { PUBLIC_FORM_SUCCESS_EVENT } from '../lib/form-success'

  const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3000'
  document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach((form) => {
    const phoneInput = form.elements.namedItem('phone')
    if (phoneInput instanceof HTMLInputElement) attachRussianPhoneMask(phoneInput)
    const status = form.querySelector<HTMLElement>('.lead-form-status')
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')
    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (!form.reportValidity()) return
      const values = new FormData(form)
      const subject = String(values.get('subject') ?? '').trim()
      const source = form.dataset.leadSource?.trim()
      let initialMetadata: Record<string, string> = {}
      try {
        const parsed = JSON.parse(form.dataset.leadMetadata ?? '{}')
        if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
          initialMetadata = Object.fromEntries(Object.entries(parsed).filter((entry): entry is [string, string] => typeof entry[1] === 'string' && entry[1].trim().length > 0))
        }
      } catch { /* A malformed optional data attribute must not block the form. */ }
      const metadata = { ...initialMetadata, ...(source ? { source } : {}), ...(subject ? { subject } : {}) }
      const payload = {
        type: form.dataset.leadType,
        name: String(values.get('name') ?? '').trim(),
        phone: String(values.get('phone') ?? '').trim() || null,
        email: String(values.get('email') ?? '').trim() || null,
        message: String(values.get('message') ?? '').trim() || null,
        metadata: Object.keys(metadata).length ? metadata : null,
        privacyAccepted: values.get('privacyAccepted') === 'on',
      }
      if (button) button.disabled = true
      if (status) status.textContent = 'Отправляем…'
      try {
        const response = await fetch(`${apiUrl}/api/leads`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })
        if (!response.ok) throw new Error('Lead request failed')
        form.reset()
        if (status) status.textContent = 'Заявка принята.'
        document.dispatchEvent(new CustomEvent(PUBLIC_FORM_SUCCESS_EVENT, { detail: { type: form.dataset.leadType, source, form } }))
      } catch {
        if (status) status.textContent = 'Не удалось отправить заявку. Позвоните нам или попробуйте ещё раз.'
      } finally {
        if (button) button.disabled = false
      }
    })
  })
</script>
<style>
  .lead-form{display:grid;grid-template-columns:1fr 1fr;gap:10px}.lead-form label{display:grid;gap:6px;font:600 11px Montserrat,Arial,sans-serif}.lead-form input,.lead-form textarea{width:100%;border:1px solid rgba(32,56,43,.22);border-radius:10px;padding:14px;background:#fff;color:#20251f;font:14px Montserrat,Arial,sans-serif}.lead-form textarea{min-height:104px;resize:vertical}.lead-form-message,.lead-form-consent,.lead-form button,.lead-form-status{grid-column:1/-1}.lead-form .lead-form-consent{display:flex;margin:5px 0;align-items:flex-start;gap:10px;color:rgba(32,56,43,.72);font-size:10px;line-height:1.5}.lead-form-consent input{flex:0 0 auto;width:18px;height:18px;margin:1px 0 0;padding:0;accent-color:#20382b}.lead-form-consent a{color:inherit;text-underline-offset:2px}.lead-form button{justify-self:start;border:0;border-radius:99px;padding:16px 20px;background:#b9dc3d;color:#20382b;font:800 12px Montserrat,Arial,sans-serif;cursor:pointer}.lead-form button svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.8}.lead-form button:disabled{opacity:.55;cursor:wait}.lead-form-status{min-height:18px;margin:0;font:600 12px Montserrat,Arial,sans-serif}@media(max-width:600px){.lead-form{grid-template-columns:1fr}.lead-form-message,.lead-form-consent,.lead-form button,.lead-form-status{grid-column:auto}}
</style>
