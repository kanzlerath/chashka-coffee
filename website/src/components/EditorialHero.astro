---
interface Props {
  title: string
  image: string
  alt: string
  description: string
  eyebrow?: string
  actionLabel?: string
  actionHref?: string
}

const { title, image, alt, description, eyebrow, actionLabel, actionHref } = Astro.props
const [scriptLine, ...mainLines] = title.split(/\r?\n/).filter(Boolean)
---

<section class="editorial-hero">
  <img src={image} alt={alt} fetchpriority="high" />
  <div class="editorial-hero-shade" aria-hidden="true"></div>
  <div class="editorial-hero-copy">
    <h1>
      <span class="editorial-hero-script">{scriptLine}</span>
      {mainLines.length > 0 && <span class="editorial-hero-main">{mainLines.join(' ')}</span>}
    </h1>
    {eyebrow && <p class="editorial-hero-eyebrow">{eyebrow}</p>}
    <p class="editorial-hero-description">{description}</p>
    {actionLabel && actionHref && <a href={actionHref}>{actionLabel}</a>}
  </div>
</section>

<style>
  .editorial-hero{position:relative;isolation:isolate;min-height:calc(100svh - 126px);overflow:hidden;border-radius:var(--radius);background:var(--moss);color:#fff}
  .editorial-hero>img,.editorial-hero-shade{position:absolute;inset:0;width:100%;height:100%}
  .editorial-hero>img{z-index:-2;object-fit:cover;animation:editorial-hero-image-in 1.1s cubic-bezier(.22,1,.36,1) both}
  .editorial-hero-shade{z-index:-1;background:linear-gradient(90deg,rgba(14,25,19,.69) 0%,rgba(14,25,19,.32) 47%,rgba(14,25,19,.04) 76%),linear-gradient(0deg,rgba(14,25,19,.52) 0%,transparent 48%)}
  .editorial-hero-copy{position:absolute;right:clamp(28px,3.5vw,58px);bottom:clamp(28px,3.5vw,58px);left:clamp(28px,3.5vw,58px);max-width:790px;animation:editorial-hero-copy-in .68s .12s cubic-bezier(.22,1,.36,1) both}
  .editorial-hero h1{max-width:760px!important;margin:0;color:#fff!important;font-size:clamp(58px,6.8vw,118px)!important;line-height:.77!important;letter-spacing:-.095em!important;text-shadow:0 2px 18px rgba(0,0,0,.12)}
  .editorial-hero-script,.editorial-hero-main{display:block}.editorial-hero-script{font-family:'21Cent',serif;font-size:1.04em;font-style:italic;font-weight:400;letter-spacing:-.045em;line-height:.72}.editorial-hero-main{margin-top:.13em;font-size:.77em;font-weight:800;letter-spacing:-.095em;line-height:.83}
  .editorial-hero-eyebrow{margin:17px 0 0;color:var(--lime);font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}
  .editorial-hero-description{max-width:570px;margin:11px 0 0;color:rgba(255,255,255,.9);font-size:14px;line-height:1.5}
  .editorial-hero a{display:inline-flex;min-height:46px;align-items:center;margin-top:22px;padding:0 21px;border:1px solid #fff;border-radius:var(--radius);background:#fff;color:var(--moss);font-size:12px;font-weight:800;text-decoration:none;transition:border-color .2s ease,background-color .2s ease,transform .2s ease}
  .editorial-hero a:hover{border-color:var(--lime);background:var(--lime);transform:translateY(-2px)}.editorial-hero a:focus-visible{outline:3px solid var(--lime);outline-offset:3px}
  @keyframes editorial-hero-image-in{from{opacity:.72;transform:scale(1.04)}to{opacity:1;transform:scale(1)}}
  @keyframes editorial-hero-copy-in{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
  @media(max-width:980px){.editorial-hero{min-height:calc(100svh - 116px);margin:0 var(--mobile-gutter)}.editorial-hero-copy{right:24px;bottom:24px;left:24px}.editorial-hero h1{max-width:390px!important;font-size:clamp(57px,16vw,78px)!important}.editorial-hero-description{max-width:320px;font-size:13px}}
  @media(prefers-reduced-motion:reduce){.editorial-hero>img,.editorial-hero-copy{animation:none}}
</style>
