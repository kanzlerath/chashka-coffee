---
import PageShell from '../layouts/PageShell.astro'
import { LEGAL_SUPPORT_EMAIL, getLegalDocument, type LegalSection } from '../lib/legal-documents'

interface Props {
  href: string
  intro: string
  sections: LegalSection[]
  related?: string[]
}

const { href, intro, sections, related = ['/privacy', '/consent', '/terms'] } = Astro.props
const document = getLegalDocument(href)
const relatedDocuments = related
  .filter((relatedHref) => relatedHref !== href)
  .map(getLegalDocument)
---

<PageShell title={document.shortTitle} description={`${document.title}. Чашка кофе.`} active="about">
  <header class="legal-hero">
    <div class="legal-hero-topline">
      <span>Документ {document.number}</span>
      <a href="/legal">Все документы</a>
    </div>
    <div class="legal-hero-copy">
      <p>Юридическая информация</p>
      <h1>{document.title}</h1>
      <span>{intro}</span>
    </div>
    <dl>
      <div><dt>Редакция</dt><dd>{document.effectiveDate}</dd></div>
      <div><dt>Контакт</dt><dd><a href={`mailto:${LEGAL_SUPPORT_EMAIL}`}>{LEGAL_SUPPORT_EMAIL}</a></dd></div>
    </dl>
  </header>

  <div class="legal-reading">
    <aside class="legal-toc">
      <p>Содержание</p>
      <ol>
        {sections.map((section, index) => <li><a href={`#${section.id}`}><span>{String(index + 1).padStart(2, '0')}</span>{section.heading}</a></li>)}
      </ol>
    </aside>

    <article class="legal-article">
      {sections.map((section, index) => (
        <section id={section.id}>
          <span class="legal-section-number">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets?.length && <ul>{section.bullets.map((item) => <li>{item}</li>)}</ul>}
            {section.note && <aside class="legal-note">{section.note}</aside>}
            {section.links?.length && <div class="legal-section-links">{section.links.map((link) => <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>{link.label}<span aria-hidden="true">↗</span></a>)}</div>}
          </div>
        </section>
      ))}
    </article>
  </div>

  <section class="legal-related" aria-labelledby="legal-related-title">
    <header><p>Продолжить чтение</p><h2 id="legal-related-title">Связанные документы</h2></header>
    <div>{relatedDocuments.map((entry) => <a href={entry.href}><span>{entry.number}</span><strong>{entry.shortTitle}</strong><i aria-hidden="true">↗</i></a>)}</div>
  </section>
</PageShell>

<style>
  .legal-hero{display:grid;min-height:clamp(580px,64vw,820px);padding:clamp(32px,4.8vw,72px);grid-template-rows:auto 1fr auto;border-radius:var(--radius);background:var(--moss);color:#fff;overflow:hidden}.legal-hero-topline{display:flex;align-items:center;justify-content:space-between;gap:24px;color:#c8d5cb;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.legal-hero-topline a{color:inherit;text-underline-offset:4px}.legal-hero-copy{align-self:center;max-width:1050px;padding:clamp(62px,8vw,116px) 0}.legal-hero-copy>p{margin:0 0 25px;color:var(--lime);font-size:10px;font-weight:800;letter-spacing:.15em;text-transform:uppercase}.legal-hero h1{max-width:1030px;margin:0;color:#fff;font-size:clamp(50px,7vw,112px);line-height:.84;letter-spacing:-.095em;text-wrap:balance}.legal-hero-copy>span{display:block;max-width:620px;margin-top:32px;color:#d6dfd8;font-size:clamp(14px,1.3vw,17px);line-height:1.65}.legal-hero dl{display:grid;margin:0;padding-top:22px;grid-template-columns:1fr 1fr;border-top:1px solid rgba(255,255,255,.2);gap:30px}.legal-hero dl div{display:grid;gap:7px}.legal-hero dt{color:#9fb0a5;font-size:8px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.legal-hero dd{margin:0;color:#fff;font-size:11px}.legal-hero dd a{color:inherit;text-underline-offset:3px}
  .legal-reading{display:grid;max-width:1240px;margin:0 auto;padding:clamp(82px,10vw,150px) var(--content-gutter);grid-template-columns:minmax(220px,.42fr) minmax(0,1fr);gap:clamp(54px,8vw,130px);align-items:start}.legal-toc{position:sticky;top:122px}.legal-toc>p{margin:0 0 22px;color:#6f902b;font-size:9px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.legal-toc ol{display:grid;margin:0;padding:0;border-top:1px solid var(--line);list-style:none}.legal-toc li{border-bottom:1px solid var(--line)}.legal-toc a{display:grid;padding:13px 0;grid-template-columns:34px 1fr;gap:8px;color:var(--muted);font-size:10px;line-height:1.4;text-decoration:none;transition:color .18s ease,transform .18s ease}.legal-toc a span{color:#79942f;font-size:8px;font-weight:800}.legal-toc a:hover{color:var(--moss);transform:translateX(3px)}.legal-toc a:focus-visible{outline:3px solid var(--lime);outline-offset:3px}
  .legal-article{min-width:0}.legal-article>section{display:grid;padding:0 0 clamp(62px,7vw,94px);grid-template-columns:50px minmax(0,1fr);gap:18px;scroll-margin-top:125px}.legal-section-number{padding-top:8px;color:#78942f;font-size:9px;font-weight:850}.legal-article h2{max-width:750px;margin:0 0 25px;color:var(--moss);font-size:clamp(31px,3.2vw,48px);line-height:.96;letter-spacing:-.065em}.legal-article p,.legal-article li{color:#514b46;font-size:14px;line-height:1.82;text-wrap:pretty}.legal-article p{max-width:760px;margin:0 0 17px}.legal-article ul{display:grid;max-width:760px;margin:24px 0 0;padding:0;border-top:1px solid var(--line);list-style:none}.legal-article li{position:relative;padding:14px 0 14px 27px;border-bottom:1px solid var(--line)}.legal-article li:before{position:absolute;top:23px;left:3px;width:7px;height:7px;border-radius:50%;background:var(--lime);content:''}.legal-note{max-width:760px;margin-top:26px;padding:22px 24px;border-left:4px solid var(--lime);border-radius:0 var(--radius) var(--radius) 0;background:var(--moss-soft);color:var(--moss);font-size:12px;font-weight:650;line-height:1.65}.legal-section-links{display:flex;flex-wrap:wrap;gap:8px;margin-top:26px}.legal-section-links a{display:inline-flex;min-height:46px;padding:0 17px;border:1px solid var(--line);border-radius:var(--radius);align-items:center;gap:12px;background:var(--paper);color:var(--moss);font-size:10px;font-weight:800;text-decoration:none;transition:background .18s ease,color .18s ease,transform .18s ease}.legal-section-links a:hover{background:var(--moss);color:#fff;transform:translateY(-2px)}
  .legal-related{margin:0 0 14px;padding:clamp(58px,7vw,96px);border-radius:var(--radius);background:var(--sand)}.legal-related header p{margin:0 0 17px;color:#6f902b;font-size:9px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.legal-related h2{max-width:650px;margin:0;color:var(--moss);font-size:clamp(39px,4.8vw,72px)}.legal-related>div{display:grid;margin-top:clamp(42px,5vw,72px);border-top:1px solid #dcd5cc}.legal-related>div>a{display:grid;min-height:82px;padding:15px 3px;grid-template-columns:50px 1fr auto;align-items:center;gap:15px;border-bottom:1px solid #dcd5cc;color:var(--moss);text-decoration:none;transition:padding .2s ease,color .2s ease}.legal-related a span{color:#78942f;font-size:9px;font-weight:850}.legal-related a strong{font-size:clamp(17px,2vw,25px);letter-spacing:-.04em}.legal-related a i{font-size:19px;font-style:normal}.legal-related a:hover{padding-right:12px;padding-left:12px;color:#6f902b}
  @media(max-width:820px){.legal-hero{min-height:650px;margin:0 var(--mobile-gutter);padding:30px 24px}.legal-hero-copy{padding:68px 0}.legal-hero h1{font-size:clamp(47px,13vw,68px)}.legal-hero dl{grid-template-columns:1fr}.legal-reading{grid-template-columns:1fr;padding:72px var(--mobile-gutter);gap:56px}.legal-toc{position:static}.legal-toc a{padding:15px 0;font-size:11px}.legal-article>section{grid-template-columns:35px 1fr;gap:8px}.legal-article p,.legal-article li{font-size:13px}.legal-related{margin-right:var(--mobile-gutter);margin-left:var(--mobile-gutter);padding:52px 24px}.legal-related>div>a{grid-template-columns:36px 1fr auto}}
  @media(prefers-reduced-motion:reduce){.legal-toc a,.legal-section-links a,.legal-related a{transition:none}}
</style>
