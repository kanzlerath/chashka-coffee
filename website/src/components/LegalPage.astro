---
import PageShell from '../layouts/PageShell.astro'
import { LEGAL_SUPPORT_EMAIL, getLegalDocument, type LegalSection } from '../lib/legal-documents'

interface Props {
  href: string
  sections: LegalSection[]
  subtitle?: string
}

const { href, sections, subtitle } = Astro.props
const document = getLegalDocument(href)
---

<PageShell title={document.shortTitle} description={`${document.title}. Чашка кофе.`} active="about">
  <article class="legal-document">
    <header class="legal-document-header">
      <h1>{document.title}</h1>
      {subtitle && <p class="legal-document-subtitle">{subtitle}</p>}
      <p class="legal-document-revision">Редакция от {document.effectiveDate}</p>
    </header>

    <div class="legal-document-body">
      {sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          {section.clauses.map((clause) => (
            <div class="legal-clause">
              <p>{clause.number && <strong>{clause.number}</strong>} {clause.text}</p>
              {clause.bullets?.length && <ul>{clause.bullets.map((item) => <li>{item}</li>)}</ul>}
              {clause.links?.length && (
                <p class="legal-clause-links">
                  {clause.links.map((link) => (
                    <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>{link.label}</a>
                  ))}
                </p>
              )}
            </div>
          ))}
          {section.tables?.map((table) => (
            <div class="legal-table-wrap">
              <table>
                {table.caption && <caption>{table.caption}</caption>}
                <thead><tr>{table.headers.map((header) => <th scope="col">{header}</th>)}</tr></thead>
                <tbody>{table.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
              </table>
            </div>
          ))}
        </section>
      ))}
    </div>

    <footer class="legal-document-footer">
      <p>Обращения по документу: <a href={`mailto:${LEGAL_SUPPORT_EMAIL}`}>{LEGAL_SUPPORT_EMAIL}</a></p>
      <a href="/legal">Все правила и реквизиты</a>
    </footer>
  </article>
</PageShell>

<style>
  .legal-document{width:min(100% - (var(--content-gutter) * 2),960px);margin:0 auto;padding:clamp(72px,8vw,118px) 0 clamp(100px,11vw,160px);color:var(--ink)}
  .legal-document-header{padding-bottom:clamp(42px,5vw,68px);border-bottom:1px solid var(--line)}
  .legal-document h1{max-width:920px;margin:0;color:var(--moss);font-size:clamp(42px,5.6vw,78px);line-height:.98;letter-spacing:-.065em;text-wrap:balance}
  .legal-document-subtitle{max-width:820px;margin:28px 0 0;color:var(--ink);font-size:clamp(18px,2vw,25px);font-weight:700;line-height:1.35;text-transform:uppercase}
  .legal-document-revision{margin:24px 0 0;color:var(--muted);font-size:11px;line-height:1.5}
  .legal-document-body{padding-top:clamp(52px,6vw,82px)}
  .legal-document-body>section+section{margin-top:clamp(58px,7vw,88px)}
  .legal-document h2{margin:0 0 28px;color:var(--moss);font-size:clamp(25px,3vw,36px);line-height:1.15;letter-spacing:-.035em;text-transform:uppercase}
  .legal-clause+.legal-clause{margin-top:18px}
  .legal-clause p,.legal-clause li,.legal-document-footer p,.legal-document-footer>a{margin:0;color:#45413d;font-size:14px;line-height:1.78}
  .legal-clause p strong{color:var(--ink);font-weight:800}
  .legal-clause ul{margin:10px 0 0;padding-left:26px}
  .legal-clause li+li{margin-top:8px}
  .legal-clause a,.legal-document-footer a{color:var(--moss);text-decoration-thickness:1px;text-underline-offset:3px}
  .legal-clause-links{display:flex;flex-wrap:wrap;gap:8px 18px;margin-top:8px!important}
  .legal-table-wrap{overflow-x:auto;margin-top:28px;border-top:1px solid var(--line)}
  .legal-table-wrap table{width:100%;border-collapse:collapse;text-align:left}
  .legal-table-wrap caption{padding:0 0 14px;text-align:left;color:var(--muted);font-size:11px}
  .legal-table-wrap :is(th,td){min-width:155px;padding:14px 12px;border-bottom:1px solid var(--line);vertical-align:top;font-size:11px;line-height:1.55}
  .legal-table-wrap th{color:var(--moss);font-weight:800}
  .legal-table-wrap td{color:#514c47}
  .legal-document-footer{display:flex;margin-top:clamp(70px,8vw,110px);padding-top:25px;border-top:1px solid var(--line);justify-content:space-between;gap:24px}
  .legal-document-footer p,.legal-document-footer>a{font-size:11px}
  @media(max-width:700px){.legal-document{width:auto;margin:0 var(--mobile-gutter);padding-top:56px}.legal-document h1{font-size:42px}.legal-document-subtitle{font-size:18px}.legal-document h2{font-size:25px}.legal-clause p,.legal-clause li{font-size:13px;line-height:1.72}.legal-document-footer{display:grid}}
</style>
