---
import type { ContentEntry } from '@chashka-coffee/contracts'

import StoryDetail from '../../components/StoryDetail.astro';
import { promotionPeriodLabel } from '../../lib/promotions'
import { getContent } from '../../lib/public-api'
import { createContentStaticPaths } from '../../lib/static-detail-paths'

export async function getStaticPaths() {
  return createContentStaticPaths(await getContent('PROMOTION'))
}

const { entry } = Astro.props as { entry: ContentEntry }
---
<StoryDetail
  active="promotions"
  action="Ко всем акциям"
  actionHref="/promotions"
  blocks={entry.blocks}
  body={entry.body}
  eyebrow="Акция"
  image={entry.imageUrl ?? undefined}
  intro={entry.excerpt ?? entry.body ?? 'Условия акции указаны ниже.'}
  meta={promotionPeriodLabel(entry)}
  title={entry.title}
/>
