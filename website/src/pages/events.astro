---
import PageShell from '../layouts/PageShell.astro'
import { getContent } from '../lib/public-api'
const entries = await getContent('EVENT')
const money = (value:number|null) => value === null ? 'Бесплатно' : `${Math.round(value/100).toLocaleString('ru-RU')} ₽`
const date = (value:string|null) => value ? new Date(value).toLocaleDateString('ru-RU',{day:'numeric',month:'long'}) : 'Дата уточняется'
---
<PageShell title="События" active="events"><section class="events-intro"><p>Афиша «Чашки кофе»</p><h1>Встречаемся не только за кофе</h1><span>Мастер-классы, музыка и встречи, для которых хочется освободить вечер.</span></section><section class="event-catalog"><header><p>Ближайшие даты</p><h2>Выберите повод встретиться</h2></header>{entries.length ? <div>{entries.map((entry) => <a href={`/events/${entry.slug}`}><img src={entry.imageUrl ?? '/images/home-breakfast.png'} alt="" loading="lazy"/><div><small>{date(entry.eventStartsAt)}</small><h3>{entry.title}</h3><p>{entry.excerpt}</p><footer><strong>{money(entry.priceKopecks)}</strong><span>Подробнее</span></footer></div></a>)}</div> : <p class="empty">События появятся здесь после запуска API.</p>}</section></PageShell>
<style>
  .events-intro{padding:clamp(70px,9vw,140px) var(--content-gutter) clamp(90px,11vw,170px);border-radius:var(--radius);background:var(--moss);color:#fff}.events-intro p,.event-catalog header p{margin:0;color:var(--lime);font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.events-intro h1{max-width:1300px;margin:20px 0 30px;color:#fff!important;font-size:clamp(58px,7vw,112px)!important}.events-intro span{display:block;max-width:600px;color:#dbe3dc;font-size:15px;line-height:1.65}.event-catalog{padding:clamp(90px,10vw,160px) var(--content-gutter)}.event-catalog header{max-width:980px;margin-bottom:52px}.event-catalog header p{color:#6f902b}.event-catalog h2{margin:15px 0;font-size:clamp(44px,5vw,82px)}.event-catalog>div{display:grid;grid-template-columns:1fr 1fr;gap:14px}.event-catalog a{display:grid;overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);background:#fffdf9;color:inherit;text-decoration:none;transition:transform .25s,box-shadow .25s}.event-catalog a:hover{box-shadow:0 16px 30px rgba(31,38,32,.09);transform:translateY(-4px)}.event-catalog img{width:100%;aspect-ratio:1/.64;object-fit:cover}.event-catalog a>div{display:flex;min-height:280px;padding:28px;flex-direction:column}.event-catalog small{color:#6f902b;font-size:10px;font-weight:800;text-transform:uppercase}.event-catalog h3{margin:15px 0 12px;font-size:clamp(27px,2.5vw,40px);line-height:.98}.event-catalog p{margin:0;color:var(--muted);font-size:13px;line-height:1.6}.event-catalog footer{display:flex;align-items:end;justify-content:space-between;margin-top:auto;padding-top:35px}.event-catalog footer strong{font-size:25px}.event-catalog footer span{font-size:10px;font-weight:800;text-transform:uppercase}.empty{padding:30px;border-radius:var(--radius);background:var(--sand)}@media(max-width:760px){.events-intro{margin:0 12px;padding:60px 25px 90px}.events-intro h1{font-size:56px!important}.event-catalog{padding:76px 20px}.event-catalog>div{grid-template-columns:1fr}}
</style>
