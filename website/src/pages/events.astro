---
import PageShell from '../layouts/PageShell.astro'
import { getContent } from '../lib/public-api'
const entries = await getContent('EVENT')
const money = (value:number|null) => value === null ? 'Бесплатно' : `${Math.round(value/100).toLocaleString('ru-RU')} ₽`
const date = (value:string|null) => value ? new Date(value).toLocaleDateString('ru-RU',{day:'numeric',month:'long'}) : 'Дата уточняется'
---
<PageShell title="События" active="events"><section class="events-page" aria-labelledby="events-title"><header class="events-heading"><h1 id="events-title">События</h1></header>{entries.length ? <div class="event-grid">{entries.map((entry) => <a href={`/events/${entry.slug}`}><img src={entry.imageUrl ?? '/images/home-breakfast.png'} alt="" loading="lazy"/><div><small>{date(entry.eventStartsAt)}</small><h2>{entry.title}</h2><p>{entry.excerpt}</p><footer><strong>{money(entry.priceKopecks)}</strong><span>Подробнее</span></footer></div></a>)}</div> : <p class="empty">Афиша временно недоступна. Попробуйте обновить страницу немного позже.</p>}</section></PageShell>
<style>
  .events-page{padding:clamp(58px,7.5vw,118px) 0 clamp(88px,10vw,156px)}.events-heading{margin-bottom:clamp(42px,5vw,72px)}.events-heading h1{margin:0;font-size:clamp(52px,6vw,94px);line-height:.88;letter-spacing:-.09em}.event-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.event-grid a{display:grid;overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);background:#fffdf9;color:inherit;text-decoration:none;transition:transform .25s,box-shadow .25s}.event-grid a:hover{box-shadow:0 16px 30px rgba(31,38,32,.09);transform:translateY(-4px)}.event-grid img{width:100%;aspect-ratio:1/.64;object-fit:cover}.event-grid a>div{display:flex;min-height:280px;padding:28px;flex-direction:column}.event-grid small{color:#6f902b;font-size:10px;font-weight:800;text-transform:uppercase}.event-grid h2{margin:15px 0 12px;font-size:clamp(27px,2.5vw,40px);line-height:.98}.event-grid p{margin:0;color:var(--muted);font-size:13px;line-height:1.6}.event-grid footer{display:flex;align-items:end;justify-content:space-between;margin-top:auto;padding-top:35px}.event-grid footer strong{font-size:25px}.event-grid footer span{font-size:10px;font-weight:800;text-transform:uppercase}.empty{margin:0;padding:30px;border-radius:var(--radius);background:var(--sand)}@media(max-width:760px){.events-page{padding:52px var(--mobile-gutter) 84px}.events-heading{margin-bottom:36px}.event-grid{grid-template-columns:1fr}}
</style>
