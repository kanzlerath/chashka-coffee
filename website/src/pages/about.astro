---
import PageShell from '../layouts/PageShell.astro'
import ContentBlocks from '../components/ContentBlocks.astro'
import { getManagedPage } from '../lib/public-api'

const page = await getManagedPage('ABOUT')
const milestones = [
  ['2003','Первая «Чашка кофе» в Новосибирске.'],
  ['2017','Запустили собственную обжарку на 15-килограммовом ростере Giesen.'],
  ['Сегодня','Рестораны, кондитерская, доставка и команда, которая продолжает расти.'],
]
---
<PageShell title="О компании" description="История и ремесло сети ресторанов «Чашка кофе»." active="about">
  <section class="about-opening"><img src="/images/restaurants-hero.png" alt="Интерьер ресторана «Чашка кофе»"/><div><p>Новосибирск · с 2003 года</p><h1>Город меняется.<br/>Любимое место<br/>остаётся.</h1><span>Мы создаём рестораны, в которых одинаково естественно начать утро, назначить важную встречу и задержаться без особого повода.</span></div></section>
  <section class="about-statement"><p>Чашка кофе</p><h2>Двадцать с лишним лет мы превращаем ежедневный кофе в часть городской культуры.</h2></section>
  <section class="about-history"><header><p>История</p><h2>От первой чашки<br/>до собственного ремесла</h2></header><div>{milestones.map(([year,text]) => <article><strong>{year}</strong><p>{text}</p></article>)}</div></section>
  <section class="about-craft"><figure><img src="/images/home-morning-v2.png" alt="Кофе собственной обжарки"/><figcaption>Собственная обжарка · с 2017 года</figcaption></figure><div><p>Что стоит за вкусом</p><h2>Зерно, кухня<br/>и кондитерская</h2><span>Мы сами обжариваем specialty-кофе, готовим блюда в ресторанах и делаем торты из натуральных ингредиентов — без маргарина, искусственных красителей и ароматизаторов.</span><nav><a href="/coffee">Кофе</a><a href="/bakery">Кондитерская</a><a href="/menu">Меню</a></nav></div></section>
  {page && <ContentBlocks blocks={page.blocks}/>} 
  <section class="about-links"><a href="/restaurants"><span>Найти своё место</span><strong>Рестораны</strong></a><a href="/jobs"><span>Стать частью истории</span><strong>Вакансии</strong></a><a href="/franchise"><span>Расти вместе</span><strong>Франшиза</strong></a></section>
</PageShell>
<style>
  .about-opening{position:relative;min-height:720px;overflow:hidden;border-radius:var(--radius);background:var(--moss);color:#fff}.about-opening>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.about-opening:after{position:absolute;inset:0;background:linear-gradient(90deg,rgba(17,49,36,.96),rgba(17,49,36,.7) 45%,rgba(17,49,36,.08));content:''}.about-opening>div{position:relative;z-index:1;display:flex;min-height:720px;justify-content:flex-end;align-items:flex-start;padding:clamp(50px,7vw,110px);flex-direction:column}.about-opening p,.about-history header>p,.about-craft>div>p,.about-statement>p{margin:0;color:var(--lime);font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.about-opening h1{max-width:1100px;margin:17px 0;font-size:clamp(54px,6.3vw,104px);line-height:.87}.about-opening span{max-width:570px;color:#dce4dd;font-size:15px;line-height:1.65}.about-statement{padding:clamp(110px,15vw,230px) var(--content-gutter)}.about-statement h2{max-width:1500px;margin:20px 0 0;font-size:clamp(48px,6vw,98px)}.about-history{display:grid;grid-template-columns:.7fr 1.3fr;gap:clamp(45px,8vw,130px);padding:clamp(80px,10vw,150px) var(--content-gutter);border-top:1px solid var(--line)}.about-history h2,.about-craft h2{margin:16px 0;font-size:clamp(40px,4.7vw,75px)}.about-history>div{border-top:1px solid var(--line)}.about-history article{display:grid;grid-template-columns:160px 1fr;gap:22px;padding:27px 0;border-bottom:1px solid var(--line)}.about-history strong{color:#70902b;font-size:26px}.about-history article p{max-width:590px;margin:0;color:var(--muted);font-size:13px;line-height:1.65}.about-craft{display:grid;grid-template-columns:1.1fr .9fr;min-height:620px;overflow:hidden;border-radius:var(--radius);background:#e8e0d5}.about-craft figure{position:relative;margin:0}.about-craft img{width:100%;height:100%;object-fit:cover}.about-craft figcaption{position:absolute;bottom:17px;left:17px;padding:10px 13px;border-radius:var(--radius);background:rgba(252,251,248,.9);font-size:9px}.about-craft>div{display:flex;justify-content:center;align-items:flex-start;padding:clamp(40px,6vw,90px);flex-direction:column}.about-craft>div>span{max-width:510px;color:var(--muted);font-size:13px;line-height:1.7}.about-craft nav{display:flex;gap:9px;flex-wrap:wrap;margin-top:30px}.about-craft nav a{padding:12px 16px;border:1px solid #aaa39a;border-radius:var(--radius);color:inherit;font-size:11px;font-weight:700;text-decoration:none}.about-craft nav a:hover{border-color:var(--lime);background:var(--lime)}.about-links{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.about-links a{display:flex;min-height:280px;justify-content:space-between;align-items:flex-start;padding:28px;border-radius:var(--radius);background:#efebe4;color:inherit;text-decoration:none;flex-direction:column;transition:background .25s,transform .25s}.about-links a:nth-child(2){background:#dfe8d2}.about-links a:nth-child(3){background:var(--moss);color:#fff}.about-links a:hover{background:var(--lime);color:var(--moss);transform:translateY(-4px)}.about-links span{font-size:11px}.about-links strong{font-size:clamp(29px,3vw,48px)}@media(max-width:820px){.about-opening,.about-opening>div{min-height:650px}.about-opening>div{padding:48px 25px}.about-statement{padding:90px 20px}.about-history,.about-craft,.about-links{grid-template-columns:1fr}.about-history{padding:82px 20px}.about-history article{grid-template-columns:90px 1fr}.about-craft figure{height:390px}.about-links a{min-height:210px}}
</style>
