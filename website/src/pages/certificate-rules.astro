---
import LegalPage from '../components/LegalPage.astro';
const sections=[
  {heading:'Бумажные сертификаты',text:'Доступны номиналы 1 000, 1 500, 2 000, 3 000 и 5 000 рублей. Сертификат действует 3 месяца с даты выдачи.'},
  {heading:'Расчёт в ресторане',text:'Бумажный сертификат используется один раз. Если сумма заказа больше номинала, разницу можно доплатить наличными или банковской картой.'},
  {heading:'Остаток и ограничения',text:'Неиспользованный остаток не возвращается, сертификат нельзя обменять на деньги. На один стол действует один бумажный сертификат, другие скидки при таком расчёте не применяются.'},
  {heading:'Пластиковые сертификаты',text:'Пластиковую карту можно оформить на любую сумму. Актуальные условия использования и срок действия уточняйте в ресторане при покупке.'},
  {heading:'Помощь',text:'Чтобы уточнить наличие нужного номинала или другие детали, свяжитесь с выбранным рестораном через раздел контактов.'}
];
---
<LegalPage title="Правила сертификатов" eyebrow="подарки чашка кофе" intro="Условия покупки и использования бумажных и пластиковых подарочных сертификатов." sections={sections}/>
