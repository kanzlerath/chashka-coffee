---
import LegalPage from '../components/LegalPage.astro'
import type { LegalSection } from '../lib/legal-documents'

const sections: LegalSection[] = [
  {
    heading: '1. Общие положения',
    clauses: [
      { number: '1.1.', text: 'Подарочный сертификат «Чашка кофе» удостоверяет внесение его приобретателем денежных средств в качестве предварительной оплаты услуг общественного питания и товаров на сумму, равную номиналу сертификата.' },
      { number: '1.2.', text: 'Продавцом сертификата является юридическое лицо ресторана, в котором сертификат приобретен и которое указано в кассовом чеке.' },
      { number: '1.3.', text: 'Право использовать сертификат принадлежит его предъявителю. Предъявитель вправе передать сертификат другому лицу, если иное прямо не указано на сертификате.' },
      { number: '1.4.', text: 'Приобретение и использование сертификата означают ознакомление с настоящими Правилами.' },
      { number: '1.5.', text: 'Сертификат принимается в участвующих ресторанах «Чашки кофе», указанных на самом сертификате или в актуальной информации продавца.' },
    ],
  },
  {
    heading: '2. Срок действия и номинал',
    clauses: [
      { number: '2.1.', text: 'Номинал сертификата указывается в рублях Российской Федерации на сертификате либо определяется при его активации.' },
      { number: '2.2.', text: 'Сертификат может быть предъявлен для оплаты в течение 3 месяцев с даты выдачи, если на сертификате не указан более продолжительный срок.' },
      { number: '2.3.', text: 'Дата выдачи указывается на бумажном сертификате либо фиксируется в учетной системе продавца при активации пластикового сертификата.' },
      { number: '2.4.', text: 'Истечение срока предъявления прекращает возможность использовать сертификат для расчета в ресторане, но не прекращает право предъявителя потребовать возврата неиспользованной суммы предварительной оплаты в порядке, установленном законодательством Российской Федерации.' },
    ],
  },
  {
    heading: '3. Бумажный сертификат',
    clauses: [
      { number: '3.1.', text: 'Бумажный сертификат используется для расчета один раз.' },
      { number: '3.2.', text: 'Если стоимость заказа превышает номинал сертификата, разница оплачивается наличными денежными средствами или банковской картой.' },
      { number: '3.3.', text: 'Если стоимость заказа меньше номинала, сертификат считается использованным после расчета. Неиспользованный остаток не выдается наличными непосредственно на кассе, но может быть возвращен продавцом на основании отдельного требования предъявителя.' },
      { number: '3.4.', text: 'При расчете по одному столу может быть использован один бумажный сертификат.' },
      { number: '3.5.', text: 'При расчете бумажным сертификатом скидки, бонусы и иные специальные предложения не применяются, если условия конкретного предложения прямо не предусматривают иное.' },
    ],
  },
  {
    heading: '4. Пластиковый сертификат',
    clauses: [
      { number: '4.1.', text: 'Пластиковый сертификат может использоваться неоднократно до полного расходования доступного остатка.' },
      { number: '4.2.', text: 'При каждом расчете с пластикового сертификата списывается сумма фактического заказа в пределах доступного остатка.' },
      { number: '4.3.', text: 'Если стоимость заказа превышает доступный остаток, разница оплачивается наличными денежными средствами или банковской картой.' },
      { number: '4.4.', text: 'Остаток пластикового сертификата может быть использован при последующих расчетах в течение срока предъявления.' },
      { number: '4.5.', text: 'Правило об использовании одного сертификата для расчета по одному столу и ограничения по одновременному применению скидок действуют также для пластикового сертификата, если продавец письменно не установил иное.' },
    ],
  },
  {
    heading: '5. Возврат неиспользованной суммы',
    clauses: [
      { number: '5.1.', text: 'Предъявитель вправе потребовать у продавца возврата номинала неиспользованного сертификата либо остатка предварительной оплаты.' },
      { number: '5.2.', text: 'Для возврата необходимо обратиться к продавцу сертификата и предоставить сертификат либо сведения, позволяющие проверить его подлинность, доступный остаток и отсутствие повторного использования.' },
      { number: '5.3.', text: 'Продавец вправе запросить письменное заявление и реквизиты для перечисления денежных средств.' },
      { number: '5.4.', text: 'Возврат производится в срок и способом, предусмотренными законодательством Российской Федерации.' },
      { number: '5.5.', text: 'Техническое правило о невозможности обменять сертификат на наличные непосредственно на кассе не ограничивает право предъявителя обратиться к продавцу с требованием о возврате предварительной оплаты.' },
    ],
  },
  {
    heading: '6. Утрата, повреждение и безопасность',
    clauses: [
      { number: '6.1.', text: 'Предъявитель обязан обеспечивать сохранность сертификата, его номера, штрихкода и иных реквизитов, позволяющих произвести расчет.' },
      { number: '6.2.', text: 'До получения продавцом заявления о блокировке сертификата риск его использования третьим лицом несет предъявитель в пределах, допускаемых законодательством.' },
      { number: '6.3.', text: 'Восстановление утраченного бумажного сертификата возможно, если продавец может достоверно установить факт приобретения, реквизиты сертификата и отсутствие его использования.' },
      { number: '6.4.', text: 'Поврежденный пластиковый сертификат может быть заменен после проверки его реквизитов и доступного остатка при наличии технической возможности.' },
    ],
  },
  {
    heading: '7. Обращения',
    clauses: [
      { number: '7.1.', text: 'Обращения по использованию, проверке остатка и возврату направляются продавцу сертификата либо по адресу support@chashkacoffee.ru для передачи ответственному юридическому лицу.' },
      { number: '7.2.', text: 'В обращении рекомендуется указать ресторан и дату приобретения, номер сертификата, содержание требования и приложить кассовый чек, если он сохранился.' },
      { number: '7.3.', text: 'Отсутствие кассового чека не лишает предъявителя права подтверждать приобретение сертификата иными доказательствами.' },
    ],
  },
]
---

<LegalPage href="/certificate-rules" sections={sections} />
