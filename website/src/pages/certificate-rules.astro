---
import LegalPage from '../components/LegalPage.astro'
import type { LegalSection } from '../lib/legal-documents'

const sections: LegalSection[] = [
  { id: 'seller', heading: 'Кто продаёт сертификат', paragraphs: ['Продавцом является юридическое лицо ресторана, в котором приобретён сертификат и которое указано в кассовом чеке. Сертификат подтверждает внесение аванса в счёт будущего заказа в участвующих ресторанах «Чашки кофе».'], links: [{ label: 'Сведения об организациях', href: '/requisites' }] },
  { id: 'scope', heading: 'Где и сколько действует', paragraphs: ['Сертификат принимается в указанных на нём или опубликованных участвующих ресторанах. Предъявить его для оплаты заказа можно в течение 3 месяцев с даты выдачи, если на самом сертификате не указан более длительный срок.', 'Окончание срока предъявления не отменяет права владельца потребовать возврата неиспользованного аванса в порядке, установленном законом.'] },
  { id: 'paper', heading: 'Бумажный сертификат', paragraphs: ['Бумажный сертификат предъявляется один раз. Если заказ дороже номинала, разницу можно доплатить наличными или банковской картой. Если заказ дешевле, сертификат закрывается после расчёта, а неиспользованный остаток можно получить у продавца по заявлению.', 'На один стол принимается один бумажный сертификат. При таком способе расчёта другие скидки и специальные предложения не применяются, если условия конкретной акции прямо не предусматривают иное.'] },
  { id: 'plastic', heading: 'Пластиковый сертификат', paragraphs: ['Пластиковым сертификатом можно пользоваться несколько раз и частично списывать доступный остаток. Если стоимость заказа выше остатка, разницу можно доплатить. Актуальный остаток уточняется при расчёте или обращении к продавцу.', 'Ограничение «один сертификат на один стол» и несовместимость с другими скидками применяются так же, как для бумажного сертификата, если продавец письменно не указал иное.'] },
  { id: 'refund', heading: 'Возврат денег', paragraphs: ['Владелец сертификата вправе потребовать возврат всей неиспользованной суммы или доступного остатка. Возврат осуществляет продавец сертификата после проверки его подлинности и остатка. Деньги возвращаются в предусмотренный законом срок; продавец может запросить сертификат, заявление и реквизиты для возврата.', 'Сертификат не обменивается на наличные непосредственно на кассе во время обычного расчёта, однако это техническое правило не ограничивает законное право подать требование о возврате аванса.'] },
  { id: 'loss', heading: 'Утрата и повреждение', paragraphs: ['Сертификат следует хранить как средство оплаты. При утрате бумажного сертификата восстановление возможно только если продавец может надёжно установить его реквизиты, факт покупки и неиспользование. Повреждённый или пластиковый сертификат восстанавливается после проверки технической возможности и остатка.'], note: 'Не публикуйте номер или штрихкод сертификата: другое лицо может использовать его раньше владельца.' },
  { id: 'claims', heading: 'Обращения', paragraphs: ['По использованию, остатку и возврату следует обращаться в ресторан-продавец либо на support@chashkacoffee.ru. В обращении укажите точку покупки, дату, номер сертификата и приложите чек, если он сохранился. Отсутствие чека не лишает возможности подтвердить покупку иначе.'] },
]
---

<LegalPage href="/certificate-rules" intro="Бумажный сертификат используется один раз, пластиковый — частями; права на неиспользованный аванс сохраняются." sections={sections} related={['/requisites', '/promotion-rules', '/terms']} />
