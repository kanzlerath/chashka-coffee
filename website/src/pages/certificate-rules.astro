---
import LegalPage from '../components/LegalPage.astro'
import type { LegalSection } from '../lib/legal-documents'

const sections: LegalSection[] = [
  {
    heading: '1. Общие положения',
    clauses: [
      { number: '1.1.', text: 'Подарочный сертификат подтверждает внесение предварительной оплаты и может быть использован для расчета в участвующих ресторанах «Чашки кофе».' },
      { number: '1.2.', text: 'Продавцом сертификата является юридическое лицо ресторана, в котором сертификат приобретен и которое указано в кассовом чеке.' },
      { number: '1.3.', text: 'Право использовать сертификат принадлежит его предъявителю.' },
    ],
  },
  {
    heading: '2. Использование сертификата',
    clauses: [
      { number: '2.1.', text: 'Номинал сертификата указывается в рублях на самом сертификате либо определяется при его активации.' },
      { number: '2.2.', text: 'Если стоимость заказа превышает доступный номинал или остаток, разницу можно доплатить.' },
      { number: '2.3.', text: 'Пластиковый сертификат используется неоднократно до полного расходования доступного остатка.' },
      { number: '2.4.', text: 'Условия одновременного применения сертификата со скидками и специальными предложениями определяются условиями соответствующего предложения.' },
    ],
  },
  {
    heading: '3. Возврат неиспользованной суммы',
    clauses: [
      { number: '3.1.', text: 'Предъявитель вправе потребовать у продавца возврата номинала неиспользованного сертификата либо его остатка.' },
      { number: '3.2.', text: 'Для возврата обратитесь к продавцу сертификата и предоставьте сертификат либо сведения, позволяющие проверить его подлинность, доступный остаток и отсутствие повторного использования.' },
      { number: '3.3.', text: 'Продавец может запросить заявление и реквизиты для перечисления денежных средств. Возврат производится в порядке и сроки, предусмотренные законодательством Российской Федерации.' },
    ],
  },
  {
    heading: '4. Обращения',
    clauses: [
      { number: '4.1.', text: 'По вопросам использования, проверки остатка и возврата обратитесь к продавцу сертификата. Также можно написать на sbis-ivanov@denisivanov.ru для передачи обращения ответственному лицу.' },
      { number: '4.2.', text: 'Укажите ресторан и дату приобретения, номер сертификата и содержание обращения. Отсутствие кассового чека не лишает предъявителя права подтвердить приобретение иными доказательствами.' },
    ],
  },
]
---

<LegalPage href="/certificate-rules" sections={sections} />
