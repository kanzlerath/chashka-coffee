---
import LegalPage from '../components/LegalPage.astro'
import type { LegalSection } from '../lib/legal-documents'

const sections: LegalSection[] = [
  {
    heading: '1. Согласие субъекта персональных данных',
    clauses: [
      { number: '1.1.', text: 'Я, действуя свободно, своей волей и в своем интересе, подтверждая свою дееспособность, даю ООО «Чашка кофе», ИНН 5407066477, ОГРН 1095407010555, адрес: 633104, Новосибирская область, г. Обь, пр-т Мозжерина, зд. 100А (далее — Оператор), согласие на обработку моих персональных данных на условиях настоящего документа.' },
      { number: '1.2.', text: 'Согласие предоставляется путем установки отдельного флажка в форме Сайта и последующего нажатия кнопки отправки формы.' },
      { number: '1.3.', text: 'Согласие является конкретным, предметным, информированным, сознательным и однозначным.' },
    ],
  },
  {
    heading: '2. Цели обработки',
    clauses: [
      { number: '2.1.', text: 'Целью обработки является прием и рассмотрение моего обращения, связь со мной, уточнение сведений и организация исполнения выбранной услуги.' },
      { number: '2.2.', text: 'В зависимости от выбранной формы обращение может относиться к бронированию, банкету, франшизе, заказу продукции кондитерской, вакансии, мероприятию, обратной связи или иной прямо указанной в форме цели.' },
    ],
  },
  {
    heading: '3. Перечень персональных данных',
    clauses: [
      { number: '3.1.', text: 'Согласие предоставляется на обработку следующих персональных данных: имя, номер телефона, адрес электронной почты, содержание сообщения.' },
      { number: '3.2.', text: 'В зависимости от формы также могут обрабатываться сведения о выбранной услуге, ресторане, вакансии, мероприятии, количестве гостей, теме и техническом источнике обращения.' },
      { number: '3.3.', text: 'Оператор не запрашивает посредством указанных форм специальные категории персональных данных и биометрические персональные данные.' },
    ],
  },
  {
    heading: '4. Действия с персональными данными',
    clauses: [
      { number: '4.1.', text: 'Согласие предоставляется на сбор, запись, систематизацию, накопление, хранение, уточнение, извлечение, использование, передачу, предоставление доступа, блокирование, удаление и уничтожение персональных данных.' },
      { number: '4.2.', text: 'Обработка может осуществляться с использованием средств автоматизации и без использования таких средств.' },
    ],
  },
  {
    heading: '5. Передача данных',
    clauses: [
      { number: '5.1.', text: 'Если обращение относится к услуге, оказываемой иным юридическим лицом, Оператор вправе передать персональные данные в необходимом объеме ООО «Таймс 2», ООО «Дельфин кейтеринг» либо юридическому лицу выбранного ресторана.' },
      { number: '5.2.', text: 'Оператор вправе поручить обработку персональных данных поставщикам хостинга, связи и технического обеспечения Сайта при условии соблюдения требований законодательства и договора.' },
    ],
  },
  {
    heading: '6. Срок действия и отзыв согласия',
    clauses: [
      { number: '6.1.', text: 'Согласие действует до достижения цели обработки или до его отзыва, если отсутствует иное законное основание для продолжения обработки.' },
      { number: '6.2.', text: 'Сведения, необходимые для подтверждения факта предоставления согласия и защиты прав сторон, могут храниться в течение 3 лет после завершения работы с обращением, если более продолжительный срок не установлен законом или не требуется в связи со спором.' },
      { number: '6.3.', text: 'Согласие может быть отозвано путем направления обращения на адрес support@chashkacoffee.ru. В обращении необходимо указать сведения, позволяющие идентифицировать заявителя и найти первоначальное обращение.' },
      { number: '6.4.', text: 'После получения отзыва Оператор прекращает обработку и уничтожает персональные данные в установленный законом срок, кроме случаев, когда обработка может быть продолжена на ином законном основании.' },
    ],
  },
  {
    heading: '7. Ограничение действия согласия',
    clauses: [
      { number: '7.1.', text: 'Настоящее согласие не является согласием на получение рекламы.' },
      { number: '7.2.', text: 'Настоящее согласие не является согласием на использование аналитических cookies. Соответствующий выбор осуществляется отдельно в интерфейсе Сайта.' },
      { number: '7.3.', text: 'Дополнительные сведения об обработке персональных данных приведены в Политике обработки персональных данных.', links: [{ label: 'Политика обработки персональных данных', href: '/privacy' }] },
    ],
  },
]
---

<LegalPage href="/consent" sections={sections} />
