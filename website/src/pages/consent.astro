---
import LegalPage from '../components/LegalPage.astro'
import type { LegalSection } from '../lib/legal-documents'

const sections: LegalSection[] = [
  { id: 'who', heading: 'Кому и как даётся согласие', paragraphs: ['Устанавливая отдельный флажок под формой и отправляя её, пользователь свободно, своей волей и в своём интересе даёт ООО «Чашка кофе» согласие на обработку указанных в форме персональных данных. Реквизиты оператора приведены в разделе «Сведения об организациях».'], links: [{ label: 'Реквизиты оператора', href: '/requisites' }] },
  { id: 'data', heading: 'Данные и цель', paragraphs: ['Согласие относится к имени, телефону, e-mail, сообщению и сведениям о контексте формы: выбранной услуге, ресторане, вакансии, событии, количестве гостей или источнике обращения. Цель — принять обращение, связаться с пользователем, уточнить детали и организовать исполнение запроса.'] },
  { id: 'actions', heading: 'Разрешённые действия', paragraphs: ['Разрешаются сбор, запись, систематизация, накопление, хранение, уточнение, извлечение, использование, передача исполнителю обращения, блокирование, удаление и уничтожение данных с применением автоматизированных средств и без них.'] },
  { id: 'transfer', heading: 'Передача исполнителю', paragraphs: ['Если запрос относится к конкретной услуге, ООО «Чашка кофе» вправе передать его в необходимом объёме ООО «Таймс 2», ООО «Дельфин кейтеринг» или юридическому лицу выбранного ресторана. Технические подрядчики получают доступ только для обеспечения работы сайта и коммуникации.'] },
  { id: 'term', heading: 'Срок и отзыв', paragraphs: ['Согласие действует до достижения цели обработки либо до его отзыва. Для подтверждения законности обращения и защиты прав сторон запись о согласии может храниться до 3 лет после завершения работы с запросом, если закон или спор не требуют большего срока.', 'Отозвать согласие можно письмом на support@chashkacoffee.ru. В письме нужно указать данные, позволяющие найти обращение. Обработка прекращается в срок, установленный законом, кроме случаев, когда сохраняется иное правовое основание.'], links: [{ label: 'Порядок обращений', href: '/data-request' }] },
  { id: 'separate', heading: 'Что в согласие не входит', paragraphs: ['Это согласие не разрешает рекламные рассылки и не заменяет выбор аналитических cookies. Для рекламы и аналитики используются самостоятельные, необязательные решения пользователя.'], links: [{ label: 'Согласие на рекламу', href: '/advertising-consent' }, { label: 'Настройки cookies', href: '/cookies' }] },
]
---

<LegalPage href="/consent" intro="Отдельное согласие, которое пользователь подтверждает перед отправкой формы." sections={sections} related={['/privacy', '/data-request', '/advertising-consent']} />
