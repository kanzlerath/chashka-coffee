---
import LegalPage from '../components/LegalPage.astro'
import type { LegalSection } from '../lib/legal-documents'

const sections: LegalSection[] = [
  { id: 'scope', heading: 'О чём эти условия', paragraphs: ['Сайт знакомит с ресторанами, меню, событиями и сервисами «Чашки кофе», позволяет отправлять обращения, пользоваться личным кабинетом и оформлять самовывоз кофе для дома. Начав пользоваться сайтом, посетитель принимает эти условия в относящейся к нему части.'], note: 'Покупка товара регулируется офертой магазина, сертификаты — отдельными правилами, а программа лояльности — условиями PremiumBonus.' },
  { id: 'information', heading: 'Информация, цены и наличие', paragraphs: ['Мы стараемся поддерживать сведения актуальными. Меню, состав, цены, часы работы, наличие и условия предложения могут отличаться по ресторанам и уточняются перед заказом или в выбранной точке. Ошибка на странице сама по себе не означает заключение договора на ошибочных условиях.'] },
  { id: 'account', heading: 'Личный кабинет и SMS-вход', paragraphs: ['Для входа используется номер телефона и одноразовый сервисный код. Пользователь отвечает за доступ к своему номеру и не передаёт код другим лицам. Профиль и бонусная карта работают через PremiumBonus; техническую часть мобильного приложения обеспечивает «Рестомания».'], links: [{ label: 'Условия PremiumBonus', href: 'https://cards.premiumbonus.su/DIB_Len21sibsib/public-offer-agreement', external: true }, { label: 'Политика данных', href: '/privacy' }] },
  { id: 'external', heading: 'Внешние сервисы', paragraphs: ['На сайте могут использоваться платёжная страница ЮKassa, карты, аналитика, PremiumBonus и ссылки на сторонние ресурсы. Их собственные условия применяются на соответствующем ресурсе. Мы отвечаем за корректную передачу пользователя, но не управляем доступностью внешнего сервиса.'] },
  { id: 'content', heading: 'Материалы и допустимое использование', paragraphs: ['Тексты, фотографии, знаки и оформление охраняются законом. Их можно просматривать и использовать для личных некоммерческих целей. Нельзя вмешиваться в работу сайта, обходить ограничения, автоматически собирать данные в ущерб сервису или выдавать материалы за свои.'] },
  { id: 'changes', heading: 'Обновление и связь', paragraphs: ['Новая редакция публикуется на этой странице и действует с указанной даты. Изменения не отменяют уже возникшие права потребителя. О неточности или проблеме можно написать на support@chashkacoffee.ru.'], links: [{ label: 'Реквизиты организаций', href: '/requisites' }] },
]
---

<LegalPage href="/terms" intro="Общие правила публичного сайта, личного кабинета и подключённых сервисов." sections={sections} related={['/requisites', '/privacy', '/offer']} />
