---
import PageShell from '../layouts/PageShell.astro'
import ContentBlocks from '../components/ContentBlocks.astro'
import StoreBadges from '../components/StoreBadges.astro'
import { APP_DOWNLOAD_URL } from '../lib/app-links'
import { getManagedPage } from '../lib/public-api'

const page = await getManagedPage('APP')
const heroTitle = page?.heroTitle ?? 'Вся «Чашка»\nв вашем телефоне'
const heroDescription = page?.heroDescription ?? 'Заказывайте и оплачивайте онлайн, копите бонусы, возвращайтесь к любимым блюдам и узнавайте о новом раньше всех.'
const heroImage = page?.heroImageUrl ?? '/images/app/hero.webp'
const defaultAppChoices = [
  { id: '018f8d94-1f4f-7000-8000-000000000101', label: 'Заказать', title: 'Выбрать ресторан и заказать', description: 'Доставка или самовывоз, актуальное меню и ближайшая «Чашка» — всё начинается с одного экрана.', imageUrl: '/images/app/order-screen.webp', imageAlt: 'Главный экран приложения Чашка кофе с выбором доставки, самовывоза и ресторана' },
  { id: '018f8d94-1f4f-7000-8000-000000000102', label: 'Открыть карту', title: 'Показать карту и получить бонусы', description: 'QR-карта всегда под рукой: откройте её перед оплатой, чтобы копить и использовать бонусы.', imageUrl: '/images/app/bonus-card.webp', imageAlt: 'Экран бонусной QR-карты в приложении Чашка кофе' },
]
const appChoices = page?.appChoices ?? defaultAppChoices
---

<PageShell title="Приложение" description="Приложение «Чашка кофе»: заказ и онлайн-оплата, доставка, DI Bonus, история, промокоды и новости." active="app" image={heroImage}>
  <section class="app-opening">
    <img class="app-opening-image" src={heroImage} alt="Приложение Чашка кофе на телефоне рядом с кофе и круассаном" />
    <div class="app-opening-copy">
      <h1>{heroTitle.split(/\r?\n/).map((line) => <span>{line}</span>)}</h1>
      <p>{heroDescription}</p>
      <StoreBadges />
    </div>
  </section>

  <section class="app-intro">
    <h2>Не отдельный сервис.<br />Один привычный маршрут.</h2>
    <p>От выбора ближайшего ресторана до оплаты и повторного заказа — приложение помнит контекст и помогает двигаться дальше без лишнего шума.</p>
  </section>

  <section class="app-workspace" data-app-workspace aria-labelledby="app-workspace-title">
    <div class="app-workspace-copy">
      <h2 id="app-workspace-title">Что сегодня<br />важнее?</h2>
      <div class="app-tabs" role="tablist" aria-label="Возможности приложения">
        {appChoices.map((choice, index) => <button class:list={{ 'is-active': index === 0 }} type="button" role="tab" id={`app-tab-${choice.id}`} aria-controls={`app-panel-${choice.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-app-tab={choice.id}><span>{choice.label}</span><svg class="app-tab-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-5 5 5-5 5" /></svg></button>)}
      </div>
    </div>
    <div class="app-device-stage">
      <span class="app-device-shadow" aria-hidden="true"></span>
      <div class="app-device">
        <span class="app-device-speaker" aria-hidden="true"></span>
      {appChoices.map((choice, index) => <article class:list={{ 'is-active': index === 0 }} role="tabpanel" id={`app-panel-${choice.id}`} aria-labelledby={`app-tab-${choice.id}`} hidden={index !== 0} data-app-panel={choice.id}>
          <img src={choice.imageUrl} alt={choice.imageAlt} loading={index === 0 ? 'eager' : 'lazy'} />
      </article>)}
      </div>
    </div>
    <div class="app-scene-copy">
      {appChoices.map((choice, index) => <article class:list={{ 'is-active': index === 0 }} hidden={index !== 0} data-app-copy={choice.id}><h3>{choice.title}</h3><p>{choice.description}</p></article>)}
    </div>
  </section>

  <section class="app-capabilities" aria-label="Другие возможности приложения">
    <article class="capability-map"><h2>Всё важное<br />рядом</h2><p>Покажем ближайшую точку, актуальное время работы и блюда, которые доступны прямо сейчас.</p><div aria-hidden="true"><span></span><span></span><span></span><i>Вы здесь</i></div></article>
    <article class="capability-status"><div><strong>35</strong><span>минут</span></div><h2>Статус заказа<br />в реальном времени</h2></article>
    <article class="capability-feed"><h2>Новости, события<br />и персональные акции</h2><div class="capability-feed-particles" data-feed-particles aria-hidden="true"><span style="--x:8%;--y:17%;--r:-5deg;--drift-x:13px;--drift-y:10px;--duration:5.7s">Новый десерт</span><span style="--x:32%;--y:56%;--r:3deg;--drift-x:-10px;--drift-y:14px;--duration:6.4s">+200 бонусов</span><span style="--x:56%;--y:20%;--r:-2deg;--drift-x:11px;--drift-y:-12px;--duration:5.2s">Вечер в Чашке</span><span style="--x:74%;--y:61%;--r:5deg;--drift-x:-14px;--drift-y:8px;--duration:6.8s">Кофе в подарок</span><span style="--x:44%;--y:76%;--r:-4deg;--drift-x:8px;--drift-y:-13px;--duration:5.9s">Новое меню</span><span style="--x:82%;--y:29%;--r:2deg;--drift-x:-9px;--drift-y:-10px;--duration:6.2s">−15% сегодня</span></div></article>
  </section>

  {page && <div class="app-managed"><ContentBlocks blocks={page.blocks} /></div>}

  <section id="download" class="app-download">
    <div><h2>Скачайте.<br />Остальное уже внутри.</h2><StoreBadges /></div>
    <a class="app-qr" href={APP_DOWNLOAD_URL} aria-label="Открыть ссылку для установки приложения"><img src="/brand/app-download-qr.png" alt="QR-код для установки приложения Чашка кофе" width="688" height="688" /></a>
  </section>
</PageShell>

<script>
  const workspace = document.querySelector<HTMLElement>('[data-app-workspace]')
  const tabs = [...workspace?.querySelectorAll<HTMLButtonElement>('[data-app-tab]') ?? []]
  const showScene = (key: string, moveFocus = false) => {
    tabs.forEach((tab) => {
      const active = tab.dataset.appTab === key
      tab.classList.toggle('is-active', active)
      tab.setAttribute('aria-selected', String(active))
      tab.tabIndex = active ? 0 : -1
      if (active && moveFocus) tab.focus()
    })
    workspace?.querySelectorAll<HTMLElement>('[data-app-panel],[data-app-copy]').forEach((panel) => {
      const active = (panel.dataset.appPanel ?? panel.dataset.appCopy) === key
      panel.hidden = !active
      requestAnimationFrame(() => panel.classList.toggle('is-active', active))
    })
  }
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => showScene(tab.dataset.appTab ?? ''))
    tab.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(event.key)) return
      event.preventDefault()
      const direction = ['ArrowRight', 'ArrowDown'].includes(event.key) ? 1 : -1
      const target = tabs[(index + direction + tabs.length) % tabs.length]
      showScene(target?.dataset.appTab ?? '', true)
    })
  })

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (!reducedMotion) document.querySelectorAll<HTMLElement>('[data-feed-particles]').forEach((field) => {
    const states = [...field.querySelectorAll<HTMLElement>('span')].map((element) => ({
      element,
      baseX: 0,
      baseY: 0,
      x: 0,
      y: 0,
      vx: 0,
      vy: 0,
      angle: Number.parseFloat(element.style.getPropertyValue('--r')) || 0,
      angularVelocity: 0,
    }))
    let animationFrame = 0
    let previousFrame = 0
    let launched = false
    let isVisible = false
    let lastScrollY = window.scrollY

    const measure = () => states.forEach((state) => {
      state.baseX = state.element.offsetLeft
      state.baseY = state.element.offsetTop
    })
    const render = () => states.forEach((state) => {
      state.element.style.transform = `translate3d(${state.x}px, ${state.y}px, 0) rotate(${state.angle}deg)`
    })
    const keepInBounds = (state: typeof states[number], width: number, height: number) => {
      const minX = -state.baseX
      const maxX = width - state.element.offsetWidth - state.baseX
      const floor = height - state.element.offsetHeight - state.baseY

      if (state.x < minX || state.x > maxX) {
        const impactVelocity = state.vx
        state.x = Math.min(Math.max(state.x, minX), maxX)
        state.vx *= -.46
        state.angularVelocity += (state.angle / 90) * impactVelocity * .08
      }
      if (state.y > floor) {
        const impactVelocity = state.vy
        state.y = floor
        state.vy = Math.abs(state.vy) > 24 ? state.vy * -.3 : 0
        state.vx *= .86
        state.angularVelocity += Math.sin(state.angle * Math.PI / 180) * impactVelocity * .08
      }
    }
    const separateCollisions = (width: number, height: number) => {
      for (let pass = 0; pass < 2; pass += 1) states.forEach((state, index) => {
        states.slice(index + 1).forEach((other) => {
          const left = state.baseX + state.x
          const top = state.baseY + state.y
          const otherLeft = other.baseX + other.x
          const otherTop = other.baseY + other.y
          const overlapX = Math.min(left + state.element.offsetWidth, otherLeft + other.element.offsetWidth) - Math.max(left, otherLeft)
          const overlapY = Math.min(top + state.element.offsetHeight, otherTop + other.element.offsetHeight) - Math.max(top, otherTop)

          if (overlapX <= 0 || overlapY <= 0) return
          if (overlapX < overlapY) {
            const direction = left + state.element.offsetWidth / 2 < otherLeft + other.element.offsetWidth / 2 ? -1 : 1
            state.x += direction * overlapX / 2
            other.x -= direction * overlapX / 2
            state.vx += direction * 8
            other.vx -= direction * 8
            const contactOffset = (top + state.element.offsetHeight / 2 - otherTop - other.element.offsetHeight / 2) / Math.max(state.element.offsetHeight, other.element.offsetHeight)
            const rotationImpulse = contactOffset * (state.vx - other.vx) * .26
            state.angularVelocity -= rotationImpulse
            other.angularVelocity += rotationImpulse
          } else {
            const direction = top + state.element.offsetHeight / 2 < otherTop + other.element.offsetHeight / 2 ? -1 : 1
            state.y += direction * overlapY / 2
            other.y -= direction * overlapY / 2
            state.vy += direction * 7
            other.vy -= direction * 7
            const contactOffset = (left + state.element.offsetWidth / 2 - otherLeft - other.element.offsetWidth / 2) / Math.max(state.element.offsetWidth, other.element.offsetWidth)
            const rotationImpulse = contactOffset * (state.vy - other.vy) * .24
            state.angularVelocity -= rotationImpulse
            other.angularVelocity += rotationImpulse
          }
          keepInBounds(state, width, height)
          keepInBounds(other, width, height)
        })
      })
    }
    const tick = (now: number) => {
      const delta = Math.min((now - previousFrame) / 1000 || 0, .032)
      const width = field.clientWidth
      const height = field.clientHeight
      let isMoving = false

      states.forEach((state) => {
        state.vy += 760 * delta
        state.x += state.vx * delta
        state.y += state.vy * delta
        state.angle += state.angularVelocity * delta
        state.angularVelocity *= .985
        keepInBounds(state, width, height)
      })
      separateCollisions(width, height)
      states.forEach((state) => {
        if (Math.abs(state.vx) + Math.abs(state.vy) + Math.abs(state.angularVelocity) > 2) isMoving = true
      })

      render()
      previousFrame = now
      animationFrame = isMoving ? requestAnimationFrame(tick) : 0
    }
    const start = () => {
      if (animationFrame) return
      previousFrame = performance.now()
      animationFrame = requestAnimationFrame(tick)
    }
    const launch = () => {
      if (launched) return
      launched = true
      measure()
      states.forEach((state, index) => {
        state.vx = (index - (states.length - 1) / 2) * 5
        state.vy = -14 - index * 6
      })
      start()
    }
    const observer = new IntersectionObserver((entries) => {
      isVisible = entries.some((entry) => entry.isIntersecting)
      if (isVisible) launch()
    }, { threshold: .35 })
    observer.observe(field)
    window.addEventListener('scroll', () => {
      const scrollDelta = window.scrollY - lastScrollY
      lastScrollY = window.scrollY
      if (!isVisible || Math.abs(scrollDelta) < 1) return

      launch()
      states.forEach((state, index) => {
        state.vx += Math.max(-75, Math.min(75, scrollDelta * .12)) + (index - 2.5) * 5
        state.vy -= Math.min(165, Math.abs(scrollDelta) * .35) + index * 4
      })
      start()
    }, { passive: true })
  })
</script>

<style>
  .app-opening{position:relative;display:flex;min-height:calc(100svh - 126px);align-items:center;overflow:hidden;border-radius:var(--radius);background:#ead5c2;color:var(--ink);isolation:isolate}.app-opening:after{position:absolute;z-index:-1;inset:0;background:linear-gradient(90deg,rgba(249,237,224,.98) 0%,rgba(249,237,224,.87) 31%,rgba(249,237,224,.24) 55%,transparent 72%);content:''}.app-opening-image{position:absolute;z-index:-2;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}.app-opening-copy{width:min(48%,720px);padding:clamp(42px,4.7vw,80px) clamp(52px,7vw,112px);animation:app-opening-in .7s cubic-bezier(.22,1,.36,1) both}.app-opening .app-opening-copy h1{margin:0;color:var(--ink)!important;font-size:clamp(52px,5.6vw,90px)!important}.app-opening .app-opening-copy h1 span{display:block}.app-opening-copy>p{max-width:510px;margin:24px 0 0;color:#65574e;font-size:15px;line-height:1.65}.app-opening :global(.store-badges){margin-top:30px}@keyframes app-opening-in{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
  .app-intro{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr);align-items:end;gap:clamp(40px,8vw,130px);padding:clamp(100px,12vw,180px) var(--content-gutter)}.app-intro h2{margin:0;font-size:clamp(50px,5.6vw,91px)}.app-intro p{max-width:480px;margin:0 0 9px;color:var(--muted);font-size:15px;line-height:1.7}
  .app-workspace{display:grid;grid-template-columns:minmax(250px,.75fr) minmax(260px,.75fr) minmax(260px,.7fr);align-items:center;gap:clamp(32px,5vw,78px);min-height:650px;padding:clamp(48px,6.5vw,100px);border-radius:var(--radius);background:#ebe4d9}.app-workspace-copy h2{margin:0 0 38px;font-size:clamp(42px,4.6vw,72px)}.app-tabs{display:grid}.app-tabs button{display:flex;min-height:58px;align-items:center;justify-content:space-between;padding:0;border:0;border-top:1px solid #cfc6ba;background:transparent;color:#756f68;cursor:pointer;font-size:13px;font-weight:700;text-align:left;transition:padding .22s ease,color .22s ease}.app-tabs button:last-child{border-bottom:1px solid #cfc6ba}.app-tab-arrow{width:18px;height:18px;opacity:0;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.8;transform:translateX(-8px);transition:opacity .22s ease,transform .22s ease}.app-tabs button:hover,.app-tabs button.is-active{padding-left:9px;color:var(--moss)}.app-tabs button.is-active .app-tab-arrow{opacity:1;transform:none}.app-tabs button:focus-visible{outline:3px solid var(--lime);outline-offset:3px}
  .app-workspace>*{min-width:0}.app-device-stage{position:relative;display:grid;place-items:center;justify-self:center;width:min(100%,340px);padding:14px}.app-device-shadow{position:absolute;right:2%;bottom:1%;width:82%;height:88%;border-radius:52px;background:rgba(69,55,43,.16);filter:blur(2px);transform:translate(18px,18px) rotate(4deg)}.app-device{position:relative;width:min(100%,304px);aspect-ratio:1179/2556;overflow:hidden;border:8px solid #15261e;border-radius:47px;background:#f4f3f0;box-shadow:0 24px 48px rgba(58,49,40,.18);transform:rotate(-2.5deg);transition:transform .5s cubic-bezier(.22,1,.36,1)}.app-device-stage:hover .app-device{transform:rotate(-.7deg) translateY(-7px)}.app-device-speaker{position:absolute;z-index:3;top:9px;left:50%;width:31%;height:24px;border-radius:999px;background:#101411;transform:translateX(-50%)}.app-device article{position:absolute;inset:0;animation:app-scene-in .38s cubic-bezier(.22,1,.36,1)}.app-device article img{display:block;width:100%;height:100%;object-fit:cover;object-position:center top}.app-scene-copy article{animation:app-scene-in .36s cubic-bezier(.22,1,.36,1)}.app-scene-copy h3{margin:0;font-size:clamp(29px,3vw,47px);line-height:.95;letter-spacing:-.065em}.app-scene-copy p{max-width:400px;margin:20px 0 0;color:var(--muted);font-size:13px;line-height:1.7}@keyframes app-scene-in{from{opacity:0;transform:translateY(12px) scale(.99)}to{opacity:1;transform:none}}.app-device article[hidden],.app-scene-copy article[hidden]{display:none}
  .app-capabilities{display:grid;grid-template-columns:1.08fr .92fr;grid-template-rows:auto auto;gap:12px;padding:clamp(90px,11vw,170px) 0}.app-capabilities article{position:relative;min-height:430px;padding:clamp(36px,5vw,75px);overflow:hidden;border-radius:var(--radius)}.app-capabilities h2{max-width:700px;margin:0;font-size:clamp(38px,4vw,65px)}.app-capabilities p{max-width:480px;margin:20px 0 0;font-size:13px;line-height:1.65}.capability-map{background:#dfe9d3}.capability-map>div{position:absolute;right:-5%;bottom:-21%;width:55%;aspect-ratio:1;border:1px solid #afc19e;border-radius:50%;transform:rotate(-8deg)}.capability-map>div:before,.capability-map>div:after{position:absolute;border:1px solid #afc19e;border-radius:50%;content:''}.capability-map>div:before{inset:18%}.capability-map>div:after{inset:36%}.capability-map>div span{position:absolute;z-index:1;width:13px;height:13px;border-radius:50%;background:var(--moss)}.capability-map>div span:nth-child(1){top:14%;left:28%}.capability-map>div span:nth-child(2){top:46%;right:11%;background:#e56f52}.capability-map>div span:nth-child(3){bottom:11%;left:34%;background:#efc86f}.capability-map>div i{position:absolute;z-index:2;top:47%;left:47%;padding:9px 11px;border-radius:var(--radius);background:var(--lime);font-size:9px;font-style:normal;font-weight:800;white-space:nowrap}.capability-status{background:var(--moss);color:#fff}.capability-status>div{display:flex;align-items:end;gap:9px;margin-bottom:100px;color:var(--lime)}.capability-status strong{font-size:clamp(80px,8vw,135px);line-height:.65;letter-spacing:-.1em}.capability-status span{font-size:14px}.capability-status h2{color:#fff}.capability-status p{color:#d6dfd7}.capability-feed{grid-column:1/-1;min-height:360px!important;background:#eee4d8}.capability-feed>:not(.capability-feed-particles){position:relative;z-index:2}.capability-feed-particles{position:absolute;z-index:1;right:clamp(32px,5vw,75px);bottom:clamp(26px,4vw,58px);width:min(51%,610px);height:180px;