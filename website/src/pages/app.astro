---
import PageShell from '../layouts/PageShell.astro'
import ContentBlocks from '../components/ContentBlocks.astro'
import StoreBadges from '../components/StoreBadges.astro'
import { getManagedPage } from '../lib/public-api'

const page = await getManagedPage('APP')
const benefits = [
  ['Быстрый заказ','Повторяйте любимое или собирайте новый заказ без лишних шагов.'],
  ['Доставка и самовывоз','Выбирайте удобный сценарий и следите за статусом.'],
  ['DI Bonus','Баланс, уровень и персональные предложения всегда под рукой.'],
  ['Всё в одном месте','Меню, рестораны, события и новости сети.'],
]
---
<PageShell title="Приложение" description="Приложение «Чашка кофе»: заказ, доставка и DI Bonus." active="app">
  <section class="app-opening"><div><p>Чашка кофе — всегда рядом</p><h1>Любимое<br/>под рукой</h1><span>Заказывайте быстрее, копите бонусы и узнавайте о новинках раньше всех.</span><StoreBadges/></div><div class="phone-demo" aria-hidden="true"><small>Доброе утро</small><strong>Что будем<br/>сегодня?</strong><i>☕</i><span>Ваш любимый латте уже ждёт</span></div></section>
  <section class="app-benefits"><header><p>В приложении</p><h2>Один спокойный<br/>сценарий на весь день</h2></header><div>{benefits.map(([title,text],index) => <article><b>0{index+1}</b><h3>{title}</h3><p>{text}</p></article>)}</div></section>
  <section class="app-flow"><div class="flow-screen"><span>01 / 03</span><h3>Выберите ресторан</h3><p>Покажем доступное меню и актуальное время работы.</p></div><div class="flow-copy"><p>Без лишнего шума</p><h2>Сначала место.<br/>Потом любимое.</h2><span>Небольшие переходы и мягкая анимация помогают не потеряться между меню, бонусами и заказом.</span><a class="button" href="/delivery">Как работает доставка</a></div></section>
  <section id="download" class="app-download"><div><p>Установить приложение</p><h2>Ваш следующий<br/>заказ уже ближе</h2><span>Откройте магазин приложений на телефоне.</span><StoreBadges/></div><div class="qr" aria-hidden="true">ЧК</div></section>
  {page && <ContentBlocks blocks={page.blocks}/>} 
</PageShell>
<style>
  .app-opening{display:grid;grid-template-columns:1fr 1fr;min-height:690px;align-items:center;overflow:hidden;border-radius:var(--radius);background:#e2e9d2}.app-opening>div:first-child{padding:clamp(48px,7vw,110px)}.app-opening p,.app-benefits header>p,.flow-copy>p,.app-download>div>p{margin:0;color:#6f902b;font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.app-opening h1{margin:18px 0;font-size:clamp(56px,5.8vw,96px);line-height:.85}.app-opening span,.flow-copy>span,.app-download>div>span{display:block;max-width:460px;color:var(--muted);font-size:14px;line-height:1.65}.app-opening :global(.store-badges),.app-download :global(.store-badges){margin-top:28px}.phone-demo{justify-self:center;width:260px;height:500px;padding:74px 28px;border:10px solid var(--moss);border-radius:42px;background:#fcfbf8;box-shadow:25px 27px 0 rgba(70,92,57,.13);transform:rotate(6deg);transition:transform .5s cubic-bezier(.22,1,.36,1)}.app-opening:hover .phone-demo{transform:rotate(2deg) translateY(-8px)}.phone-demo small{color:var(--muted);font-size:11px}.phone-demo strong{display:block;margin-top:10px;font-size:32px;line-height:.9}.phone-demo i{display:grid;width:140px;aspect-ratio:1;margin:54px auto 24px;place-items:center;border-radius:50%;background:var(--lime);font-size:62px;font-style:normal}.phone-demo span{text-align:center;font-size:10px}.app-benefits{padding:clamp(90px,11vw,170px) var(--content-gutter)}.app-benefits h2,.flow-copy h2,.app-download h2{margin:16px 0;font-size:clamp(43px,4.8vw,78px)}.app-benefits>div{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:54px}.app-benefits article{min-height:280px;padding:26px;border-radius:var(--radius);background:#efebe4;transition:transform .3s,background .3s}.app-benefits article:nth-child(2){background:#dfe8d2}.app-benefits article:nth-child(3){background:var(--moss);color:#fff}.app-benefits article:hover{transform:translateY(-5px)}.app-benefits b{color:#72902b;font-size:10px}.app-benefits h3{margin:94px 0 10px;font-size:23px}.app-benefits article p{margin:0;color:var(--muted);font-size:12px;line-height:1.6}.app-benefits article:nth-child(3) p{color:#d8e1d8}.app-flow{display:grid;grid-template-columns:1fr 1fr;min-height:530px;overflow:hidden;border-radius:var(--radius);background:var(--moss);color:#fff}.flow-screen{display:flex;justify-content:flex-end;padding:clamp(34px,5vw,74px);background:linear-gradient(150deg,#d7e6c7,#f0e6da);color:var(--ink);flex-direction:column}.flow-screen>span{font-size:10px}.flow-screen h3{margin:18px 0 8px;font-size:clamp(34px,4vw,62px)}.flow-screen p{max-width:470px;margin:0;color:var(--muted);font-size:13px;line-height:1.6}.flow-copy{display:flex;justify-content:center;align-items:flex-start;padding:clamp(34px,5vw,74px);flex-direction:column}.flow-copy>p{color:var(--lime)}.flow-copy>span{color:#d8e1d8}.flow-copy .button{margin-top:28px;padding:0 22px;background:var(--lime);color:var(--moss)}.app-download{display:grid;grid-template-columns:1fr 1fr;min-height:490px;align-items:center;padding:clamp(42px,7vw,105px);border-radius:var(--radius);background:#eee4d8}.qr{justify-self:center;display:grid;width:220px;aspect-ratio:1;place-items:center;border:13px solid var(--moss);background:repeating-linear-gradient(90deg,var(--moss) 0 10px,#f8f7f2 10px 19px),repeating-linear-gradient(var(--moss) 0 10px,#f8f7f2 10px 19px);background-blend-mode:multiply;color:var(--moss);font-size:40px;font-weight:800}@media(max-width:820px){.app-opening,.app-flow,.app-download{grid-template-columns:1fr}.app-opening>div:first-child{min-height:540px;padding:48px 25px}.phone-demo{margin:20px auto -70px;transform:rotate(4deg) scale(.82);transform-origin:bottom}.app-benefits{padding:82px 20px}.app-benefits>div{grid-template-columns:1fr 1fr}.app-benefits article{min-height:230px;padding:19px}.app-benefits h3{margin-top:67px}.flow-screen,.flow-copy{min-height:380px}.app-download{padding:58px 25px}.qr{width:180px;margin-top:44px}}
</style>
