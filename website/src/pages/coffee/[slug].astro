---
import type { Product } from '@chashka-coffee/contracts'

import ProductDetail from '../../components/ProductDetail.astro'
import { getProducts } from '../../lib/public-api'
import { createProductStaticPaths } from '../../lib/static-detail-paths'

export async function getStaticPaths() {
  return createProductStaticPaths(await getProducts('COFFEE'))
}

const { product, related } = Astro.props as { product: Product; related: Product[] }
---
<ProductDetail product={product} related={related}/>
