---
import PageShell from '../layouts/PageShell.astro'
import ProductCard from '../components/ProductCard.astro'
import { getManagedPage, getProducts } from '../lib/public-api'

const [products, page] = await Promise.all([getProducts('COFFEE'), getManagedPage('COFFEE')])
const productGroups = products.reduce((groups, product) => {
  const name = product.subtitle || 'Кофе'
  const group = groups.find((item) => item.name === name)
  if (group) group.products.push(product)
  else groups.push({ id: `coffee-group-${groups.length + 1}`, name, products: [product] })
  return groups
}, [] as Array<{ id: string; name: string; products: typeof products }>)

const heroImage = page?.heroImageUrl ?? '/images/coffee-editorial-v1.webp'
const heroTitle = page?.heroTitle ?? 'Кофе —\nнаша работа.'
const heroDescription = page?.heroDescription ?? 'Выбираем зерно, строим профиль обжарки и каждый день настраиваем вкус в чашке.'
const heroLines = heroTitle.split(/\r?\n/).filter(Boolean)
const tasteGallery = page?.coffeeTastes ?? [
  { title: 'Абрикос', description: 'сочная сладость и мягкая кислотность', imageUrl: '/images/coffee-taste-apricot-v1.webp' },
  { title: 'Шоколад', description: 'плотность, какао и долгий тёплый шлейф', imageUrl: '/images/coffee-taste-chocolate-v1.webp' },
  { title: 'Персик', description: 'бархатистый аромат и лёгкая свежесть', imageUrl: '/images/coffee-taste-peach-v1.webp' },
  { title: 'Вишня', description: 'ягодная сочность и винная кислинка', imageUrl: '/images/coffee-taste-cherry-v1.webp' },
  { title: 'Апельсин', description: 'яркий цитрус, цедра и чистая свежесть', imageUrl: '/images/coffee-taste-orange-v1.webp' },
  { title: 'Карамель', description: 'тягучая сладость и округлый тёплый вкус', imageUrl: '/images/coffee-taste-caramel-v1.webp' },
  { title: 'Фундук', description: 'жареный орех и мягкое сливочное послевкусие', imageUrl: '/images/coffee-taste-hazelnut-v1.webp' },
]
---

<PageShell title="Кофе" description="Кофе собственной обжарки «Чашки кофе»." active="coffee" image={heroImage}>
  <div class="coffee-page">
    <section class="coffee-cover" aria-labelledby="coffee-title">
      <figure class="coffee-cover-visual"><img src={heroImage} alt="Кофе собственной обжарки" /></figure>
      <div class="coffee-cover-copy">
        <h1 id="coffee-title"><span>{heroLines[0]}</span>{heroLines.length > 1 && <em>{heroLines.slice(1).join(' ')}</em>}</h1>
        <p>{heroDescription}</p>
      </div>
      <div class="coffee-cover-dock" aria-label="Навигация по странице">
        <div class="coffee-cover-well coffee-cover-well--catalog">
          <span class="coffee-cover-shadow coffee-cover-shadow--side" aria-hidden="true"></span>
          <span class="coffee-cover-shadow coffee-cover-shadow--floor" aria-hidden="true"></span>
          <a class="coffee-cover-action" href="#catalog">Выбрать кофе</a>
        </div>
        <div class="coffee-cover-well coffee-cover-well--roastery">
          <span class="coffee-cover-shadow coffee-cover-shadow--side" aria-hidden="true"></span>
          <span class="coffee-cover-shadow coffee-cover-shadow--floor" aria-hidden="true"></span>
          <a class="coffee-cover-action" href="#coffee-production">Как мы обжариваем</a>
        </div>
      </div>
    </section>

    <section class="coffee-story" aria-labelledby="coffee-story-title" data-coffee-reveal>
      <div class="coffee-story-title"><h2 id="coffee-story-title">Сначала<br/><em>урожай.</em></h2></div>
      <div class="coffee-story-copy">
        <p>Для кофе мы берём specialty-сорта и лучшие лоты, которые приезжают к нам от фермеров из Колумбии, Эфиопии, Бразилии и других стран. У каждого зерна есть свой климат, высота, способ обработки и характер — мы не пытаемся это сгладить.</p>
        <p>Наши специалисты ездят на плантации, пробуют урожаи и узнают, как меняется вкус кофе от сезона к сезону. Так в Новосибирск попадают не случайные зёрна, а те, с которыми хочется работать дальше — искать их ясный, живой вкус.</p>
      </div>
    </section>

    <section id="coffee-production" class="coffee-roastery" aria-labelledby="coffee-production-title">
      <div class="coffee-roastery-intro"><h2 id="coffee-production-title">Свой<br/><em>ростер.</em><br/>Свой вкус.</h2><p>Обжарочное производство находится в двух ресторанах «Чашка кофе» в центре Новосибирска.</p></div>
      <div class="coffee-roastery-ledger">
        <article data-coffee-reveal><span>2017</span><div><h3>Обжариваем самостоятельно</h3><p>С этого года всё привезённое зерно проходит обжарку у нашей команды — от первого тестового профиля до партии для ресторанов.</p></div></article>
        <article data-coffee-reveal><span>15 кг</span><div><h3>Работаем на Giesen</h3><p>Размер ростера позволяет держать вкус стабильным и при этом внимательно работать с каждым отдельным лотом.</p></div></article>
        <article data-coffee-reveal><span>°C + время</span><div><h3>Не используем один рецепт</h3><p>Для каждого сорта заново подбираем температуру, время и другие параметры, которые влияют на аромат и вкус кофе.</p></div></article>
      </div>
    </section>

    <section class="coffee-senses" aria-labelledby="coffee-senses-title" data-coffee-senses>
      <header><h2 id="coffee-senses-title">Вкус можно<br/><em>увидеть.</em></h2></header>
      <div class="coffee-sense-gallery" data-coffee-sense-gallery>{tasteGallery.map((taste, index) => <article class:list={['coffee-sense-card', { 'is-active': index === 0 }]} tabindex="0" data-coffee-sense-card><img src={taste.imageUrl} alt={taste.title} loading="lazy"/><div><h3>{taste.title}</h3><p>{taste.description}</p></div></article>)}</div>
      <div class="coffee-sense-progress" aria-label="Навигация по вкусам">{tasteGallery.map((taste, index) => <button class:list={{ 'is-active': index === 0 }} type="button" aria-label={`Показать вкус: ${taste.title}`} aria-current={index === 0 ? 'true' : undefined} data-coffee-sense-control={index}></button>)}</div>
    </section>

    <section id="catalog" class="coffee-catalog coffee-catalog--controls-pending" aria-label="Каталог кофе" data-coffee-catalog>
      {productGroups.length ? <div class="coffee-catalog-layout"><div class="coffee-catalog-nav-slot" data-coffee-catalog-nav-slot><aside class="coffee-catalog-nav" data-coffee-catalog-nav><nav aria-label="Категории кофе">{productGroups.map((group) => <a href={`#${group.id}`} data-coffee-category-link={group.id}>{group.name}</a>)}</nav></aside></div><div class="coffee-catalog-groups">{productGroups.map((group) => <section id={group.id} class="coffee-catalog-group" data-coffee-category={group.id}><h2>{group.name}</h2><div class="coffee-catalog-items">{group.products.map((product) => <ProductCard product={product} presentation="menu"/>)}</div></section>)}</div></div> : <p class="catalog-empty">Каталог временно недоступен. Попробуйте обновить страницу немного позже.</p>}
    </section>

    <section class="coffee-ending" data-coffee-reveal aria-labelledby="coffee-ending-title">
      <div class="coffee-ending-copy">
        <h2 id="coffee-ending-title">К кофе —<br/><em>что-нибудь сладкое.</em></h2>
        <p>Завтраки, десерты и блюда, ради которых хочется продлить встречу ещё на один заказ.</p>
        <a href="/menu">Открыть меню</a>
      </div>
      <img class="coffee-ending-art" src="/images/coffee-dessert-cup.svg" alt="" aria-hidden="true" />
    </section>
  </div>
</PageShell>

<script>
  const reduceCoffeeMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const coffeeRevealItems = document.querySelectorAll<HTMLElement>('[data-coffee-reveal]')
  const coffeeSenseGallery = document.querySelector<HTMLElement>('[data-coffee-sense-gallery]')
  const coffeeSenseCards = [...document.querySelectorAll<HTMLElement>('[data-coffee-sense-card]')]
  const coffeeSenseControls = [...document.querySelectorAll<HTMLButtonElement>('[data-coffee-sense-control]')]
  const coffeeCatalog = document.querySelector<HTMLElement>('[data-coffee-catalog]')
  const coffeeCatalogNav = document.querySelector<HTMLElement>('[data-coffee-catalog-nav]')
  const coffeeCatalogNavSlot = document.querySelector<HTMLElement>('[data-coffee-catalog-nav-slot]')
  const coffeeCatalogGroups = [...document.querySelectorAll<HTMLElement>('[data-coffee-category]')]
  const coffeeCategoryLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-coffee-category-link]')]
  const coffeeMobileQuery = window.matchMedia('(max-width: 900px)')

  coffeeSenseCards.forEach((card) => {
    card.addEventListener('pointerup', () => card.blur())
  })

  const setActiveSense = (index: number) => {
    coffeeSenseCards.forEach((card, cardIndex) => card.classList.toggle('is-active', cardIndex === index))
    coffeeSenseControls.forEach((control, controlIndex) => {
      const isActive = controlIndex === index
      control.classList.toggle('is-active', isActive)
      if (isActive) control.setAttribute('aria-current', 'true')
      else control.removeAttribute('aria-current')
    })
  }

  let coffeeSenseFrame = 0
  const syncActiveSense = () => {
    coffeeSenseFrame = 0
    if (!coffeeSenseGallery || !coffeeMobileQuery.matches || !coffeeSenseCards.length) return
    const galleryLeft = coffeeSenseGallery.getBoundingClientRect().left
    let closestIndex = 0
    let closestDistance = Number.POSITIVE_INFINITY
    coffeeSenseCards.forEach((card, index) => {
      const distance = Math.abs(card.getBoundingClientRect().left - galleryLeft - 20)
      if (distance < closestDistance) {
        closestIndex = index
        closestDistance = distance
      }
    })
    setActiveSense(closestIndex)
  }

  coffeeSenseGallery?.addEventListener('scroll', () => {
    if (coffeeSenseFrame) return
    coffeeSenseFrame = window.requestAnimationFrame(syncActiveSense)
  }, { passive: true })
  window.addEventListener('resize', syncActiveSense)
  coffeeSenseControls.forEach((control, index) => control.addEventListener('click', () => {
    const card = coffeeSenseCards[index]
    if (!coffeeSenseGallery || !card) return
    coffeeSenseGallery.scrollTo({ left: card.offsetLeft - 20, behavior: reduceCoffeeMotion ? 'auto' : 'smooth' })
    setActiveSense(index)
  }))

  let coffeeCategoryFrame = 0
  let activeCoffeeCategory = ''
  const setActiveCoffeeCategory = (categoryId: string) => {
    if (activeCoffeeCategory === categoryId) return
    activeCoffeeCategory = categoryId
    coffeeCategoryLinks.forEach((link) => {
      const isActive = link.dataset.coffeeCategoryLink === categoryId
      link.classList.toggle('is-active', isActive)
      if (isActive) link.setAttribute('aria-current', 'true')
      else link.removeAttribute('aria-current')
    })
    const activeLink = coffeeCategoryLinks.find((link) => link.dataset.coffeeCategoryLink === categoryId)
    const navList = coffeeCatalogNav?.querySelector<HTMLElement>('nav')
    if (!activeLink || !navList || !coffeeMobileQuery.matches) return
    const centeredLeft = activeLink.offsetLeft - (navList.clientWidth - activeLink.offsetWidth) / 2
    navList.scrollTo({ left: Math.max(0, Math.min(centeredLeft, navList.scrollWidth - navList.clientWidth)), behavior: reduceCoffeeMotion ? 'auto' : 'smooth' })
  }

  const syncCoffeeCatalog = () => {
    coffeeCategoryFrame = 0
    if (!coffeeCatalog || !coffeeCatalogNav || !coffeeCatalogNavSlot) return
    if (!coffeeMobileQuery.matches) {
      setActiveCoffeeCategory('')
      return
    }
    const activationLine = (coffeeCatalogNav.getBoundingClientRect().bottom || 0) + 18
    let currentGroup = coffeeCatalogGroups[0]
    coffeeCatalogGroups.forEach((group) => {
      if (group.getBoundingClientRect().top <= activationLine) currentGroup = group
    })
    setActiveCoffeeCategory(currentGroup?.dataset.coffeeCategory ?? '')
  }

  const requestCoffeeCatalogSync = () => {
    if (coffeeCategoryFrame) return
    coffeeCategoryFrame = window.requestAnimationFrame(syncCoffeeCatalog)
  }

  window.addEventListener('scroll', requestCoffeeCatalogSync, { passive: true })
  window.addEventListener('resize', () => {
    syncCoffeeCatalog()
  })
  window.requestAnimationFrame(() => {
    coffeeCatalog?.classList.remove('coffee-catalog--controls-pending')
    syncActiveSense()
    syncCoffeeCatalog()
  })

  if (reduceCoffeeMotion || !('IntersectionObserver' in window)) {
    coffeeRevealItems.forEach((item) => item.classList.add('is-visible'))
  } else {
    const coffeeRevealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return
        entry.target.classList.add('is-visible')
        coffeeRevealObserver.unobserve(entry.target)
      })
    }, { threshold: 0.18 })
    coffeeRevealItems.forEach((item) => coffeeRevealObserver.observe(item))
  }
</script>

<style>
  @font-face{font-family:'21Cent';src:url('/brand/21Cent-Italic.ttf') format('truetype');font-style:italic;font-display:swap}
  :global(html:has(.coffee-page)){scroll-behavior:smooth}
  .coffee-page{--coffee-edge:clamp(24px,5.6vw,92px);overflow:visible}.coffee-page :is(h1,h2,h3,p){text-wrap:balance}

  .coffee-cover{position:relative;isolation:isolate;display:flex;align-items:flex-end;height:min(720px,calc(100svh - 116px));min-height:590px;padding:clamp(44px,5.8vw,94px) clamp(44px,5.8vw,94px) 118px;overflow:hidden;border-radius:var(--radius);background:#312b25;color:#fff}.coffee-cover:after{position:absolute;z-index:1;inset:0;border-radius:inherit;background:linear-gradient(90deg,rgba(25,24,20,.78) 0%,rgba(25,24,20,.47) 42%,rgba(25,24,20,.08) 76%),linear-gradient(0deg,rgba(25,24,20,.62),transparent 58%);content:''}.coffee-cover-copy{position:relative;z-index:2;max-width:760px}.coffee-cover h1{margin:0 0 30px;color:#fff;font-size:clamp(63px,7.3vw,116px);line-height:.72;letter-spacing:-.095em}.coffee-cover h1 span,.coffee-cover h1 em{display:block}.coffee-cover h1 em{margin-left:clamp(12px,4vw,64px);color:var(--lime);font-family:'21Cent',serif;font-size:1.03em;font-weight:400;letter-spacing:-.05em}.coffee-cover-copy>p{max-width:500px;margin:0;color:#f0eee8;font-size:16px;line-height:1.65}.coffee-cover-visual{position:absolute;z-index:0;inset:0;margin:0;overflow:hidden;border-radius:var(--radius);background:#312b25;clip-path:inset(0 round var(--radius));animation:coffee-cover-image 1.1s cubic-bezier(.22,1,.36,1) both}.coffee-cover-visual img{width:100%;height:100%;border-radius:inherit;object-fit:cover;object-position:center 56%;transition:transform 1s cubic-bezier(.22,1,.36,1)}.coffee-cover:hover .coffee-cover-visual img{transform:scale(1.025)}.coffee-cover-copy>*{animation:coffee-cover-copy .7s cubic-bezier(.22,1,.36,1) both}.coffee-cover-copy h1{animation-delay:.08s}.coffee-cover-copy p{animation-delay:.15s}.coffee-cover-dock{position:absolute;z-index:3;right:0;bottom:0;left:0;display:flex;align-items:flex-end;justify-content:space-between;pointer-events:none}.coffee-cover-well{position:relative;isolation:isolate;display:flex;min-height:64px;align-items:flex-end;padding:0 12px;background:var(--canvas);pointer-events:auto}.coffee-cover-well--catalog{padding-left:0;border-radius:0 var(--radius) 0 0}.coffee-cover-well--roastery{padding-right:0;border-radius:var(--radius) 0 0 0}.coffee-cover-shadow{position:absolute;z-index:0;display:block;width:var(--radius);height:var(--radius);pointer-events:none}.coffee-cover-well--catalog .coffee-cover-shadow{background:radial-gradient(circle at 100% 0,transparent calc(var(--radius) - .5px),var(--canvas) var(--radius))}.coffee-cover-well--roastery .coffee-cover-shadow{background:radial-gradient(circle at 0 0,transparent calc(var(--radius) - .5px),var(--canvas) var(--radius))}.coffee-cover-well--catalog .coffee-cover-shadow--side{top:calc(-1 * var(--radius));left:0}.coffee-cover-well--catalog .coffee-cover-shadow--floor{right:calc(-1 * var(--radius));bottom:0}.coffee-cover-well--roastery .coffee-cover-shadow--side{top:calc(-1 * var(--radius));right:0}.coffee-cover-well--roastery .coffee-cover-shadow--floor{bottom:0;left:calc(-1 * var(--radius))}.coffee-cover-action{position:relative;z-index:2;display:flex;width:max-content;min-height:52px;align-items:center;justify-content:center;padding:0 24px;border:1px solid transparent;border-radius:var(--radius);background:var(--lime);color:var(--moss-deep);font-size:10px;font-weight:800;letter-spacing:.07em;line-height:1.3;text-decoration:none;text-transform:uppercase;white-space:nowrap;transition:background .22s ease,color .22s ease,transform .22s ease}.coffee-cover-well--roastery .coffee-cover-action{border-color:#315241;background:transparent;color:#294637}.coffee-cover-action:hover{background:#cbe56b;color:var(--moss-deep);transform:translateY(-2px)}.coffee-cover-well--roastery .coffee-cover-action:hover{border-color:var(--moss);background:var(--moss);color:#fff}

  .coffee-story{display:grid;grid-template-columns:.8fr 1.22fr;gap:clamp(40px,7vw,125px);margin:clamp(104px,13vw,190px) var(--coffee-edge);color:#25201c}.coffee-story-title h2{margin:0;font-size:clamp(55px,6.1vw,96px);line-height:.77;letter-spacing:-.09em}.coffee-story-title em{display:block;margin-left:clamp(14px,4vw,66px);color:#6d8e25;font-family:'21Cent',serif;font-size:1.02em;font-weight:400;letter-spacing:-.045em}.coffee-story-copy{display:grid;gap:22px;max-width:660px;padding-top:8px}.coffee-story-copy p{margin:0;color:#4f4943;font-size:clamp(16px,1.35vw,19px);line-height:1.65}

  .coffee-roastery{display:grid;grid-template-columns:minmax(280px,.78fr) minmax(0,1.22fr);gap:clamp(40px,6vw,100px);margin:0 14px;padding:clamp(48px,6.2vw,100px);border-radius:var(--radius);background:var(--moss);color:#fff;scroll-margin-top:112px}.coffee-roastery-intro{position:sticky;top:128px;align-self:start}.coffee-roastery h2{margin:0 0 30px;color:#fff;font-size:clamp(53px,5.7vw,92px);line-height:.79;letter-spacing:-.085em}.coffee-roastery h2 em{color:var(--lime);font-family:'21Cent',serif;font-size:.92em;font-weight:400;letter-spacing:-.04em}.coffee-roastery-intro>p{max-width:360px;margin:0;color:#d3dfd4;font-size:14px;line-height:1.7}.coffee-roastery-ledger{border-top:1px solid rgba(255,255,255,.24)}.coffee-roastery-ledger article{display:grid;grid-template-columns:145px minmax(0,1fr);gap:30px;min-height:245px;padding:34px 0;border-bottom:1px solid rgba(255,255,255,.18)}.coffee-roastery-ledger article>span{color:var(--lime);font-size:clamp(27px,3.5vw,53px);font-weight:700;letter-spacing:-.07em}.coffee-roastery-ledger h3{margin:2px 0 16px;color:#fff;font-size:clamp(24px,2.5vw,38px);line-height:.96;letter-spacing:-.065em}.coffee-roastery-ledger p{max-width:470px;margin:0;color:#d3dfd4;font-size:14px;line-height:1.7}

