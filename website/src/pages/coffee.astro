---
import PageShell from '../layouts/PageShell.astro'
import ContentBlocks from '../components/ContentBlocks.astro'
import ProductCard from '../components/ProductCard.astro'
import { getManagedPage, getProducts } from '../lib/public-api'
const [products,page] = await Promise.all([getProducts('COFFEE'),getManagedPage('COFFEE')])
---
<PageShell title="Кофе" description="Кофе собственной обжарки «Чашки кофе»." active="coffee">
  <section class="coffee-opening"><div><p>Собственная обжарка с 2017 года</p><h1>Сначала<br/>слышим<br/>зерно</h1><span>Ищем лоты с чистым характером, потом помогаем им раскрыться в чашке.</span><a class="button" href="#catalog">К каталогу</a></div><figure><img src="/images/home-morning-v2.png" alt="Кофе собственной обжарки"/><figcaption>15 кг · Giesen · Новосибирск</figcaption></figure></section>
  <section class="coffee-manifesto"><p>Что для нас важно</p><h2>Не спрятать вкус за сложными словами.</h2><div><span>Сезонные specialty-лоты из Эфиопии, Колумбии и Бразилии.</span><span>Профиль обжарки под каждый лот, а не универсальный рецепт.</span><span>Кофе, который работает и в ресторане, и в вашем домашнем ритуале.</span></div></section>
  {page && <ContentBlocks blocks={page.blocks}/>} 
  <section id="catalog" class="product-catalog"><header><p>Кофе для дома</p><h2>Выберите свою чашку</h2><span>Нажмите на карточку, чтобы узнать о лоте, обработке и вариантах фасовки.</span></header>{products.length ? <div>{products.map((product) => <ProductCard product={product}/>)}</div> : <p class="catalog-empty">Каталог появится после запуска локального API.</p>}</section>
  <section class="coffee-work"><div><p>Команда обжарки</p><h2>Любопытство сильнее готовых ответов.</h2></div><div><p>Если вам интересны кофе, ремесло и работа с людьми — давайте знакомиться.</p><a class="button" href="/jobs">Смотреть вакансии</a></div></section>
</PageShell>
<style>
  .coffee-opening{display:grid;grid-template-columns:.86fr 1.14fr;min-height:690px;overflow:hidden;border-radius:var(--radius);background:#e9e1d6}.coffee-opening>div{display:flex;justify-content:flex-end;align-items:flex-start;padding:clamp(55px,6.5vw,105px);flex-direction:column}.coffee-opening p,.coffee-manifesto>p,.product-catalog header p,.coffee-work>div>p{margin:0;color:#6f902b;font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.coffee-opening h1{margin:20px 0;font-size:clamp(60px,6.3vw,105px);line-height:.82}.coffee-opening span{max-width:440px;color:var(--muted);font-size:15px;line-height:1.65}.coffee-opening .button{margin-top:28px;padding:0 22px}.coffee-opening figure{position:relative;margin:0}.coffee-opening figure img{width:100%;height:100%;object-fit:cover}.coffee-opening figcaption{position:absolute;right:20px;bottom:20px;padding:10px 13px;border-radius:var(--radius);background:rgba(252,251,248,.9);font-size:9px;font-weight:700}.coffee-manifesto{padding:clamp(100px,12vw,190px) var(--content-gutter)}.coffee-manifesto h2{max-width:1250px;margin:19px 0 65px;font-size:clamp(48px,6vw,96px)}.coffee-manifesto>div{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;border-top:1px solid var(--line)}.coffee-manifesto span{padding-top:22px;color:var(--muted);font-size:13px;line-height:1.65}.product-catalog{padding:clamp(90px,10vw,160px) var(--content-gutter)}.product-catalog header{max-width:900px;margin-bottom:52px}.product-catalog h2{margin:15px 0;font-size:clamp(44px,5vw,82px)}.product-catalog header>span{color:var(--muted);font-size:14px;line-height:1.6}.product-catalog>div{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.catalog-empty{padding:30px;border-radius:var(--radius);background:var(--sand)}.coffee-work{display:grid;grid-template-columns:1.35fr .65fr;gap:60px;padding:clamp(50px,7vw,105px);border-radius:var(--radius);background:var(--moss);color:#fff}.coffee-work h2{max-width:920px;margin:18px 0 0;font-size:clamp(44px,5.4vw,88px)}.coffee-work>div:last-child{align-self:end}.coffee-work>div:last-child p{color:#d9e2da;font-size:14px;line-height:1.65}.coffee-work .button{margin-top:24px;padding:0 22px;background:var(--lime)!important;color:var(--moss)!important}@media(max-width:900px){.coffee-opening{grid-template-columns:1fr}.coffee-opening>div{min-height:560px;padding:48px 25px}.coffee-opening figure{height:380px}.coffee-manifesto>div,.product-catalog>div{grid-template-columns:1fr}.coffee-manifesto{padding:82px 20px}.product-catalog{padding:82px 20px}.coffee-work{margin:0 12px;grid-template-columns:1fr;padding:50px 25px}.coffee-work h2{font-size:48px}}
</style>
