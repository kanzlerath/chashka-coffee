---
import PageShell from '../layouts/PageShell.astro'
import ProductCard from '../components/ProductCard.astro'
import { getProducts } from '../lib/public-api'

const products = await getProducts('COFFEE')
const productGroups = products.reduce((groups, product) => {
  const name = product.subtitle || 'Кофе'
  const group = groups.find((item) => item.name === name)
  if (group) group.products.push(product)
  else groups.push({ id: `coffee-group-${groups.length + 1}`, name, products: [product] })
  return groups
}, [] as Array<{ id: string; name: string; products: typeof products }>)

const heroImage = '/images/coffee-editorial-v1.webp'
const tasteGallery = [
  { name: 'Абрикос', detail: 'сочная сладость и мягкая кислотность', image: '/images/coffee-taste-apricot-v1.webp' },
  { name: 'Шоколад', detail: 'плотность, какао и долгий тёплый шлейф', image: '/images/coffee-taste-chocolate-v1.webp' },
  { name: 'Персик', detail: 'бархатистый аромат и лёгкая свежесть', image: '/images/coffee-taste-peach-v1.webp' },
]
---

<PageShell title="Кофе" description="Кофе собственной обжарки «Чашки кофе»." active="coffee" image={heroImage}>
  <div class="coffee-page">
    <section class="coffee-cover" aria-labelledby="coffee-title">
      <figure class="coffee-cover-visual"><img src={heroImage} alt="Кофе собственной обжарки" /></figure>
      <div class="coffee-cover-copy">
        <h1 id="coffee-title"><span>Кофе —</span><em>наша работа.</em></h1>
        <p>Выбираем зерно, строим профиль обжарки и каждый день настраиваем вкус в чашке.</p>
      </div>
      <div class="coffee-cover-dock" aria-label="Навигация по странице">
        <div class="coffee-cover-well coffee-cover-well--catalog">
          <span class="coffee-cover-shadow coffee-cover-shadow--side" aria-hidden="true"></span>
          <span class="coffee-cover-shadow coffee-cover-shadow--floor" aria-hidden="true"></span>
          <a class="coffee-cover-action" href="#catalog">Выбрать кофе</a>
        </div>
        <div class="coffee-cover-well coffee-cover-well--roastery">
          <span class="coffee-cover-shadow coffee-cover-shadow--side" aria-hidden="true"></span>
          <span class="coffee-cover-shadow coffee-cover-shadow--floor" aria-hidden="true"></span>
          <a class="coffee-cover-action" href="#coffee-production">Как мы обжариваем</a>
        </div>
      </div>
    </section>

    <section class="coffee-story" aria-labelledby="coffee-story-title" data-coffee-reveal>
      <div class="coffee-story-title"><h2 id="coffee-story-title">Сначала<br/><em>урожай.</em></h2></div>
      <div class="coffee-story-copy">
        <p>Для кофе мы берём specialty-сорта и лучшие лоты, которые приезжают к нам от фермеров из Колумбии, Эфиопии, Бразилии и других стран. У каждого зерна есть свой климат, высота, способ обработки и характер — мы не пытаемся это сгладить.</p>
        <p>Наши специалисты ездят на плантации, пробуют урожаи и узнают, как меняется вкус кофе от сезона к сезону. Так в Новосибирск попадают не случайные зёрна, а те, с которыми хочется работать дальше — искать их ясный, живой вкус.</p>
      </div>
    </section>

    <section id="coffee-production" class="coffee-roastery" aria-labelledby="coffee-production-title">
      <div class="coffee-roastery-intro"><h2 id="coffee-production-title">Свой<br/><em>ростер.</em><br/>Свой вкус.</h2><p>Обжарочное производство находится в двух ресторанах «Чашка кофе» в центре Новосибирска.</p></div>
      <div class="coffee-roastery-ledger">
        <article data-coffee-reveal><span>2017</span><div><h3>Обжариваем самостоятельно</h3><p>С этого года всё привезённое зерно проходит обжарку у нашей команды — от первого тестового профиля до партии для ресторанов.</p></div></article>
        <article data-coffee-reveal><span>15 кг</span><div><h3>Работаем на Giesen</h3><p>Размер ростера позволяет держать вкус стабильным и при этом внимательно работать с каждым отдельным лотом.</p></div></article>
        <article data-coffee-reveal><span>°C + время</span><div><h3>Не используем один рецепт</h3><p>Для каждого сорта заново подбираем температуру, время и другие параметры, которые влияют на аромат и вкус кофе.</p></div></article>
      </div>
    </section>

    <section class="coffee-senses" aria-labelledby="coffee-senses-title">
      <header><h2 id="coffee-senses-title">Вкус можно<br/><em>увидеть.</em></h2></header>
      <div class="coffee-sense-gallery">{tasteGallery.map((taste) => <article class="coffee-sense-card" tabindex="0"><img src={taste.image} alt={taste.name} loading="lazy"/><div><h3>{taste.name}</h3><p>{taste.detail}</p></div></article>)}</div>
    </section>

    <section id="catalog" class="coffee-catalog" aria-label="Каталог кофе">
      {productGroups.length ? <div class="coffee-catalog-layout"><aside class="coffee-catalog-nav"><nav aria-label="Категории кофе">{productGroups.map((group) => <a href={`#${group.id}`}>{group.name}</a>)}</nav></aside><div class="coffee-catalog-groups">{productGroups.map((group) => <section id={group.id} class="coffee-catalog-group"><h2>{group.name}</h2><div class="coffee-catalog-items">{group.products.map((product) => <ProductCard product={product} presentation="menu"/>)}</div></section>)}</div></div> : <p class="catalog-empty">Каталог появится после запуска локального API.</p>}
    </section>

    <section class="coffee-ending" data-coffee-reveal aria-labelledby="coffee-ending-title">
      <div class="coffee-ending-copy">
        <h2 id="coffee-ending-title">К кофе —<br/><em>что-нибудь сладкое.</em></h2>
        <p>Завтраки, десерты и блюда, ради которых хочется продлить встречу ещё на один заказ.</p>
        <a href="/menu">Открыть меню</a>
      </div>
      <img class="coffee-ending-art" src="/images/coffee-dessert-cup.svg" alt="" aria-hidden="true" />
    </section>
  </div>
</PageShell>

<script>
  const reduceCoffeeMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const coffeeRevealItems = document.querySelectorAll<HTMLElement>('[data-coffee-reveal]')
  if (reduceCoffeeMotion || !('IntersectionObserver' in window)) {
    coffeeRevealItems.forEach((item) => item.classList.add('is-visible'))
  } else {
    const coffeeRevealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return
        entry.target.classList.add('is-visible')
        coffeeRevealObserver.unobserve(entry.target)
      })
    }, { threshold: 0.18 })
    coffeeRevealItems.forEach((item) => coffeeRevealObserver.observe(item))
  }
</script>

<style>
