  @media(max-width:1180px){.coffee-catalog-items{grid-template-columns:repeat(2,minmax(0,1fr))}.coffee-roastery-ledger article{grid-template-columns:115px minmax(0,1fr)}}
  @media(max-width:900px){.coffee-page{--coffee-edge:20px}.coffee-cover{height:calc(100svh - 116px);min-height:610px;margin:0 var(--mobile-gutter);padding:38px 25px 110px}.coffee-cover:after{background:linear-gradient(0deg,rgba(22,21,18,.82) 0%,rgba(22,21,18,.45) 60%,rgba(22,21,18,.08) 100%)}.coffee-cover h1{margin-bottom:25px;font-size:clamp(52px,15vw,66px);line-height:.73}.coffee-cover h1 em{margin-left:8px}.coffee-cover-copy>p{font-size:15px}.coffee-cover-visual img{object-position:56% center}.coffee-cover-dock{gap:8px}.coffee-cover-well{min-height:56px;padding:0 8px}.coffee-cover-well--catalog{padding-left:0}.coffee-cover-well--roastery{padding-right:0}.coffee-cover-action{min-height:48px;padding:0 15px;font-size:8px}.coffee-story{display:block;margin:88px var(--coffee-edge)}.coffee-story-title h2{font-size:clamp(47px,13vw,61px)}.coffee-story-title em{margin-left:8px}.coffee-story-copy{gap:17px;margin-top:33px;padding:0}.coffee-story-copy p{font-size:16px}.coffee-roastery{display:block;margin:0 12px;padding:48px 25px}.coffee-roastery-intro{position:static}.coffee-roastery h2{font-size:clamp(50px,14vw,65px)}.coffee-roastery-ledger{margin-top:52px}.coffee-roastery-ledger article{grid-template-columns:1fr;gap:18px;min-height:0;padding:28px 0}.coffee-roastery-ledger article>span{font-size:34px}.coffee-roastery-ledger h3{font-size:28px}.coffee-senses{padding:82px 0}.coffee-senses header{display:block;margin:0 var(--coffee-edge) 29px}.coffee-senses h2{font-size:clamp(49px,13vw,62px)}.coffee-sense-gallery{min-height:430px}.coffee-sense-card{flex-basis:0}.coffee-sense-card div{right:16px;bottom:17px;left:16px}.coffee-sense-card h3{font-size:31px}.coffee-sense-card p{font-size:11px}.coffee-catalog{padding:0 var(--mobile-gutter) 88px}.coffee-catalog-layout{display:block;padding-top:18px}.coffee-catalog-nav{position:static;height:auto;min-height:0;margin-bottom:34px;overflow:auto;padding:9px;border:1px solid var(--line);border-radius:18px;background:rgba(252,251,248,.58);s