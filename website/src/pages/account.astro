---
import PageShell from '../layouts/PageShell.astro'
---

<PageShell
  title="Личный кабинет"
  description="Бонусная карта, баланс и будущие онлайн-заказы «Чашки кофе»."
  noindex
>
  <div class="account-page">
    <section class="account-loading" data-account-page-loading aria-live="polite">
      <span aria-hidden="true"></span>
      Проверяем вашу сессию…
    </section>

    <section class="account-welcome" data-account-page-signed-out hidden aria-labelledby="account-welcome-title">
      <div class="account-welcome-copy">
        <h1 id="account-welcome-title">Личный кабинет</h1>
        <p>Бонусная карта, баланс и ваши данные — в одном спокойном месте.</p>
        <button type="button" data-account-trigger>Войти по номеру телефона</button>
      </div>
      <div class="account-welcome-note">
        <span class="account-qr-glyph" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM15 14h2v2h-2zM19 14h2v2h-2zM14 18h2v3h-2zM18 18h3v3h-3z" /></svg>
        </span>
        <h2>Ваша карта уже здесь</h2>
        <p>Войдите по номеру, который привязан к бонусной программе. Регистрация новой карты пока остаётся в приложении.</p>
      </div>
    </section>

    <div class="account-dashboard" data-account-page-dashboard hidden>
      <section class="account-overview" aria-labelledby="account-title">
        <div class="account-overview-copy">
          <h1 id="account-title">Здравствуйте, <span data-account-page-name>гость</span></h1>
          <p>Здесь собраны ваша бонусная карта, актуальный баланс и контактные данные.</p>
          <button class="account-show-qr" type="button" data-account-trigger>
            <img src="/icons/qr-code.svg" width="20" height="20" alt="" aria-hidden="true" />
            Показать QR-код
          </button>
        </div>
        <div class="account-balance" aria-label="Баланс бонусов">
          <span>Доступно сейчас</span>
          <strong data-account-page-balance>—</strong>
          <small>бонусов</small>
          <p>Баланс обновляется напрямую из бонусной системы.</p>
        </div>
      </section>

      <section class="account-details" aria-labelledby="account-details-title">
        <header>
          <h2 id="account-details-title">Ваши данные</h2>
          <span>Данные доступны только для просмотра. Если что-то изменилось, обратитесь в поддержку.</span>
        </header>
        <dl>
          <div><dt>Имя</dt><dd data-account-page-full-name>—</dd></div>
          <div><dt>Телефон</dt><dd data-account-page-phone>—</dd></div>
          <div><dt>E-mail</dt><dd data-account-page-email>Не указан</dd></div>
          <div><dt>Номер карты</dt><dd data-account-page-card>Не указан</dd></div>
        </dl>
      </section>

      <section class="account-orders" aria-labelledby="account-orders-title">
        <header>
          <h2 id="account-orders-title">История заказов</h2>
        </header>
        <div class="account-order-list" data-account-order-list hidden></div>
        <div class="account-orders-empty" data-account-orders-empty>
          <span class="account-orders-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M6 8h12l-1 12H7L6 8Zm3 0V6a3 3 0 0 1 6 0v2" /></svg>
          </span>
          <div>
            <strong>Здесь появятся заказы кофе с сайта</strong>
            <p>Покупки в ресторанах сюда не попадут. История начнёт заполняться, когда мы запустим онлайн-заказ.</p>
          </div>
        </div>
      </section>

      <section class="account-service" aria-label="Управление аккаунтом">
        <div><p>Нужно изменить данные или удалить аккаунт?</p><a href="/contacts">Обратитесь в поддержку</a></div>
        <button type="button" data-account-page-logout>Выйти из аккаунта</button>
      </section>
    </div>

    <section class="account-page-error" data-account-page-error hidden role="alert">
      <h1>Сейчас не получается</h1>
      <span data-account-page-error-copy>Попробуйте обновить страницу немного позже.</span>
      <button type="button" data-account-page-retry>Попробовать снова</button>
      <a href="/contacts">Обратиться в поддержку</a>
    </section>
  </div>
</PageShell>

<script>
  import type { CustomerProfile, Order, OrderStatus } from '@chashka-coffee/contracts'
  import { CustomerAccountApiError, customerAccountApi } from '../lib/customer-account-api'

  const loading = document.querySelector<HTMLElement>('[data-account-page-loading]')
  const signedOut = document.querySelector<HTMLElement>('[data-account-page-signed-out]')
  const dashboard = document.querySelector<HTMLElement>('[data-account-page-dashboard]')
  const errorView = document.querySelector<HTMLElement>('[data-account-page-error]')
  const errorCopy = document.querySelector<HTMLElement>('[data-account-page-error-copy]')
  const orderList = document.querySelector<HTMLElement>('[data-account-order-list]')
  const ordersEmpty = document.querySelector<HTMLElement>('[data-account-orders-empty]')
  const orderStatusLabel: Record<OrderStatus, string> = {
    AWAITING_PAYMENT: 'Ожидает оплаты', PAID: 'Оплачен', PREPARING: 'Готовится',
    READY_FOR_PICKUP: 'Готов к выдаче', COMPLETED: 'Выдан', CANCELLED: 'Отменён',
  }

  function showOnly(target: HTMLElement | null) {
    ;[loading, signedOut, dashboard, errorView].forEach((view) => { if (view) view.hidden = view !== target })
  }

  function formatPhone(phone: string) {
    const digits = phone.replace(/\D/g, '').replace(/^8/, '7')
    if (!/^7\d{10}$/.test(digits)) return phone
    return `+7 ${digits.slice(1, 4)} ${digits.slice(4, 7)}-${digits.slice(7, 9)}-${digits.slice(9)}`
  }

  function setText(selector: string, value: string) {
    document.querySelectorAll<HTMLElement>(selector).forEach((node) => { node.textContent = value })
  }

  function renderCustomer(customer: CustomerProfile | null) {
    if (!customer) { showOnly(signedOut); return }
    const fullName = [customer.surname, customer.name, customer.middleName].filter(Boolean).join(' ') || 'Не указано'
    setText('[data-account-page-name]', customer.name || 'гость')
    setText('[data-account-page-full-name]', fullName)
    setText('[data-account-page-phone]', formatPhone(customer.phone))
    setText('[data-account-page-email]', customer.email || 'Не указан')
    setText('[data-account-page-card]', customer.cardNumber || 'Не указан')
    setText('[data-account-page-balance]', new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 2 }).format(customer.balance))
    showOnly(dashboard)
  }

  function renderOrders(orders: Order[]) {
    orderList?.replaceChildren()
    orderList?.toggleAttribute('hidden', orders.length === 0)
    ordersEmpty?.toggleAttribute('hidden', orders.length > 0)
    for (const order of orders) {
      const article = document.createElement('article')
      const header = document.createElement('div')
      const number = document.createElement('strong'); number.textContent = order.publicNumber
      const status = document.createElement('span'); status.textContent = orderStatusLabel[order.status]
      header.append(number, status)
      const pickup = document.createElement('p'); pickup.textContent = `${order.pickupLocation.address} · ${new Date(order.createdAt).toLocaleDateString('ru-RU')}`
      const summary = document.createElement('small'); summary.textContent = `${order.items.map((item) => `${item.productName}, ${item.variantLabel}`).join(' · ')} · ${(order.totalKopecks / 100).toLocaleString('ru-RU')} ₽`
      article.append(header, pickup, summary)
      orderList?.append(article)
    }
  }

  async function loadOrders() {
    try { renderOrders(await customerAccountApi.getOrders()) }
    catch { renderOrders([]) }
  }

  function showError(error: unknown) {
    if (errorCopy) {
      errorCopy.textContent = error instanceof CustomerAccountApiError && error.code === 'CUSTOMER_BLOCKED'
        ? 'Доступ к карте ограничен. Обратитесь в поддержку — мы поможем разобраться.'
        : 'Бонусная система временно недоступна. Попробуйте обновить страницу немного позже.'
    }
    showOnly(errorView)
  }

  async function loadAccount() {
    showOnly(loading)
    try {
      const customer = await customerAccountApi.getProfile()
      renderCustomer(customer)
      if (customer) await loadOrders()
    }
    catch (error) { showError(error) }
  }

  document.addEventListener('customer-account:changed', (event) => {
    const customer = (event as CustomEvent<{ customer: CustomerProfile | null }>).detail.customer
    renderCustomer(customer)
    if (customer) void loadOrders()
    else renderOrders([])
  })
  document.querySelector('[data-account-page-retry]')?.addEventListener('click', () => void loadAccount())
  document.querySelector('[data-account-page-logout]')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement
    button.disabled = true
    try {
      await customerAccountApi.logout()
      renderCustomer(null)
      document.dispatchEvent(new CustomEvent('customer-account:changed', { detail: { customer: null } }))
    } catch (error) {
      showError(error)
    } finally {
      button.disabled = false
    }
  })
  void loadAccount()
</script>

<style is:global>
  .account-page{display:grid;gap:12px;color:#1f3b2e}.account-page [hidden]{display:none}.account-loading{display:flex;min-height:520px;align-items:center;justify-content:center;gap:14px;border-radius:var(--radius);background:#f3eee7;color:#6c665f;font-size:11px}.account-loading span{width:25px;height:25px;border:2px solid #d6ddcd;border-top-color:#6f902b;border-radius:50%;animation:account-spin .8s linear infinite}
  .account-welcome{display:grid;min-height:530px;padding:clamp(44px,6vw,82px);grid-template-columns:minmax(0,1.05fr) minmax(300px,.75fr);gap:clamp(44px,7vw,110px);align-items:center;border-radius:var(--radius);background:#f0eee8}.account-welcome-copy{max-width:560px}.account-welcome h1,.account-overview h1,.account-page-error h1{margin:0;color:#1f3b2e;font-size:clamp(42px,5.2vw,72px);line-height:.96;letter-spacing:-.065em}.account-welcome-copy>p,.account-overview-copy>p{max-width:470px;margin:22px 0 0;color:#69645d;font-size:13px;line-height:1.65}.account-welcome-note{padding-left:clamp(30px,4vw,58px);border-left:1px solid #d8d4cc}.account-qr-glyph{display:grid;width:58px;height:58px;margin-bottom:25px;border-radius:18px;place-items:center;background:#1f3b2e;color:#bdd65a}.account-qr-glyph svg{width:29px;fill:currentColor}.account-welcome h2{margin:0 0 15px;color:#1f3b2e;font-size:clamp(27px,2.6vw,38px);line-height:1;letter-spacing:-.045em}.account-welcome-note>p{margin:0;color:#69645d;font-size:12px;line-height:1.65}.account-welcome button,.account-page-error button{min-height:50px;margin-top:28px;padding:0 23px;border:0;border-radius:var(--radius);background:#1f3b2e;color:#fff;cursor:pointer;font-size:11px;font-weight:800;transition:background .2s ease,transform .2s ease}.account-welcome button:hover,.account-page-error button:hover{background:#294d3b;transform:translateY(-1px)}
  .account-dashboard{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(320px,.65fr);gap:12px}.account-overview{grid-column:1/-1;display:grid;min-height:410px;padding:clamp(44px,6vw,82px);grid-template-columns:minmax(0,1.2fr) minmax(300px,.58fr);gap:clamp(42px,7vw,100px);align-items:center;border-radius:var(--radius);background:#f0eee8}.account-overview-copy{display:flex;align-items:flex-start;flex-direction:column}.account-overview h1{max-width:760px}.account-overview h1 span{color:#6f902b}.account-show-qr{display:inline-flex;min-height:50px;margin-top:30px;padding:0 21px;border:0;border-radius:var(--radius);align-items:center;gap:10px;background:#1f3b2e;color:#fff;cursor:pointer;font-size:11px;font-weight:800;transition:background .2s ease,transform .2s ease}.account-show-qr img{width:19px;height:19px;filter:invert(1)}.account-show-qr:hover{background:#294d3b;transform:translateY(-1px)}.account-balance{display:flex;min-height:260px;padding:clamp(28px,3.5vw,44px);border-radius:var(--radius);align-items:flex-start;background:#1f3b2e;color:#fff;flex-direction:column}.account-balance>span{color:#bdd65a;font-size:9px;font-weight:800;letter-spacing:.11em;text-transform:uppercase}.account-balance strong{margin-top:auto;color:#fff;font-size:clamp(64px,7vw,94px);line-height:.82;letter-spacing:-.08em}.account-balance small{margin-top:13px;color:#bdd65a;font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.account-balance p{max-width:260px;margin:21px 0 0;padding-top:16px;border-top:1px solid rgba(255,255,255,.2);color:#dfe6e1;font-size:10px;line-height:1.5}
  .account-details,.account-orders{min-width:0;padding:clamp(38px,4.5vw,62px);border-radius:var(--radius)}.account-details{background:#fcfbf8}.account-orders{background:#e4eadb}.account-details h2,.account-orders h2{margin:0;color:#1f3b2e;font-size:clamp(28px,3vw,40px);line-height:1;letter-spacing:-.045em}.account-details header>span{display:block;max-width:410px;margin-top:15px;color:#6c665f;font-size:11px;line-height:1.6}.account-details dl{margin:31px 0 0}.account-details dl>div{display:grid;min-height:66px;padding:15px 0;grid-template-columns:135px 1fr;align-items:center;border-top:1px solid #ded9d1}.account-details dl>div:last-child{border-bottom:1px solid #ded9d1}.account-details dt{color:#79736c;font-size:9px;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.account-details dd{margin:0;color:#1f3b2e;font-size:13px;font-weight:650;overflow-wrap:anywhere}
  .account-orders{display:flex;min-height:100%;flex-direction:column}.account-order-list{display:grid;margin-top:28px}.account-order-list[hidden]{display:none}.account-order-list article{padding:17px 0;border-top:1px solid #cbd3c1}.account-order-list article>div{display:flex;align-items:center;justify-content:space-between;gap:16px}.account-order-list article strong{font-size:13px}.account-order-list article span{padding:6px 8px;border-radius:10px;background:#1f3b2e;color:#bdd65a;font-size:7px;font-weight:850;text-transform:uppercase}.account-order-list article p{margin:8px 0 5px;color:#596156;font-size:9px}.account-order-list article small{display:block;color:#737b70;font-size:9px;line-height:1.5}.account-orders-empty{display:grid;margin-top:auto;padding-top:42px;grid-template-columns:52px 1fr;gap:20px;align-items:start}.account-orders-icon{display:grid;width:52px;height:52px;border-radius:16px;place-items:center;background:#1f3b2e;color:#bdd65a}.account-orders-icon svg{width:24px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.7}.account-orders-empty strong{display:block;color:#1f3b2e;font-size:16px;line-height:1.35}.account-orders-empty p{margin:9px 0 0;color:#62685e;font-size:11px;line-height:1.6}.account-service{grid-column:1/-1;display:flex;padding:26px clamp(26px,4vw,52px);border-radius:var(--radius);align-items:center;justify-content:space-between;gap:30px;background:#f0eee8}.account-service p{margin:0 0 7px;color:#69645d;font-size:10px}.account-service a{color:#1f3b2e;font-size:12px;font-weight:800;text-underline-offset:3px}.account-service button{padding:10px 0;border:0;background:transparent;color:#1f3b2e;cursor:pointer;font-size:11px;font-weight:800;text-decoration:underline;text-underline-offset:3px}.account-service button:disabled{opacity:.5}
  .account-page-error{min-height:500px;padding:clamp(48px,7vw,94px);border-radius:var(--radius);background:#f3eee7}.account-page-error h1{max-width:680px;margin-bottom:23px}.account-page-error>span{display:block;max-width:480px;color:#675f58;font-size:13px;line-height:1.6}.account-page-error>a{display:inline-block;margin-left:20px;color:#1f3b2e;font-size:11px;font-weight:800;text-underline-offset:3px}
  @keyframes account-spin{to{transform:rotate(360deg)}}
  @media(max-width:900px){.account-welcome,.account-overview{grid-template-columns:1fr}.account-welcome{min-height:0;padding:60px 34px;gap:52px}.account-welcome-note{max-width:560px;padding:38px 0 0;border-top:1px solid #d8d4cc;border-left:0}.account-dashboard{grid-template-columns:1fr}.account-overview{padding:58px 28px 28px;gap:44px}.account-balance{min-height:240px}.account-details,.account-orders{padding:48px 28px}.account-orders{min-height:330px}.account-service{grid-column:1;padding:26px 24px}.account-page-error{padding:68px 28px}}
  @media(max-width:520px){.account-loading,.account-welcome,.account-overview,.account-details,.account-orders,.account-service,.account-page-error{border-radius:0}.account-welcome{padding:52px 24px}.account-welcome h1,.account-overview h1,.account-page-error h1{font-size:40px}.account-overview{padding:50px 20px 20px}.account-balance strong{font-size:70px}.account-details,.account-orders{padding:42px 24px}.account-details dl>div{grid-template-columns:105px 1fr}.account-orders-empty{grid-template-columns:46px 1fr;gap:16px}.account-orders-icon{width:46px;height:46px}.account-service{align-items:flex-start;flex-direction:column}.account-page-error>a{display:block;margin:20px 0 0}}
  @media(prefers-reduced-motion:reduce){.account-loading span{animation-duration:.01ms}}
</style>
