---
import PageShell from '../layouts/PageShell.astro'
import ContentBlocks from '../components/ContentBlocks.astro'
import StoreBadges from '../components/StoreBadges.astro'
import { getManagedPage } from '../lib/public-api'

const page = await getManagedPage('LOYALTY')
const levels = [
  ['01','3%','После регистрации'],
  ['02','7%','От 20 000 ₽ оборота'],
  ['03','10%','От 50 000 ₽ оборота'],
  ['04','15%','От 100 000 ₽ оборота'],
  ['05','20%','VIP от 200 000 ₽'],
]
---
<PageShell title="Программа лояльности" description="DI Bonus в ресторанах «Чашка кофе»." active="loyalty">
  <section class="loyalty-opening"><div><p>Denis Ivanov Bonus Card</p><h1>Любимое<br/>возвращается</h1><span>Электронная карта живёт в смартфоне: показывайте её в ресторане, копите бонусы и открывайте новые уровни.</span><StoreBadges/></div><div class="loyalty-phone" aria-hidden="true"><small>DI BONUS</small><strong>3%</strong><span>ваш уровень</span><i>500 приветственных бонусов</i></div></section>
  <section class="welcome-bonus"><strong>500</strong><div><h2>Бонусов после первого использования</h2><p>Они действуют 10 дней, и ими можно оплатить до 20% чека.</p></div></section>
  <section class="loyalty-levels"><header><p>Уровни программы</p><h2>Чаще встречаемся —<br/>больше возвращаем</h2></header><div>{levels.map(([number,percent,condition]) => <article><b>{number}</b><strong>{percent}</strong><span>{condition}</span></article>)}</div><small>Условия повышения и сохранения уровня зависят от оборота по карте и активности гостя. Актуальные правила доступны в личном кабинете программы.</small></section>
  <section class="loyalty-how"><article><b>01</b><h3>Откройте карту</h3><p>Зарегистрируйтесь в приложении и заполните профиль.</p></article><article><b>02</b><h3>Показывайте в ресторане</h3><p>Бонусы начисляются после каждой покупки по правилам программы.</p></article><article><b>03</b><h3>Проверяйте баланс</h3><p>Уровень, срок действия подарочных бонусов и история — в электронной карте.</p></article></section>
  {page && <ContentBlocks blocks={page.blocks}/>} 
</PageShell>
<style>
  .loyalty-opening{display:grid;grid-template-columns:1fr 1fr;min-height:690px;align-items:center;overflow:hidden;border-radius:var(--radius);background:var(--moss);color:#fff}.loyalty-opening>div:first-child{padding:clamp(48px,7vw,110px)}.loyalty-opening p,.loyalty-levels header>p{margin:0;color:var(--lime);font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.loyalty-opening h1{margin:18px 0;font-size:clamp(56px,5.8vw,96px);line-height:.85}.loyalty-opening>div:first-child>span{display:block;max-width:480px;color:#d5dfd7;font-size:14px;line-height:1.65}.loyalty-opening :global(.store-badges){margin-top:28px}.loyalty-phone{justify-self:center;width:270px;height:500px;padding:68px 28px;border:10px solid #101a14;border-radius:42px;background:#fcfbf8;color:var(--ink);box-shadow:24px 25px 0 rgba(188,219,61,.18);transform:rotate(5deg)}.loyalty-phone small{color:#77912e;font-size:10px;font-weight:800}.loyalty-phone strong{display:block;margin-top:72px;font-size:100px;line-height:.8}.loyalty-phone span{display:block;margin-top:12px;color:var(--muted);font-size:12px}.loyalty-phone i{display:block;margin-top:120px;padding:14px;border-radius:var(--radius);background:var(--lime);font-size:11px;font-style:normal;font-weight:700;text-align:center}.welcome-bonus{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:clamp(35px,7vw,110px);padding:clamp(70px,9vw,140px) var(--content-gutter);border-bottom:1px solid var(--line)}.welcome-bonus>strong{color:#75922f;font-size:clamp(110px,17vw,290px);line-height:.75;letter-spacing:-.12em}.welcome-bonus h2{max-width:700px;margin:0;font-size:clamp(32px,4vw,65px)}.welcome-bonus p{max-width:570px;margin:20px 0 0;color:var(--muted);font-size:14px;line-height:1.65}.loyalty-levels{padding:clamp(90px,11vw,170px) var(--content-gutter)}.loyalty-levels h2{margin:16px 0 54px;font-size:clamp(43px,4.8vw,78px)}.loyalty-levels>div{border-top:1px solid var(--line)}.loyalty-levels article{display:grid;grid-template-columns:80px 150px 1fr;align-items:center;padding:22px 0;border-bottom:1px solid var(--line)}.loyalty-levels article b{color:#71902b;font-size:10px}.loyalty-levels article strong{font-size:36px}.loyalty-levels article span{color:var(--muted);font-size:13px}.loyalty-levels>small{display:block;max-width:760px;margin-top:24px;color:var(--muted);font-size:11px;line-height:1.6}.loyalty-how{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.loyalty-how article{min-height:320px;padding:30px;border-radius:var(--radius);background:#efebe4}.loyalty-how article:nth-child(2){background:#dfe8d2}.loyalty-how article:nth-child(3){background:var(--moss);color:#fff}.loyalty-how b{color:#71902b;font-size:10px}.loyalty-how h3{margin:110px 0 12px;font-size:26px}.loyalty-how p{max-width:360px;margin:0;color:var(--muted);font-size:12px;line-height:1.6}.loyalty-how article:nth-child(3) p{color:#d6dfd7}@media(max-width:820px){.loyalty-opening{grid-template-columns:1fr}.loyalty-opening>div:first-child{min-height:540px;padding:48px 25px}.loyalty-phone{margin:10px auto -70px;transform:rotate(4deg) scale(.82);transform-origin:bottom}.welcome-bonus{grid-template-columns:1fr;padding:82px 20px}.loyalty-levels{padding:82px 20px}.loyalty-levels article{grid-template-columns:42px 90px 1fr}.loyalty-how{grid-template-columns:1fr}.loyalty-how article{min-height:240px}.loyalty-how h3{margin-top:65px}}
</style>
