---
import PageShell from '../layouts/PageShell.astro'
---
<PageShell title="Оформление заказа" description="Самовывоз кофе собственной обжарки." active="coffee" noindex>
  <section class="checkout-page" aria-labelledby="checkout-title">
    <header class="checkout-heading"><p>Самовывоз</p><h1 id="checkout-title">Забрать кофе<br/>по пути.</h1><span>Выберите ресторан, оставьте контакты и проверьте заказ.</span></header>
    <div class="checkout-loading" data-checkout-loading><span aria-hidden="true"></span>Проверяем корзину…</div>
    <section class="checkout-empty" data-checkout-empty hidden><h2>Корзина пуста</h2><p>Добавьте кофе и вернитесь к оформлению.</p><a href="/coffee#catalog">Перейти к кофе</a></section>
    <form class="checkout-layout" data-checkout-form hidden novalidate>
      <div class="checkout-order">
        <div class="checkout-section-title"><span>01</span><h2>Ваш заказ</h2></div>
        <div class="checkout-lines" data-checkout-lines></div>
        <div class="checkout-total"><span>Итого</span><strong data-checkout-total>—</strong></div>
        <p class="checkout-price-note">Цена рассчитана сервером по актуальному каталогу.</p>
      </div>
      <div class="checkout-details">
        <fieldset class="checkout-fieldset checkout-pickup"><legend><span>02</span>Где забрать</legend><div data-pickup-locations></div></fieldset>
        <fieldset class="checkout-fieldset"><legend><span>03</span>Контакты</legend>
          <label>Имя<input name="name" autocomplete="name" maxlength="180" required placeholder="Как к вам обращаться" /></label>
          <label>Телефон<input name="phone" type="tel" inputmode="tel" autocomplete="tel" required placeholder="+7 (999) 000-00-00" /></label>
          <label>E-mail <small>необязательно</small><input name="email" type="email" autocomplete="email" maxlength="320" placeholder="name@example.com" /></label>
          <label>Комментарий <small>необязательно</small><textarea name="comment" maxlength="1000" placeholder="Например, позвонить, когда заказ будет готов"></textarea></label>
        </fieldset>
        <label class="checkout-consent"><input name="privacy" type="checkbox" required /><span>Согласен с <a href="/privacy" target="_blank">политикой конфиденциальности</a> и обработкой данных для оформления заказа.</span></label>
        <div class="checkout-payment-note"><strong>Оплата появится следующим шагом</strong><p>Сейчас заказ сохранится со статусом «Ожидает оплаты» и не уйдёт в приготовление.</p></div>
        <p class="checkout-error" data-checkout-error role="alert" hidden></p>
        <button class="checkout-submit" type="submit">Подтвердить заказ</button>
      </div>
    </form>
  </section>
</PageShell>

<script>
  import type { OrderQuoteResponse, PickupLocation } from '@chashka-coffee/contracts'
  import { clearCart, getCart } from '../lib/cart-store'
  import { attachRussianPhoneMask, formatRussianPhone } from '../lib/contact-fields'
  import { customerAccountApi } from '../lib/customer-account-api'
  import { StoreApiError, storeApi } from '../lib/store-api'

  const loading = document.querySelector<HTMLElement>('[data-checkout-loading]')
  const empty = document.querySelector<HTMLElement>('[data-checkout-empty]')
  const form = document.querySelector<HTMLFormElement>('[data-checkout-form]')
  const linesRoot = document.querySelector<HTMLElement>('[data-checkout-lines]')
  const locationsRoot = document.querySelector<HTMLElement>('[data-pickup-locations]')
  const total = document.querySelector<HTMLElement>('[data-checkout-total]')
  const errorNode = document.querySelector<HTMLElement>('[data-checkout-error]')
  const submit = form?.querySelector<HTMLButtonElement>('[type="submit"]')
  const money = (kopecks: number) => `${(kopecks / 100).toLocaleString('ru-RU')} ₽`
  let quote: OrderQuoteResponse | null = null
  let idempotencyKey = sessionStorage.getItem('chashka_checkout_idempotency') ?? crypto.randomUUID()
  sessionStorage.setItem('chashka_checkout_idempotency', idempotencyKey)

  const checkoutPhoneInput = form?.elements.namedItem('phone')
  if (checkoutPhoneInput instanceof HTMLInputElement) attachRussianPhoneMask(checkoutPhoneInput)

  function showError(message = '') {
    if (!errorNode) return
    errorNode.textContent = message
    errorNode.hidden = message.length === 0
  }

  function renderQuote(nextQuote: OrderQuoteResponse) {
    quote = nextQuote
    linesRoot?.replaceChildren()
    for (const item of nextQuote.items) {
      const row = document.createElement('article')
      const image = document.createElement('img'); image.src = item.imageUrl ?? '/images/home-morning-v2.png'; image.alt = ''
      const copy = document.createElement('div')
      const name = document.createElement('strong'); name.textContent = item.productName
      const detail = document.createElement('span'); detail.textContent = `${item.variantLabel} · ${item.quantity} шт.`
      copy.append(name, detail)
      const price = document.createElement('b'); price.textContent = money(item.totalKopecks)
      row.append(image, copy, price)
      linesRoot?.append(row)
    }
    if (total) total.textContent = money(nextQuote.totalKopecks)
  }

  function renderLocations(locations: PickupLocation[]) {
    locationsRoot?.replaceChildren()
    for (const [index, location] of locations.entries()) {
      const label = document.createElement('label')
      const input = document.createElement('input'); input.type = 'radio'; input.name = 'pickupRestaurantId'; input.value = location.id; input.required = true; input.checked = index === 0
      const copy = document.createElement('span')
      const name = document.createElement('strong'); name.textContent = location.name.replace(/^Чашка кофе\s*[—-]\s*/i, '')
      const address = document.createElement('b'); address.textContent = `${location.city}, ${location.address}`
      const hours = document.createElement('small'); hours.textContent = location.openingHoursLabel
      copy.append(name, address, hours)
      label.append(input, copy)
      locationsRoot?.append(label)
    }
  }

  async function load() {
    const cart = getCart()
    if (cart.length === 0) {
      loading?.setAttribute('hidden', '')
      empty?.removeAttribute('hidden')
      return
    }
    try {
      const [quoted, pickupResponse, customer] = await Promise.all([
        storeApi.quote(cart.map(({ variantId, quantity }) => ({ variantId, quantity }))),
        storeApi.pickupLocations(),
        customerAccountApi.getProfile().catch(() => null),
      ])
      if (quoted.unavailableLines.length > 0 || quoted.items.length === 0) throw new Error('Некоторые позиции больше недоступны. Уберите их из корзины и попробуйте снова.')
      if (pickupResponse.locations.length === 0) throw new Error('Сейчас нет точек, готовых выдать заказ. Попробуйте немного позже.')
      renderQuote(quoted)
      renderLocations(pickupResponse.locations)
      if (customer && form) {
        const nameInput = form.elements.namedItem('name') as HTMLInputElement
        const phoneInput = form.elements.namedItem('phone') as HTMLInputElement
        const emailInput = form.elements.namedItem('email') as HTMLInputElement
        nameInput.value = [customer.name, customer.surname].filter(Boolean).join(' ')
        phoneInput.value = formatRussianPhone(customer.phone)
        emailInput.value = customer.email ?? ''
      }
      loading?.setAttribute('hidden', '')
      form?.removeAttribute('hidden')
    } catch (error) {
      loading?.setAttribute('hidden', '')
      empty?.removeAttribute('hidden')
      const copy = empty?.querySelector('p')
      if (copy) copy.textContent = error instanceof Error ? error.message : 'Не удалось проверить корзину.'
    }
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    showError()
    if (!form.reportValidity() || !quote) return
    submit?.setAttribute('disabled', '')
    if (submit) submit.textContent = 'Сохраняем заказ…'
    const data = new FormData(form)
    try {
      const result = await storeApi.createOrder({
        lines: getCart().map(({ variantId, quantity }) => ({ variantId, quantity })),
        pickupRestaurantId: String(data.get('pickupRestaurantId') ?? ''),
        customer: {
          name: String(data.get('name') ?? ''),
          phone: String(data.get('phone') ?? ''),
          email: String(data.get('email') ?? '').trim() || null,
        },
        comment: String(data.get('comment') ?? '').trim() || null,
        privacyAccepted: data.get('privacy') === 'on',
        idempotencyKey,
      })
      clearCart()
      sessionStorage.removeItem('chashka_checkout_idempotency')
      location.assign(`/order?token=${encodeURIComponent(result.accessToken)}`)
    } catch (error) {
      const message = error instanceof StoreApiError && error.code === 'CONFLICT'
        ? error.message
        : error instanceof Error && error.name === 'ZodError'
          ? 'Проверьте имя, телефон, e-mail и выбранную точку.'
          : 'Не удалось сохранить заказ. Проверьте соединение и попробуйте ещё раз.'
      showError(message)
      submit?.removeAttribute('disabled')
      if (submit) submit.textContent = 'Подтвердить заказ'
    }
  })

  void load()
</script>

<style is:global>
  .checkout-page{padding:clamp(54px,7vw,105px) 0 clamp(90px,10vw,150px);color:#1f3b2e}.checkout-heading{display:grid;padding:0 clamp(24px,6vw,92px) clamp(54px,7vw,100px);grid-template-columns:minmax(0,1fr) minmax(280px,.45fr);align-items:end;gap:40px}.checkout-heading>p{grid-column:1/-1;margin:0 0 -15px;color:#78912f;font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.checkout-heading h1{margin:0;font-size:clamp(58px,7.5vw,116px);line-height:.84;letter-spacing:-.085em}.checkout-heading>span{max-width:340px;padding-bottom:8px;color:#716a63;font-size:13px;line-height:1.6}.checkout-loading{display:flex;min-height:360px;align-items:center;justify-content:center;gap:14px;border-top:1px solid #e0dbd2;color:#716a63;font-size:11px}.checkout-loading[hidden]{display:none}.checkout-loading span{width:26px;height:26px;border:2px solid #dbe2d3;border-top-color:#78912f;border-radius:50%;animation:checkout-spin .8s linear infinite}.checkout-layout{display:grid;grid-template-columns:minmax(0,.9fr) minmax(480px,1.1fr);border-top:1px solid #dcd7ce}.checkout-layout[hidden],.checkout-empty[hidden]{display:none}.checkout-order{padding:clamp(38px,5vw,76px) clamp(24px,6vw,92px);border-right:1px solid #dcd7ce;background:#f2eee7}.checkout-details{padding:clamp(38px,5vw,76px) clamp(24px,6vw,92px)}.checkout-section-title{display:flex;align-items:baseline;gap:14px;margin-bottom:30px}.checkout-section-title span,.checkout-fieldset legend span{color:#78912f;font-size:9px;font-weight:850;letter-spacing:.1em}.checkout-section-title h2{margin:0;font-size:34px;letter-spacing:-.05em}.checkout-lines article{display:grid;padding:18px 0;grid-template-columns:70px 1fr auto;align-items:center;gap:15px;border-bottom:1px solid #d8d2c9}.checkout-lines img{width:70px;height:78px;border-radius:16px;object-fit:cover}.checkout-lines div{display:grid;gap:6px}.checkout-lines strong{font-size:15px}.checkout-lines span{color:#777069;font-size:10px}.checkout-lines b{font-size:14px}.checkout-total{display:flex;align-items:end;justify-content:space-between;margin-top:28px}.checkout-total span{color:#6d665f;font-size:11px}.checkout-total strong{font-size:33px;letter-spacing:-.05em}.checkout-price-note{margin:9px 0 0;color:#807970;font-size:9px}.checkout-fieldset{display:grid;margin:0 0 38px;padding:0;border:0;gap:14px}.checkout-fieldset legend{display:flex;margin-bottom:22px;align-items:center;gap:14px;font-size:25px;font-weight:750;letter-spacing:-.04em}.checkout-pickup>div{display:grid;gap:8px}.checkout-pickup label{display:flex;position:relative;padding:17px;border:1px solid #ded8cf;border-radius:18px;align-items:flex-start;gap:13px;cursor:pointer;transition:border-color .2s,background .2s,transform .2s}.checkout-pickup label:has(input:checked){border-color:#78912f;background:#eff3e7;transform:translateX(3px)}.checkout-pickup input{margin-top:3px;accent-color:#1f3b2e}.checkout-pickup label>span{display:grid;gap:4px}.checkout-pickup strong{font-size:14px}.checkout-pickup b{font-size:10px;font-weight:600}.checkout-pickup small{color:#777069;font-size:9px}.checkout-fieldset>label{display:grid;gap:7px;color:#635d57;font-size:9px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.checkout-fieldset label small{font-size:8px;font-weight:500;letter-spacing:0;text-transform:none}.checkout-fieldset :is(input,textarea){width:100%;min-height:52px;padding:0 16px;border:1px solid #dcd7ce;border-radius:15px;background:#fff;color:#1f3b2e;font:500 14px/1.3 Montserrat,Arial,sans-serif;outline:0}.checkout-fieldset textarea{min-height:100px;padding-top:15px;resize:vertical}.checkout-fieldset :is(input,textarea):focus{border-color:#78912f;box-shadow:0 0 0 3px rgba(189,214,90,.2)}.checkout-consent{display:flex;align-items:flex-start;gap:11px;color:#69635c;font-size:9px;line-height:1.55}.checkout-consent input{margin-top:2px;accent-color:#1f3b2e}.checkout-consent a{color:inherit}.checkout-payment-note{margin:24px 0 12px;padding:18px;border-radius:18px;background:#e7ecdd}.checkout-payment-note strong{font-size:11px}.checkout-payment-note p{margin:6px 0 0;color:#62685f;font-size:9px;line-height:1.5}.checkout-error{margin:12px 0;color:#a4382f;font-size:10px;line-height:1.5}.checkout-error[hidden]{display:none}.checkout-submit{width:100%;min-height:58px;margin-top:12px;border:0;border-radius:17px;background:#1f3b2e;color:#fff;cursor:pointer;font-size:11px;font-weight:850;transition:background .2s,transform .2s}.checkout-submit:hover{background:#294d3b;transform:translateY(-1px)}.checkout-submit:disabled{cursor:wait;opacity:.6}.checkout-empty{max-width:680px;margin:0 auto;padding:90px 30px;text-align:center}.checkout-empty h2{margin:0;font-size:48px;letter-spacing:-.06em}.checkout-empty p{margin:16px 0 25px;color:#716a63}.checkout-empty a{display:inline-flex;min-height:50px;padding:0 22px;border-radius:16px;align-items:center;background:#1f3b2e;color:#fff;font-size:11px;font-weight:800;text-decoration:none}@keyframes checkout-spin{to{transform:rotate(360deg)}}
  @media(max-width:900px){.checkout-heading{grid-template-columns:1fr;padding:30px 24px 58px}.checkout-heading>p{margin:0}.checkout-heading h1{font-size:clamp(54px,15vw,78px)}.checkout-layout{grid-template-columns:1fr}.checkout-order{border-right:0;border-bottom:1px solid #dcd7ce}.checkout-details,.checkout-order{padding:42px 24px}.checkout-page{padding-top:20px}}@media(prefers-reduced-motion:reduce){.checkout-loading span{animation-duration:.01ms}}
</style>
