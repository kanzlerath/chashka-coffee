  body.public-site .public-main[data-path^="/checkout"] .checkout-order{padding:clamp(34px,4.6vw,64px);border:0;border-right:1px solid var(--line);background:var(--sand)}
  body.public-site .public-main[data-path^="/checkout"] .checkout-details{padding:clamp(34px,4.6vw,64px);background:var(--paper)}
  body.public-site .public-main[data-path^="/checkout"] .checkout-section-title{margin-bottom:24px}.public-main[data-path^="/checkout"] .checkout-section-title h2,.public-main[data-path^="/checkout"] .checkout-fieldset legend{font-size:clamp(25px,2.4vw,34px);line-height:.95;letter-spacing:-.055em}
  body.public-site .public-main[data-path^="/checkout"] .checkout-lines article{padding:17px 0;grid-template-columns:62px 1fr auto;gap:13px;border-color:var(--line)}.public-main[data-path^="/checkout"] .checkout-lines img{width:62px;height:70px;border-radius:calc(var(--radius) - 8px)}.public-main[data-path^="/checkout"] .checkout-total{margin-top:25px}.public-main[data-path^="/checkout"] .checkout-total strong{font-size:30px}
  body.public-site .public-main[data-path^="/checkout"] .checkout-fieldset{margin:0 0 34px;gap:12px}.public-main[data-path^="/checkout"] .checkout-fieldset legend{margin-bottom:17px}.public-main[data-path^="/checkout"] .checkout-pickup>div[data-pickup-locations]{gap:7px}
  body.public-site .public-main[data-path^="/checkout"] .checkout-pickup-map{position:relative;height:260px;overflow:hidden;margin:0 0 16px;border:1px solid var(--line);border-radius:calc(var(--radius) - 5px);background:var(--moss-soft)}.public-main[data-path^="/checkout"] .checkout-pickup-map[hidden]{display:none}.public-main[data-path^="/checkout"] .checkout-pickup-map [data-pickup-map-canvas]{position:absolute;inset:0}.public-main[data-path^="/checkout"] .checkout-pickup-map p{position:absolute;z-index:1;right:14px;bottom:14px;max-width:210px;margin:0;padding:9px 11px;border-radius:11px;background:rgba(255,253,249,.92);color:var(--muted);font-size:10px;line-height:1.35;box-shadow:0 4px 18px rgba(31,59,46,.1)}.public-main[data-path^="/checkout"] .checkout-pickup-map p[hidden]{display:none}
