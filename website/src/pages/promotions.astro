---
import PageShell from '../layouts/PageShell.astro'
import PromotionCard from '../components/PromotionCard.astro'
import { getContent } from '../lib/public-api'
import type { PromotionCardEntry } from '../lib/promotions'

const fallbackOffers: PromotionCardEntry[] = [
  { slug: 'summer-breakfasts', title: 'Летние завтраки', excerpt: 'Когда утро хочется начать не на бегу: любимые блюда и кофе по специальной цене.', imageUrl: '/images/home-breakfast.png', ctaLabel: null, ctaUrl: null, startsAt: null, endsAt: '2026-08-31T05:00:00.000Z' },
  { slug: 'coffee-to-go', title: 'Кофе с собой', excerpt: 'Второй напиток для прогулки, дороги или человека, с которым хочется задержаться.', imageUrl: '/images/home-morning-v2.png', ctaLabel: 'Открыть меню', ctaUrl: '/menu', startsAt: null, endsAt: null },
  { slug: 'dessert-cappuccino', title: 'Десерт к капучино', excerpt: 'Выбирайте любимый десерт — мы добавим к напитку немного сладкого настроения.', imageUrl: '/images/home-hero-v1.png', ctaLabel: null, ctaUrl: null, startsAt: null, endsAt: null },
]
const fallbackImages = ['/images/home-breakfast.png', '/images/home-morning-v2.png', '/images/home-hero-v1.png']
const publishedOffers = await getContent('PROMOTION')
const offers: PromotionCardEntry[] = publishedOffers.length ? publishedOffers : fallbackOffers
---

<PageShell title="Акции" active="promotions">
  <section class="promotions-page" aria-labelledby="promotions-title">
    <header class="promotions-heading">
      <h1 id="promotions-title">Акции</h1>
    </header>

    {offers.length
      ? <div class="promotions-grid">
          {offers.map((entry, index) => <PromotionCard entry={entry} fallbackImage={fallbackImages[index % fallbackImages.length]} featured={index === 0} />)}
        </div>
      : <p class="promotions-empty">Новые акции появятся здесь после публикации.</p>}

    <section class="promotions-app">
      <div>
        <h2>Все акции —<br />в приложении</h2>
        <p>Там они появляются первыми, а ещё можно копить баллы и оплачивать ими любимый кофе.</p>
        <a href="/app">Узнать о приложении</a>
      </div>
      <img class="promotions-app-logo" src="/brand/logo.png" alt="" aria-hidden="true" />
    </section>
  </section>
</PageShell>

<style>
  .promotions-page{padding:clamp(58px,7.5vw,118px) 0 14px}
  .promotions-heading{margin-bottom:clamp(42px,5vw,72px)}
  .promotions-heading h1{margin:0;font-size:clamp(52px,6vw,94px);line-height:.88;letter-spacing:-.09em}
  .promotions-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
  .promotions-empty{margin:0;padding:32px;border-radius:var(--radius);background:var(--sand);color:var(--muted)}
  .promotions-app{position:relative;isolation:isolate;display:flex;min-height:430px;align-items:flex-end;justify-content:space-between;gap:40px;margin-top:clamp(72px,9vw,132px);padding:clamp(44px,6vw,88px);overflow:hidden;border-radius:var(--radius);background:var(--moss);color:#fff}
  .promotions-app>div{position:relative;z-index:1;max-width:760px}
  .promotions-app h2{margin:0;color:#fff;font-size:clamp(43px,5vw,80px);line-height:.9;letter-spacing:-.085em}
  .promotions-app p{max-width:520px;margin:24px 0 0;color:#dce7de;font-size:14px;line-height:1.65}
  .promotions-app a{display:inline-flex;min-height:50px;align-items:center;margin-top:30px;padding:0 21px;border-radius:var(--radius);background:var(--lime);color:var(--moss);font-size:11px;font-weight:800;text-decoration:none;transition:background-color .2s ease,transform .2s ease}
  .promotions-app a:hover{background:#d0e86c;transform:translateY(-2px)}
  .promotions-app-logo{position:absolute;right:clamp(-120px,-5vw,-58px);bottom:clamp(-150px,-8vw,-76px);width:clamp(300px,32vw,520px);height:auto;opacity:.96;transform:rotate(-8deg)}
  @media(max-width:700px){
    .promotions-page{padding:52px var(--mobile-gutter) 12px}
    .promotions-heading{margin-bottom:36px}
    .promotions-grid{grid-template-columns:1fr;gap:10px}
    .promotions-app{min-height:540px;align-items:flex-start;margin-top:64px;padding:46px 24px}
    .promotions-app h2{font-size:48px}.promotions-app p{font-size:13px}.promotions-app a{width:100%;justify-content:center}
    .promotions-app-logo{right:-92px;bottom:-82px;width:300px}
  }
  @media(prefers-reduced-motion:reduce){.promotions-app a{transition:none}.promotions-app a:hover{transform:none}}
</style>
