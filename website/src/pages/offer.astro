---
import LegalPage from '../components/LegalPage.astro'
import type { LegalSection } from '../lib/legal-documents'

const sections: LegalSection[] = [
  { id: 'seller', heading: 'Продавец и предмет оферты', paragraphs: ['Настоящий документ является предложением ООО «Таймс 2» заключить договор розничной купли-продажи дистанционным способом. Продавец: ИНН 5407963565, ОГРН 1175476040850, адрес 630099, г. Новосибирск, ул. Ленина, д. 12, 1 этаж; телефон +7 (913) 748-76-10; e-mail sbis-times2@denisivanov.ru.', 'На сайте продаются упакованные зерно, дрипы и капсулы. Наименование, вариант, количество, цена и точка самовывоза фиксируются в заказе.'], links: [{ label: 'Все реквизиты', href: '/requisites' }] },
  { id: 'acceptance', heading: 'Заключение договора', paragraphs: ['Покупатель выбирает товар и точку самовывоза, указывает контакты, подтверждает обработку данных и нажимает кнопку оформления. До оплаты можно проверить итоговую сумму и исправить данные. Договор считается заключённым после оплаты заказа на платёжной странице ЮKassa и подтверждения операции.', 'Электронный кассовый чек направляется в порядке, предусмотренном законом, по контактам, указанным покупателем.'] },
  { id: 'price', heading: 'Цена и оплата', paragraphs: ['Цена указывается в рублях и включает применимые налоги. Оплата производится онлайн через ЮKassa. Банковские реквизиты обрабатываются платёжным сервисом; продавец и сайт не получают полный номер карты и код безопасности. При технической ошибке повторный переход к оплате не создаёт второй заказ при использовании сохранённого заказа.'] },
  { id: 'pickup', heading: 'Подготовка и самовывоз', paragraphs: ['Оплаченный заказ обычно готов в течение 30 минут. Фактическая готовность подтверждается статусом или сообщением. Заказ хранится в выбранной точке 3 календарных дня с момента уведомления о готовности. Для выдачи может потребоваться номер заказа и подтверждение личности получателя.'], note: 'Если товар временно недоступен или выполнить заказ невозможно, продавец свяжется с покупателем и предложит замену либо возврат оплаты.' },
  { id: 'cancellation', heading: 'Отмена до получения', paragraphs: ['Покупатель вправе отказаться от товара в любое время до его передачи. Для отмены нужно написать на support@chashkacoffee.ru либо обратиться по контактам продавца и сообщить номер заказа. Возврат проводится отменой платежа на тот же способ оплаты в сроки, зависящие от банка и платёжной системы.'] },
  { id: 'returns', heading: 'Возврат после получения', paragraphs: ['Товар надлежащего качества можно вернуть в течение 7 дней после передачи, если сохранены товарный вид и потребительские свойства и товар не относится к исключениям закона. Пищевой товар надлежащего качества, упаковка которого вскрыта либо свойства изменились, как правило, возврату не подлежит.', 'Товар ненадлежащего качества можно вернуть и предъявить предусмотренные законом требования в пределах применимого срока. Для быстрого рассмотрения сообщите номер заказа и приложите фотографии, если дефект видим. Отсутствие чека само по себе не лишает права подтвердить покупку иным способом.'] },
  { id: 'claims', heading: 'Обращения и возврат денег', paragraphs: ['Претензии принимаются по e-mail support@chashkacoffee.ru и контактам ООО «Таймс 2». Деньги возвращаются в сроки, установленные законом, обычно тем же способом, которым производилась оплата. Расходы и порядок возврата товара определяются причиной возврата и требованиями закона.'] },
  { id: 'liability', heading: 'Ответственность и закон', paragraphs: ['Стороны отвечают в соответствии с законодательством Российской Федерации. Условия оферты не ограничивают обязательные права потребителя. Спор сначала можно попытаться решить обращением к продавцу; право обратиться в Роспотребнадзор или суд сохраняется.'] },
  { id: 'changes', heading: 'Редакция оферты', paragraphs: ['К заказу применяется редакция, опубликованная на момент его оформления. Новая редакция действует для последующих заказов и не изменяет уже заключённый договор без законного основания.'] },
]
---

<LegalPage href="/offer" intro="Дистанционная продажа зерна, дрипов и капсул с онлайн-оплатой и самовывозом." sections={sections} related={['/requisites', '/privacy', '/terms']} />
