---
import LegalPage from '../components/LegalPage.astro'
import type { LegalSection } from '../lib/legal-documents'

const sections: LegalSection[] = [
  {
    heading: '1. Термины и определения',
    clauses: [
      { number: '1.1.', text: 'Продавец — ООО «Таймс 2», ИНН 5407963565, ОГРН 1175476040850, адрес: 630099, Новосибирская область, г. Новосибирск, ул. Ленина, д. 12, 1 этаж.' },
      { number: '1.2.', text: 'Покупатель — дееспособное физическое лицо, имеющее намерение заказать или заказывающее Товар для личных, семейных, домашних и иных нужд, не связанных с осуществлением предпринимательской деятельности.' },
      { number: '1.3.', text: 'Сайт — интернет-сайт «Чашка кофе», посредством которого Покупатель может ознакомиться с Товарами и оформить Заказ.' },
      { number: '1.4.', text: 'Товар — упакованный зерновой кофе, дрип-пакеты и кофейные капсулы, представленные в интернет-магазине на Сайте и доступные для заказа.' },
      { number: '1.5.', text: 'Заказ — оформленный Покупателем запрос на приобретение выбранных Товаров с самовывозом из указанного ресторана.' },
      { number: '1.6.', text: 'ЮKassa — платежный сервис, обеспечивающий прием безналичной оплаты Заказа.' },
      { number: '1.7.', text: 'Точка самовывоза — выбранный Покупателем ресторан, в котором осуществляется подготовка и выдача Заказа.' },
    ],
  },
  {
    heading: '2. Общие положения',
    clauses: [
      { number: '2.1.', text: 'Настоящий документ является публичной офертой Продавца, адресованной неопределенному кругу лиц, и содержит существенные условия договора розничной купли-продажи Товара дистанционным способом.' },
      { number: '2.2.', text: 'К отношениям между Продавцом и Покупателем применяются Гражданский кодекс Российской Федерации, Закон РФ от 07.02.1992 № 2300-1 «О защите прав потребителей», Правила продажи товаров по договору розничной купли-продажи и иные применимые нормативные правовые акты.' },
      { number: '2.3.', text: 'Оформляя Заказ, Покупатель подтверждает ознакомление с настоящей офертой, Политикой обработки персональных данных, сведениями о Товаре, его цене и порядке самовывоза.' },
      { number: '2.4.', text: 'Оферта применяется к Заказу в редакции, действовавшей в момент его оформления.' },
    ],
  },
  {
    heading: '3. Информация о товаре',
    clauses: [
      { number: '3.1.', text: 'Наименование, вариант, масса или количество, цена и иные основные характеристики Товара указываются на странице соответствующего Товара и в корзине.' },
      { number: '3.2.', text: 'Фотографии Товара носят информационный характер. Оттенок упаковки и несущественные элементы оформления могут отличаться от изображения.' },
      { number: '3.3.', text: 'Информация о составе, дате изготовления, сроке годности, условиях хранения и изготовителе указывается на упаковке Товара.' },
      { number: '3.4.', text: 'Продавец вправе изменить описание и цену Товара до оформления Заказа. Изменение не распространяется на уже оплаченный Заказ.' },
      { number: '3.5.', text: 'При выявлении очевидной технической ошибки в цене до оплаты Продавец сообщает Покупателю корректную цену. Покупатель вправе оформить Заказ по корректной цене или отказаться от его оформления.' },
    ],
  },
  {
    heading: '4. Оформление заказа и заключение договора',
    clauses: [
      { number: '4.1.', text: 'Для оформления Заказа Покупатель выбирает Товар и его вариант, указывает количество, Точку самовывоза, имя, номер телефона, адрес электронной почты и при необходимости комментарий.' },
      { number: '4.2.', text: 'Покупатель обязан предоставить достоверные сведения, достаточные для исполнения Заказа.' },
      { number: '4.3.', text: 'До направления Заказа Покупатель может проверить состав, количество, итоговую стоимость, Точку самовывоза и введенные контактные данные.' },
      { number: '4.4.', text: 'Покупатель подтверждает отдельное согласие на обработку персональных данных и нажимает кнопку перехода к оплате.' },
      { number: '4.5.', text: 'Договор считается заключенным с момента подтверждения оплаты платежным сервисом и принятия Заказа информационной системой Продавца.' },
      { number: '4.6.', text: 'После оформления Заказу присваивается уникальный номер. Сведения о Заказе и его статусе отображаются на странице Заказа и, при наличии авторизованного аккаунта, в личном кабинете.' },
      { number: '4.7.', text: 'Если исполнение Заказа невозможно полностью или в части, Продавец связывается с Покупателем и предлагает замену, изменение состава Заказа либо возврат денежных средств за недоступный Товар. Замена, влияющая на цену или характеристики Товара, производится только с согласия Покупателя.' },
    ],
  },
  {
    heading: '5. Цена и порядок оплаты',
    clauses: [
      { number: '5.1.', text: 'Цена Товара указывается в рублях Российской Федерации и включает применимые налоги.' },
      { number: '5.2.', text: 'Оплата осуществляется в безналичной форме на защищенной платежной странице ЮKassa.' },
      { number: '5.3.', text: 'Обязательство Покупателя по оплате считается исполненным после подтверждения успешной операции платежным сервисом.' },
      { number: '5.4.', text: 'Сайт и Продавец не получают полный номер банковской карты, срок ее действия и код безопасности. Указанные сведения обрабатываются платежным сервисом.' },
      { number: '5.5.', text: 'Кассовый чек формируется и направляется Покупателю в порядке, предусмотренном Федеральным законом от 22.05.2003 № 54-ФЗ «О применении контрольно-кассовой техники при осуществлении расчетов в Российской Федерации».' },
      { number: '5.6.', text: 'При техническом сбое Покупатель вправе повторно перейти к оплате ранее созданного Заказа. Использование того же Заказа не должно приводить к повторному созданию состава Заказа.' },
    ],
  },
  {
    heading: '6. Подготовка и самовывоз заказа',
    clauses: [
      { number: '6.1.', text: 'Продавец приступает к исполнению Заказа после подтверждения оплаты.' },
      { number: '6.2.', text: 'Обычный срок подготовки Заказа составляет до 30 минут с момента подтверждения оплаты. Срок может быть увеличен при повышенной загрузке, техническом сбое или иных обстоятельствах, влияющих на возможность своевременной подготовки.' },
      { number: '6.3.', text: 'Готовность Заказа подтверждается изменением его статуса или направлением сообщения Покупателю.' },
      { number: '6.4.', text: 'Заказ хранится в Точке самовывоза в течение 3 календарных дней с момента уведомления о готовности.' },
      { number: '6.5.', text: 'Для получения Заказа Покупатель или указанный им получатель сообщает номер Заказа. При наличии обоснованных сомнений Продавец вправе запросить дополнительное подтверждение права на получение.' },
      { number: '6.6.', text: 'Право собственности и риск случайного повреждения Товара переходят к Покупателю в момент передачи Заказа.' },
    ],
  },
  {
    heading: '7. Отказ от заказа и возврат товара',
    clauses: [
      { number: '7.1.', text: 'Покупатель вправе отказаться от Заказа в любое время до передачи Товара.' },
      { number: '7.2.', text: 'Для отказа Покупатель направляет обращение на support@chashkacoffee.ru либо обращается по контактам Продавца и сообщает номер Заказа.' },
      { number: '7.3.', text: 'После передачи Товара надлежащего качества Покупатель вправе отказаться от него в течение 7 дней при сохранении товарного вида, потребительских свойств и документа, подтверждающего приобретение, если Товар не относится к установленным законом исключениям.' },
      { number: '7.4.', text: 'Продовольственный Товар надлежащего качества с нарушенной упаковкой, утратой товарного вида или измененными потребительскими свойствами возврату не подлежит, если иное не предусмотрено законом.' },
      { number: '7.5.', text: 'При обнаружении недостатка Покупатель вправе предъявить требования, предусмотренные законодательством о защите прав потребителей, включая замену, соразмерное уменьшение цены или возврат уплаченной суммы.' },
      { number: '7.6.', text: 'Для рассмотрения требования Покупатель сообщает номер Заказа, описывает недостаток и по возможности прикладывает фотографии. Отсутствие кассового чека не лишает Покупателя права подтверждать покупку иными доказательствами.' },
      { number: '7.7.', text: 'Возврат денежных средств производится тем же способом, которым была осуществлена оплата, если иной способ не согласован сторонами и допускается правилами платежной системы.' },
      { number: '7.8.', text: 'Срок возврата денежных средств определяется законодательством Российской Федерации. Фактический срок зачисления после проведения возврата зависит от банка и платежной системы.' },
    ],
  },
  {
    heading: '8. Ответственность сторон',
    clauses: [
      { number: '8.1.', text: 'Стороны несут ответственность в соответствии с законодательством Российской Федерации и настоящей офертой.' },
      { number: '8.2.', text: 'Продавец не отвечает за невозможность связаться с Покупателем или выдать Заказ, если Покупатель предоставил неверные контактные сведения или не сообщил номер Заказа.' },
      { number: '8.3.', text: 'Продавец не отвечает за ухудшение качества Товара после его передачи вследствие нарушения Покупателем условий хранения, транспортировки или использования.' },
      { number: '8.4.', text: 'Условия оферты не ограничивают права Покупателя, которые не могут быть ограничены соглашением сторон.' },
    ],
  },
  {
    heading: '9. Обращения и заключительные положения',
    clauses: [
      { number: '9.1.', text: 'Обращения и претензии принимаются по адресу support@chashkacoffee.ru, телефону +7 (913) 748-76-10 или адресу электронной почты Продавца sbis-times2@denisivanov.ru.' },
      { number: '9.2.', text: 'Для ускорения рассмотрения обращения рекомендуется указать номер Заказа, дату оформления, контактные сведения и содержание требования.' },
      { number: '9.3.', text: 'Стороны стремятся урегулировать разногласия путем переговоров. При недостижении соглашения спор рассматривается в соответствии с законодательством Российской Федерации.' },
      { number: '9.4.', text: 'Продавец вправе изменять оферту. Новая редакция применяется к Заказам, оформленным после даты ее публикации.' },
    ],
  },
]
---

<LegalPage href="/offer" subtitle="Условия дистанционной продажи зернового кофе, дрип-пакетов и кофейных капсул с самовывозом" sections={sections} />
