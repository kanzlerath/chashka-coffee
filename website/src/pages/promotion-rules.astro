---
import LegalPage from '../components/LegalPage.astro'
import type { LegalSection } from '../lib/legal-documents'

const sections: LegalSection[] = [
  {
    heading: '1. Общие положения',
    clauses: [
      { number: '1.1.', text: 'Настоящие Правила определяют общие условия проведения акций и применения скидок в участвующих ресторанах и сервисах «Чашки кофе».' },
      { number: '1.2.', text: 'Для каждой акции публикуются специальные условия, содержащие сведения об организаторе, сроке проведения, территории, участниках, товарах или услугах, размере выгоды и порядке ее получения.' },
      { number: '1.3.', text: 'Специальные условия конкретной акции применяются совместно с настоящими Правилами. При расхождении применяются специальные условия.' },
    ],
  },
  {
    heading: '2. Срок и территория проведения',
    clauses: [
      { number: '2.1.', text: 'Акция проводится в течение срока и в ресторанах либо сервисах, прямо указанных в специальных условиях.' },
      { number: '2.2.', text: 'Если предложение ограничено запасом товара, это указывается в специальных условиях. В таком случае акция действует до окончания соответствующего запаса, но не дольше установленного срока.' },
      { number: '2.3.', text: 'Информация об участвующих ресторанах может изменяться до начала акции. Изменения, затрагивающие уже приобретенное право на выгоду, не допускаются без законного основания.' },
    ],
  },
  {
    heading: '3. Порядок предоставления выгоды',
    clauses: [
      { number: '3.1.', text: 'Для получения скидки, подарка или иной выгоды участник обязан выполнить условия конкретной акции до завершения расчета или иного момента, указанного организатором.' },
      { number: '3.2.', text: 'Если специальные условия не предусматривают иное, скидки, промокоды, бонусы, специальные цены и расчеты подарочным сертификатом не суммируются.' },
      { number: '3.3.', text: 'Если одновременно доступны несколько предложений, участник вправе выбрать одно из них до проведения расчета.' },
      { number: '3.4.', text: 'Денежный эквивалент скидки, подарка или иной неденежной выгоды не выплачивается, если иное прямо не предусмотрено условиями акции или законодательством.' },
    ],
  },
  {
    heading: '4. Ограничения участия',
    clauses: [
      { number: '4.1.', text: 'Участник обязан предоставлять достоверные сведения и действовать добросовестно.' },
      { number: '4.2.', text: 'Не допускаются использование технических ошибок, массовое создание учетных записей, подмена идентификаторов, передача одноразового промокода после его использования и иные действия, направленные на получение выгоды в обход условий акции.' },
      { number: '4.3.', text: 'Организатор вправе проверить соблюдение условий и отказать в предоставлении выгоды при наличии доказанного нарушения. Такой отказ не ограничивает обязательные права потребителя по основной покупке.' },
    ],
  },
  {
    heading: '5. Изменение и прекращение акции',
    clauses: [
      { number: '5.1.', text: 'Организатор вправе изменить или прекратить акцию на будущее, опубликовав информацию тем же способом, которым были опубликованы ее условия.' },
      { number: '5.2.', text: 'Изменение или прекращение акции не отменяет право участника на выгоду, если до публикации изменений участник надлежащим образом выполнил все условия ее получения.' },
      { number: '5.3.', text: 'Организатор вправе временно приостановить акцию при техническом сбое, если продолжение невозможно или может привести к неправильному расчету. После устранения сбоя организатор возобновляет акцию либо определяет порядок урегулирования уже совершенных действий.' },
    ],
  },
  {
    heading: '6. Обращения',
    clauses: [
      { number: '6.1.', text: 'Вопросы по конкретной акции направляются организатору, указанному в ее специальных условиях, либо в участвующий ресторан.' },
      { number: '6.2.', text: 'Обращение также может быть направлено на support@chashkacoffee.ru. В обращении рекомендуется приложить ссылку, фотографию или снимок экрана соответствующего предложения и указать дату обращения.' },
    ],
  },
]
---

<LegalPage href="/promotion-rules" sections={sections} />
