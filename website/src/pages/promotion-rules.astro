---
import LegalPage from '../components/LegalPage.astro'
import type { LegalSection } from '../lib/legal-documents'

const sections: LegalSection[] = [
  { id: 'specific', heading: 'Специальные условия важнее общих', paragraphs: ['Для каждой акции в карточке, приложении, ресторане или рекламном сообщении указываются организатор, период, территория, участники, товары, размер выгоды и порядок её получения. Эти специальные сведения применяются вместе с настоящими общими правилами.'] },
  { id: 'availability', heading: 'Срок, точки и наличие', paragraphs: ['Акция действует только в обозначенный период и в участвующих ресторанах. Если предложение связано с ограниченным запасом товара, оно действует до окончания такого запаса при наличии ясного указания об этом в специальных условиях.'] },
  { id: 'compatibility', heading: 'Совместимость скидок', paragraphs: ['Если в карточке акции не указано иное, скидки, промокоды, бонусы, специальные цены и расчёт подарочным сертификатом между собой не суммируются. Перед оплатой гость может выбрать одно доступное предложение.'] },
  { id: 'participation', heading: 'Добросовестное участие', paragraphs: ['Участник предоставляет достоверные сведения и не использует технические ошибки, массовые регистрации, подмену идентификаторов или иные способы получения преимущества в обход условий. Организатор вправе проверить соблюдение правил и отказать в неправомерной выгоде.'] },
  { id: 'changes', heading: 'Изменение или завершение', paragraphs: ['Организатор может изменить или завершить акцию на будущее, опубликовав новые условия тем же способом, которым акция была объявлена. Изменения не отменяют уже надлежащим образом полученное право на скидку, подарок или иную выгоду и не ограничивают обязательные права потребителя.'] },
  { id: 'questions', heading: 'Вопросы и спорные ситуации', paragraphs: ['Сначала проверьте карточку конкретной акции: в ней указан организатор и особые ограничения. Если ответа нет, обратитесь в участвующий ресторан или напишите на support@chashkacoffee.ru, приложив ссылку или скриншот предложения.'] },
]
---

<LegalPage href="/promotion-rules" intro="Базовые правила; срок, организатор и механика каждой акции указываются отдельно." sections={sections} related={['/certificate-rules', '/loyalty-rules', '/terms']} />
