---
import PageShell from '../layouts/PageShell.astro'
import { legalDocuments } from '../lib/legal-documents'
---

<PageShell title="Правила и реквизиты" description="Правила, условия и сведения об организациях Чашки кофе." active="about">
  <main class="legal-index">
    <h1>Правила и реквизиты</h1>
    <nav aria-label="Список юридических документов">
      {legalDocuments.map((document) => (
        <a href={document.href}><span>{document.title}</span><span aria-hidden="true">→</span></a>
      ))}
    </nav>
  </main>
</PageShell>

<style>
  .legal-index{width:min(100% - (var(--content-gutter) * 2),960px);margin:0 auto;padding:clamp(72px,8vw,118px) 0 clamp(100px,11vw,160px)}
  .legal-index h1{max-width:880px;margin:0 0 clamp(42px,5vw,68px);color:var(--moss);font-size:clamp(48px,6vw,82px);line-height:.96;letter-spacing:-.07em}
  .legal-index nav{display:grid;border-top:1px solid var(--line)}
  .legal-index a{display:grid;min-height:76px;padding:17px 18px;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:24px;border-bottom:1px solid var(--line);color:var(--ink);font-size:14px;font-weight:650;line-height:1.45;text-decoration:none;transition:background-color .18s ease,color .18s ease}
  .legal-index a:hover{background:var(--moss-soft);color:var(--moss)}
  .legal-index a:focus-visible{outline:3px solid var(--lime);outline-offset:2px}
  .legal-index a span:last-child{color:#6f902b;font-size:19px}
  @media(max-width:700px){.legal-index{width:auto;margin:0 var(--mobile-gutter);padding-top:56px}.legal-index h1{font-size:46px}.legal-index a{min-height:70px;padding:15px 4px;font-size:13px}}
  @media(prefers-reduced-motion:reduce){.legal-index a{transition:none}}
</style>
