  @media(max-width:850px){body.public-site .public-main[data-path="/order"] .order-page{padding-top:36px}.public-main[data-path="/order"] .order-loading,.public-main[data-path="/order"] .order-receipt,.public-main[data-path="/order"] .order-error{margin-right:var(--mobile-gutter);margin-left:var(--mobile-gutter)}.public-main[data-path="/order"] .order-receipt>header{min-height:0;align-items:flex-start;flex-direction:row}.public-main[data-path="/order"] .order-grid{grid-template-columns:1fr}.public-main[data-path="/order"] .order-composition{border-right:0;border-bottom:1px solid var(--line)}.public-main[data-path="/order"] .order-grid aside{min-height:0}}
