  @media(max-width:850px){body.public-site .public-main[data-path="/order"] .order-receipt-header{flex-direction:row!important}.public-main[data-path="/order"] .order-grid{grid-template-columns:1fr!important}.public-main[data-path="/order"] .order-composition{border-right:0!important;border-bottom:1px solid var(--line)!important}}
