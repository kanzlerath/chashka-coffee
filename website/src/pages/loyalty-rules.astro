---
import LegalPage from '../components/LegalPage.astro'
import { PREMIUM_BONUS_OFFER_URL, type LegalSection } from '../lib/legal-documents'

const sections: LegalSection[] = [
  { id: 'external', heading: 'Программа работает в PremiumBonus', paragraphs: ['«Чашка кофе» не публикует собственную копию правил и не пересказывает их на этой странице. Регистрация, карта, баланс, начисление и списание бонусов регулируются актуальными условиями PremiumBonus по ссылке ниже.'], links: [{ label: 'Открыть актуальные условия PremiumBonus', href: PREMIUM_BONUS_OFFER_URL, external: true }] },
  { id: 'account', heading: 'Личный кабинет на сайте', paragraphs: ['Сайт даёт технический доступ к данным бонусной карты через PremiumBonus. Для входа используется номер телефона и сервисный SMS-код. Отображаемые баланс, операции и статус поступают из внешней системы.'], note: 'Если содержание этой навигационной страницы расходится с документом PremiumBonus, применяются условия, опубликованные PremiumBonus.' },
  { id: 'support', heading: 'Куда обратиться', paragraphs: ['Вопрос по входу на сайт можно направить на support@chashkacoffee.ru. Вопросы об условиях программы, начислении или списании рассматриваются по правилам и каналам, указанным в документе PremiumBonus.'] },
]
---

<LegalPage href="/loyalty-rules" intro="Здесь нет собственной редакции правил: официальный документ находится у PremiumBonus." sections={sections} related={['/terms', '/privacy', '/requisites']} />
