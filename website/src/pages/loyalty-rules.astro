---
import LegalPage from '../components/LegalPage.astro'
import { PREMIUM_BONUS_OFFER_URL, type LegalSection } from '../lib/legal-documents'

const sections: LegalSection[] = [
  {
    heading: '1. Общие положения',
    clauses: [
      { number: '1.1.', text: 'Программа лояльности, доступная пользователям «Чашки кофе», функционирует с использованием внешнего сервиса PremiumBonus.' },
      { number: '1.2.', text: 'Регистрация участника, формирование бонусной карты, начисление и списание бонусов, срок их действия, ограничения и иные условия участия определяются документом, опубликованным PremiumBonus.' },
      { number: '1.3.', text: 'ООО «Чашка кофе» не утверждает на настоящей странице самостоятельные правила программы лояльности и не воспроизводит текст документа PremiumBonus.' },
      { number: '1.4.', text: 'Актуальная редакция условий программы доступна по следующей ссылке.', links: [{ label: 'Публичная оферта PremiumBonus', href: PREMIUM_BONUS_OFFER_URL, external: true }] },
    ],
  },
  {
    heading: '2. Доступ через сайт',
    clauses: [
      { number: '2.1.', text: 'Личный кабинет на Сайте предоставляет технический доступ к сведениям бонусной карты, получаемым из PremiumBonus.' },
      { number: '2.2.', text: 'Для входа используется номер телефона и одноразовый сервисный SMS-код.' },
      { number: '2.3.', text: 'Отображаемые баланс, история операций и статус участника формируются на основании сведений внешней системы.' },
      { number: '2.4.', text: 'В случае расхождения информации на настоящей странице с документом PremiumBonus применяются условия, опубликованные PremiumBonus.' },
    ],
  },
  {
    heading: '3. Обращения',
    clauses: [
      { number: '3.1.', text: 'Обращения по техническому входу на Сайт принимаются по адресу support@chashkacoffee.ru.' },
      { number: '3.2.', text: 'Вопросы, связанные с правилами программы, начислением, списанием и сроком действия бонусов, рассматриваются в порядке и по контактам, указанным в документе PremiumBonus.' },
    ],
  },
]
---

<LegalPage href="/loyalty-rules" sections={sections} />
