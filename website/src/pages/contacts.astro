---
import PageShell from '../layouts/PageShell.astro'
import LeadPanel from '../components/LeadPanel.astro'
import ContentBlocks from '../components/ContentBlocks.astro'
import { getManagedPage } from '../lib/public-api'

const page = await getManagedPage('CONTACTS')
const contacts = [
  ['Центральный офис', '+7 (383) 123-20-20', 'hello@chashkacoffee.ru', 'Пн–Пт · 09:00–18:00'],
  ['Банкеты и события', '+7 (383) 123-20-20', 'events@chashkacoffee.ru', 'Ежедневно · 10:00–21:00'],
  ['Кондитерская', '+7 (383) 123-20-20', 'cake@chashkacoffee.ru', 'Ежедневно · 09:00–21:00'],
  ['Франшиза', '+7 (383) 123-20-20', 'franchise@chashkacoffee.ru', 'Пн–Пт · 09:00–18:00'],
  ['Вакансии', '+7 (383) 123-20-20', 'team@chashkacoffee.ru', 'Пн–Пт · 10:00–18:00'],
]
---

<PageShell title="Контакты" description="Контакты центрального офиса, кондитерской, банкетной службы, франшизы и команды Чашки кофе." active="contacts">
  <section class="contacts-intro"><h1>Контакты</h1></section>

  <section class="contact-grid" aria-label="Контактные направления">
    {contacts.map(([title, phone, email, hours]) => <article>
      <h2>{title}</h2>
      <div><a href={`tel:${phone.replace(/[^+\d]/g, '')}`}>{phone}</a><a href={`mailto:${email}`}>{email}</a></div>
      <small>{hours}</small>
    </article>)}
    <article class="catering-card">
      <h2>Кейтеринг</h2>
      <p>Выездные события и обслуживание вне ресторанов.</p>
      <a class="catering-link" href="https://catering-denisivanov.ru/" target="_blank" rel="noreferrer">Перейти на сайт <span aria-hidden="true">↗</span></a>
    </article>
  </section>

  <LeadPanel
    title="Напишите нам"
    description="Оставьте контакты и коротко опишите задачу. Команда ответит по указанному адресу."
    type="CONTACT"
    submitLabel="Отправить сообщение"
    subjectLabel="Тема обращения"
  />

  {page && <div class="contacts-managed"><ContentBlocks blocks={page.blocks} /></div>}
</PageShell>

<style>
  .contacts-intro{padding:clamp(88px,11vw,170px) var(--content-gutter) clamp(62px,8vw,115px)}.contacts-intro h1{margin:0;font-size:clamp(70px,9vw,150px)!important;line-height:.75!important}
  .contact-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;padding:0}.contact-grid article{display:flex;min-width:0;min-height:320px;align-items:flex-start;padding:clamp(25px,3vw,44px);border-radius:var(--radius);background:#dfe9d3;flex-direction:column;transition:transform .3s cubic-bezier(.22,1,.36,1),box-shadow .3s ease}.contact-grid article:nth-child(2){background:#ebe4d9}.contact-grid article:nth-child(3){background:#efdba9}.contact-grid article:nth-child(4){background:#d9e7e0}.contact-grid article:nth-child(5){background:#e8ddd2}.contact-grid article:hover{z-index:1;box-shadow:0 18px 32px rgba(48,40,33,.1);transform:translateY(-6px)}.contact-grid h2{max-width:310px;margin:0 0 auto;font-size:clamp(24px,2.4vw,38px);line-height:.95}.contact-grid article>div{margin-top:70px}.contact-grid article>div a{display:block;color:inherit;font-size:12px;font-weight:700;line-height:1.9;text-decoration:none}.contact-grid article>div a:hover{text-decoration:underline;text-underline-offset:4px}.contact-grid small{margin-top:18px;color:var(--muted);font-size:10px}.contact-grid .catering-card{background:var(--moss);color:#fff}.catering-card p{max-width:310px;margin:auto 0 0;color:#d7e0d7;font-size:12px;line-height:1.65}.catering-link{display:flex;width:100%;min-height:52px;align-items:center;justify-content:space-between;margin-top:24px;padding:0 18px;border-radius:var(--radius);background:var(--lime);color:var(--moss);font-size:11px;font-weight:800;text-decoration:none;transition:background .2s ease,transform .2s ease}.catering-link:hover{background:#d0e578;transform:translateY(-2px)}.catering-link span{font-size:17px}
  .contacts-managed{margin-top:14px}
  @media(max-width:900px){.contacts-intro{padding:80px var(--mobile-gutter) 60px}.contact-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;padding:0 var(--mobile-gutter)}.contact-grid article{min-height:280px;padding:25px}.contact-grid article>div{margin-top:55px}}
  @media(max-width:540px){.contacts-intro h1{font-size:66px!important}.contact-grid{grid-template-columns:1fr}.contact-grid article{min-height:250px}.contact-grid article>div{margin-top:45px}}
  @media(prefers-reduced-motion:reduce){.contact-grid article,.catering-link{transition:none}}
</style>
