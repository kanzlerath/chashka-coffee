---
import PageShell from '../layouts/PageShell.astro'
import LeadForm from '../components/LeadForm.astro'
import ContentBlocks from '../components/ContentBlocks.astro'
import { getManagedPage } from '../lib/public-api'

const page = await getManagedPage('CONTACTS')
const contacts = [
  ['Центральный офис','+7 (383) 123-20-20','hello@chashkacoffee.ru','Пн–Пт · 09:00–18:00'],
  ['Банкеты и события','+7 (383) 123-20-20','events@chashkacoffee.ru','Ежедневно · 10:00–21:00'],
  ['Кондитерская','+7 (383) 123-20-20','cake@chashkacoffee.ru','Ежедневно · 09:00–21:00'],
  ['Франшиза','+7 (383) 123-20-20','franchise@chashkacoffee.ru','Пн–Пт · 09:00–18:00'],
  ['Вакансии','+7 (383) 123-20-20','team@chashkacoffee.ru','Пн–Пт · 10:00–18:00'],
]
---
<PageShell title="Контакты" active="contacts">
  <section class="contacts-intro"><p>Контакты</p><h1>Найдите нужную<br/>команду</h1><span>Если не уверены, куда написать, выбирайте центральный офис — мы передадим вопрос коллегам.</span></section>
  <section class="contact-grid">{contacts.map(([title,phone,email,hours],index) => <article><b>0{index+1}</b><h2>{title}</h2><div><a href={`tel:${phone.replace(/[^+\d]/g,'')}`}>{phone}</a><a href={`mailto:${email}`}>{email}</a></div><small>{hours}</small></article>)}<article class="catering-card"><b>06</b><h2>Кейтеринг</h2><p>Выездные события и обслуживание вне ресторанов.</p><a class="button" href="https://catering-denisivanov.ru/" target="_blank" rel="noreferrer">Перейти на сайт</a></article></section>
  <section class="contact-form"><div><p>Один адрес для вопроса</p><h2>Напишите нам</h2><span>Оставьте контакты и коротко опишите задачу. Команда ответит по указанному адресу.</span></div><LeadForm type="CONTACT" submitLabel="Отправить сообщение" subjectLabel="Тема обращения" /></section>
  {page && <ContentBlocks blocks={page.blocks}/>} 
</PageShell>
<style>
  .contacts-intro{display:grid;grid-template-columns:.35fr 1fr .55fr;align-items:end;gap:30px;padding:clamp(72px,10vw,150px) var(--content-gutter);border-bottom:1px solid var(--line)}.contacts-intro>p{margin:0;color:#6f902b;font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.contacts-intro h1{margin:0;font-size:clamp(48px,5.7vw,92px)}.contacts-intro span{color:var(--muted);font-size:13px;line-height:1.65}.contact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;padding:clamp(80px,10vw,145px) var(--content-gutter)}.contact-grid article{display:flex;min-height:300px;align-items:flex-start;padding:28px;border-radius:var(--radius);background:#efebe4;flex-direction:column}.contact-grid article:nth-child(2n){background:#e1e8d8}.contact-grid b{color:#71902b;font-size:10px}.contact-grid h2{margin:76px 0 22px;font-size:25px}.contact-grid a{display:block;color:inherit;font-size:12px;font-weight:600;line-height:1.9;text-decoration:none}.contact-grid small{margin-top:auto;color:var(--muted);font-size:10px}.contact-grid .catering-card{background:var(--moss);color:#fff}.catering-card p{max-width:320px;margin:0;color:#d7e0d7;font-size:12px;line-height:1.6}.catering-card .button{margin-top:auto;padding:0 20px;background:var(--lime);color:var(--moss)}.contact-form{display:grid;grid-template-columns:.8fr 1.2fr;gap:70px;padding:clamp(48px,7vw,100px);border-radius:var(--radius);background:var(--moss);color:#fff}.contact-form>div>p{margin:0;color:var(--lime);font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.contact-form h2{margin:17px 0;font-size:clamp(44px,4.7vw,76px)}.contact-form>div>span{display:block;max-width:390px;color:#d7e0d7;font-size:13px;line-height:1.65}@media(max-width:820px){.contacts-intro{grid-template-columns:1fr;padding:82px 20px}.contact-grid{grid-template-columns:1fr;padding:12px}.contact-grid article{min-height:250px}.contact-grid h2{margin-top:55px}.contact-form{grid-template-columns:1fr;padding:58px 25px}.contact-form form{margin-top:20px}}
</style>
