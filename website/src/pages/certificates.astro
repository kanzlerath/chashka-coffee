---
import PageShell from '../layouts/PageShell.astro'
import ContentBlocks from '../components/ContentBlocks.astro'
import { getManagedPage } from '../lib/public-api'

const page = await getManagedPage('CERTIFICATES')
const values = ['1 000 ₽','3 000 ₽','5 000 ₽','10 000 ₽']
---
<PageShell title="Сертификаты" active="certificates">
  <section class="certificate-opening"><div><p>Подарок со вкусом</p><h1>Для тех,<br/>чей выбор<br/>важен</h1><span>Электронный сертификат оставляет главное — свободу выбрать любимый кофе, десерт или долгий ужин.</span><a class="button" href="/app">Выбрать в приложении</a></div><div class="gift-card" aria-hidden="true"><span>ЧК</span><strong>Подарочный<br/>сертификат</strong><i>Место для хорошего дня.</i></div></section>
  <section class="certificate-values"><header><p>Номиналы</p><h2>От маленького повода<br/>до большого праздника</h2></header><div>{values.map((value,index) => <article><b>0{index+1}</b><strong>{value}</strong><span>Электронный сертификат</span></article>)}</div></section>
  <section class="certificate-rules"><div><p>Как это работает</p><h2>Выберите.<br/>Подарите.<br/>Встретьтесь.</h2></div><ol><li>Сертификат оформляется в приложении.</li><li>Им можно оплатить покупки в «Чашке кофе» по правилам программы.</li><li>Срок действия и актуальные условия доступны при оформлении.</li></ol><a class="button button-outline" href="/certificate-rules">Полные правила</a></section>
  {page && <ContentBlocks blocks={page.blocks}/>} 
</PageShell>
<style>
  .certificate-opening{display:grid;grid-template-columns:1fr 1fr;min-height:690px;align-items:center;overflow:hidden;border-radius:var(--radius);background:var(--lime);color:var(--moss)}.certificate-opening>div:first-child{padding:clamp(48px,7vw,110px)}.certificate-opening p,.certificate-values header>p,.certificate-rules>div>p{margin:0;font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.certificate-opening h1{margin:18px 0;font-size:clamp(56px,5.8vw,96px);line-height:.85}.certificate-opening>div:first-child>span{display:block;max-width:480px;font-size:14px;line-height:1.65}.certificate-opening .button{margin-top:28px;padding:0 22px;background:var(--moss);color:#fff}.gift-card{justify-self:center;display:flex;width:min(74%,470px);aspect-ratio:1.58;padding:34px;border-radius:var(--radius);background:var(--moss);color:#fff;box-shadow:22px 24px 0 rgba(31,59,46,.15);transform:rotate(-6deg);flex-direction:column}.gift-card>span{font-size:48px;font-weight:800}.gift-card strong{margin:auto 0;font-size:33px;line-height:.95}.gift-card i{font-size:11px;font-style:normal}.certificate-values{padding:clamp(90px,11vw,170px) var(--content-gutter)}.certificate-values h2,.certificate-rules h2{margin:16px 0;font-size:clamp(43px,4.8vw,78px)}.certificate-values>div{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:52px}.certificate-values article{display:flex;min-height:260px;padding:26px;border-radius:var(--radius);background:#efebe4;flex-direction:column}.certificate-values article:nth-child(2n){background:#dfe8d2}.certificate-values b{color:#71902b;font-size:10px}.certificate-values strong{margin:auto 0 8px;font-size:32px}.certificate-values span{color:var(--muted);font-size:10px}.certificate-rules{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(40px,8vw,120px);padding:clamp(50px,7vw,105px);border-radius:var(--radius);background:var(--moss);color:#fff}.certificate-rules>div>p{color:var(--lime)}.certificate-rules ol{margin:0;padding:0;list-style:none;border-top:1px solid rgba(255,255,255,.2)}.certificate-rules li{padding:22px 0;border-bottom:1px solid rgba(255,255,255,.2);font-size:14px;line-height:1.6}.certificate-rules>a{grid-column:2;justify-self:start;padding:0 22px;border-color:#fff;color:#fff}@media(max-width:820px){.certificate-opening{grid-template-columns:1fr}.certificate-opening>div:first-child{min-height:530px;padding:48px 25px}.gift-card{margin:35px auto 80px}.certificate-values{padding:82px 20px}.certificate-values>div{grid-template-columns:1fr 1fr}.certificate-values article{min-height:210px;padding:20px}.certificate-rules{grid-template-columns:1fr;padding:55px 25px}.certificate-rules>a{grid-column:1}}
</style>
