---
import PageShell from '../../layouts/PageShell.astro'
import ContentBlocks from '../../components/ContentBlocks.astro'
import EventRegistrationForm from '../../components/EventRegistrationForm.astro'
import NotFoundPage from '../../components/NotFoundPage.astro'
import { getContentEntry, getContentSlugs } from '../../lib/public-api'
export async function getStaticPaths(){return (await getContentSlugs('EVENT',['italian-classics','jazz-in-park','latte-art','book-club'])).map((slug)=>({params:{slug}}))}
const entry = await getContentEntry('EVENT',Astro.params.slug!)
const date = entry?.eventStartsAt ? new Date(entry.eventStartsAt).toLocaleString('ru-RU',{day:'numeric',month:'long',hour:'2-digit',minute:'2-digit'}) : 'Дата уточняется'
const money = entry?.priceKopecks === null ? 'Бесплатно' : entry ? `${Math.round((entry.priceKopecks ?? 0)/100).toLocaleString('ru-RU')} ₽` : ''
if (!entry) { Astro.response.status = 404; Astro.response.statusText = 'Not Found' }
---
{entry ? <PageShell title={entry.title} active="events" image={entry.imageUrl ?? '/images/home-breakfast.png'}><article class="event-detail"><div><p>Событие</p><h1>{entry.title}</h1><span>{entry.excerpt}</span><dl><div><dt>Дата</dt><dd>{date}</dd></div><div><dt>Место</dt><dd>{entry.location ?? 'Уточняется'}</dd></div><div><dt>Стоимость</dt><dd>{money}</dd></div></dl></div><img src={entry.imageUrl ?? '/images/home-breakfast.png'} alt=""/></article><ContentBlocks blocks={entry.blocks}/>{entry.registrationEnabled && <section class="registration"><div><p>Участие</p><h2>Запишитесь на событие</h2><span>Заявка попадёт команде ресторана. Мы уточним детали и подтвердим место.</span></div><EventRegistrationForm eventSlug={entry.slug} eventTitle={entry.title}/></section>}<a class="back" href="/events">Ко всем событиям</a></PageShell> : <NotFoundPage/>}
<style>
  .event-detail{display:grid;grid-template-columns:.9fr 1.1fr;min-height:650px;overflow:hidden;border-radius:var(--radius);background:#ece7df}.event-detail>div{display:flex;justify-content:flex-end;align-items:flex-start;padding:clamp(50px,6vw,95px);flex-direction:column}.event-detail>div>p,.registration>div>p{margin:0;color:#6f902b;font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.event-detail h1{margin:19px 0;font-size:clamp(48px,5.5vw,90px)}.event-detail>div>span{color:var(--muted);font-size:15px;line-height:1.6}.event-detail>img{width:100%;height:100%;object-fit:cover}.event-detail dl{display:grid;grid-template-columns:repeat(3,1fr);width:100%;margin:40px 0 0;border-top:1px solid #d4cdc3}.event-detail dl>div{padding:20px 10px 0 0}.event-detail dt{color:var(--muted);font-size:9px}.event-detail dd{margin:8px 0 0;font-size:12px;font-weight:700}.registration{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(40px,7vw,100px);margin-top:var(--section-gap);padding:clamp(48px,7vw,100px);border-radius:var(--radius);background:var(--moss);color:#fff}.registration h2{margin:18px 0;font-size:clamp(43px,5vw,80px)}.registration>div>span{color:#dbe5dc;font-size:13px;line-height:1.65}@media(max-width:820px){.event-detail,.registration{grid-template-columns:1fr}.event-detail>div{min-height:560px;padding:48px 25px}.event-detail>img{height:360px}.event-detail dl{grid-template-columns:1fr}.registration{margin:12px;padding:50px 25px}}
</style>
