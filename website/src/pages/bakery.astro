---
import PageShell from '../layouts/PageShell.astro'
import ContentBlocks from '../components/ContentBlocks.astro'
import ProductCard from '../components/ProductCard.astro'
import { getManagedPage, getProducts } from '../lib/public-api'
const [products,page] = await Promise.all([getProducts('CAKE'),getManagedPage('BAKERY')])
---
<PageShell title="Кондитерская" active="bakery">
  <section class="bakery-opening"><div><p>Собственная кондитерская</p><h1>Десерт<br/>как часть<br/>истории</h1><span>Собираем торты вручную — из натуральных ингредиентов, без маргарина, искусственных красителей и ароматизаторов.</span><a class="button" href="#catalog">Каталог тортов</a></div><img src="/images/home-breakfast.png" alt="Торт из собственной кондитерской"/></section>
  <section class="bakery-values"><article><b>01</b><h2>Вкус важнее декора</h2><p>Оформление должно поддерживать идею торта, а не спорить с ней.</p></article><article><b>02</b><h2>Всё начинается с продукта</h2><p>Сливки, ягоды, шоколад и бисквит — без ненужных компромиссов.</p></article></section>
  {page && <ContentBlocks blocks={page.blocks}/>} 
  <section id="catalog" class="cake-catalog"><header><p>Каталог 2025</p><h2>Торты для вашего дня</h2><span>В карточке указаны состав, масса и стоимость. Заказы принимаем заранее.</span></header>{products.length ? <div>{products.map((product) => <ProductCard product={product}/>)}</div> : <p class="catalog-empty">Каталог временно недоступен. Попробуйте обновить страницу немного позже.</p>}</section>
  <section class="cake-order"><div><p>Особый заказ</p><h2>Ваш повод, наша работа</h2></div><div><p>Поможем выбрать вкус, вес и оформление. Обсудить заказ можно с командой кондитерской.</p><a class="button" href="/contacts">Связаться</a></div></section>
</PageShell>
<style>
  .bakery-opening{display:grid;grid-template-columns:.9fr 1.1fr;min-height:700px;overflow:hidden;border-radius:var(--radius);background:#efe5da}.bakery-opening>div{display:flex;justify-content:flex-end;align-items:flex-start;padding:clamp(55px,6.5vw,105px);flex-direction:column}.bakery-opening>div>p,.cake-catalog header p,.cake-order>div>p{margin:0;color:#6f902b;font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.bakery-opening h1{margin:20px 0;font-size:clamp(58px,6vw,100px);line-height:.82}.bakery-opening span{max-width:470px;color:var(--muted);font-size:15px;line-height:1.65}.bakery-opening .button{margin-top:28px;padding:0 22px}.bakery-opening>img{width:100%;height:100%;object-fit:cover}.bakery-values{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:clamp(90px,11vw,170px) var(--content-gutter)}.bakery-values article{min-height:360px;padding:clamp(28px,4vw,58px);border:1px solid var(--line);border-radius:var(--radius);background:#f1ece5}.bakery-values article+article{background:#e4eadb}.bakery-values b{color:#6f902b;font-size:11px}.bakery-values h2{margin:85px 0 20px;font-size:clamp(36px,4vw,64px)}.bakery-values p{max-width:530px;color:var(--muted);font-size:13px;line-height:1.65}.cake-catalog{padding:clamp(90px,10vw,160px) var(--content-gutter)}.cake-catalog header{max-width:900px;margin-bottom:52px}.cake-catalog h2{margin:15px 0;font-size:clamp(44px,5vw,82px)}.cake-catalog header>span{color:var(--muted);font-size:14px;line-height:1.6}.cake-catalog>div{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.catalog-empty{padding:30px;border-radius:var(--radius);background:var(--sand)}.cake-order{display:grid;grid-template-columns:1.35fr .65fr;gap:60px;padding:clamp(50px,7vw,105px);border-radius:var(--radius);background:#e7ddcf}.cake-order h2{max-width:920px;margin:18px 0 0;font-size:clamp(44px,5.4vw,88px)}.cake-order>div:last-child{align-self:end}.cake-order>div:last-child p{color:var(--muted);font-size:14px;line-height:1.65}.cake-order .button{margin-top:24px;padding:0 22px}@media(max-width:900px){.bakery-opening{grid-template-columns:1fr}.bakery-opening>div{min-height:560px;padding:48px 25px}.bakery-opening>img{height:380px}.bakery-values,.cake-catalog>div,.cake-order{grid-template-columns:1fr}.bakery-values{padding:82px 20px}.bakery-values h2{margin-top:55px}.cake-catalog{padding:82px 20px}.cake-order{margin:0 12px;padding:50px 25px}.cake-order h2{font-size:48px}}
</style>
