---
import PageShell from '../layouts/PageShell.astro';
import DishDialog from '../components/DishDialog.astro';
import JournalCard from '../components/JournalCard.astro';
import type { ContentEntry, HomepagePublicResponse, RestaurantSummary } from '@chashka-coffee/contracts';
import { formatMenuPortion } from '../lib/menu-portion';

const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3000'
let homepage: HomepagePublicResponse | null = null
let promotions: ContentEntry[] = []
let events: ContentEntry[] = []
let articles: ContentEntry[] = []
let restaurants: RestaurantSummary[] = []

try {
  const [homepageResponse, promotionResponse, eventResponse, articleResponse, restaurantResponse] = await Promise.all([
    fetch(`${apiUrl}/api/homepage`),
    fetch(`${apiUrl}/api/content?type=PROMOTION`),
    fetch(`${apiUrl}/api/content?type=EVENT`),
    fetch(`${apiUrl}/api/content?type=ARTICLE`),
    fetch(`${apiUrl}/api/restaurants`),
  ])
  if (homepageResponse.ok) homepage = await homepageResponse.json()
  if (promotionResponse.ok) promotions = (await promotionResponse.json()).entries
  if (eventResponse.ok) events = (await eventResponse.json()).entries
  if (articleResponse.ok) articles = (await articleResponse.json()).entries
  if (restaurantResponse.ok) restaurants = (await restaurantResponse.json()).restaurants
} catch { /* The local fallback keeps the storefront complete before the API is available. */ }

const defaultSlides = [
  { mediaType: 'IMAGE', mediaUrl: '/images/home-morning-v2.png', posterUrl: null, eyebrow: 'С хорошего кофе', title: 'Начните день\nв своём ритме', description: 'Завтрак, любимый кофе и немного времени для себя.', ctaLabel: 'Открыть меню', ctaUrl: '/menu', durationSeconds: 7 },
  { mediaType: 'IMAGE', mediaUrl: '/images/home-breakfast.png', posterUrl: null, eyebrow: 'В каждом районе', title: 'Место, куда\nхочется зайти', description: 'Встретиться, поработать или просто сделать паузу.', ctaLabel: 'Найти ресторан', ctaUrl: '/restaurants', durationSeconds: 7 },
  { mediaType: 'IMAGE', mediaUrl: '/images/restaurants-hero.png', posterUrl: null, eyebrow: 'Любимое — ближе', title: 'Кофе и еда\nс доставкой', description: 'Привезём из ближайшей «Чашки кофе» бережно и вовремя.', ctaLabel: 'Заказать доставку', ctaUrl: '/delivery', durationSeconds: 7 },
]
const safeMenuHref = (href: string | null | undefined) => {
  if (!href) return href
  const menuRoute = href.match(/^\/restaurants\/([^/]+)\/menu$/)
  if (!menuRoute) return href
  return restaurants.some(({ slug }) => slug === menuRoute[1]) ? href : '/menu'
}
const slides = (homepage?.slides.length ? homepage.slides : defaultSlides).map((slide) => ({ ...slide, ctaUrl: safeMenuHref(slide.ctaUrl) }))
const productFallbacks = ['/images/home-breakfast.png', '/images/home-hero-v1.png', '/images/home-morning-v2.png', '/images/restaurants-hero.png']
const badgeLabel = (value: string | null | undefined) => ({ NEW: 'Новинка', HIT: 'Хит', SEASONAL: 'Сезонное', SPECIAL: 'Специальное' }[value ?? ''] ?? value ?? null)
const defaultBestsellers = [
  { slug: 'avocado-toast', name: 'Тост с авокадо', price: '590 ₽', output: '260 г', badge: 'Хит', imageUrl: productFallbacks[0], categoryName: 'Завтраки', description: 'Хрустящий хлеб, авокадо и яйцо пашот.', ingredients: 'Хлеб на закваске, авокадо, яйцо, лимонный сок.', allergens: ['Глютен', 'Яйцо'], dietaryMarks: ['Вегетарианское'], calories: '520', proteins: '18 г', fats: '27 г', carbohydrates: '46 г' },
  { slug: 'cappuccino', name: 'Капучино', price: '290 ₽', output: '300 мл', badge: 'Классика', imageUrl: productFallbacks[1], categoryName: 'Кофе', description: 'Эспрессо и нежная молочная текстура.', ingredients: 'Кофе, молоко.', allergens: ['Молочный продукт'], dietaryMarks: [], calories: null, proteins: null, fats: null, carbohydrates: null },
  { slug: 'ricotta-syrniki', name: 'Сырники из рикотты', price: '490 ₽', output: '220 г', badge: 'Любимое', imageUrl: productFallbacks[2], categoryName: 'Завтраки', description: 'Нежные сырники с ягодным соусом.', ingredients: 'Рикотта, яйцо, рисовая мука, сахар.', allergens: ['Яйцо', 'Молочный продукт'], dietaryMarks: ['Без глютена'], calories: null, proteins: null, fats: null, carbohydrates: null },
  { slug: 'filter-coffee', name: 'Фильтр-кофе', price: '240 ₽', output: '250 мл', badge: 'Новинка', imageUrl: productFallbacks[3], categoryName: 'Кофе', description: 'Чистая и выразительная чашка дня.', ingredients: 'Кофе, вода.', allergens: [], dietaryMarks: [], calories: null, proteins: null, fats: null, carbohydrates: null },
]
const badgeTone = (badge: string | null | undefined) => {
  const value = badge?.toLocaleLowerCase('ru') ?? ''
  if (value.includes('хит')) return 'hit'
  if (value.includes('нов')) return 'new'
  if (value.includes('сезон') || value.includes('лет')) return 'seasonal'
  if (value.includes('люб')) return 'favourite'
  return 'special'
}
const dietaryLabel = (mark: string) => ({ VEGETARIAN: 'Вегетарианское', SPICY: 'Острое', LACTOSE_FREE: 'Без лактозы', GLUTEN_FREE: 'Без глютена', LIGHT: 'Лёгкое' }[mark] ?? mark)
const bestsellers = homepage?.bestsellers.length
  ? homepage.bestsellers.map((entry, index) => ({
      slug: entry.item.slug,
      name: entry.item.name,
      price: `${Math.round(entry.item.priceKopecks / 100)} ₽`,
      output: formatMenuPortion(entry.item.weightGrams, entry.item.measurementUnit),
      badge: badgeLabel(entry.badge ?? entry.item.marketingBadge),
      badgeTone: badgeTone(badgeLabel(entry.badge ?? entry.item.marketingBadge)),
      imageUrl: entry.item.imageUrl ?? productFallbacks[index % productFallbacks.length],
      categoryName: entry.item.categoryName,
      description: entry.item.description ?? '',
      ingredients: entry.item.ingredients ?? '',
      allergens: entry.item.allergens,
      dietaryMarks: entry.item.dietaryMarks.map(dietaryLabel),
      calories: entry.item.calories === null ? null : String(entry.item.calories),
      proteins: entry.item.proteins === null ? null : `${entry.item.proteins} г`,
      fats: entry.item.fats === null ? null : `${entry.item.fats} г`,
      carbohydrates: entry.item.carbohydrates === null ? null : `${entry.item.carbohydrates} г`,
    }))
  : defaultBestsellers.map((item) => ({ ...item, badgeTone: badgeTone(item.badge) }))
const bestsellerPayload = (item: (typeof bestsellers)[number]) => JSON.stringify({
  name:item.name,categoryName:item.categoryName,description:item.description,ingredients:item.ingredients,
  allergens:item.allergens,dietaryMarks:item.dietaryMarks,weight:item.output,price:item.price,
  calories:item.calories,proteins:item.proteins,fats:item.fats,carbohydrates:item.carbohydrates,
  imageUrl:item.imageUrl,badge:item.badge,badgeTone:item.badgeTone,
})
const featuredPromotion = promotions.at(0) ?? null
const featuredEvent = events.at(0) ?? null
const journal = articles.slice(0, 2).length ? articles.slice(0, 2) : [
  { slug: 'coffee-morning', title: 'Кофе для первого тёплого утра', excerpt: 'Как выбрать напиток, который не спорит с вашим настроением.', imageUrl: '/images/home-breakfast.png', startsAt: null, createdAt: '2026-07-18T05:00:00.000Z' },
  { slug: 'croissant-now', title: 'Почему круассан лучше есть сразу', excerpt: 'Немного масла, много слоёв и один простой совет от кондитера.', imageUrl: '/images/home-hero-v1.png', startsAt: null, createdAt: '2026-07-12T05:00:00.000Z' },
]
const fallbackPlaces: RestaurantSummary[] = [
  { id: '019a2f17-453e-7c1a-9c04-4e468e7eb514', slug: 'krasny-prospekt', name: 'Чашка кофе — Красный проспект', format: 'CITY', area: 'CITY', isAtApartHotel: false, city: 'Новосибирск', address: 'Красный проспект, 25', phone: '+7 (383) 123-20-20', openingHoursLabel: 'Пн–Вс: 07:30–23:00', hasMenu: true, coverImageUrl: '/images/restaurants-hero.png' },
  { id: '019a2f17-453e-7c1a-9c04-4e468e7eb515', slug: 'tolmachevo-domestic', name: 'Чашка кофе — Толмачёво, вылеты по России', format: 'AIRPORT', area: 'AIRPORT', isAtApartHotel: false, city: 'Обь', address: 'Аэропорт Толмачёво, сектор A', phone: '+7 (383) 123-20-30', openingHoursLabel: 'Ежедневно: круглосуточно', hasMenu: true, coverImageUrl: '/images/home-hero-v1.png' },
]
const availablePlaces = restaurants.length ? restaurants : fallbackPlaces
const cityPlaces = availablePlaces.filter((place) => place.area !== 'AIRPORT')
const airportPlaces = availablePlaces.filter((place) => place.area === 'AIRPORT')
const placeGroups = [
  { id: 'city', label: 'Город', places: cityPlaces },
  { id: 'airport', label: 'Аэропорт', places: airportPlaces },
]
const allPlaces = placeGroups.flatMap((group) => group.places.map((place) => ({ ...place, group: group.id })))
const defaultDaySection = {
  title: 'Поводы\nзайти сегодня',
  description: 'Сначала завтрак, потом встреча, а вечером — время для себя. Выбирайте свой ритм.',
  parts: [
    { id: 'morning', label: 'Утро', title: 'Завтраки\nдо 12:00', description: 'Медленные утра и кофе, который не нужно торопить.', ctaUrl: '/menu' },
    { id: 'daytime', label: 'Днём', title: 'Встречи\nв городе', description: 'Ресторан рядом, когда нужно место для своих людей.', ctaUrl: '/restaurants' },
    { id: 'evening', label: 'Вечером', title: 'События\nи музыка', description: 'Поводы задержаться дольше обычного.', ctaUrl: featuredEvent ? `/events/${featuredEvent.slug}` : '/events' },
  ],
}
const daySection = homepage?.daySection?.parts.length ? homepage.daySection : defaultDaySection
const eventTitle = featuredEvent?.title ?? 'Вечер в Чашке'
---

<PageShell title="Чашка кофе" description="Чашка кофе — сеть ресторанов в Новосибирске: завтраки, десерты, кофе и места для хорошего дня." image="/images/home-morning-v2.png">
  <div class="home-page">
    <section class="home-stories" data-home-stories aria-label="Актуальное в Чашке кофе" aria-roledescription="карусель" tabindex="0">
      <div class="stories-media">
        {slides.map((slide, index) => <article class:list={['story-media-item', { 'is-active': index === 0 }]} data-story-media aria-hidden={index === 0 ? 'false' : 'true'}>
          {slide.mediaType === 'VIDEO'
            ? <video loop muted playsinline poster={slide.posterUrl ?? undefined} preload={index === 0 ? 'auto' : 'metadata'} src={slide.mediaUrl}></video>
            : <img src={slide.mediaUrl} alt="" fetchpriority={index === 0 ? 'high' : undefined} loading={index === 0 ? 'eager' : 'lazy'} />}
        </article>)}
      </div>
      <div class="stories-copy">
        {slides.map((slide, index) => <article class:list={['story-copy-item', { 'is-active': index === 0 }]} data-story-copy aria-hidden={index === 0 ? 'false' : 'true'}>
          {(() => {
            const [scriptTitle, ...mainTitle] = slide.title.split(/\r?\n/).filter(Boolean)
            return <h1><span class="story-title-script">{scriptTitle}</span>{mainTitle.length > 0 && <span class="story-title-main">{mainTitle.join(' ')}</span>}</h1>
          })()}
          {slide.eyebrow && <p class="story-kicker">{slide.eyebrow}</p>}
          {slide.description && <p class="story-description">{slide.description}</p>}
          {slide.ctaLabel && slide.ctaUrl && <a class="ui-button ui-button--fill" href={slide.ctaUrl}>{slide.ctaLabel}</a>}
        </article>)}
      </div>
      {slides.length > 1 && <div class="story-navigation" aria-label="Управление историями">
        <div class="story-progress" aria-label="Выбор истории">
          {slides.map((slide, index) => <button class:list={{ 'is-active': index === 0 }} type="button" data-story-control={index} data-story-duration={slide.durationSeconds} style={`--story-duration:${slide.durationSeconds}s`} aria-current={index === 0 ? 'true' : undefined} aria-label={`История ${index + 1}: ${slide.title.replace('\n', ' ')}`}></button>)}
        </div>
        <p class="story-counter"><span data-story-current>01</span> / {String(slides.length).padStart(2, '0')}</p>
        <div class="story-arrows">
          <button type="button" data-story-previous aria-label="Предыдущая история"><svg viewBox="0 0 18 18" aria-hidden="true"><path d="m11 3-6 6 6 6" /></svg></button>
          <button type="button" data-story-next aria-label="Следующая история"><svg viewBox="0 0 18 18" aria-hidden="true"><path d="m7 3 6 6-6 6" /></svg></button>
        </div>
      </div>}
    </section>

    <section class="home-bestsellers home-section" data-bestseller-carousel aria-labelledby="bestsellers-title">
      <header class="home-section-head"><div><h2 id="bestsellers-title">Бестселлеры</h2></div></header>
      <div class="bestseller-viewport" data-bestseller-viewport aria-label="Бестселлеры" aria-roledescription="карусель" tabindex="0">
        <div class="bestseller-list" data-bestseller-track style={`--bestseller-card-basis:${bestsellers.length === 2 ? '72%' : bestsellers.length === 3 ? '42%' : '30.4%'}`}>{bestsellers.map((item, index) => <button type="button" class="product-card" data-bestseller-card data-bestseller-index={index} data-dish-trigger data-dish={bestsellerPayload(item)} aria-haspopup="dialog"><div class="product-card-image"><img src={item.imageUrl} alt="" loading="lazy" draggable="false" />{item.badge && <span class={`product-badge product-badge--${item.badgeTone}`}>{item.badge}</span>}</div><div class="product-card-info"><small>{item.categoryName}</small><h3>{item.name}</h3><div><span>{item.output}</span><strong>{item.price}</strong></div></div></button>)}</div>
      </div>
      <a class="ui-button ui-button--outline section-action" href="/menu">Смотреть все</a>
    </section>

    <section class="home-bento" aria-label="Разделы Чашки кофе">
      <a class="bento-card bento-app" href="/app"><h2>Приложение<br />«Чашка кофе»</h2><img class="bento-art bento-art-app" src="/brand/bento/App.svg" alt="" aria-hidden="true" /></a>
      <a class="bento-card bento-coffee" href="/coffee"><h2>Кофе<br />для дома</h2><img class="bento-art bento-art-coffee" src="/brand/bento/Coffeeshop.svg" alt="" aria-hidden="true" /></a>
      <a class="bento-card bento-event" href={featuredEvent ? `/events/${featuredEvent.slug}` : '/events'}><h2>{eventTitle}</h2><img class="bento-art bento-art-event" src="/brand/bento/Evenings.svg" alt="" aria-hidden="true" /></a>
      <a class="bento-card bento-promo" href={featuredPromotion ? `/promotions/${featuredPromotion.slug}` : '/promotions'}><h2>Акции<br />и новинки</h2><img class="bento-art bento-art-promo" src="/brand/bento/Sale.svg" alt="" aria-hidden="true" /></a>
      <a class="bento-card bento-certificates" href="/certificates"><h2>Сертификаты</h2><img class="bento-art bento-art-certificate" src="/brand/bento/Certificate.svg" alt="" aria-hidden="true" /></a>
      <a class="bento-card bento-bakery" href="/bakery"><h2>Кондитерская</h2><img class="bento-art bento-art-cake" src="/brand/bento/Cake.svg" alt="" aria-hidden="true" /></a>
    </section>

    <section class="home-day" aria-labelledby="day-title">
      <div class="day-intro"><h2 id="day-title">{daySection.title.split('\n').map((line) => <>{line}<br /></>)}</h2>{daySection.description && <p>{daySection.description}</p>}</div>
      <div class="day-stops">{daySection.parts.map((part) => <a href={safeMenuHref(part.ctaUrl) ?? '/'}><small>{part.label}</small><h3>{part.title.split('\n').map((line) => <>{line}<br /></>)}</h3>{part.description && <p>{part.description}</p>}</a>)}</div>
    </section>

    <section class="home-menu home-section" aria-labelledby="menu-title">
      <header class="home-section-head"><div><h2 id="menu-title">Меню по настроению</h2></div></header>
      <div class="menu-grid">
        <a class="menu-tile menu-main" href="/menu"><img src="/images/home-breakfast.png" alt="Завтраки" loading="lazy" /><span>Завтраки</span></a>
        <a class="menu-tile menu-tile-coffee" href="/menu"><span>Кофе</span><img class="menu-tile-art menu-art-coffee" src="/images/coffee-inhouse.svg" alt="" aria-hidden="true" /></a>
        <a class="menu-tile menu-tile-seasonal" href="/promotions"><span>Летние<br />хиты</span><img class="menu-tile-art menu-art-seasonal" src="/images/summer-hits.svg" alt="" aria-hidden="true" /></a>
        <a class="menu-tile menu-tile-hot" href="/menu"><span>Горячие<br />блюда</span><img class="menu-tile-art menu-art-hot" src="/images/hot-dish.svg" alt="" aria-hidden="true" /></a>
        <a class="menu-tile menu-tile-salad" href="/menu"><span>Закуски<br />и салаты</span><img class="menu-tile-art menu-art-salad" src="/images/appetit.svg" alt="" aria-hidden="true" /></a>
        <a class="menu-tile menu-tile-dessert" href="/bakery"><span>Десерты<br />и выпечка</span><img class="menu-tile-art menu-art-dessert" src="/images/desserts.svg" alt="" aria-hidden="true" /></a>
        <a class="menu-all" href="/menu"><span>Посмотреть все блюда</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-5 5 5-5 5" /></svg></a>
      </div>
    </section>

    <section class="home-places home-section" data-home-places aria-labelledby="places-title">
      <header class="home-section-head places-heading"><div><h2 id="places-title">Рестораны в городе</h2></div></header>
      <div class="places-stage">
        <div class="place-feature">
          {allPlaces.map((place, index) => <article class:list={{ 'is-active': index === 0 }} data-place-panel={place.slug} data-place-group={place.group}>
            <img src={place.coverImageUrl ?? productFallbacks[index % productFallbacks.length]} alt="" loading="lazy" />
            <div><h3>{place.name.replace('Чашка кофе — ', '')}</h3><span>{place.address}<br />{place.openingHoursLabel}</span><a class="ui-button ui-button--fill" href={`/restaurants/${place.slug}`}>Подробнее</a></div>
          </article>)}
        </div>
        <div class="place-list">{allPlaces.map((place) => <button data-place-button={place.slug} type="button"><span>{place.name.replace('Чашка кофе — ', '')}</span><small>{place.address}</small></button>)}</div>
      </div>
      <a class="ui-button ui-button--outline section-action" href="/restaurants">Все рестораны</a>
    </section>

    <div class="home-final-callouts">
      <section class="home-home-coffee" aria-labelledby="home-coffee-title"><div><h2 id="home-coffee-title">Заварите<br />свой момент</h2><p>Зерно, дрипы и капсулы для утра дома, офиса или дороги, которую вы выбираете сами.</p><a class="ui-button ui-button--fill" href="/coffee">Выбрать кофе</a></div><img class="home-coffee-visual" src="/images/home-beans.svg" alt="" aria-hidden="true" /></section>

      <section class="home-app-loyalty" aria-labelledby="loyalty-title"><div class="loyalty-copy"><h2 id="loyalty-title">Бонусы за<br />любимые встречи</h2><p>Показывайте карту при каждом заказе, копите бонусы и оплачивайте ими следующие визиты.</p><a class="ui-button ui-button--fill" href="/loyalty">О программе лояльности</a></div><img class="loyalty-visual" src="/images/loyalty-system.svg" alt="" aria-hidden="true" /></section>
    </div>

    <section class="home-journal home-section" aria-labelledby="journal-title">
      <header class="home-section-head"><div><h2 id="journal-title">Читайте медленнее</h2></div></header>
      <div class="journal-list">
        {journal.map((article, index) => <JournalCard entry={article} fallbackImage={productFallbacks[index]} headingLevel={3} />)}
      </div>
      <a class="ui-button ui-button--outline section-action" href="/journal">Посмотреть все</a>
    </section>

    <div class="home-marquee" aria-label="Чашка кофе: кофе, завтраки, десерты и встречи"><div>ЧАШКА КОФЕ <i>✦</i> КОФЕ <i>✦</i> ЗАВТРАКИ <i>✦</i> ДЕСЕРТЫ <i>✦</i> ВСТРЕЧИ <i>✦</i> ЧАШКА КОФЕ <i>✦</i> КОФЕ <i>✦</i> ЗАВТРАКИ <i>✦</i> ДЕСЕРТЫ <i>✦</i> ВСТРЕЧИ <i>✦</i></div></div>
    <DishDialog />
  </div>
</PageShell>

<script>
  const stories = document.querySelector<HTMLElement>('[data-home-stories]')

  if (stories) {
    const media = [...stories.querySelectorAll<HTMLElement>('[data-story-media]')]
    const copy = [...stories.querySelectorAll<HTMLElement>('[data-story-copy]')]
    const controls = [...stories.querySelectorAll<HTMLButtonElement>('[data-story-control]')]
    const previous = stories.querySelector<HTMLButtonElement>('[data-story-previous]')
    const next = stories.querySelector<HTMLButtonElement>('[data-story-next]')
    const current = stories.querySelector<HTMLElement>('[data-story-current]')
    let active = 0
    let pointerId: number | null = null
    let startX = 0
    let startY = 0
    let autoplayTimer: number | undefined
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

    const clearAutoplay = () => {
      if (autoplayTimer === undefined) return
      window.clearTimeout(autoplayTimer)
      autoplayTimer = undefined
    }

    const scheduleAutoplay = () => {
      clearAutoplay()
      if (media.length < 2 || reduceMotion.matches || document.hidden) return
      const duration = Number(controls[active]?.dataset.storyDuration ?? 7)
      autoplayTimer = window.setTimeout(() => show(active + 1), Math.max(duration, 3) * 1000)
    }

    const show = (index: number) => {
      if (!media.length) return
      active = (index + media.length) % media.length
      media.forEach((item, itemIndex) => {
        const isActive = itemIndex === active
        item.classList.toggle('is-active', isActive)
        item.setAttribute('aria-hidden', String(!isActive))
        const video = item.querySelector('video')
        if (!video) return
        if (isActive) void video.play().catch(() => undefined)
        else { video.pause(); video.currentTime = 0 }
      })
      copy.forEach((item, itemIndex) => { item.classList.toggle('is-active', itemIndex === active); item.setAttribute('aria-hidden', String(itemIndex !== active)) })
      controls.forEach((control) => { control.classList.remove('is-active'); control.removeAttribute('aria-current') })
      if (controls.length) void stories.offsetWidth
      controls.forEach((control, controlIndex) => {
        const isActive = controlIndex === active
