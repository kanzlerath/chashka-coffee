  }

  const bestsellerCarousel = document.querySelector<HTMLElement>('[data-bestseller-carousel]')
  if (bestsellerCarousel) {
    const viewport = bestsellerCarousel.querySelector<HTMLElement>('[data-bestseller-viewport]')
    const track = bestsellerCarousel.querySelector<HTMLElement>('[data-bestseller-track]')
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    let pointerId: number | null = null
    let pointerStartX = 0
    let pointerStartY = 0
    let scrollStart = 0
    let dragged = false
    let suppressClick = false

