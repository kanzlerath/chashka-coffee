---
import LegalPage from '../components/LegalPage.astro'
import type { LegalSection } from '../lib/legal-documents'

const sections: LegalSection[] = [
  { id: 'voluntary', heading: 'Добровольный выбор', paragraphs: ['Рекламные сообщения направляются только после отдельного согласия. Отказ от рекламы не мешает оформить заказ, отправить обращение, войти в аккаунт или получать сервисные сообщения. Молчание, регистрация и принятие других документов не считаются согласием на рекламу.'] },
  { id: 'channels', heading: 'Каналы и содержание', paragraphs: ['Если пользователь отдельно выберет соответствующий канал, ООО «Чашка кофе» может сообщать об акциях, новых продуктах, событиях и персональных предложениях по SMS и электронной почте. Push-уведомления будут использоваться только после их запуска и отдельного разрешения в приложении или браузере.'] },
  { id: 'data', heading: 'Какие данные используются', paragraphs: ['Для рассылки используются имя, телефон, e-mail, выбранный канал и сведения о предоставлении или отзыве согласия. Обработка выполняется в соответствии с политикой персональных данных.'], links: [{ label: 'Политика данных', href: '/privacy' }] },
  { id: 'term', heading: 'Срок и отказ', paragraphs: ['Согласие действует до отзыва. Отказаться можно по ссылке в письме, командой в сообщении, через доступные настройки профиля или письмом на support@chashkacoffee.ru. После получения отказа рекламные сообщения по выбранному каналу прекращаются в разумный технический срок.'], note: 'Сервисные SMS с кодом входа, статусом или безопасностью аккаунта не являются рекламой и могут направляться для исполнения запрошенной услуги.' },
]
---

<LegalPage href="/advertising-consent" intro="Реклама — только по отдельному выбору; сервисные сообщения работают независимо." sections={sections} related={['/privacy', '/consent', '/data-request']} />
