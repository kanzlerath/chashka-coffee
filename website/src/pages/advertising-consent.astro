---
import LegalPage from '../components/LegalPage.astro'
import type { LegalSection } from '../lib/legal-documents'

const sections: LegalSection[] = [
  {
    heading: '1. Предоставление согласия',
    clauses: [
      { number: '1.1.', text: 'Я, действуя свободно, своей волей и в своем интересе, даю ООО «Чашка кофе», ИНН 5407066477, ОГРН 1095407010555, адрес: 633104, Новосибирская область, г. Обь, пр-т Мозжерина, зд. 100А, согласие на получение информационных и рекламных сообщений на условиях настоящего документа.' },
      { number: '1.2.', text: 'Согласие предоставляется отдельно от иных согласий и договоров путем совершения действия, прямо обозначенного в соответствующем интерфейсе.' },
      { number: '1.3.', text: 'Отказ от предоставления согласия не ограничивает возможность пользоваться Сайтом, направлять обращения, оформлять заказы, входить в личный кабинет и получать сервисные сообщения.' },
    ],
  },
  {
    heading: '2. Содержание и каналы сообщений',
    clauses: [
      { number: '2.1.', text: 'Сообщения могут содержать сведения об акциях, новых товарах, специальных предложениях, мероприятиях и иных предложениях «Чашки кофе».' },
      { number: '2.2.', text: 'Сообщения могут направляться по SMS и электронной почте в зависимости от выбранного пользователем канала.' },
      { number: '2.3.', text: 'Push-уведомления могут направляться только после запуска соответствующей функции и получения отдельного разрешения в приложении или браузере.' },
    ],
  },
  {
    heading: '3. Персональные данные и действия с ними',
    clauses: [
      { number: '3.1.', text: 'Для направления сообщений могут обрабатываться имя, номер телефона, адрес электронной почты, выбранный канал связи, дата предоставления и дата отзыва согласия.' },
      { number: '3.2.', text: 'С данными могут совершаться сбор, запись, систематизация, накопление, хранение, уточнение, извлечение, использование, передача техническому исполнителю рассылки, блокирование, удаление и уничтожение.' },
      { number: '3.3.', text: 'Обработка осуществляется в соответствии с Политикой обработки персональных данных.', links: [{ label: 'Политика обработки персональных данных', href: '/privacy' }] },
    ],
  },
  {
    heading: '4. Срок действия и отказ от рассылки',
    clauses: [
      { number: '4.1.', text: 'Согласие действует до его отзыва субъектом персональных данных.' },
      { number: '4.2.', text: 'Отказаться от рекламных сообщений можно по ссылке в электронном письме, способом, указанным в сообщении, через доступные настройки профиля или путем направления обращения на support@chashkacoffee.ru.' },
      { number: '4.3.', text: 'После получения отказа направление рекламных сообщений по соответствующему каналу прекращается в срок, необходимый для технической обработки требования.' },
      { number: '4.4.', text: 'Сервисные сообщения, необходимые для входа, исполнения заказа, информирования о его статусе или обеспечения безопасности, не являются рекламой и могут направляться независимо от настоящего согласия.' },
    ],
  },
]
---

<LegalPage href="/advertising-consent" sections={sections} />
