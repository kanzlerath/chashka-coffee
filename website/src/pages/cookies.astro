---
import LegalPage from '../components/LegalPage.astro'
import type { LegalSection } from '../lib/legal-documents'

const sections: LegalSection[] = [
  { id: 'definition', heading: 'Что хранит браузер', paragraphs: ['Сайт использует localStorage и аналогичные технологии, которые принято объединять словом cookies. Они помогают сохранить корзину, сессию личного кабинета и выбор пользователя об аналитике.'] },
  { id: 'necessary', heading: 'Необходимые данные', paragraphs: ['Технические значения, без которых не работают корзина, авторизация, безопасность и запоминание cookie-настроек, используются для предоставления запрошенного сервиса. Их блокировка средствами браузера может нарушить работу сайта.'] },
  { id: 'analytics', heading: 'Аналитика — только после разрешения', paragraphs: ['До нажатия «Разрешить аналитику» сайт не отправляет собственный page-view и не загружает Яндекс Метрику. При согласии собственная статистика получает путь страницы без query-параметров, обезличенный UUID, тип устройства и сокращённый адрес предыдущей страницы. IP, имя, телефон и e-mail в собственную веб-аналитику не записываются.', 'Яндекс Метрика может обрабатывать технические данные по своим документам. Вебвизор в конфигурации сайта отключён. Собственные события хранятся до 12 месяцев.'], links: [{ label: 'Условия Яндекс Метрики', href: 'https://yandex.ru/legal/confidential/', external: true }] },
  { id: 'choice', heading: 'Как изменить выбор', paragraphs: ['При первом посещении можно разрешить аналитику или оставить только необходимые технологии. Выбор сохраняется в браузере. Повторно открыть окно можно по ссылке «Настройки cookies» в подвале. При отказе обезличенный UUID собственной аналитики удаляется, а уже запущенный счётчик Метрики останавливается.'] },
  { id: 'browser', heading: 'Настройки браузера', paragraphs: ['Cookies и localStorage можно очистить или запретить в настройках браузера. После очистки сайт снова запросит выбор и может потерять корзину или сессию. Подробнее об обработке данных и правах пользователя — в политике.'], links: [{ label: 'Политика данных', href: '/privacy' }] },
]
---

<LegalPage href="/cookies" intro="Что необходимо для работы сайта и что включается только после разрешения." sections={sections} related={['/privacy', '/data-request', '/terms']} />
