---
import LegalPage from '../components/LegalPage.astro'
import type { LegalSection } from '../lib/legal-documents'

const sections: LegalSection[] = [
  {
    heading: '1. Общие положения',
    clauses: [
      { number: '1.1.', text: 'Настоящий документ определяет порядок использования на Сайте файлов cookies, localStorage и иных аналогичных технологий.' },
      { number: '1.2.', text: 'Такие технологии позволяют сохранять небольшие объемы информации в браузере пользователя и получать технические сведения о работе Сайта.' },
      { number: '1.3.', text: 'В зависимости от назначения технологии подразделяются на необходимые и аналитические.' },
    ],
  },
  {
    heading: '2. Необходимые технологии',
    clauses: [
      { number: '2.1.', text: 'Необходимые технологии используются для сохранения корзины, поддержания сессии личного кабинета, обеспечения безопасности и хранения выбора пользователя относительно аналитики.' },
      { number: '2.2.', text: 'Указанные технологии применяются для предоставления запрошенных пользователем функций и не отключаются посредством cookie-баннера.' },
      { number: '2.3.', text: 'Блокирование необходимых технологий в настройках браузера может привести к невозможности оформления заказа, входа в личный кабинет или сохранения настроек.' },
    ],
  },
  {
    heading: '3. Собственная аналитика',
    clauses: [
      { number: '3.1.', text: 'Собственная аналитика включается только после выбора пользователем варианта «Разрешить аналитику» в cookie-баннере.' },
      { number: '3.2.', text: 'Собственная аналитика получает путь страницы без query-параметров, обезличенный идентификатор браузера, тип устройства, сокращенный адрес предыдущей страницы, дату и время просмотра.' },
      { number: '3.3.', text: 'Имя, номер телефона, адрес электронной почты и IP-адрес не сохраняются в собственной таблице просмотров Сайта.' },
      { number: '3.4.', text: 'Сведения собственной аналитики хранятся не более 12 месяцев, после чего удаляются.' },
    ],
  },
  {
    heading: '4. Яндекс Метрика',
    clauses: [
      { number: '4.1.', text: 'После получения согласия Сайт может загружать сервис Яндекс Метрика.' },
      { number: '4.2.', text: 'Состав, порядок и сроки обработки данных Яндекс Метрикой определяются настройками счетчика и документами ООО «ЯНДЕКС».' },
      { number: '4.3.', text: 'Вебвизор в конфигурации Сайта отключен.' },
      { number: '4.4.', text: 'До получения согласия скрипт Яндекс Метрики не загружается.', links: [{ label: 'Политика конфиденциальности Яндекса', href: 'https://yandex.ru/legal/confidential/', external: true }] },
    ],
  },
  {
    heading: '5. Управление выбором',
    clauses: [
      { number: '5.1.', text: 'При первом посещении пользователь вправе разрешить аналитику либо выбрать вариант «Только необходимые».' },
      { number: '5.2.', text: 'Изменить выбор можно по ссылке «Настройки cookies» в нижней части любой страницы Сайта.' },
      { number: '5.3.', text: 'При отказе обезличенный идентификатор собственной аналитики удаляется из браузера, а запущенный счетчик Яндекс Метрики останавливается.' },
      { number: '5.4.', text: 'Пользователь вправе очистить либо заблокировать cookies и localStorage средствами браузера. После очистки Сайт может повторно запросить выбор и утратить сохраненную корзину или сессию.' },
    ],
  },
]
---

<LegalPage href="/cookies" sections={sections} />
