---
import type { JobOpening } from '@chashka-coffee/contracts'
import PageShell from '../layouts/PageShell.astro'
import ContentBlocks from '../components/ContentBlocks.astro'
import EditorialHero from '../components/EditorialHero.astro'
import JobApplicationDialog from '../components/JobApplicationDialog.astro'
import { fallbackJobOpenings, normalizeJobOpening, type JobOpeningCard } from '../lib/job-openings'
import { getManagedPage, managedPageImage } from '../lib/public-api'

let jobs: JobOpeningCard[] = fallbackJobOpenings
try {
  const response = await fetch(`${import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3000'}/api/jobs`)
  if (response.ok) {
    const data = await response.json() as { openings: JobOpening[] }
    if (data.openings.length) jobs = data.openings.map(normalizeJobOpening)
  }
} catch { /* Static editorial vacancies keep the page useful without the API. */ }

const page = await getManagedPage('JOBS')
const heroTitle = page?.heroTitle ?? 'Работа\nсо вкусом к людям'
const heroDescription = page?.heroDescription ?? 'Ищем внимательных людей, которым важны гости, команда и хорошо сделанная работа.'
const heroImage = page?.heroImageUrl ?? '/images/home-hero-v1.png'
const teamImage = managedPageImage(page, 'team', { imageUrl: '/images/stock/jobs-team.jpg', imageAlt: 'Команда бариста за стойкой' })
const values = [
  ['01', 'Можно прийти без опыта', 'Научим продукту, сервису и спокойной работе в ритме ресторана.'],
  ['02', 'Есть куда расти', 'От первой смены до роли тренера, менеджера или управляющего.'],
  ['03', 'Команда рядом', 'Вопросы можно задавать прямо, а сложные смены не остаются личной проблемой.'],
]
const restaurantFilters = [...new Map(jobs.flatMap((job) => job.restaurant ? [[job.restaurant.id, job.restaurant] as const] : [])).values()]
---

<PageShell title="Вакансии" description="Вакансии в ресторанах, кондитерской и команде Чашки кофе." active="jobs" image={heroImage}>
  <EditorialHero
    title={heroTitle}
    image={heroImage}
    alt="Кофе и свежая выпечка в Чашке кофе"
    description={heroDescription}
    actionLabel="Смотреть вакансии"
    actionHref="#vacancies"
  />

  <section class="jobs-intro">
    <h2>Люди делают<br />хороший день.</h2>
    <div>
      <p>Учим с нуля, поддерживаем в начале и даём расти тем, кто хочет больше, чем просто должность.</p>
      <a class="text-link jobs-intro-link" href="#vacancies">К вакансиям <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v13m-5-5 5 5 5-5" /></svg></a>
    </div>
  </section>

  <section class="jobs-portrait">
    <figure><img src={teamImage.imageUrl} alt={teamImage.imageAlt} loading="lazy" /></figure>
    <div>
      <p>Хороший сервис не играют по сценарию. Он получается там, где людям удобно говорить, спрашивать и помогать друг другу.</p>
      <blockquote>Работаем<br />вместе.<br /><em>По-настоящему.</em></blockquote>
    </div>
  </section>

  <section class="jobs-values" aria-label="Что важно в работе">
    {values.map(([number, title, description]) => <article>
      <span>{number}</span>
      <div><h3>{title}</h3><p>{description}</p></div>
    </article>)}
  </section>

  {page && <div class="jobs-managed"><ContentBlocks blocks={page.blocks} /></div>}

  <section id="vacancies" class="vacancies" aria-labelledby="vacancies-title">
    <header>
      <h2 id="vacancies-title">Вакансии</h2>
      {restaurantFilters.length > 0 && <details class="job-location-picker" data-job-filter-picker>
        <summary aria-label="Выбрать заведение для вакансий"><span><b data-job-filter-label>Все вакансии</b><small>Выберите заведение</small></span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 8 4 4 4-4" /></svg></summary>
        <div class="job-location-picker-panel">
          <button class="is-active" type="button" data-job-filter="all" aria-pressed="true">Все вакансии <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10 3 3 6-6" /></svg></button>
          {restaurantFilters.map((restaurant) => <button type="button" data-job-filter={restaurant.id} aria-pressed="false">{restaurant.name}<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10 3 3 6-6" /></svg></button>)}
        </div>
      </details>}
    </header>
    <div class="job-list" data-job-list>
      {jobs.map((job) => <details class="job-opening" data-job-opening data-restaurant-id={job.restaurant?.id ?? 'other'}>
        <summary>
          <strong>{job.title}</strong>
          <span class="job-terms">{job.terms}</span>
          <i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m7 10 5 5 5-5" /></svg></i>
        </summary>
        <div class="job-details">
          <p>{job.description}</p>
          <button class="job-details-apply" type="button" data-job-opening-application-trigger data-job-title={job.title} data-job-restaurant={job.restaurant?.name ?? ''} data-job-address={job.restaurant?.address ?? job.place}>Откликнуться <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6" /></svg></span></button>
        </div>
      </details>)}
      <p class="job-list-empty" data-job-list-empty hidden>В этой точке пока нет открытых вакансий.</p>
    </div>
  </section>

  <JobApplicationDialog />

  <section class="jobs-open-call">
    <p>Не нашли подходящую роль? Это не повод не знакомиться.</p>
    <h2>Хорошие люди<br />нужны всегда.</h2>
    <button class="jobs-open-call-button" type="button" data-job-general-contact-trigger>Рассказать о себе <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6" /></svg></span></button>
  </section>
</PageShell>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-job-filter]')
  const openings = document.querySelectorAll<HTMLDetailsElement>('[data-job-opening]')
  const emptyMessage = document.querySelector<HTMLElement>('[data-job-list-empty]')
  const filterPicker = document.querySelector<HTMLDetailsElement>('[data-job-filter-picker]')
  const filterLabel = document.querySelector<HTMLElement>('[data-job-filter-label]')
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

  const toggleOpening = (opening: HTMLDetailsElement) => {
    const summary = opening.querySelector<HTMLElement>('summary')
    if (!summary || opening.dataset.animating === 'true') return
    if (reducedMotion.matches) { opening.open = !opening.open; return }

    opening.dataset.animating = 'true'
    const startHeight = `${opening.offsetHeight}px`
    const finish = () => {
      opening.style.height = ''
      delete opening.dataset.animating
    }

    if (opening.open) {
      const animation = opening.animate([{ height: startHeight }, { height: `${summary.offsetHeight}px` }], { duration: 240, easing: 'cubic-bezier(.22,1,.36,1)' })
      animation.onfinish = () => { opening.open = false; finish() }
      animation.oncancel = finish
      return
    }

    opening.open = true
    const endHeight = `${opening.offsetHeight}px`
    opening.style.height = startHeight
    requestAnimationFrame(() => {
      const animation = opening.animate([{ height: startHeight }, { height: endHeight }], { duration: 300, easing: 'cubic-bezier(.22,1,.36,1)' })
      animation.onfinish = finish
      animation.oncancel = finish
    })
  }

  openings.forEach((opening) => opening.querySelector('summary')?.addEventListener('click', (event) => {
    event.preventDefault()
    toggleOpening(opening)
  }))

  filters.forEach((filter) => filter.addEventListener('click', () => {
    const restaurantId = filter.dataset.jobFilter
    let visibleCount = 0
    filters.forEach((item) => {
      const active = item === filter
      item.classList.toggle('is-active', active)
      item.setAttribute('aria-pressed', String(active))
    })
    if (filterLabel) filterLabel.textContent = filter.textContent?.trim() || 'Все вакансии'
    if (filterPicker) filterPicker.open = false
    openings.forEach((opening) => {
      const visible = restaurantId === 'all' || opening.dataset.restaurantId === restaurantId
      opening.hidden = !visible
      if (!visible) opening.open = false
      if (visible) visibleCount += 1
    })
    if (emptyMessage) emptyMessage.hidden = visibleCount > 0
  }))
</script>

