---
import type { JobOpening } from '@chashka-coffee/contracts'
import PageShell from '../layouts/PageShell.astro'
import ContentBlocks from '../components/ContentBlocks.astro'
import EditorialHero from '../components/EditorialHero.astro'
import JobDialog from '../components/JobDialog.astro'
import JobApplicationDialog from '../components/JobApplicationDialog.astro'
import { fallbackJobOpenings, normalizeJobOpening, type JobOpeningCard } from '../lib/job-openings'
import { getManagedPage } from '../lib/public-api'

let jobs: JobOpeningCard[] = fallbackJobOpenings
try {
  const response = await fetch(`${import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3000'}/api/jobs`)
  if (response.ok) {
    const data = await response.json() as { openings: JobOpening[] }
    if (data.openings.length) jobs = data.openings.map(normalizeJobOpening)
  }
} catch { /* Static editorial vacancies keep the page useful without the API. */ }

const page = await getManagedPage('JOBS')
const heroTitle = page?.heroTitle ?? 'Работа\nсо вкусом к людям'
const heroDescription = page?.heroDescription ?? 'Ищем внимательных людей, которым важны гости, команда и хорошо сделанная работа.'
const heroImage = page?.heroImageUrl ?? '/images/home-hero-v1.png'
const values = [
  ['01', 'Можно прийти без опыта', 'Научим продукту, сервису и спокойной работе в ритме ресторана.'],
  ['02', 'Есть куда расти', 'От первой смены до роли тренера, менеджера или управляющего.'],
  ['03', 'Команда рядом', 'Вопросы можно задавать прямо, а сложные смены не остаются личной проблемой.'],
]
---

<PageShell title="Вакансии" description="Вакансии в ресторанах, кондитерской и команде Чашки кофе." active="jobs" image={heroImage}>
  <EditorialHero
    title={heroTitle}
    image={heroImage}
    alt="Кофе и свежая выпечка в Чашке кофе"
    description={heroDescription}
    actionLabel="Смотреть вакансии"
    actionHref="#vacancies"
  />

  <section class="jobs-intro">
    <h2>Люди делают<br />хороший день.</h2>
    <div>
      <p>Учим с нуля, поддерживаем в начале и даём расти тем, кто хочет больше, чем просто должность.</p>
      <a href="#vacancies">К открытым позициям <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v13m-5-5 5 5 5-5" /></svg></a>
    </div>
  </section>

  <section class="jobs-portrait">
    <figure><img src="/images/stock/jobs-team.jpg" alt="Команда бариста за стойкой" loading="lazy" /></figure>
    <div>
      <p>Хороший сервис не играют по сценарию. Он получается там, где людям удобно говорить, спрашивать и помогать друг другу.</p>
      <blockquote>Работаем<br />вместе.<br /><em>По-настоящему.</em></blockquote>
    </div>
  </section>

  <section class="jobs-values" aria-label="Что важно в работе">
    {values.map(([number, title, description]) => <article>
      <span>{number}</span>
      <div><h3>{title}</h3><p>{description}</p></div>
    </article>)}
  </section>

  <section class="jobs-principles">
    <div class="principles-quote"><span aria-hidden="true">«</span><h2>Спокойная смена начинается с уважения друг к другу.</h2><p>Команда Чашки кофе</p></div>
    <div class="principles-list">
      <article><span>01</span><div><h3>Говорим прямо</h3><p>Без лишней иерархии и сложных маршрутов для простых вопросов.</p></div></article>
      <article><span>02</span><div><h3>Замечаем гостя</h3><p>Качество живёт в деталях — от первого приветствия до последней крошки.</p></div></article>
      <article><span>03</span><div><h3>Помогаем расти</h3><p>Бариста может стать тренером, менеджер — управляющим, если ему это интересно.</p></div></article>
    </div>
  </section>

  {page && <div class="jobs-managed"><ContentBlocks blocks={page.blocks} /></div>}

  <section id="vacancies" class="vacancies">
    <header><h2>Открытые<br />позиции</h2><p>Нажмите на вакансию — внутри условия, задачи и быстрый переход к отклику.</p></header>
    <div class="job-list">
      {jobs.map((job) => <button type="button" data-job-trigger data-job={JSON.stringify(job)} aria-haspopup="dialog">
        <span class="job-place">{job.place}</span>
        <strong>{job.title}</strong>
        <span class="job-terms">{job.terms}</span>
        <i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h13m-5-5 5 5-5 5" /></svg></i>
      </button>)}
    </div>
  </section>

  <JobDialog />
  <JobApplicationDialog />

  <section class="jobs-open-call">
    <p>Не нашли подходящую роль? Это не повод не знакомиться.</p>
    <h2>Хорошие люди<br />нужны всегда.</h2>
    <button type="button" data-job-application-trigger>Рассказать о себе <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6" /></svg></span></button>
  </section>
</PageShell>

<style>
  .jobs-intro{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,.85fr);align-items:end;gap:clamp(45px,8vw,130px);padding:clamp(105px,12vw,185px) var(--content-gutter)}.jobs-intro h2{margin:0;font-size:clamp(51px,6vw,96px)}.jobs-intro>div{margin-bottom:8px}.jobs-intro p{max-width:470px;margin:0;color:var(--muted);font-size:15px;line-height:1.7}.jobs-intro a{display:inline-flex;align-items:center;gap:16px;margin-top:30px;padding-bottom:5px;border-bottom:1px solid var(--ink);color:inherit;font-size:12px;font-weight:800;text-decoration:none}.jobs-intro a svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.8;transition:transform .2s ease}.jobs-intro a:hover svg{transform:translateY(3px)}
  .jobs-portrait{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(310px,.92fr);min-height:730px;overflow:hidden;border-radius:var(--radius);background:#222b24;color:#fff}.jobs-portrait figure{min-height:640px;margin:0;overflow:hidden}.jobs-portrait img{width:100%;height:100%;object-fit:cover;transition:transform .7s cubic-bezier(.22,1,.36,1)}.jobs-portrait:hover img{transform:scale(1.025)}.jobs-portrait>div{display:flex;padding:clamp(42px,6vw,92px);flex-direction:column}.jobs-portrait>div>p{max-width:420px;margin:0;color:#d6ddd7;font-size:13px;line-height:1.72}.jobs-portrait blockquote{max-width:570px;margin:auto 0 0;font-size:clamp(49px,5.5vw,88px);font-weight:800;line-height:.84;letter-spacing:-.08em}.jobs-portrait blockquote em{font-family:'21Cent',serif;color:var(--lime);font-weight:400}
  .jobs-values{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;padding:14px 0}.jobs-values article{display:flex;min-height:330px;padding:clamp(25px,3vw,42px);border-radius:var(--radius);background:#e9e3da;flex-direction:column;transition:background-color .25s ease,transform .3s cubic-bezier(.22,1,.36,1)}.jobs-values article:nth-child(2){background:#dfe9d3}.jobs-values article:nth-child(3){background:#efdba9}.jobs-values article:hover{background:#fff;transform:translateY(-6px)}.jobs-values article>span{font-size:11px;font-weight:800}.jobs-values article>div{margin-top:auto}.jobs-values h3{max-width:340px;margin:0;font-size:clamp(28px,2.8vw,43px);line-height:.92;letter-spacing:-.065em}.jobs-values p{max-width:350px;margin:18px 0 0;color:var(--muted);font-size:12px;line-height:1.65}
  .jobs-principles{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(0,.98fr);min-height:640px;overflow:hidden;border-radius:var(--radius);background:var(--moss);color:#fff}.principles-quote{display:flex;padding:clamp(45px,6.5vw,100px);background:#dfe9d3;color:var(--moss);flex-direction:column}.principles-quote>span{font-family:'21Cent',serif;font-size:92px;line-height:.5}.principles-quote h2{max-width:680px;margin:auto 0 0;font-size:clamp(39px,4.6vw,72px)}.principles-quote p{margin:28px 0 0;font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.principles-list{display:grid;align-content:center;padding:clamp(35px,5vw,78px)}.principles-list article{display:grid;grid-template-columns:42px 1fr;gap:20px;padding:31px 0;border-bottom:1px solid rgba(255,255,255,.18);transition:padding-left .25s ease,color .25s ease}.principles-list article:first-child{border-top:1px solid rgba(255,255,255,.18)}.principles-list article:hover{padding-left:10px;color:var(--lime)}.principles-list article>span{color:var(--lime);font-size:10px;font-weight:800}.principles-list h3{margin:0;font-size:clamp(22px,2.2vw,31px);letter-spacing:-.05em}.principles-list p{max-width:440px;margin:10px 0 0;color:#d3ddd4;font-size:12px;line-height:1.65}.jobs-managed{margin-top:14px}
  .vacancies{padding:clamp(105px,12vw,180px) var(--content-gutter)}.vacancies header{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,.55fr);align-items:end;gap:50px;margin-bottom:55px}.vacancies header h2{margin:0;font-size:clamp(51px,5.7vw,91px)}.vacancies header p{max-width:400px;margin:0 0 8px;color:var(--muted);font-size:13px;line-height:1.65}.job-list{display:grid;gap:9px}.job-list button{display:grid;width:100%;min-height:132px;grid-template-columns:minmax(190px,.7fr) minmax(220px,1.2fr) minmax(150px,.55fr) 58px;align-items:center;gap:25px;padding:22px 24px;border:0;border-radius:var(--radius);background:#e9e3da;color:var(--ink);cursor:pointer;text-align:left;transition:background .25s ease,transform .3s cubic-bezier(.22,1,.36,1),box-shadow .25s ease}.job-list button:nth-child(2n){background:#dfe9d3}.job-list button:nth-child(3n){background:#efdba9}.job-list button:hover{z-index:1;background:#fff;box-shadow:0 17px 34px rgba(48,40,33,.1);transform:translateX(8px)}.job-list button:focus-visible{outline:3px solid var(--lime);outline-offset:4px}.job-list .job-place{color:var(--muted);font-size:9px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.job-list strong{font-size:clamp(24px,2.8vw,42px);line-height:.95;letter-spacing:-.06em}.job-terms{font-size:12px;font-weight:700}.job-list i{display:grid;place-items:center;width:54px;height:54px;border-radius:50%;background:var(--moss);color:#fff;transition:background .2s ease,transform .25s ease}.job-list button:hover i{background:#315b45;transform:translateX(3px)}.job-list svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.8}
  .jobs-open-call{position:relative;min-height:520px;padding:clamp(55px,7vw,108px);overflow:hidden;border-radius:var(--radius);background:var(--lime);color:var(--moss)}.jobs-open-call:after{position:absolute;right:-6%;bottom:-45%;width:43%;aspect-ratio:1;border:1px solid rgba(31,59,46,.28);border-radius:50%;box-shadow:0 0 0 55px rgba(31,59,46,.05),0 0 0 110px rgba(31,59,46,.04);content:''}.jobs-open-call>p{max-width:400px;margin:0;font-size:13px;font-weight:700;line-height:1.5}.jobs-open-call h2{position:relative;z-index:1;max-width:900px;margin:30px 0 0;font-size:clamp(52px,6.2vw,100px)}.jobs-open-call button{position:absolute;z-index:2;right:clamp(34px,6vw,92px);bottom:clamp(34px,6vw,92px);display:flex;min-width:220px;min-height:58px;align-items:center;justify-content:space-between;padding:0 10px 0 20px;border:0;border-radius:var(--radius);background:var(--moss);color:#fff;cursor:pointer;font-size:11px;font-weight:800}.jobs-open-call button span{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:#fff;color:var(--moss);transition:transform .2s ease}.jobs-open-call button svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.8}.jobs-open-call button:hover span{transform:translateX(3px)}.jobs-open-call button:focus-visible{outline:3px solid var(--moss);outline-offset:3px}
  @media(max-width:900px){.jobs-intro,.jobs-portrait,.jobs-principles,.vacancies header{grid-template-columns:1fr}.jobs-intro{padding:85px var(--mobile-gutter)}.jobs-portrait,.jobs-principles,.jobs-open-call{margin-right:var(--mobile-gutter);margin-left:var(--mobile-gutter)}.jobs-portrait figure{min-height:520px}.jobs-portrait>div{min-height:470px;padding:45px 25px}.jobs-values{grid-template-columns:1fr;margin:0 var(--mobile-gutter);gap:8px}.jobs-values article{min-height:260px;padding:25px}.principles-quote{min-height:450px}.vacancies{padding:85px var(--mobile-gutter)}.vacancies header{gap:20px}.job-list button{min-height:0;grid-template-columns:1fr 54px;gap:12px;padding:24px}.job-list .job-place,.job-list strong,.job-terms{grid-column:1}.job-list i{grid-row:1/4;grid-column:2}.job-list button:hover{transform:translateY(-3px)}.jobs-open-call{min-height:500px;padding:50px 25px}.jobs-open-call:after{width:75%}.jobs-open-call button{right:25px;bottom:25px;left:25px}}
  @media(max-width:540px){.jobs-portrait figure{min-height:430px}.jobs-portrait blockquote{font-size:53px}.jobs-portrait>div{min-height:420px}.principles-quote{min-height:400px;padding:42px 24px}.principles-list{padding:30px 24px}.principles-list article{grid-template-columns:31px 1fr}.job-list button{padding:21px}.job-list strong{font-size:28px}.jobs-open-call h2{font-size:52px}}
  @media(prefers-reduced-motion:reduce){.jobs-intro a svg,.jobs-portrait img,.jobs-values article,.principles-list article,.job-list button,.job-list i,.jobs-open-call button span{transition:none}}
</style>
