---
import PageShell from '../layouts/PageShell.astro'
import RestaurantMap from '../components/RestaurantMap.astro'
import type { RestaurantSummary } from '@chashka-coffee/contracts'

const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3000'
const yandexMapsApiKey = import.meta.env.PUBLIC_YANDEX_MAPS_API_KEY ?? ''
let restaurants: RestaurantSummary[] = []
let apiUnavailable = false
try { const response=await fetch(`${apiUrl}/api/restaurants`);if(!response.ok)throw new Error();restaurants=(await response.json()).restaurants } catch { apiUnavailable=true }
const fallbackImages=['/images/restaurants-hero.png','/images/home-hero-v1.png','/images/home-breakfast.png','/images/home-morning-v2.png']
---

<PageShell title="Рестораны" description="Рестораны Чашка кофе в Новосибирске и аэропорту Толмачёво." active="restaurants">
  <main class="restaurants-page">
    <header class="restaurants-heading"><h1>Рестораны</h1></header>
    <RestaurantMap restaurants={restaurants} apiKey={yandexMapsApiKey} />
    <section class="restaurants-catalog" aria-label="Список ресторанов">
      {apiUnavailable ? <div class="restaurants-error"><h3>Список пока недоступен</h3><p>Запустите локальный API командой <code>bun run dev:backend</code> и обновите страницу.</p></div> : <div class="restaurant-grid">{restaurants.map((restaurant,index)=><article class="restaurant-card">
        <a class="restaurant-card-image" href={`/restaurants/${restaurant.slug}`}><img src={restaurant.coverImageUrl ?? fallbackImages[index % fallbackImages.length]} alt="" loading="lazy" /></a>
        <div><h3>{restaurant.name.replace('Чашка кофе — ', '')}</h3><p>{restaurant.address}</p><span class="restaurant-hours">{restaurant.openingHoursLabel}</span><nav class:list={{ 'is-single': !restaurant.hasMenu }}><a href={`/restaurants/${restaurant.slug}`}>Подробнее</a>{restaurant.hasMenu && <a class="restaurant-menu-link" href={`/restaurants/${restaurant.slug}/menu`}>Меню</a>}</nav></div>
      </article>)}</div>}
    </section>
    <aside class="restaurants-promo"><div><p>Завтраки весь день</p><h2>Встречайтесь без повода</h2><span>Любимое меню, спокойная музыка и стол, который уже ждёт.</span></div><a href="/menu">Посмотреть меню</a></aside>
  </main>
</PageShell>

<style>
  .restaurants-page{padding:clamp(48px,6vw,92px) 0 0}.restaurants-heading{padding-bottom:44px}.restaurants-heading h1{margin:0;font-size:clamp(55px,7vw,112px);line-height:.84;letter-spacing:-.1em}.restaurants-promo>div>p{margin:0;color:#6f902b;font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.restaurants-catalog{padding:clamp(62px,8vw,118px) 0}.restaurant-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px;align-items:stretch}.restaurant-card{display:grid;grid-template-rows:auto 1fr;min-width:0;overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);background:#fffdf9}.restaurant-card-image{display:block;aspect-ratio:1.35;overflow:hidden;background:#ece8e0}.restaurant-card-image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .45s ease}.restaurant-card:hover img{transform:scale(1.045)}.restaurant-card>div{display:flex;min-width:0;flex-direction:column;padding:21px}.restaurant-card h3{margin:0;font-size:clamp(20px,1.7vw,27px);line-height:1;letter-spacing:-.06em;overflow-wrap:anywhere}.restaurant-card p{min-height:38px;margin:13px 0 8px;color:#5e5a54;font-size:12px;line-height:1.5}.restaurant-card .restaurant-hours{display:block;color:#858078;font-size:10px;line-height:1.55}.restaurant-card nav{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:auto;padding-top:21px}.restaurant-card nav.is-single{grid-template-columns:1fr}.restaurant-card nav a{display:flex;min-height:46px;align-items:center;justify-content:center;border:1px solid var(--line);border-radius:var(--radius);font-size:11px;font-weight:800;text-decoration:none;transition:background .2s,color .2s,border-color .2s}.restaurant-card nav a:hover{border-color:#bddb3d;background:#bddb3d;color:#1f3b2e}.restaurant-card nav .restaurant-menu-link{border-color:var(--moss);background:var(--moss);color:#fff}.restaurants-error{padding:42px;border-radius:var(--radius);background:#f3eee7}.restaurants-error h3{margin:0;font-size:30px}.restaurants-error p{color:var(--muted)}.restaurants-promo{display:flex;min-height:330px;align-items:end;justify-content:space-between;gap:38px;margin-bottom:14px;padding:clamp(38px,6vw,92px);border-radius:var(--radius);background:#1f3b2e;color:#fff}.restaurants-promo h2{max-width:850px;margin:16px 0 12px;color:#fff;font-size:clamp(38px,5vw,78px);line-height:.88;letter-spacing:-.085em}.restaurants-promo span{color:#dce5d9;font-size:13px}.restaurants-promo>a{display:flex;min-height:52px;align-items:center;justify-content:center;padding:0 23px;border-radius:var(--radius);background:#bddb3d;color:#1f3b2e;font-size:11px;font-weight:800;text-decoration:none;white-space:nowrap;transition:transform .2s}.restaurants-promo>a:hover{transform:translateY(-3px)}
  @media(max-width:900px){.restaurants-page{padding:40px 20px 0}.restaurant-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.restaurants-promo{align-items:flex-start;flex-direction:column}}
  @media(max-width:620px){.restaurant-grid{grid-template-columns:1fr}.restaurants-catalog{padding-block:82px}.restaurants-promo{min-height:390px;padding:34px 25px}.restaurants-promo>a{width:100%}}
  @media(prefers-reduced-motion:reduce){.restaurant-card-image img,.restaurant-card nav a,.restaurants-promo>a{transition:none}}
</style>
