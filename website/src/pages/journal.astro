---
import PageShell from '../layouts/PageShell.astro'
import JournalIndex from '../components/JournalIndex.astro'
import { getContent } from '../lib/public-api'
import { JOURNAL_PAGE_SIZE } from '../lib/journal'

const entries = await getContent('ARTICLE')
const totalPages = Math.ceil(entries.length / JOURNAL_PAGE_SIZE)
---

<PageShell title="Новости" active="journal">
  <JournalIndex entries={entries.slice(0, JOURNAL_PAGE_SIZE)} currentPage={1} totalPages={totalPages} />
</PageShell>
