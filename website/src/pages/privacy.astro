---
import LegalPage from '../components/LegalPage.astro'
import type { LegalSection } from '../lib/legal-documents'

const sections: LegalSection[] = [
  {
    heading: '1. Общие положения',
    clauses: [
      { number: '1.1.', text: 'Настоящая Политика определяет порядок обработки и защиты персональных данных, получаемых при использовании сайта «Чашка кофе», направлении обращений, оформлении заказов и использовании личного кабинета.' },
      { number: '1.2.', text: 'Оператором персональных данных, получаемых посредством форм Сайта, является ООО «Чашка кофе», ИНН 5407066477, ОГРН 1095407010555, адрес: 633104, Новосибирская область, г. Обь, пр-т Мозжерина, зд. 100А (далее — Оператор).' },
      { number: '1.3.', text: 'Адрес электронной почты Оператора для обращений по вопросам обработки персональных данных: support@chashkacoffee.ru.' },
      { number: '1.4.', text: 'Политика разработана в соответствии с Конституцией Российской Федерации, Федеральным законом от 27.07.2006 № 152-ФЗ «О персональных данных» и иными применимыми нормативными правовыми актами.' },
      { number: '1.5.', text: 'Действие Политики распространяется на обработку персональных данных с использованием средств автоматизации и без использования таких средств.' },
      { number: '1.6.', text: 'Оператор не осуществляет целенаправленную обработку специальных категорий персональных данных и биометрических персональных данных посредством Сайта.' },
    ],
  },
  {
    heading: '2. Термины и определения',
    clauses: [
      { number: '2.1.', text: 'Персональные данные — любая информация, относящаяся прямо или косвенно к определенному или определяемому физическому лицу.' },
      { number: '2.2.', text: 'Обработка персональных данных — любое действие или совокупность действий с персональными данными, совершаемых с использованием средств автоматизации или без их использования.' },
      { number: '2.3.', text: 'Пользователь — физическое лицо, использующее Сайт, направляющее обращение, оформляющее заказ или использующее личный кабинет.' },
      { number: '2.4.', text: 'Cookies — файлы и иные значения, сохраняемые браузером или аналогичной технологией для обеспечения работы Сайта и, при наличии согласия, для аналитики.' },
    ],
  },
  {
    heading: '3. Цели, категории данных, основания и сроки обработки',
    clauses: [
      { number: '3.1.', text: 'Оператор обрабатывает только те персональные данные, которые необходимы для конкретной цели обработки.' },
      { number: '3.2.', text: 'Состав обрабатываемых данных, правовые основания и сроки обработки определяются следующей таблицей.' },
    ],
    tables: [
      {
        headers: ['Цель обработки', 'Персональные данные', 'Правовое основание', 'Срок обработки'],
        rows: [
          ['Прием и обработка обращений, бронирований, заявок на банкеты, франшизу, вакансии, торты и мероприятия', 'Имя, телефон, e-mail, текст обращения, выбранная услуга, ресторан, вакансия, событие, количество гостей и технический источник формы', 'Согласие субъекта персональных данных', 'До достижения цели или отзыва согласия; сведения, необходимые для подтверждения обработки и защиты прав, — до 3 лет после завершения обращения, если закон или спор не требуют иного'],
          ['Оформление, оплата, исполнение, отмена и сопровождение заказа кофе', 'Имя, телефон, e-mail, состав и сумма заказа, точка самовывоза, комментарий, идентификаторы и статус заказа и оплаты', 'Заключение и исполнение договора; исполнение обязанностей, установленных законом', 'В течение исполнения договора и далее в сроки обязательного бухгалтерского, налогового и потребительского учета'],
