---
import LegalPage from '../components/LegalPage.astro'
import type { LegalSection } from '../lib/legal-documents'

const sections: LegalSection[] = [
  { id: 'operator', heading: 'Оператор и область действия', paragraphs: ['Оператор данных, полученных через формы сайта, — ООО «Чашка кофе», ИНН 5407066477, ОГРН 1095407010555, адрес: 633104, Новосибирская область, г. Обь, пр-т Мозжерина, зд. 100А. Контакт по вопросам данных: support@chashkacoffee.ru.', 'Политика относится к сайту «Чашка кофе». При оформлении покупки или использовании внешнего сервиса самостоятельным оператором отдельных данных может быть продавец либо владелец такого сервиса.'] },
  { id: 'data', heading: 'Какие данные обрабатываются', paragraphs: ['Состав зависит от действия пользователя. Мы не просим специальные категории данных или биометрию.'], bullets: ['Имя, телефон, e-mail, текст сообщения, выбранная услуга или вакансия, событие и количество гостей.', 'Для заказа: состав корзины, точка самовывоза, комментарий, сумма, статус и идентификаторы заказа и оплаты. Реквизиты банковской карты обрабатывает ЮKassa и сайт их не получает.', 'Для личного кабинета: номер телефона, данные профиля, бонусной карты и заказов, получаемые через подключённые системы.', 'Технические данные: путь страницы, обезличенный UUID, тип устройства и сокращённый referrer — только после согласия на аналитику; необходимые значения корзины, сессии и выбора cookies — для работы сайта.'] },
  { id: 'purposes', heading: 'Цели и правовые основания', paragraphs: ['Данные используются только для заранее определённых целей. Основанием служат согласие, заключение и исполнение договора, исполнение требований закона либо законный интерес в безопасной работе сайта — в зависимости от ситуации.'], bullets: ['Ответ на обращение, бронирование, банкет, франшиза, вакансия, торт или регистрация на событие.', 'Оформление, оплата, выдача, отмена и поддержка заказа.', 'Вход по сервисному SMS, показ профиля и бонусной карты.', 'Обеспечение безопасности, работоспособности, предотвращение злоупотреблений и ведение обязательного учёта.', 'Аналитика и улучшение сайта — только после отдельного выбора в cookie-баннере.', 'Рекламные сообщения — только при отдельном добровольном согласии.'] },
  { id: 'actions', heading: 'Действия с данными и способы обработки', paragraphs: ['Обработка может включать сбор, запись, систематизацию, хранение, уточнение, использование, передачу исполнителю услуги, обезличивание, блокирование и удаление. Используются автоматизированные средства и, когда это необходимо для обработки обращения, работа уполномоченных сотрудников.'] },
  { id: 'recipients', heading: 'Кому данные могут передаваться', paragraphs: ['ООО «Чашка кофе» сначала принимает данные формы, а затем передаёт их организации, которая должна исполнить обращение. Получатели используют данные только в необходимом объёме.'], bullets: ['ООО «Таймс 2» — для заказов зерна, дрипов и капсул; ООО «Дельфин кейтеринг» — для заказов кондитерской.', 'ЮKassa — для проведения оплаты; PremiumBonus — для личного кабинета и программы лояльности; «Рестомания» — для технической работы приложения.', 'Поставщики российского хостинга, связи, карт и технической поддержки — как обработчики по поручению или самостоятельные операторы в пределах своих сервисов.', 'Государственные органы — только в случаях, предусмотренных законом.'], note: 'Мы не продаём персональные данные и не передаём их другим компаниям для их собственной рекламы.' },
  { id: 'storage', heading: 'Сроки и место хранения', paragraphs: ['Данные хранятся в базах данных на территории России не дольше, чем этого требуют цель обработки и закон. После достижения цели они удаляются или обезличиваются, если обязательный срок хранения не требует иного.'], bullets: ['Обращение и зафиксированное согласие — на время работы с обращением и до 3 лет после её окончания для защиты прав сторон, если спор или закон не требуют дольше.', 'Документы о заказах и расчётах — в сроки обязательного бухгалтерского, налогового и потребительского учёта.', 'Собственная обезличенная веб-аналитика — до 12 месяцев.', 'Данные аккаунта — пока аккаунт используется либо до получения обоснованного требования об удалении, с учётом обязательных сроков хранения.'], note: 'Условия хранения данных в PremiumBonus, ЮKassa и Яндекс Метрике дополнительно определяются документами соответствующего сервиса.' },
  { id: 'security', heading: 'Защита данных', paragraphs: ['Доступ имеют только назначенные сотрудники и подрядчики, которым он нужен для работы. Применяются разграничение доступа, защищённая передача, резервирование, журналирование и иные организационные и технические меры, соответствующие характеру данных и рискам.'] },
  { id: 'rights', heading: 'Права пользователя', paragraphs: ['Можно запросить сведения об обработке, доступ и копию данных, их исправление, блокирование или удаление, отозвать согласие и возразить против обработки в предусмотренных законом случаях. Отзыв не делает незаконной обработку, выполненную до его получения, и не отменяет обязанности хранить сведения по закону.'], links: [{ label: 'Как направить запрос', href: '/data-request' }, { label: 'Отозвать рекламу', href: '/advertising-consent' }] },
  { id: 'updates', heading: 'Изменения политики', paragraphs: ['Актуальная редакция постоянно доступна по адресу /privacy. При существенном изменении целей или состава обработки мы запросим новое согласие там, где оно требуется законом.'] },
]
---

<LegalPage href="/privacy" intro="Какие данные получает сайт, зачем они нужны, кому передаются и когда удаляются." sections={sections} related={['/consent', '/cookies', '/data-request']} />
