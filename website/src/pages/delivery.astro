---
import PageShell from '../layouts/PageShell.astro'
import ContentBlocks from '../components/ContentBlocks.astro'
import { getManagedPage } from '../lib/public-api'

const page = await getManagedPage('DELIVERY')
const steps = [
  {
    number: '01',
    title: 'Выберите свою Чашку',
    text: 'Покажем ближайший ресторан, актуальное меню и время доставки.',
  },
  {
    number: '02',
    title: 'Соберите любимое',
    text: 'Завтраки, горячие блюда, десерты и кофе — всё в одном заказе.',
  },
  {
    number: '03',
    title: 'Встречайте у двери',
    text: 'Начнём готовить после оформления и бережно привезём к вашему времени.',
  },
]

const cargo = [
  {
    title: 'Завтраки',
    note: 'для медленного утра',
    image: '/images/appetit.svg',
    tone: 'cream',
  },
  {
    title: 'Горячее',
    note: 'к обеду и на вечер',
    image: '/images/hot-dish.svg',
    tone: 'green',
  },
  {
    title: 'Десерты',
    note: 'даже без повода',
    image: '/images/desserts.svg',
    tone: 'rose',
  },
]
---

<PageShell
  title="Доставка"
  description="Доставка и самовывоз из ресторанов «Чашка кофе»: любимые блюда и кофе в приложении или Яндекс Еде."
  active="delivery"
  image="/images/home-breakfast.png"
>
  <div class="delivery-page">
    <section class="delivery-hero" aria-labelledby="delivery-title">
      <figure class="delivery-hero-visual">
        <img src="/images/home-breakfast.png" alt="Кофе, круассан и ягоды на светлом столе" fetchpriority="high" />
      </figure>
      <div class="delivery-hero-copy">
        <h1 id="delivery-title"><span>Любимое</span><em>приедет.</em></h1>
        <p>Для медленного утра, обеда между встречами или вечера, когда хочется остаться дома.</p>
        <div class="delivery-actions">
          <a class="delivery-button delivery-button-dark" href="/app">Заказать в приложении</a>
          <a class="delivery-button delivery-button-accent" href="/menu">Посмотреть меню</a>
        </div>
      </div>
    </section>

    <section class="delivery-route" aria-labelledby="route-title">
      <header data-delivery-reveal>
        <h2 id="route-title">От кухни —<br /><em>к вашей двери.</em></h2>
        <p>Три понятных шага без звонков и долгого ожидания ответа.</p>
      </header>
      <ol class="delivery-route-track">
        {steps.map((step) => (
          <li data-delivery-reveal>
            <span>{step.number}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="delivery-cargo" aria-labelledby="cargo-title">
      <div class="delivery-cargo-copy" data-delivery-reveal>
        <h2 id="cargo-title">Везём весь<br /><em>ваш день.</em></h2>
        <p>Не только кофе: соберите полноценный заказ из меню ближайшего ресторана.</p>
        <a class="delivery-button delivery-button-accent" href="/menu">Выбрать блюда</a>
      </div>
      <div class="delivery-cargo-scene" aria-label="Блюда для доставки">
        {cargo.map((item, index) => (
          <article class={`delivery-cargo-item delivery-cargo-item-${item.tone}`} data-delivery-reveal style={`--cargo-index:${index}`}>
            <div>
              <img src={item.image} alt="" aria-hidden="true" />
            </div>
            <h3>{item.title}</h3>
            <p>{item.note}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="delivery-ordering" aria-labelledby="ordering-title">
      <header data-delivery-reveal>
        <h2 id="ordering-title">Заказывайте,<br /><em>как удобно.</em></h2>
        <p>В приложении «Чашки кофе», через привычный сервис или заранее на самовывоз.</p>
      </header>

      <div class="delivery-ordering-board" data-delivery-reveal>
        <article class="delivery-ordering-app">
          <div>
            <h3>Приложение<br />«Чашки кофе»</h3>
            <p>Выбирайте ресторан, следите за заказом и копите DI Bonus в одном месте.</p>
            <a class="delivery-button delivery-button-accent" href="/app">Открыть приложение</a>
          </div>
          <img src="/brand/bento/App.svg" alt="" aria-hidden="true" />
        </article>

        <article class="delivery-ordering-yandex">
          <img class="delivery-yandex-icon" src="/brand-badges/yandex-food.svg" alt="" aria-hidden="true" />
          <div>
            <h3>Яндекс Еда</h3>
            <p>Найдите ближайшую «Чашку кофе» и оформите заказ знакомым способом.</p>
            <a class="delivery-button delivery-button-dark" href="https://eda.yandex.ru/" target="_blank" rel="noreferrer">Перейти в сервис</a>
          </div>
        </article>

        <article class="delivery-ordering-pickup">
          <div>
            <h3>Самовывоз<br />без ожидания</h3>
            <p>Закажите заранее — приготовим к вашему приходу.</p>
          </div>
          <a class="delivery-button delivery-button-dark" href="/restaurants">Выбрать ресторан</a>
        </article>
      </div>
    </section>

    {page && <ContentBlocks blocks={page.blocks} />}

    <section class="delivery-receipt-section" aria-labelledby="receipt-title">
      <div class="delivery-receipt-copy" data-delivery-reveal>
        <h2 id="receipt-title">Заказ начинается<br /><em>с меню.</em></h2>
        <p>Сырники, паста, десерт или просто тот самый кофе — решать вам.</p>
      </div>
      <div class="delivery-receipt" data-delivery-reveal aria-label="Пример заказа">
        <div class="delivery-receipt-brand">
          <img src="/brand/logo.png" alt="" aria-hidden="true" />
          <strong>Чашка кофе</strong>
        </div>
        <div class="delivery-receipt-lines">
          <p><span>Блюда по настроению</span><b>01</b></p>
          <p><span>Любимый кофе</span><b>01</b></p>
          <p><span>Время для себя</span><b>∞</b></p>
        </div>
        <div class="delivery-receipt-total">
          <span>Итого</span>
          <strong>Хороший день</strong>
        </div>
        <a class="delivery-button delivery-button-accent" href="/menu">Смотреть меню</a>
      </div>
    </section>
  </div>
</PageShell>

<script>
  const reduceDeliveryMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const deliveryRevealItems = document.querySelectorAll<HTMLElement>('[data-delivery-reveal]')

  if (reduceDeliveryMotion || !('IntersectionObserver' in window)) {
    deliveryRevealItems.forEach((item) => item.classList.add('is-visible'))
  } else {
    const deliveryRevealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return
        entry.target.classList.add('is-visible')
        deliveryRevealObserver.unobserve(entry.target)
      })
    }, { threshold: 0.14 })

    deliveryRevealItems.forEach((item) => deliveryRevealObserver.observe(item))
  }
</script>

<style>
  @font-face {
    font-family: '21Cent';
    src: url('/brand/21Cent-Italic.ttf') format('truetype');
    font-style: italic;
    font-display: swap;
  }

  .delivery-page {
    --delivery-edge: clamp(24px, 5.6vw, 92px);
    overflow: clip;
  }

  .delivery-page :is(h1, h2, h3, p) {
    text-wrap: balance;
  }

  .delivery-button {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    padding: 0 23px;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition: transform .22s ease, background-color .22s ease, border-color .22s ease, color .22s ease, box-shadow .22s ease;
  }

  .delivery-button:hover {
    box-shadow: 0 9px 18px rgba(31, 59, 46, .14);
    transform: translateY(-2px);
  }

  .delivery-button-dark {
    background: var(--moss);
    color: #fff;
  }

  .delivery-button-dark:hover {
    background: #315b45;
  }

  .delivery-button-accent {
    background: var(--lime);
    color: var(--moss);
  }

  .delivery-button-accent:hover {
    background: #cae65f;
  }

  .delivery-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: min(720px, calc(100svh - 116px));
    align-items: flex-end;
    padding: clamp(48px, 6.2vw, 100px);
    overflow: hidden;
    border-radius: var(--radius);
    background: #e8e1d7;
  }

  .delivery-hero::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(245, 240, 232, .97) 0%, rgba(245, 240, 232, .83) 34%, rgba(245, 240, 232, .08) 65%),
      linear-gradient(0deg, rgba(236, 229, 218, .28), transparent 55%);
    content: '';
    pointer-events: none;
  }

  .delivery-hero-visual {
    position: absolute;
    z-index: 0;
    inset: 0;
    margin: 0;
    overflow: hidden;
    border-radius: inherit;
    animation: delivery-hero-image 1s cubic-bezier(.22, 1, .36, 1) both;
  }

  .delivery-hero-visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform .9s cubic-bezier(.22, 1, .36, 1);
  }

  .delivery-hero:hover .delivery-hero-visual img {
    transform: scale(1.025);
  }

  .delivery-hero-copy {
    position: relative;
    z-index: 2;
    width: min(58%, 720px);
  }

  .delivery-hero-copy > * {
    animation: delivery-hero-copy .72s cubic-bezier(.22, 1, .36, 1) both;
  }

  .delivery-hero h1 {
    margin: 0 0 28px;
    color: var(--ink);
    font-size: clamp(68px, 7.6vw, 122px);
    line-height: .71;
    letter-spacing: -.1em;
  }

  .delivery-hero h1 span,
  .delivery-hero h1 em {
    display: block;
  }

  .delivery-hero h1 em {
    margin-left: clamp(10px, 3.8vw, 60px);
    color: #708c2e;
    font-family: '21Cent', serif;
    font-size: 1.03em;
    font-weight: 400;
    letter-spacing: -.045em;
  }

  .delivery-hero-copy > p {
    max-width: 480px;
    margin: 0;
    color: #4e4943;
    font-size: 16px;
    line-height: 1.65;
    animation-delay: .1s;
  }

  .delivery-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 31px;
    animation-delay: .18s;
  }

  .delivery-route {
    padding: clamp(108px, 13vw, 190px) var(--delivery-edge);
  }

  .delivery-route > header {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, .8fr);
    gap: clamp(38px, 7vw, 115px);
    align-items: end;
    margin-bottom: clamp(64px, 8vw, 118px);
  }

  .delivery-route h2,
  .delivery-cargo h2,
  .delivery-ordering > header h2,
  .delivery-receipt-copy h2 {
    margin: 0;
    font-size: clamp(54px, 6vw, 96px);
    line-height: .78;
    letter-spacing: -.09em;
  }

  .delivery-route h2 em,
  .delivery-cargo h2 em,
  .delivery-ordering > header h2 em,
  .delivery-receipt-copy h2 em {
    color: #6f8e2d;
    font-family: '21Cent', serif;
    font-size: 1.03em;
    font-weight: 400;
    letter-spacing: -.045em;
  }

  .delivery-route > header > p,
  .delivery-ordering > header > p,
  .delivery-receipt-copy > p {
    max-width: 430px;
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .delivery-route-track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 5vw, 78px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .delivery-route-track::before {
    position: absolute;
    top: 30px;
    right: 0;
    left: 0;
    height: 1px;
    background: #bcc5ad;
    content: '';
  }

  .delivery-route-track li {
    position: relative;
    padding-top: 96px;
  }

  .delivery-route-track li > span {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    width: 61px;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid #9bad87;
    border-radius: 50%;
    background: var(--canvas);
    color: #5f7a29;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .08em;
    transition: background .25s ease, color .25s ease, transform .25s ease;
  }

  .delivery-route-track li:hover > span {
    background: var(--moss);
    color: #fff;
    transform: translateY(-4px);
  }

  .delivery-route-track h3 {
    margin: 0 0 15px;
    font-size: clamp(27px, 2.7vw, 43px);
    line-height: .93;
    letter-spacing: -.07em;
  }

  .delivery-route-track p {
    max-width: 360px;
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.68;
  }

  .delivery-cargo {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(280px, .62fr) minmax(0, 1.38fr);
    min-height: 680px;
    gap: clamp(30px, 5vw, 78px);
    align-items: center;
    padding: clamp(50px, 6vw, 96px);
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--moss);
    color: #fff;
  }

  .delivery-cargo::before {
    position: absolute;
    z-index: -1;
    top: 13%;
    right: -9%;
    width: 73%;
    aspect-ratio: 1.75;
    border: 1px dashed rgba(189, 214, 90, .38);
    border-radius: 50%;
    content: '';
    transform: rotate(-7deg);
  }

  .delivery-cargo-copy {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
  }

  .delivery-cargo h2 {
    color: #fff;
  }

  .delivery-cargo h2 em {
    color: var(--lime);
  }

  .delivery-cargo-copy > p {
    max-width: 380px;
    margin: 28px 0 0;
    color: #d7e1d8;
    font-size: 14px;
    line-height: 1.7;
  }

  .delivery-cargo-copy .delivery-button {
    margin-top: 31px;
  }

  .delivery-cargo-scene {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    align-items: end;
  }

  .delivery-cargo-item {
    position: relative;
    z-index: calc(3 - var(--cargo-index));
    text-align: center;
    transform: translateY(calc((1 - var(--cargo-index)) * 30px));
  }

  .delivery-cargo-item > div {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    transition: transform .5s cubic-bezier(.22, 1, .36, 1);
  }

  .delivery-cargo-item:hover > div {
    transform: translateY(-10px) rotate(3deg);
  }

  .delivery-cargo-item img {
    position: absolute;
    inset: 7%;
    width: 86%;
    height: 86%;
    object-fit: contain;
  }

  .delivery-cargo-item-cream > div {
    background: #f0dfc7;
  }

  .delivery-cargo-item-green > div {
    background: var(--lime);
  }

  .delivery-cargo-item-rose > div {
    background: #e8c6ae;
  }

  .delivery-cargo-item h3 {
    margin: 21px 0 5px;
    color: #fff;
    font-size: clamp(20px, 2vw, 31px);
    line-height: .95;
    letter-spacing: -.06em;
  }

  .delivery-cargo-item p {
    margin: 0;
    color: #cbd7cd;
    font-size: 11px;
  }

  .delivery-ordering {
    padding: clamp(110px, 13vw, 190px) 0;
  }

  .delivery-ordering > header {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, .8fr);
    gap: clamp(38px, 7vw, 115px);
    align-items: end;
    margin: 0 var(--delivery-edge) clamp(58px, 7vw, 105px);
  }

  .delivery-ordering-board {
    display: grid;
    grid-template-columns: minmax(0, 1.32fr) minmax(300px, .68fr);
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--moss);
  }

  .delivery-ordering-board article {
    position: relative;
    min-width: 0;
    overflow: hidden;
  }

  .delivery-ordering-board h3 {
    margin: 0;
    font-size: clamp(39px, 4.4vw, 70px);
    line-height: .8;
    letter-spacing: -.085em;
  }

  .delivery-ordering-board article p {
    max-width: 410px;
    margin: 25px 0 0;
    font-size: 14px;
    line-height: 1.7;
  }

  .delivery-ordering-app {
    display: flex;
    min-height: 610px;
    align-items: flex-end;
    padding: clamp(45px, 6vw, 94px);
    background: var(--moss);
    color: #fff;
  }

  .delivery-ordering-app::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(90deg, var(--moss) 0%, rgba(31, 59, 46, .98) 47%, rgba(31, 59, 46, 0) 76%);
    content: '';
    pointer-events: none;
  }

  .delivery-ordering-app > div {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    flex-direction: column;
  }

  .delivery-ordering-app p {
    color: #d7e1d8;
  }

  .delivery-ordering-app .delivery-button,
  .delivery-ordering-yandex .delivery-button {
    margin-top: 32px;
  }

  .delivery-ordering-app > img {
    position: absolute;
    z-index: 1;
    right: clamp(-120px, -7vw, -68px);
    bottom: -145px;
    width: clamp(300px, 30vw, 470px);
    filter: drop-shadow(24px 28px 0 rgba(8, 24, 16, .2));
    transform: rotate(7deg);
    transition: transform .55s cubic-bezier(.22, 1, .36, 1);
  }

  .delivery-ordering-app:hover > img {
    transform: rotate(3deg) translateY(-10px);
  }

  .delivery-ordering-yandex {
    display: flex;
    min-height: 610px;
    align-items: flex-end;
    padding: clamp(42px, 4.8vw, 74px);
    background: #ffe033;
    color: #111;
  }

  .delivery-ordering-yandex h3 {
    font-size: clamp(40px, 3.6vw, 57px);
  }

  .delivery-yandex-icon {
    position: absolute;
    top: clamp(32px, 4vw, 58px);
    right: clamp(32px, 4vw, 58px);
    width: 66px;
    height: 66px;
  }

  .delivery-ordering-pickup {
    grid-column: 1 / -1;
    display: flex;
    min-height: 240px;
    align-items: center;
    justify-content: space-between;
    gap: 42px;
    padding: clamp(38px, 5.5vw, 84px);
    border-top: 1px solid #c7cec0;
    background: #e4eadc;
    color: var(--ink);
  }

  .delivery-ordering-pickup h3 {
    font-size: clamp(34px, 3.8vw, 60px);
  }

  .delivery-ordering-pickup p {
    color: var(--muted);
  }

  .delivery-receipt-section {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(340px, .6fr);
    gap: clamp(46px, 8vw, 135px);
    align-items: center;
    min-height: 720px;
    margin-bottom: 14px;
    padding: clamp(50px, 7vw, 112px);
    border-radius: var(--radius);
    background: #1f3b2e;
    color: #fff;
  }

  .delivery-receipt-copy h2 {
    color: #fff;
  }

  .delivery-receipt-copy h2 em {
    color: var(--lime);
  }

  .delivery-receipt-copy > p {
    margin-top: 28px;
    color: #d7e1d8;
  }

  .delivery-receipt {
    position: relative;
    justify-self: center;
    width: min(100%, 420px);
    padding: 39px 34px 42px;
    background:
      radial-gradient(circle at 0 0, transparent 11px, #f8f3e9 12px) top left,
      radial-gradient(circle at 100% 0, transparent 11px, #f8f3e9 12px) top right,
      radial-gradient(circle at 0 100%, transparent 11px, #f8f3e9 12px) bottom left,
      radial-gradient(circle at 100% 100%, transparent 11px, #f8f3e9 12px) bottom right;
    background-repeat: no-repeat;
    background-size: 51% 51%;
    color: var(--ink);
    filter: drop-shadow(21px 24px 0 rgba(8, 24, 16, .22));
    transform: rotate(2deg);
    transition: transform .5s cubic-bezier(.22, 1, .36, 1);
  }

  .delivery-receipt-section:hover .delivery-receipt {
    transform: rotate(-1deg) translateY(-6px);
  }

  .delivery-receipt-brand {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 27px;
    border-bottom: 1px dashed #b8b0a5;
  }

  .delivery-receipt-brand img {
    width: 48px;
    height: 48px;
  }

  .delivery-receipt-brand strong {
    font-size: 21px;
    letter-spacing: -.05em;
  }

  .delivery-receipt-lines {
    padding: 24px 0;
    border-bottom: 1px dashed #b8b0a5;
  }

  .delivery-receipt-lines p,
  .delivery-receipt-total {
    display: flex;
