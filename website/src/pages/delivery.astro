---
import PageShell from '../layouts/PageShell.astro'
import ContentBlocks from '../components/ContentBlocks.astro'
import { getManagedPage } from '../lib/public-api'

const page = await getManagedPage('DELIVERY')
const steps = [
  ['01','Выберите ресторан','В приложении сразу видно актуальное меню ближайшей точки.'],
  ['02','Соберите заказ','Добавьте блюда, напитки и комментарий для кухни.'],
  ['03','Получите любимое','Закажите доставку или заберите всё самостоятельно.'],
]
---
<PageShell title="Доставка" description="Заказывайте доставку и самовывоз из «Чашки кофе»." active="delivery">
  <section class="delivery-opening">
    <div><p>Любимое — ближе</p><h1>Из ресторана<br/>к вашему столу</h1><span>Завтраки, горячие блюда, десерты и кофе — заказывайте так, как удобно именно сегодня.</span><a class="button" href="/app">Открыть приложение</a></div>
    <figure><img src="/images/home-hero-v1.png" alt="Кофе и свежая выпечка для доставки"/><figcaption>Доставка и самовывоз</figcaption></figure>
  </section>
  <section class="delivery-steps"><header><p>Три простых шага</p><h2>Вы выбираете.<br/>Мы готовим.</h2></header><ol>{steps.map(([number,title,text]) => <li><b>{number}</b><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></section>
  <section class="delivery-options">
    <article class="app-option"><div><p>В приложении</p><h2>Меню, баллы<br/>и заказ рядом</h2><span>Выбирайте ресторан, оформляйте самовывоз или доставку и следите за статусом заказа.</span></div><a class="button button-light" href="/app">Подробнее</a></article>
    <article class="yandex-option"><img src="/brand-badges/yandex-food.svg" alt="Яндекс Еда"/><div><p>Через сервис</p><h2>Яндекс Еда</h2><span>Знакомый сценарий заказа и доставка через сервис Яндекса.</span></div><a class="button button-outline" href="https://eda.yandex.ru/" target="_blank" rel="noreferrer">Перейти в сервис</a></article>
  </section>
  {page && <ContentBlocks blocks={page.blocks}/>} 
</PageShell>
<style>
  .delivery-opening{display:grid;grid-template-columns:.85fr 1.15fr;min-height:680px;overflow:hidden;border-radius:var(--radius);background:var(--moss);color:#fff}.delivery-opening>div{display:flex;justify-content:flex-end;align-items:flex-start;padding:clamp(48px,6vw,94px);flex-direction:column}.delivery-opening p,.delivery-steps header>p,.delivery-options article>div>p{margin:0;color:var(--lime);font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.delivery-opening h1{margin:18px 0;font-size:clamp(54px,5.5vw,90px);line-height:.88}.delivery-opening span{max-width:470px;color:#d7e0d8;font-size:15px;line-height:1.65}.delivery-opening .button{margin-top:28px;padding:0 22px;background:var(--lime);color:var(--moss)}.delivery-opening figure{position:relative;margin:0}.delivery-opening img{width:100%;height:100%;object-fit:cover}.delivery-opening figcaption{position:absolute;right:18px;bottom:18px;padding:10px 13px;border-radius:var(--radius);background:rgba(252,251,248,.9);color:var(--ink);font-size:9px;font-weight:700}.delivery-steps{display:grid;grid-template-columns:.7fr 1.3fr;gap:clamp(48px,8vw,130px);padding:clamp(90px,11vw,170px) var(--content-gutter)}.delivery-steps h2{margin:16px 0 0;font-size:clamp(44px,4.8vw,78px)}.delivery-steps ol{margin:0;padding:0;list-style:none;border-top:1px solid var(--line)}.delivery-steps li{display:grid;grid-template-columns:66px 1fr;gap:20px;padding:27px 0;border-bottom:1px solid var(--line)}.delivery-steps li>b{color:#73902d;font-size:11px}.delivery-steps h3{margin:0 0 8px;font-size:23px}.delivery-steps li p{max-width:590px;margin:0;color:var(--muted);font-size:13px;line-height:1.6}.delivery-options{display:grid;grid-template-columns:1fr 1fr;gap:12px}.delivery-options article{position:relative;display:flex;min-height:430px;align-items:flex-start;padding:clamp(35px,5vw,72px);border-radius:var(--radius);flex-direction:column}.delivery-options h2{margin:14px 0;font-size:clamp(42px,4.6vw,72px)}.delivery-options span{display:block;max-width:410px;font-size:13px;line-height:1.65}.delivery-options .button{margin-top:auto;padding:0 22px}.app-option{background:var(--moss);color:#fff}.app-option span{color:#d7e0d8}.yandex-option{overflow:hidden;background:#ffe033;color:#111}.yandex-option>img{position:absolute;top:clamp(28px,4vw,58px);right:clamp(28px,4vw,58px);width:60px;height:60px}.yandex-option>div>p{color:#111!important}.yandex-option .button-outline{border-color:#111;color:#111}@media(max-width:820px){.delivery-opening{grid-template-columns:1fr}.delivery-opening>div{min-height:560px;padding:48px 25px}.delivery-opening figure{height:360px}.delivery-steps{grid-template-columns:1fr;padding:82px 20px}.delivery-options{grid-template-columns:1fr}.delivery-options article{min-height:360px}.yandex-option>img{width:48px;height:48px}}
</style>
