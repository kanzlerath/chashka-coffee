---
import PageShell from '../../../layouts/PageShell.astro'
import DishDialog from '../../../components/DishDialog.astro'
import type { RestaurantMenuResponse, RestaurantSummary } from '@chashka-coffee/contracts'
import { getRestaurantSlugs } from '../../../lib/public-api'

export async function getStaticPaths() {
  return (await getRestaurantSlugs(['krasny-prospekt','ulitsa-lenina','akademgorodok','galereya-novosibirsk','rechnoy-vokzal','ploshchad-lenina','vertical-apart-hotel','central-park','zaeltsovsky-park','mikhaylovskaya-naberegnaya','tolmachevo-domestic','tolmachevo-international','tolmachevo-arrivals'])).map((slug) => ({ params: { slug } }))
}

const { slug } = Astro.params
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3000'
let data: RestaurantMenuResponse | null = null
let restaurants: RestaurantSummary[] = []
try {
  const [menuResponse, restaurantResponse] = await Promise.all([fetch(`${apiUrl}/api/restaurants/${slug}/menu`), fetch(`${apiUrl}/api/restaurants`)])
  if (menuResponse.ok) data = await menuResponse.json()
  if (restaurantResponse.ok) restaurants = (await restaurantResponse.json()).restaurants
} catch { /* The page keeps a useful error state while local API is offline. */ }

const money = (kopecks:number) => `${new Intl.NumberFormat('ru-RU').format(kopecks / 100)} ₽`
const badgeLabel = (badge:string|null) => ({NEW:'Новинка',HIT:'Хит',SEASONAL:'Сезонное',SPECIAL:'Специальное'}[badge ?? ''] ?? null)
const badgeTone = (badge:string|null) => ({NEW:'new',HIT:'hit',SEASONAL:'seasonal',SPECIAL:'special'}[badge ?? ''] ?? 'special')
const dietaryLabel = (mark:string) => ({VEGETARIAN:'Вегетарианское',SPICY:'Острое',LACTOSE_FREE:'Без лактозы',GLUTEN_FREE:'Без глютена',LIGHT:'Лёгкое'}[mark] ?? mark)
const allergenLabel = (allergen:string) => ({egg:'Яйцо',gluten:'Глютен',nuts:'Орехи',milk:'Молочный продукт',fish:'Рыба'}[allergen] ?? allergen)
const fallbackImages = ['/images/home-breakfast.png','/images/home-hero-v1.png','/images/home-morning-v2.png','/images/restaurants-hero.png']
const dishPayload = (item:RestaurantMenuResponse['categories'][number]['items'][number], categoryName:string, imageUrl:string) => JSON.stringify({
  name:item.name, categoryName, description:item.description ?? '', ingredients:item.ingredients ?? '', allergens:item.allergens.map(allergenLabel), dietaryMarks:item.dietaryMarks.map(dietaryLabel),
  weight:item.weightGrams ? `${item.weightGrams} г` : '1 порция', price:money(item.priceKopecks), calories:item.calories === null ? null : String(item.calories), proteins:item.proteins === null ? null : `${item.proteins} г`, fats:item.fats === null ? null : `${item.fats} г`, carbohydrates:item.carbohydrates === null ? null : `${item.carbohydrates} г`, imageUrl, badge:badgeLabel(item.marketingBadge), badgeTone:badgeTone(item.marketingBadge),
})
---

<PageShell title={data ? `Меню — ${data.restaurant.name}` : 'Меню'} active="menu">
  {data ? <main class="menu-page">
    <header class="menu-heading">
      <div><p>Меню ресторана</p><h1>{data.restaurant.name.replace('Чашка кофе — ', '')}</h1><span>{data.restaurant.address}</span></div>
      <details class="restaurant-picker"><summary>Выбрать ресторан</summary><div>{restaurants.map((restaurant) => <a class:list={{active:restaurant.slug === slug}} href={`/restaurants/${restaurant.slug}/menu`}><b>{restaurant.name.replace('Чашка кофе — ', '')}</b><span>{restaurant.address}</span></a>)}</div></details>
    </header>
    <div class="menu-layout">
      <aside><p>Категории</p><nav aria-label="Категории меню">{data.categories.map((category) => <a href={`#${category.slug}`}>{category.name}</a>)}</nav></aside>
      <div class="menu-categories">{data.categories.map((category) => <section id={category.slug} class="menu-category"><header><h2>{category.name}</h2><span>{category.items.length} позиций</span></header><div class="menu-items">{category.items.map((item, itemIndex) => {
        const imageUrl = item.imageUrl ?? fallbackImages[itemIndex % fallbackImages.length]
        const badge = badgeLabel(item.marketingBadge)
        return <button class="menu-item" type="button" data-dish-trigger data-dish={dishPayload(item,category.name,imageUrl)} aria-haspopup="dialog">
          <div class="menu-item-image"><img src={imageUrl} alt="" loading="lazy" />{badge && <span class={`menu-badge menu-badge--${badgeTone(item.marketingBadge)}`}>{badge}</span>}</div>
          <div class="menu-item-copy"><small>{category.name}</small><h3>{item.name}</h3><div><span>{item.weightGrams ? `${item.weightGrams} г` : '1 порция'}</span><strong>{money(item.priceKopecks)}</strong></div></div>
        </button>
      })}</div></section>)}</div>
    </div>
    <DishDialog />
  </main> : <section class="menu-unavailable"><p>Меню</p><h1>Не удалось загрузить данные.</h1><span>Запустите локальный API и обновите страницу.</span><a href="/restaurants">К ресторанам</a></section>}
</PageShell>

<style>
  .menu-page{padding:clamp(48px,6vw,92px) 0 clamp(90px,10vw,160px)}.menu-heading{display:flex;align-items:end;justify-content:space-between;gap:42px;padding-bottom:42px;border-bottom:1px solid var(--line)}.menu-heading p,.menu-layout aside>p,.menu-unavailable>p{margin:0;color:#6f902b;font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.menu-heading h1{margin:14px 0 12px;font-size:clamp(44px,5vw,82px);line-height:.88;letter-spacing:-.085em}.menu-heading>div>span{color:var(--muted);font-size:14px}.restaurant-picker{position:relative;z-index:8;width:min(420px,100%)}.restaurant-picker summary{display:flex;min-height:52px;align-items:center;justify-content:space-between;padding:0 20px;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper);cursor:pointer;font-size:12px;font-weight:800;list-style:none}.restaurant-picker summary:after{content:'⌄';font-size:17px}.restaurant-picker[open] summary:after{transform:rotate(180deg)}.restaurant-picker summary::-webkit-details-marker{display:none}.restaurant-picker>div{position:absolute;top:calc(100% + 8px);right:0;left:0;max-height:360px;padding:8px;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper);box-shadow:0 18px 40px rgba(35,30,27,.13);overflow:auto}.restaurant-picker a{display:grid;gap:4px;padding:13px;border-radius:calc(var(--radius) - 8px);text-decoration:none}.restaurant-picker a:hover,.restaurant-picker a.active{background:#e8eddc}.restaurant-picker b{font-size:12px}.restaurant-picker span{color:var(--muted);font-size:10px}.menu-layout{display:grid;grid-template-columns:220px minmax(0,1fr);gap:clamp(38px,6vw,94px);padding-top:60px}.menu-layout aside{position:sticky;top:118px;height:max-content}.menu-layout nav{display:grid;gap:5px;margin-top:20px}.menu-layout nav a{padding:8px 0;color:#57524c;font-size:12px;font-weight:600;text-decoration:none;transition:color .2s,transform .2s}.menu-layout nav a:hover{color:#6f902b;transform:translateX(4px)}.menu-categories{display:grid;gap:clamp(76px,9vw,132px)}.menu-category{scroll-margin-top:128px}.menu-category>header{display:flex;align-items:end;justify-content:space-between;gap:22px;margin-bottom:28px}.menu-category h2{margin:0;font-size:clamp(34px,4vw,62px);line-height:.91;letter-spacing:-.075em}.menu-category header span{color:var(--muted);font-size:11px}.menu-items{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.menu-item{width:100%;min-width:0;padding:11px;border:1px solid var(--line);border-radius:var(--radius);background:#f7f5f0;color:inherit;cursor:pointer;font:inherit;text-align:left;transition:transform .25s ease,box-shadow .25s ease,background .25s ease}.menu-item:hover{background:#fffdf9;box-shadow:0 16px 34px rgba(50,40,29,.1);transform:translateY(-4px)}.menu-item:focus-visible{outline:3px solid #bddb3d;outline-offset:4px}.menu-item-image{position:relative;aspect-ratio:1/.82;overflow:hidden;border-radius:var(--radius);background:#ebe7df}.menu-item-image img{width:100%;height:100%;object-fit:cover;transition:transform .45s ease}.menu-item:hover img{transform:scale(1.045)}.menu-badge{position:absolute;top:12px;left:12px;padding:8px 11px;border-radius:var(--radius);font-size:9px;font-weight:900;letter-spacing:.07em;text-transform:uppercase}.menu-badge--hit{background:#ef603f;color:#fff}.menu-badge--new{background:#bddb3d;color:#1f3b2e}.menu-badge--seasonal{background:#f2c86f;color:#503616}.menu-badge--special{background:#7278a9;color:#fff}.menu-item-copy{padding:17px 5px 4px}.menu-item-copy small{color:#1f3b2e;font-size:9px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.menu-item-copy h3{margin:9px 0 22px;font-size:clamp(19px,1.65vw,25px);line-height:1;letter-spacing:-.055em}.menu-item-copy>div{display:flex;align-items:end;justify-content:space-between;gap:18px}.menu-item-copy>div span{color:var(--muted);font-size:11px}.menu-item-copy strong{font-size:16px}.menu-unavailable{min-height:65svh;padding:clamp(90px,12vw,190px) 0}.menu-unavailable h1{max-width:900px;margin:18px 0;font-size:clamp(45px,6vw,90px);line-height:.9}.menu-unavailable>span{color:var(--muted)}.menu-unavailable a{display:flex;width:max-content;margin-top:30px;padding:15px 20px;border-radius:var(--radius);background:var(--moss);color:#fff;text-decoration:none;font-size:12px;font-weight:800}
  @media(max-width:850px){.menu-page{padding:38px 20px 90px}.menu-heading{align-items:stretch;flex-direction:column}.restaurant-picker{width:100%}.menu-layout{display:block;padding-top:40px}.menu-layout aside{position:static}.menu-layout nav{display:flex;margin:18px -20px 0;padding:0 20px;overflow:auto;white-space:nowrap}.menu-layout nav a{padding:10px 14px;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper)}.menu-categories{margin-top:65px;gap:85px}.menu-items{grid-template-columns:1fr}.menu-unavailable{padding-inline:20px}}
  @media(prefers-reduced-motion:reduce){.menu-item,.menu-item-image img,.menu-layout nav a{transition:none}}
</style>
