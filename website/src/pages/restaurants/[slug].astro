---
import PageShell from '../../layouts/PageShell.astro'
import RestaurantMap from '../../components/RestaurantMap.astro'
import type { RestaurantDetail, RestaurantOpeningHoursEntry } from '@chashka-coffee/contracts'
import { getRestaurantSlugs } from '../../lib/public-api'

type RestaurantFallback = {
  slug: string
  title: string
  address: string
  phone: string
  description: string
  image: string
  format?: RestaurantDetail['format']
  city?: string
  latitude: number
  longitude: number
}

const defaultHours: RestaurantOpeningHoursEntry[] = [
  { dayOfWeek: 0, opensAt: '08:00', closesAt: '22:00', isClosed: false },
  { dayOfWeek: 1, opensAt: '07:30', closesAt: '22:00', isClosed: false },
  { dayOfWeek: 2, opensAt: '07:30', closesAt: '22:00', isClosed: false },
  { dayOfWeek: 3, opensAt: '07:30', closesAt: '22:00', isClosed: false },
  { dayOfWeek: 4, opensAt: '07:30', closesAt: '22:00', isClosed: false },
  { dayOfWeek: 5, opensAt: '07:30', closesAt: '23:00', isClosed: false },
  { dayOfWeek: 6, opensAt: '08:00', closesAt: '23:00', isClosed: false },
]

const fallbacks: RestaurantFallback[] = [
  { slug: 'krasny-prospekt', title: 'Красный проспект', address: 'Красный проспект, 25', phone: '+7 (383) 123-20-20', description: 'Светлый городской ресторан на главной улице. Здесь удобно встретиться утром, поработать днём и задержаться после прогулки по центру.', image: '/images/restaurants-hero.png', latitude: 55.0302, longitude: 82.9204 },
  { slug: 'ulitsa-lenina', title: 'Улица Ленина', address: 'ул. Ленина, 12', phone: '+7 (383) 123-20-21', description: 'Место для завтрака перед делами и разговоров, которые не хочется торопить.', image: '/images/restaurants-hero.png', latitude: 55.0281, longitude: 82.9127 },
  { slug: 'akademgorodok', title: 'Академгородок', address: 'проспект Академика Коптюга, 4', phone: '+7 (383) 123-20-22', description: 'Кофе, выпечка и спокойный ритм между встречами и прогулками по Академгородку.', image: '/images/restaurants-hero.png', latitude: 54.8499, longitude: 83.1052 },
  { slug: 'galereya-novosibirsk', title: 'Галерея Новосибирск', address: 'ул. Гоголя, 13', phone: '+7 (383) 123-20-23', description: 'Удобная пауза во время прогулки по городу и шопинга.', image: '/images/restaurants-hero.png', latitude: 55.0412, longitude: 82.9208 },
  { slug: 'rechnoy-vokzal', title: 'Речной вокзал', address: 'ул. Большевистская, 12', phone: '+7 (383) 123-20-24', description: 'Ресторан на пути к набережной — для кофе с собой или неспешного завтрака.', image: '/images/home-hero-v1.png', latitude: 55.0066, longitude: 82.9383 },
  { slug: 'ploshchad-lenina', title: 'Площадь Ленина', address: 'Красный проспект, 29', phone: '+7 (383) 123-20-25', description: 'В самом центре города — для встреч перед театром и долгих разговоров за чашкой кофе.', image: '/images/restaurants-hero.png', latitude: 55.0298, longitude: 82.9196 },
  { slug: 'vertical-apart-hotel', title: 'Vertical', address: 'ул. Советская, 8', phone: '+7 (383) 123-20-26', description: 'Утренний кофе для гостей города и привычное место для тех, кто живёт рядом.', image: '/images/restaurants-hero.png', format: 'APART_HOTEL', latitude: 55.0234, longitude: 82.9151 },
  { slug: 'central-park', title: 'Центральный парк', address: 'ул. Мичурина, 8', phone: '+7 (383) 123-20-27', description: 'Кофе и десерты для прогулки по парку — берите с собой или оставайтесь на веранде.', image: '/images/home-hero-v1.png', format: 'PARK', latitude: 55.0418, longitude: 82.9277 },
  { slug: 'zaeltsovsky-park', title: 'Заельцовский парк', address: 'ул. Парковая, 88', phone: '+7 (383) 123-20-28', description: 'Точка притяжения среди сосен, тишины и длинных прогулок.', image: '/images/home-hero-v1.png', format: 'PARK', latitude: 55.0585, longitude: 82.8398 },
  { slug: 'mikhaylovskaya-naberegnaya', title: 'Михайловская набережная', address: 'ул. Большевистская, 12Б', phone: '+7 (383) 123-20-29', description: 'Кофе с видом на реку и прогулка без маршрута.', image: '/images/home-hero-v1.png', format: 'PARK', latitude: 55.0099, longitude: 82.9486 },
  { slug: 'tolmachevo-domestic', title: 'Толмачёво, вылеты по России', address: 'аэропорт Толмачёво, сектор A', phone: '+7 (383) 123-20-30', description: 'Время на хороший кофе есть даже перед вылетом.', image: '/images/restaurants-hero.png', format: 'AIRPORT', city: 'Обь', latitude: 55.0126, longitude: 82.6507 },
  { slug: 'tolmachevo-international', title: 'Толмачёво, международные вылеты', address: 'аэропорт Толмачёво, сектор B', phone: '+7 (383) 123-20-31', description: 'Пауза перед большим путешествием — с любимым вкусом рядом.', image: '/images/restaurants-hero.png', format: 'AIRPORT', city: 'Обь', latitude: 55.0122, longitude: 82.6502 },
  { slug: 'tolmachevo-arrivals', title: 'Толмачёво, зал прилёта', address: 'аэропорт Толмачёво, зал прилёта', phone: '+7 (383) 123-20-32', description: 'Встречайте близких и начинайте дорогу домой с чашки хорошего кофе.', image: '/images/home-hero-v1.png', format: 'AIRPORT', city: 'Обь', latitude: 55.0119, longitude: 82.6495 },
]

function fallbackDetail(entry: RestaurantFallback): RestaurantDetail {
  const format = entry.format ?? 'CITY'
  return {
    id: '018f8d94-1f4f-7000-8000-000000000001',
    slug: entry.slug,
    name: `Чашка кофе — ${entry.title}`,
    format,
    area: format === 'AIRPORT' ? 'AIRPORT' : format === 'PARK' ? 'PARK' : 'CITY',
    isAtApartHotel: format === 'APART_HOTEL',
    city: entry.city ?? 'Новосибирск',
    address: entry.address,
    phone: entry.phone,
    openingHoursLabel: 'Пн–Чт: 07:30–22:00 · Пт: 07:30–23:00 · Сб: 08:00–23:00 · Вс: 08:00–22:00',
    hasMenu: true,
    coverImageUrl: entry.image,
    description: entry.description,
    aboutTitle: 'О ресторане',
    aboutText: entry.description,
    visitAmenities: [],
    latitude: entry.latitude,
    longitude: entry.longitude,
    yandexMapsUrl: null,
    twoGisUrl: null,
    menuPdfUrl: null,
    galleryUrls: [],
    openingHours: defaultHours,
    scheduleExceptions: [],
  }
}

export async function getStaticPaths() {
  const slugs = await getRestaurantSlugs([
    'krasny-prospekt',
    'ulitsa-lenina',
    'akademgorodok',
    'galereya-novosibirsk',
    'rechnoy-vokzal',
    'ploshchad-lenina',
    'vertical-apart-hotel',
    'central-park',
    'zaeltsovsky-park',
    'mikhaylovskaya-naberegnaya',
    'tolmachevo-domestic',
    'tolmachevo-international',
    'tolmachevo-arrivals',
  ])
  return slugs.map((slug) => ({ params: { slug } }))
}

const slug = Astro.params.slug ?? fallbacks[0].slug
const fallback = fallbacks.find((entry) => entry.slug === slug) ?? { ...fallbacks[0], slug }
let restaurant = fallbackDetail(fallback)
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3000'

try {
  const response = await fetch(`${apiUrl}/api/restaurants/${slug}`)
  if (response.ok) restaurant = (await response.json() as { restaurant: RestaurantDetail }).restaurant
} catch { /* static editorial fallback remains available */ }

const title = restaurant.name.includes('—') ? restaurant.name.split('—').slice(1).join('—').trim() : restaurant.name
const description = restaurant.description ?? 'Подробности о ресторане скоро появятся на странице.'
const coverImage = restaurant.coverImageUrl ?? fallback.image
const mapQuery = encodeURIComponent(`${restaurant.address}, ${restaurant.city}`)
const yandexMapsUrl = restaurant.yandexMapsUrl ?? `https://yandex.ru/maps/?text=${mapQuery}`
const twoGisUrl = restaurant.twoGisUrl ?? `https://2gis.ru/novosibirsk/search/${mapQuery}`
const menuUrl = restaurant.hasMenu ? `/restaurants/${restaurant.slug}/menu` : '/menu'
const phoneHref = `tel:${restaurant.phone.replace(/[^\d+]/g, '')}`
const aboutTitle = restaurant.aboutTitle?.trim() || 'О ресторане'
const aboutText = restaurant.aboutText?.trim() || description
const visitAmenities = restaurant.visitAmenities
const gallery = [...new Set(restaurant.galleryUrls.length ? restaurant.galleryUrls : [coverImage])]
const dayLabels = ['Вс', 'Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб']
const scheduleByDay = new Map(restaurant.openingHours.map((entry) => [entry.dayOfWeek, entry]))
const scheduleRows = [1, 2, 3, 4, 5, 6, 0].map((dayOfWeek) => {
  const entry = scheduleByDay.get(dayOfWeek)
  const value = !entry ? 'Уточняйте' : entry.isClosed ? 'Выходной' : entry.opensAt && entry.closesAt ? `${entry.opensAt} – ${entry.closesAt}` : 'Уточняйте'
  return { day: dayLabels[dayOfWeek], value, isClosed: entry?.isClosed === true }
})
const yandexMapsApiKey = import.meta.env.PUBLIC_YANDEX_MAPS_API_KEY ?? ''
---

<PageShell title={title} description={description} active="restaurants" image={coverImage}>
  <div class="restaurant-detail">
    <section class="restaurant-hero">
      <div class="restaurant-hero-copy">
        <h1 class:list={{ 'is-long': title.length > 24 }}>{title}</h1>
        <p>{description}</p>
        <div class="restaurant-actions">
          <a class="detail-button detail-button-dark" href={menuUrl}>Смотреть меню</a>
          <a class="detail-button detail-button-accent" href={yandexMapsUrl} target="_blank" rel="noreferrer">Построить маршрут</a>
        </div>
      </div>
      <figure><img src={coverImage} alt={`Интерьер ресторана «${title}»`} /></figure>
    </section>

    <section class="restaurant-facts" aria-label="Информация о ресторане">
      <a class="fact-card fact-contact fact-address" href={yandexMapsUrl} target="_blank" rel="noreferrer" aria-label={`Открыть адрес ${restaurant.address} на карте`}>
        <strong>{restaurant.address}</strong>
        <img src="/images/location-pin.svg" alt="" aria-hidden="true" />
      </a>
      <article class="fact-card fact-schedule">
        <div>{scheduleRows.map(({ day, value, isClosed }) => <p class:list={{ 'is-closed': isClosed }}><span>{day}</span><b>{value}</b></p>)}</div>
      </article>
      <a class="fact-card fact-contact fact-phone" href={phoneHref} aria-label={`Позвонить в ресторан по номеру ${restaurant.phone}`}>
        <strong>{restaurant.phone}</strong>
        <img src="/images/phone.svg" alt="" aria-hidden="true" />
      </a>
    </section>

    <section class="restaurant-story" aria-label={`${aboutTitle} — «${title}»`}>
      <h2 class:list={{ 'is-single-line': aboutTitle.length <= 18 }}>{aboutTitle}</h2>
      <p>{aboutText}</p>
    </section>

    <section class="restaurant-media" aria-label="Карта и фотографии ресторана">
      <div class="restaurant-location" aria-label={`Карта ресторана «${title}»`}>
        <RestaurantMap restaurants={[restaurant]} apiKey={yandexMapsApiKey} />
      </div>
      <div class="restaurant-gallery" data-restaurant-gallery data-gallery-duration="6000" aria-label={`Галерея ресторана «${title}»`}>
        <div class="gallery-stage">
          {gallery.map((image, index) => <figure class:list={['gallery-slide', { 'is-active': index === 0 }]} data-gallery-slide aria-hidden={index === 0 ? 'false' : 'true'}>
            <img src={image} alt={`Ресторан «${title}», фотография ${index + 1}`} loading={index === 0 ? 'eager' : 'lazy'} />
          </figure>)}
          <button class="gallery-open" type="button" data-gallery-open aria-label="Открыть фотографию на весь экран">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4H4v5M15 4h5v5M9 20H4v-5M15 20h5v-5"/></svg>
          </button>
        </div>
        {gallery.length > 1 && <div class="gallery-thumbnails" aria-label="Выбор фотографии">
          {gallery.map((image, index) => <button class:list={{ 'is-active': index === 0 }} type="button" data-gallery-control={index} aria-pressed={index === 0 ? 'true' : 'false'} aria-label={`Показать фотографию ${index + 1}`}>
            <img src={image} alt="" loading="lazy" />
          </button>)}
        </div>}
        <dialog class="gallery-lightbox" data-gallery-lightbox aria-label={`Полноэкранная галерея ресторана «${title}»`}>
          <button class="lightbox-close" type="button" data-lightbox-close aria-label="Закрыть полноэкранный просмотр">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
          </button>
          <button class="lightbox-arrow lightbox-prev" type="button" data-lightbox-prev aria-label="Предыдущая фотография" hidden={gallery.length < 2}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6"/></svg>
          </button>
          <figure><img src={gallery[0]} alt={`Ресторан «${title}», фотография 1`} data-lightbox-image /></figure>
          <button class="lightbox-arrow lightbox-next" type="button" data-lightbox-next aria-label="Следующая фотография" hidden={gallery.length < 2}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 6 6 6-6 6"/></svg>
          </button>
          <span class="lightbox-counter" data-lightbox-counter>{`1 / ${gallery.length}`}</span>
        </dialog>
      </div>
    </section>

    {visitAmenities.length > 0 && <section class="restaurant-visit" aria-label="Что важно знать перед визитом">
      <h2>Перед визитом</h2>
      <div class="visit-list">
        {visitAmenities.map(({ iconUrl, title, description }) => <article>
          <span class="visit-icon" aria-hidden="true">
            <img src={iconUrl} alt="" />
          </span>
          <strong>{title}</strong>
          <p>{description}</p>
        </article>)}
      </div>
    </section>}

    <section class="restaurant-resources" aria-label="Меню и навигация">
      <a class="resource-card resource-menu" href={menuUrl}>
        <strong>Смотреть<br />меню</strong>
        <img src="/images/menu-track.svg" alt="" aria-hidden="true" />
      </a>
      {restaurant.menuPdfUrl
        ? <a class="resource-card resource-pdf" href={restaurant.menuPdfUrl} target="_blank" rel="noreferrer">
            <strong>Меню<br />в PDF</strong>
          </a>
        : <div class="resource-card resource-pdf is-disabled" aria-disabled="true">
            <strong>Меню<br />в PDF</strong>
          </div>}
      <a class="resource-card resource-yandex" href={yandexMapsUrl} target="_blank" rel="noreferrer" aria-label="Открыть ресторан в Яндекс Картах">
        <strong>Яндекс<br />Карты</strong>
        <img src="/images/yandex-maps.svg" alt="" aria-hidden="true" />
      </a>
      <a class="resource-card resource-2gis" href={twoGisUrl} target="_blank" rel="noreferrer" aria-label="Открыть ресторан в 2ГИС">
        <strong>2ГИС</strong>
        <img src="/images/2gis-logo.svg" alt="" aria-hidden="true" />
      </a>
    </section>
  </div>
</PageShell>

<script>
  document.querySelectorAll<HTMLElement>('[data-restaurant-gallery]').forEach((gallery) => {
    const slides = [...gallery.querySelectorAll<HTMLElement>('[data-gallery-slide]')]
    const controls = [...gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-control]')]
    const lightbox = gallery.querySelector<HTMLDialogElement>('[data-gallery-lightbox]')
    const lightboxImage = gallery.querySelector<HTMLImageElement>('[data-lightbox-image]')
    const lightboxCounter = gallery.querySelector<HTMLElement>('[data-lightbox-counter]')
    const duration = Number(gallery.dataset.galleryDuration) || 6000
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    let activeIndex = 0
    let timer: number | undefined

    const syncLightbox = () => {
      if (!lightboxImage) return
      const source = slides[activeIndex]?.querySelector<HTMLImageElement>('img')
      if (!source) return
      lightboxImage.src = source.currentSrc || source.src
      lightboxImage.alt = source.alt
      if (lightboxCounter) lightboxCounter.textContent = `${activeIndex + 1} / ${slides.length}`
    }

    const show = (index: number) => {
      activeIndex = (index + slides.length) % slides.length
      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === activeIndex
        slide.classList.toggle('is-active', active)
        slide.setAttribute('aria-hidden', String(!active))
      })
      controls.forEach((control, controlIndex) => {
        const active = controlIndex === activeIndex
        control.classList.toggle('is-active', active)
        control.setAttribute('aria-pressed', String(active))
      })
      if (lightbox?.open) syncLightbox()
    }

    const pause = () => {
      if (timer !== undefined) window.clearInterval(timer)
      timer = undefined
    }
    const play = () => {
      pause()
      if (slides.length < 2 || reducedMotion.matches || document.hidden || lightbox?.open) return
      timer = window.setInterval(() => show(activeIndex + 1), duration)
    }

    controls.forEach((control, index) => control.addEventListener('click', () => {
      show(index)
      play()
    }))
    gallery.querySelector<HTMLButtonElement>('[data-gallery-open]')?.addEventListener('click', () => {
      pause()
      syncLightbox()
      lightbox?.showModal()
    })
    gallery.querySelector<HTMLButtonElement>('[data-lightbox-close]')?.addEventListener('click', () => lightbox?.close())
    gallery.querySelector<HTMLButtonElement>('[data-lightbox-prev]')?.addEventListener('click', () => show(activeIndex - 1))
    gallery.querySelector<HTMLButtonElement>('[data-lightbox-next]')?.addEventListener('click', () => show(activeIndex + 1))
    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox) lightbox.close()
    })
    lightbox?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(activeIndex - 1)
      if (event.key === 'ArrowRight') show(activeIndex + 1)
    })
    lightbox?.addEventListener('close', play)
    gallery.addEventListener('pointerenter', pause)
    gallery.addEventListener('pointerleave', play)
    gallery.addEventListener('focusin', pause)
    gallery.addEventListener('focusout', (event) => {
      if (!gallery.contains(event.relatedTarget as Node | null)) play()
    })
    document.addEventListener('visibilitychange', play)
    reducedMotion.addEventListener('change', play)
    play()
  })
</script>

<style>
  .restaurant-detail{display:grid;gap:14px;width:100%;padding:0}
  .restaurant-hero{display:grid;grid-template-columns:minmax(0,.86fr) minmax(440px,1.14fr);min-height:min(47vw,690px);overflow:hidden;border-radius:var(--radius);background:#f0ece5;padding:clamp(16px,2vw,32px)}
  .restaurant-hero-copy{display:flex;align-items:flex-start;justify-content:center;flex-direction:column;padding:clamp(30px,3vw,54px)}
  .restaurant-hero h1{max-width:680px;margin:0;color:var(--ink);font-size:clamp(54px,4.7vw,82px);line-height:.86;letter-spacing:-.09em;overflow-wrap:anywhere;text-wrap:balance}.restaurant-hero h1.is-long{font-size:clamp(44px,4vw,68px);letter-spacing:-.075em}
  .restaurant-hero-copy>p{max-width:500px;margin:27px 0 0;color:var(--muted);font-size:16px;line-height:1.62}
  .restaurant-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:31px}
  .detail-button{display:inline-flex;min-height:50px;align-items:center;justify-content:center;padding:0 23px;border:1px solid transparent;border-radius:var(--radius);font-size:12px;font-weight:800;text-decoration:none;transition:transform .22s ease,background-color .22s ease,border-color .22s ease,color .22s ease,box-shadow .22s ease}
  .detail-button:hover{box-shadow:0 9px 18px rgba(31,59,46,.14);transform:translateY(-2px)}
  .detail-button-dark{background:var(--moss);color:#fff}.detail-button-dark:hover{background:#315b45}
  .detail-button-accent{background:var(--lime);color:var(--moss)}.detail-button-accent:hover{background:#cae65f}
  .restaurant-hero figure{min-width:0;margin:0;overflow:hidden;border-radius:var(--radius);background:#ded8ce}
  .restaurant-hero figure img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .65s cubic-bezier(.22,1,.36,1)}
  .restaurant-hero:hover figure img{transform:scale(1.025)}
  .restaurant-facts{--fact-primary-size:clamp(22px,1.8vw,30px);display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:clamp(42px,5vw,78px)}
  .fact-card{position:relative;display:flex;min-width:0;min-height:270px;align-items:flex-start;justify-content:flex-start;flex-direction:column;padding:clamp(22px,2.3vw,36px);overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);text-decoration:none}
  .fact-card small,.resource-card>span{color:#6f7b6e;font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}
  .fact-card strong{max-width:420px;margin-top:auto;padding-top:38px;color:var(--ink);font-size:var(--fact-primary-size);line-height:.94;letter-spacing:-.07em}
  a.fact-card{transition:transform .25s ease,background-color .25s ease}
  a.fact-card:hover{transform:translateY(-4px)}
  .fact-address{background:#e4eadc}.fact-address:hover{background:#dce7d4}
  .fact-phone{background:#eee4d8}.fact-phone:hover{background:#e8dccd}
  .fact-contact strong{position:relative;z-index:1;max-width:78%;margin-top:0;padding-top:0}
  .fact-contact img{--contact-icon-rotate:0deg;position:absolute;width:clamp(190px,18vw,300px);height:clamp(190px,18vw,300px);margin:0;filter:brightness(0) invert(1);opacity:.34;pointer-events:none;transform:rotate(var(--contact-icon-rotate));transition:transform .45s cubic-bezier(.22,1,.36,1)}
  .fact-address img{--contact-icon-rotate:-8deg;right:-7%;bottom:-31%}
  .fact-phone img{--contact-icon-rotate:7deg;right:5%;bottom:-35%}
  .fact-phone strong{max-width:none;white-space:nowrap}
  .fact-contact:hover img{transform:translateY(-8px) rotate(var(--contact-icon-rotate))}
  .fact-schedule{background:#fffdf9}
  .fact-schedule>div{width:100%;margin:auto 0}
  .fact-schedule p{display:grid;grid-template-columns:42px 1fr;gap:12px;margin:0;padding:1px 0;font-size:var(--fact-primary-size);line-height:1;letter-spacing:-.055em}
