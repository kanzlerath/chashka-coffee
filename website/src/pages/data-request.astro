---
import LegalPage from '../components/LegalPage.astro'
import type { LegalSection } from '../lib/legal-documents'

const sections: LegalSection[] = [
  { id: 'requests', heading: 'Что можно запросить', paragraphs: ['Пользователь вправе узнать, обрабатываются ли его данные, получить сведения и копию, потребовать исправления неточностей, ограничить обработку, отозвать согласие, удалить аккаунт или данные в предусмотренных законом случаях.'] },
  { id: 'submit', heading: 'Как направить обращение', paragraphs: ['Напишите на support@chashkacoffee.ru с темой «Персональные данные». Укажите имя, контакт, которым пользовались на сайте, суть требования и сервис или примерную дату обращения. Не присылайте копию паспорта без отдельного запроса: сначала мы предложим соразмерный способ подтвердить личность.'], links: [{ label: 'Написать в поддержку', href: 'mailto:support@chashkacoffee.ru' }] },
  { id: 'verification', heading: 'Почему нужна проверка', paragraphs: ['До раскрытия, изменения или удаления данных мы должны убедиться, что запрос исходит от самого пользователя или его представителя. Можем попросить подтвердить доступ к телефону или e-mail либо сообщить сведения об обращении, которые известны только заявителю.'] },
  { id: 'response', heading: 'Срок ответа', paragraphs: ['Обращение рассматривается в сроки, установленные Федеральным законом № 152-ФЗ. Если запрос сложный или затрагивает другого оператора, мы сообщим о порядке дальнейшей работы и, когда это уместно, передадим его ответственному юридическому лицу.'] },
  { id: 'limits', heading: 'Когда удаление ограничено', paragraphs: ['Часть сведений нельзя удалить сразу, если закон требует хранить документы о расчётах и заказах, данные нужны для действующего договора, рассмотрения претензии или защиты прав. В этом случае использование ограничивается соответствующей целью, а данные удаляются после прекращения основания.'] },
  { id: 'complaint', heading: 'Защита права', paragraphs: ['Если ответ не решает вопрос, пользователь вправе обратиться в Роскомнадзор или суд. До этого можно повторно написать нам — мы постараемся разобраться по существу.'], links: [{ label: 'Политика данных', href: '/privacy' }] },
]
---

<LegalPage href="/data-request" intro="Практический порядок доступа, исправления, отзыва согласия и удаления аккаунта." sections={sections} related={['/privacy', '/consent', '/requisites']} />
