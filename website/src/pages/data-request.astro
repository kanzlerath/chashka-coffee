---
import LegalPage from '../components/LegalPage.astro'
import type { LegalSection } from '../lib/legal-documents'

const sections: LegalSection[] = [
  {
    heading: '1. Права заявителя',
    clauses: [
      { number: '1.1.', text: 'Субъект персональных данных вправе запросить подтверждение факта обработки его персональных данных и получить сведения, предусмотренные законодательством Российской Федерации.' },
      { number: '1.2.', text: 'Субъект вправе потребовать уточнения, блокирования или уничтожения персональных данных, если они являются неполными, устаревшими, неточными, незаконно полученными или не нужны для заявленной цели.' },
      { number: '1.3.', text: 'Субъект вправе отозвать согласие на обработку персональных данных, отказаться от рекламных сообщений и потребовать удаления аккаунта.' },
    ],
  },
  {
    heading: '2. Порядок направления запроса',
    clauses: [
      { number: '2.1.', text: 'Запрос направляется на адрес электронной почты support@chashkacoffee.ru с темой «Персональные данные».' },
      { number: '2.2.', text: 'Запрос должен содержать фамилию и имя заявителя, контактные сведения, использованные на Сайте, описание требования, сведения о соответствующем сервисе или примерной дате обращения.' },
      { number: '2.3.', text: 'Если запрос направляет представитель, к нему прилагаются сведения и документы, подтверждающие полномочия представителя.' },
      { number: '2.4.', text: 'Не следует направлять копию паспорта без отдельного мотивированного запроса Оператора. Сначала Оператор предлагает соразмерный способ подтверждения личности.' },
    ],
  },
  {
    heading: '3. Подтверждение личности',
    clauses: [
      { number: '3.1.', text: 'До предоставления, изменения или удаления персональных данных Оператор обязан убедиться, что запрос направлен субъектом персональных данных или его надлежащим представителем.' },
      { number: '3.2.', text: 'Для подтверждения личности Оператор вправе предложить подтвердить доступ к номеру телефона или адресу электронной почты либо сообщить сведения о первоначальном обращении.' },
      { number: '3.3.', text: 'Оператор не предоставляет в ответе персональные данные иных субъектов, если отсутствует законное основание для их раскрытия.' },
    ],
  },
  {
    heading: '4. Рассмотрение запроса',
    clauses: [
      { number: '4.1.', text: 'Оператор рассматривает запрос и направляет ответ в сроки, установленные Федеральным законом от 27.07.2006 № 152-ФЗ «О персональных данных».' },
      { number: '4.2.', text: 'Если обработку осуществляет иное юридическое лицо, Оператор вправе передать запрос ответственному лицу и уведомить об этом заявителя.' },
      { number: '4.3.', text: 'Если требование не может быть исполнено полностью, Оператор направляет мотивированный ответ с указанием законного основания.' },
    ],
  },
  {
    heading: '5. Ограничения удаления',
    clauses: [
      { number: '5.1.', text: 'Удаление может быть отложено в части сведений, которые Оператор обязан хранить в соответствии с законодательством о бухгалтерском и налоговом учете, применении контрольно-кассовой техники, защите прав потребителей или по иному законному основанию.' },
      { number: '5.2.', text: 'Данные также могут быть сохранены в объеме, необходимом для исполнения действующего договора, рассмотрения претензии или защиты прав в связи со спором.' },
      { number: '5.3.', text: 'После прекращения основания для хранения персональные данные уничтожаются или обезличиваются.' },
      { number: '5.4.', text: 'Действия или бездействие Оператора могут быть обжалованы в Роскомнадзоре или в суде.' },
    ],
  },
]
---

<LegalPage href="/data-request" sections={sections} />
