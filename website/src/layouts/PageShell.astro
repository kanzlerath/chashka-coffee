---
import SiteHeader from '../components/SiteHeader.astro';
import CustomerAccountDialog from '../components/CustomerAccountDialog.astro';
import CartDrawer from '../components/CartDrawer.astro';
import FormSuccessDialog from '../components/FormSuccessDialog.astro';
import CookieConsent from '../components/CookieConsent.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/public-system.css';
interface Props { title: string; description?: string; active?: string; footer?: boolean; image?: string; noindex?: boolean }
const { title, description = 'Чашка кофе — сеть ресторанов в Новосибирске.', active = '', footer = true, image = '/images/home-hero-v1.png', noindex = false } = Astro.props;
const siteOrigin = import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin
const canonical = new URL(Astro.url.pathname, siteOrigin)
const imageUrl = new URL(image, siteOrigin)
const analyticsUrl = `${import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3000'}/api/analytics/page-view`
const rawYandexMetrikaId = import.meta.env.PUBLIC_YANDEX_METRIKA_ID ?? ''
const yandexMetrikaId = /^\d+$/.test(rawYandexMetrikaId) ? rawYandexMetrikaId : ''
---
<html lang="ru" class="public-site"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#fcfbf8"/><link rel="icon" href="/favicon.ico" sizes="any"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{noindex && <meta name="robots" content="noindex,nofollow"/>}<meta property="og:type" content="website"/><meta property="og:locale" content="ru_RU"/><meta property="og:site_name" content="Чашка кофе"/><meta property="og:title" content={`${title} — Чашка кофе`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={imageUrl}/><meta name="twitter:card" content="summary_large_image"/><title>{title} — Чашка кофе</title></head><body id="top" class="public-site"><div class="page-shell"><SiteHeader active={active}/><CustomerAccountDialog/><CartDrawer/><FormSuccessDialog/><main class="public-main" data-path={Astro.url.pathname}><slot /></main>{footer && <SiteFooter/>}</div><CookieConsent analyticsUrl={analyticsUrl} yandexMetrikaId={yandexMetrikaId}/><script is:inline>
  (() => {
    const body = document.body
    const html = document.documentElement
    let lockMode = 'none'
    let lockedScrollY = 0
    let queued = false
    const initialStyle = {
      position: body.style.position,
      top: body.style.top,
      left: body.style.left,
      right: body.style.right,
      width: body.style.width,
      overflow: body.style.overflow,
    }

    const syncScrollLock = () => {
      queued = false
      const hasDialog = Boolean(document.querySelector('dialog[open]'))
      const hasMobileMenu = Boolean(document.querySelector('[data-site-header].is-mobile-open'))
      const nextMode = hasDialog ? 'dialog' : hasMobileMenu ? 'menu' : 'none'
      if (nextMode === lockMode) return

      if (lockMode === 'dialog') {
        Object.assign(body.style, initialStyle)
        window.scrollTo(0, lockedScrollY)
      }
      lockMode = nextMode

      if (nextMode === 'dialog') {
        lockedScrollY = window.scrollY
        html.classList.add('public-scroll-locked')
        body.classList.add('public-scroll-locked')
        Object.assign(body.style, { position: 'fixed', top: `-${lockedScrollY}px`, left: '0', right: '0', width: '100%', overflow: 'hidden' })
        return
      }
      if (nextMode === 'menu') {
        html.classList.add('public-scroll-locked')
        body.classList.add('public-scroll-locked')
        body.style.overflow = 'hidden'
        return
      }
      html.classList.remove('public-scroll-locked')
      body.classList.remove('public-scroll-locked')
      Object.assign(body.style, initialStyle)
    }

    const requestSync = () => {
      if (queued) return
      queued = true
      requestAnimationFrame(syncScrollLock)
    }

    new MutationObserver(requestSync).observe(document.body, { subtree: true, attributes: true, attributeFilter: ['open', 'class'] })
    document.addEventListener('toggle', requestSync, true)
    document.addEventListener('touchmove', (event) => {
      if (lockMode !== 'menu' || (event.target instanceof Element && event.target.closest('#site-menu'))) return
      event.preventDefault()
    }, { passive: false })
    requestSync()
  })()
</script></body></html>
